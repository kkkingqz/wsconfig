#!/bin/sh
# GRUB submenu "Timeshift snapshots": one entry per Timeshift snapshot of @,
# newest first, booting the kernel and initrd inside that snapshot with it
# as root (helpws rebuild, Recovery). Timeshift snapshots are writable: what
# such a boot changes stays in the snapshot. Regenerated by update-grub,
# which the Timeshift backup hook runs after every snapshot.
set -e

[ "$GRUB_FS" = btrfs ] || exit 0
[ -n "$GRUB_DEVICE_UUID" ] || exit 0

top="$(mktemp -d)"
trap 'umount "$top" 2>/dev/null; rmdir "$top"' EXIT
mount -o ro,subvolid=5 "UUID=$GRUB_DEVICE_UUID" "$top" || exit 0
snaps="$top/timeshift-btrfs/snapshots"
[ -d "$snaps" ] || exit 0

# The newest T2 kernel with its initrd (the internal keyboard needs t2bce),
# else the newest kernel with its initrd; plain sort -V would pick a newer
# generic kernel over the T2 one.
pick_kernel() {
    for pattern in 'vmlinuz-*-t2-*' 'vmlinuz-*'; do
        k="$(find "$1" -maxdepth 1 -type f -name "$pattern" -printf '%f\n' | sort -V \
            | while read -r v; do [ -f "$1/initrd.img-${v#vmlinuz-}" ] && echo "$v"; done | tail -n1)"
        [ -n "$k" ] && { echo "$k"; return; }
    done
}

json() {
    sed -n "s/^[[:space:]]*\"$1\"[[:space:]]*:[[:space:]]*\"\(.*\)\",\{0,1\}[[:space:]]*\$/\1/p" "$2" \
        | head -n1 | tr -d "'\"\\\\\$"
}

entries=""
# shellcheck disable=SC2045 # Timeshift names: dates without spaces, newest first
for d in $(ls -1r "$snaps"); do
    boot="$snaps/$d/@/boot"
    [ -d "$boot" ] || continue
    k="$(pick_kernel "$boot")"
    [ -n "$k" ] || continue
    path="/timeshift-btrfs/snapshots/$d/@/boot"
    tags="$(json tags "$snaps/$d/info.json" 2>/dev/null || true)"
    comment="$(json comments "$snaps/$d/info.json" 2>/dev/null || true)"
    title="$d${tags:+ [$tags]}${comment:+ — $comment} (${k#vmlinuz-})"
    entries="$entries
    menuentry '$title' --class ubuntu --class gnu-linux --class os {
        insmod btrfs
        search --no-floppy --fs-uuid --set=root $GRUB_DEVICE_UUID
        linux $path/$k root=UUID=$GRUB_DEVICE_UUID rw rootflags=subvol=timeshift-btrfs/snapshots/$d/@ $GRUB_CMDLINE_LINUX $GRUB_CMDLINE_LINUX_DEFAULT
        initrd $path/initrd.img-${k#vmlinuz-}
    }"
done
[ -n "$entries" ] || exit 0

echo "Found Timeshift snapshots: $(echo "$entries" | grep -c menuentry)" >&2
cat <<GRUB
submenu 'Timeshift snapshots' {$entries
}
GRUB
