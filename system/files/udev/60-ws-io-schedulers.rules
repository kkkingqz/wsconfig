# I/O schedulers of Bazzite (60-schedulers.rules) for legiongo (helpws
# plan-legion-go, 3.6): kyber for NVMe and SATA SSDs, bfq for microSD and
# disks. Bazzite matches microSD partitions, which have no queue; here the
# card itself. The schedulers are modules: setting one loads it.
ACTION=="add|change", KERNEL=="nvme[0-9]*n[0-9]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="kyber"
ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="kyber"
ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
ACTION=="add|change", KERNEL=="mmcblk[0-9]", ATTR{queue/scheduler}="bfq"
