t2bce for linux-t2 7.3 (linux-t2-patches 7e24fb1, t2bce_core 0.09). The
no-state teardown fix of deqrocks/t2bce#9, carried here since 2026-09-25 as
0.07-nostatefix1, is upstream in this version; what stays local:

1. a NULL check in t2bce_core_reserve_submission(): a queue whose CQ
   registration failed after a no-state wake has no SQ, and the submission
   oopsed in IRQ context (the hard hang of 2026-09-25);
2. t2bce_core.stateful_sleep as a module parameter (default Y), so the
   no-state path can be tested on demand (ws help suspend).

Version tag 0.09-nostatefix2: ws-workstation-verify recognises the build by
"nostatefix".

diff --git a/drivers/staging/t2bce/t2bce_core/t2bce_main.c b/drivers/staging/t2bce/t2bce_core/t2bce_main.c
index b135057..0ce9582 100644
--- a/drivers/staging/t2bce/t2bce_core/t2bce_main.c
+++ b/drivers/staging/t2bce/t2bce_core/t2bce_main.c
@@ -28,7 +28,9 @@
 
 static dev_t bce_chrdev;
 static struct class *bce_class;
-static const bool bce_use_stateful_sleep = true;
+static bool bce_use_stateful_sleep = true;
+module_param_named(stateful_sleep, bce_use_stateful_sleep, bool, 0644);
+MODULE_PARM_DESC(stateful_sleep, "Use bridgeOS stateful sleep (default: Y); N forces the no-state path for testing");
 
 struct t2bce_device *global_bce;
 
@@ -941,7 +943,7 @@ static void __exit t2bce_module_exit(void)
 MODULE_LICENSE("GPL");
 MODULE_AUTHOR("André Eikmeyer <andre.eikmeyer@kait2en.org>");
 MODULE_DESCRIPTION("T2 BCE core driver");
-MODULE_VERSION("0.09");
+MODULE_VERSION("0.09-nostatefix2");
 MODULE_SOFTDEP("post: t2bce_vhci");
 module_init(t2bce_module_init);
 module_exit(t2bce_module_exit);
diff --git a/drivers/staging/t2bce/t2bce_core/transport.c b/drivers/staging/t2bce/t2bce_core/transport.c
index 100516e..4e31571 100644
--- a/drivers/staging/t2bce/t2bce_core/transport.c
+++ b/drivers/staging/t2bce/t2bce_core/transport.c
@@ -383,6 +383,11 @@ EXPORT_SYMBOL_GPL(t2bce_core_queue_sq_userdata);
 
 int t2bce_core_reserve_submission(struct t2bce_core_queue_sq *sq, unsigned long *timeout)
 {
+    /* A queue whose registration failed after no-state wake has no SQ; fail the submission instead of oopsing in IRQ context. */
+    if (unlikely(!sq)) {
+        pr_warn_ratelimited("t2bce_core: submission on missing queue rejected\n");
+        return -ENODEV;
+    }
     return t2bce_dma_reserve_submission(to_bce_sq(sq), timeout);
 }
 EXPORT_SYMBOL_GPL(t2bce_core_reserve_submission);
