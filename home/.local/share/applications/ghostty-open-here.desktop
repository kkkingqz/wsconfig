[Desktop Entry]
Name=Ghostty (Open Here)
Comment=Open Ghostty in selected directory
Exec=/usr/bin/ghostty --gtk-single-instance=false
TryExec=/usr/bin/ghostty
Type=Application
Terminal=false
Categories=System;TerminalEmulator;
# Only for xdg-terminal-exec ("Open in Terminal" in Files), which ignores
# NoDisplay; the menu has Ghostty itself.
NoDisplay=true
X-TerminalArgExec=-e
X-TerminalArgDir=--working-directory=
