# =============================================================================
# Ghostty common config — Linux + macOS
# =============================================================================

# -----------------------------------------------------------------------------
# Appearance
# -----------------------------------------------------------------------------

# 15% transparency
background-opacity = 0.90

# Keep native desktop chrome
window-theme = system
window-decoration = auto

# Native macOS titlebar instead of Ghostty's transparent/custom style
macos-titlebar-style = native

# Tabs
window-show-tab-bar = auto

# Very subtle dimming of inactive splits
unfocused-split-opacity = 0.95


# -----------------------------------------------------------------------------
# Scrollback
# -----------------------------------------------------------------------------

# 32 MiB per terminal surface.
# Allocated lazily, not reserved immediately.
scrollback-limit = 33554432

# Respect GNOME/macOS scrollbar behavior
scrollbar = system


# -----------------------------------------------------------------------------
# Clipboard / mouse
# -----------------------------------------------------------------------------

copy-on-select = true
right-click-action = context-menu

# OSC52 policy
clipboard-read = ask
clipboard-write = allow

# Keep paste attack protection
clipboard-paste-protection = true

# Don't show a toast every time text is copied
app-notifications = no-clipboard-copy


# -----------------------------------------------------------------------------
# URLs
# -----------------------------------------------------------------------------

link-url = true
link-previews = true


# -----------------------------------------------------------------------------
# Shell integration
# -----------------------------------------------------------------------------

shell-integration = detect

# Keep normal default shell integration features and additionally
# make sudo preserve Ghostty terminfo correctly.
shell-integration-features = sudo

window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true


# -----------------------------------------------------------------------------
# macOS keyboard behavior
# -----------------------------------------------------------------------------

# Make Option behave as Alt so Alt-based shortcuts are identical
# between Linux and macOS.
macos-option-as-alt = true


# =============================================================================
# Keybindings — iKitty-style
# =============================================================================

# -----------------------------------------------------------------------------
# Tabs
# -----------------------------------------------------------------------------

keybind = ctrl+t=new_tab
keybind = ctrl+shift+w=close_tab

keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

keybind = ctrl+shift+page_up=move_tab:-1
keybind = ctrl+shift+page_down=move_tab:1

keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=goto_tab:9
keybind = alt+0=goto_tab:10


# -----------------------------------------------------------------------------
# Windows / surfaces
# -----------------------------------------------------------------------------

keybind = ctrl+shift+n=new_window

# Close focused split/surface
keybind = ctrl+shift+x=close_surface

# Close entire OS window
keybind = ctrl+shift+q=close_window


# -----------------------------------------------------------------------------
# Splits
# -----------------------------------------------------------------------------

# Horizontal split
keybind = alt+minus=new_split:down

# Vertical split
keybind = alt+backslash=new_split:right

# Vim-style navigation
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right

# Arrow navigation
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+down=goto_split:down
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+right=goto_split:right

# Resize focused split
keybind = ctrl+shift+alt+left=resize_split:left,10
keybind = ctrl+shift+alt+right=resize_split:right,10
keybind = ctrl+shift+alt+up=resize_split:up,10
keybind = ctrl+shift+alt+down=resize_split:down,10

# Zoom / restore current split
keybind = ctrl+shift+alt+space=toggle_split_zoom

# Equalize all splits
keybind = ctrl+shift+alt+e=equalize_splits


# -----------------------------------------------------------------------------
# Clipboard
# -----------------------------------------------------------------------------

keybind = performable:ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = shift+insert=paste_from_clipboard


# -----------------------------------------------------------------------------
# Scrollback
# -----------------------------------------------------------------------------

# One line
keybind = alt+page_up=scroll_page_lines:-1
keybind = alt+page_down=scroll_page_lines:1

# One page
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down

# Beginning/end of scrollback
keybind = ctrl+shift+home=scroll_to_top
keybind = ctrl+shift+end=scroll_to_bottom

# Previous/next shell prompt
keybind = ctrl+alt+home=jump_to_prompt:-1
keybind = ctrl+alt+end=jump_to_prompt:1


# -----------------------------------------------------------------------------
# Search
# -----------------------------------------------------------------------------

keybind = ctrl+shift+f=start_search


# -----------------------------------------------------------------------------
# Font size
# -----------------------------------------------------------------------------

keybind = ctrl+equal=increase_font_size:2
keybind = ctrl+minus=decrease_font_size:2
keybind = ctrl+zero=reset_font_size


# -----------------------------------------------------------------------------
# Terminal / config
# -----------------------------------------------------------------------------

keybind = ctrl+shift+delete=clear_screen

keybind = ctrl+alt+r=reload_config
keybind = ctrl+shift+alt+comma=open_config
theme = Desert

# Common Linux/macOS keymap
config-file = keybinds.ghostty

# Common terminal behavior
config-file = behavior.ghostty

# Layout-independent terminal keys
config-file = shell-keys.ghostty
