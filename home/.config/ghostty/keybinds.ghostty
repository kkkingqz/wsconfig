# =============================================================================
# Ghostty keymap — physical keys, Linux + macOS
# =============================================================================

macos-option-as-alt = true

# Tabs
keybind = ctrl+KeyT=new_tab
keybind = ctrl+shift+KeyW=close_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+shift+page_up=move_tab:-1
keybind = ctrl+shift+page_down=move_tab:1
keybind = alt+Digit1=goto_tab:1
keybind = alt+Digit2=goto_tab:2
keybind = alt+Digit3=goto_tab:3
keybind = alt+Digit4=goto_tab:4
keybind = alt+Digit5=goto_tab:5
keybind = alt+Digit6=goto_tab:6
keybind = alt+Digit7=goto_tab:7
keybind = alt+Digit8=goto_tab:8
keybind = alt+Digit9=goto_tab:9
keybind = alt+Digit0=goto_tab:10

# Windows
keybind = ctrl+shift+KeyN=new_window
keybind = ctrl+shift+KeyX=close_surface
keybind = ctrl+shift+KeyQ=close_window

# Splits
keybind = alt+minus=new_split:down
keybind = alt+backslash=new_split:right
keybind = alt+KeyH=goto_split:left
keybind = alt+KeyJ=goto_split:down
keybind = alt+KeyK=goto_split:up
keybind = alt+KeyL=goto_split:right
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+down=goto_split:down
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+alt+left=resize_split:left,10
keybind = ctrl+shift+alt+right=resize_split:right,10
keybind = ctrl+shift+alt+up=resize_split:up,10
keybind = ctrl+shift+alt+down=resize_split:down,10
keybind = ctrl+shift+alt+space=toggle_split_zoom
keybind = ctrl+shift+alt+KeyE=equalize_splits

# Clipboard
keybind = performable:ctrl+shift+KeyC=copy_to_clipboard
keybind = ctrl+shift+KeyV=paste_from_clipboard
keybind = shift+insert=paste_from_clipboard

# macOS-style semantic layer
# Apple Command and PC Win are both Super on Linux.
keybind = super+KeyC=copy_to_clipboard
keybind = super+KeyV=paste_from_clipboard
keybind = super+KeyA=select_all
keybind = super+KeyF=start_search
keybind = super+KeyT=new_tab
keybind = super+KeyN=new_window
keybind = super+KeyW=close_surface
# Close all Ghostty windows. Upstream recommends all:close_window rather than
# the deprecated close_all_windows action.
keybind = all:super+KeyQ=close_window

keybind = super+comma=open_config
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+Digit0=reset_font_size

# URL under cursor
keybind = ctrl+shift+KeyL=copy_url_to_clipboard

# Scrollback
keybind = alt+page_up=scroll_page_lines:-1
keybind = alt+page_down=scroll_page_lines:1
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = ctrl+shift+home=scroll_to_top
keybind = ctrl+shift+end=scroll_to_bottom
keybind = ctrl+alt+home=jump_to_prompt:-1
keybind = ctrl+alt+end=jump_to_prompt:1

# Search
keybind = ctrl+shift+KeyF=start_search

# Font size
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+Digit0=reset_font_size

# Ghostty
keybind = ctrl+shift+KeyP=toggle_command_palette
keybind = ctrl+shift+delete=clear_screen
keybind = ctrl+alt+KeyR=reload_config
keybind = ctrl+shift+alt+comma=open_config

# Ctrl+Enter -> Meta/Alt+Enter for terminal TUI applications
keybind = ctrl+enter=text:\x1b\r
