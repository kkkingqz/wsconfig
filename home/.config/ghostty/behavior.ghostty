# =============================================================================
# Ghostty behavior — Linux + macOS
# =============================================================================

# Scrollback: 32 MiB per terminal surface, allocated lazily
scrollback-limit = 33554432
scrollbar = system

# Clipboard
clipboard-read = ask
clipboard-write = allow
clipboard-paste-protection = true
copy-on-select = true
selection-clear-on-copy = false
right-click-action = context-menu

# Avoid toast every time something is copied
app-notifications = no-clipboard-copy

# URLs
link-url = true
link-previews = osc8

# Shell integration / working directory inheritance
shell-integration = detect
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

# Fish 4 supports prompt marking, so click-to-move works
cursor-click-to-move = true
mouse-hide-while-typing = true

# Notify only about long commands completed in background tabs/windows
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 10s
desktop-notifications = true
