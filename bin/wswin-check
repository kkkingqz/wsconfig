#!/usr/bin/env bash
set -u
set -o pipefail

# Windows layer (windows/apps.nix, the Windows boxes of distrobox.nix):
# programs point at Windows boxes and are installed in their prefixes, .exe
# opens in the default box, menu links resolve. Read-only. wswin check; ws check runs it with --json
# (lib/check.bash).

repo="${WSCONFIG:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
# shellcheck source=../lib/check.bash
. "$repo/lib/check.bash"

case "${1:-}" in
    --json) check_json_mode ;;
    "") ;;
    -h|--help) echo "Usage: wswin check [--json]"; exit 0 ;;
    *) echo "wswin check: unknown argument: $1" >&2; exit 64 ;;
esac

data="${WSWIN_DATA:-$HOME/.local/share/workstation}"
boxes_ini="$data/distrobox/boxes.ini"
apps_ini="$data/windows/apps.ini"
# Both files are built by ws switch (distrobox/distrobox.nix, windows/apps.nix).
win_boxes="$(awk '/^\[/ { box = substr($0, 2, length($0) - 2) } /^profile=/ { print box }' "$boxes_ini" 2>/dev/null)"
if [[ -n "$win_boxes" ]]; then
    pass "Windows boxes: $(echo $win_boxes)"
else
    fail "no Windows box in boxes.ini (distrobox/distrobox.nix)"
fi

# Launchers exist only where the box is marked yes (distrobox/hosts.txt,
# windows/apps.nix); the programs of other boxes are not checked here.
hosts_file="${WSBOX_HOSTS:-$repo/distrobox/hosts.txt}"
declare -A box_state=()
# Errors apart from the BOX STATE lines: a warning must not become a box.
marks_err="$(mktemp)"
if host="$("$repo/bin/ws" host 2>/dev/null)" \
    && states="$(python3 "$repo/lib/ws_marks.py" "$hosts_file" states "$host" $win_boxes 2>"$marks_err")"; then
    while read -r box state; do
        [[ -n "$box" ]] && box_state[$box]="$state"
    done <<<"$states"
else
    err="$(tr '\n' ' ' < "$marks_err")"
    fail "workstation marks of $hosts_file: ${err:-unknown workstation (ws host)}"
    host=unknown
fi
rm -f "$marks_err"
on_host() { [[ "${box_state[$1]:-ask}" == yes ]]; }

default_box="$(sed -nE 's/^default_box=//p' "$apps_ini" 2>/dev/null)"
if [[ -n "$default_box" ]] && grep -qxF "$default_box" <<<"$win_boxes"; then
    pass "wswin default box is a Windows box: $default_box"
else
    fail "wswin default box is not a Windows box: ${default_box:-<none>}"
fi

while IFS= read -r app; do
    [[ -n "$app" && "$app" != wswin ]] || continue
    app_box="$(awk -v s="[$app]" '$0 == s { i = 1; next } i && /^\[/ { exit } i && /^box=/ { sub(/^box=/, ""); print; exit }' "$apps_ini")"
    if grep -qxF "$app_box" <<<"$win_boxes"; then
        pass "app $app: box $app_box is a Windows box"
    else
        fail "app $app: box ${app_box:-<none>} is not a Windows box"
    fi
    if ! on_host "$app_box"; then
        info "app $app: box $app_box is not on $host, no launcher (wsbox apply $app_box)"
        continue
    fi
    # The program itself is machine state (wswin install, a prefix from a
    # backup): on a new machine the launcher exists before it (phase 6, wsvm).
    app_prefix="$(awk -v s="[$app]" '$0 == s { i = 1; next } i && /^\[/ { exit } i && /^prefix=/ { sub(/^prefix=/, ""); print; exit }' "$apps_ini")"
    app_exe="$(awk -v s="[$app]" '$0 == s { i = 1; next } i && /^\[/ { exit } i && /^exe=/ { sub(/^exe=/, ""); print; exit }' "$apps_ini")"
    if [[ "$app_prefix" == default ]]; then
        app_dir="$HOME/distrobox/$app_box/.wine"
    else
        app_dir="$HOME/distrobox/$app_box/prefixes/$app_prefix"
    fi
    if [[ -f "$app_dir/$app_exe" ]]; then
        pass "app $app: installed ($app_exe)"
    else
        warn "app $app: not installed, the launcher has nothing to run: $app_dir/$app_exe (helpws windows; helpws rebuild)"
    fi
done < <(sed -nE 's/^\[([^]]+)\]$/\1/p' "$apps_ini" 2>/dev/null)

if ! on_host "$default_box"; then
    info ".exe: default box $default_box is not on $host, no ws-win-exe.desktop"
elif have xdg-mime; then
    exe_default="$(xdg-mime query default application/vnd.microsoft.portable-executable 2>/dev/null)"
    if [[ "$exe_default" == ws-win-exe.desktop ]]; then
        pass ".exe opens with ws-win-exe.desktop (wine-wayland, standard prefix)"
    else
        warn ".exe opens with ${exe_default:-nothing}, not ws-win-exe.desktop (ws switch)"
    fi
fi

dangling_menu=""
for link in "$HOME"/.local/share/applications/wswin-*.desktop; do
    [[ -L "$link" && ! -e "$link" ]] && dangling_menu+=" $(basename "$link")"
done
if [[ -n "$dangling_menu" ]]; then
    warn "wswin menu links to missing prefixes:$dangling_menu (wswin menu sync)"
else
    pass "wswin menu links resolve"
fi

info "GPU for Proton/Steam: $("$repo/bin/ws-gpu" status 2>/dev/null || echo unknown)"

check_finish
