#!/usr/bin/env bash
set -euo pipefail

# Functional baseline of the workstation: what every layer owner reports and
# what is actually installed. Used as the regression gate of the Nix migration
# (helpws history-nix, "Эталон функционала").

repo="${WSCONFIG:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
root="${XDG_STATE_HOME:-$HOME/.local/state}/workstation/baseline"

usage() {
    cat <<'USAGE'
Usage:
  ws-baseline capture NAME [--no-boxes] [--with-sudo]
  ws-baseline diff A B
  ws-baseline list

capture   snapshot of owner checks, GNOME, Flatpak, Distrobox, user links,
          system files and tools into ~/.local/state/workstation/baseline/NAME;
          system files are those of `ws system manifest` (file and watch)
          --no-boxes    skip `wsbox check` (it starts the containers)
          --with-sudo   also dpkg --verify, the initramfs listing, the default
                        Btrfs subvolume and checksums of the manifest's ESP
                        files (asks sudo)
diff      compare two baselines; owner checks are compared as sets of
          PASS/WARN/FAIL lines, everything else line by line
USAGE
}

die() {
    echo "ws-baseline: $*" >&2
    exit 1
}


# path -> resolved target and content hash, for every entry under the given
# locations (symlinks are listed with their final target).
list_entries() {
    local base path target sum
    for base in "$@"; do
        [[ -e "$base" || -L "$base" ]] || { printf '%s\tMISSING\n' "$base"; continue; }
        while IFS= read -r -d '' path; do
            target="$(readlink -f -- "$path" 2>/dev/null || echo '?')"
            if [[ -f "$target" ]]; then
                sum="$(sha256sum -- "$target" | cut -c1-16)"
            elif [[ -L "$path" ]]; then
                sum="BROKEN"
            else
                continue
            fi
            printf '%s\t%s\t%s\n' "$path" "$target" "$sum"
        done < <(find "$base" \( -type f -o -type l \) -print0 2>/dev/null | sort -z)
    done
}

run_to() {
    local out="$1"
    shift
    { "$@" 2>&1 || echo "[exit $?]"; } > "$out"
}

cmd_capture() {
    local name="" boxes=true with_sudo=false dir app
    while (($#)); do
        case "$1" in
            --no-boxes) boxes=false ;;
            --with-sudo) with_sudo=true ;;
            -*) die "unknown option: $1" ;;
            *) [[ -z "$name" ]] || die "only one NAME"; name="$1" ;;
        esac
        shift
    done
    [[ -n "$name" && "$name" != */* ]] || die "capture needs a NAME"

    dir="$root/$name"
    [[ ! -e "$dir" ]] || die "baseline exists: $dir"
    mkdir -p "$dir"/{checks,gnome,flatpak/overrides,distrobox,user,system}

    {
        echo "name: $name"
        echo "date: $(date --iso-8601=seconds)"
        echo "host: $(hostname)"
        echo "kernel: $(uname -r)"
        echo "repo: $(git -C "$repo" rev-parse HEAD 2>/dev/null || echo '?')"
        echo "repo-dirty: $(git -C "$repo" status --porcelain 2>/dev/null | wc -l)"
    } > "$dir/meta.txt"

    # What the system layer owns (system/*.nix): files, ESP files, units and
    # the files it watches. Kept with the baseline, so diff compares what
    # each baseline covered at its time.
    "$repo/bin/ws" system manifest > "$dir/system/manifest.txt" 2>/dev/null \
        || die "ws system manifest failed"

    echo "== owner checks"
    # wsbox check first: it starts the containers; verify checks NTSync inside
    # only in running ones.
    if [[ "$boxes" == true ]]; then
        run_to "$dir/checks/wsbox-check.txt" "$repo/bin/wsbox" check
    fi
    run_to "$dir/checks/ws-check-repo.txt" "$repo/bin/ws-check-repo"
    run_to "$dir/checks/ws-check-home.txt" "$repo/bin/ws-check-home"
    run_to "$dir/checks/ws-check-virt.txt" "$repo/bin/ws-check-virt"
    run_to "$dir/checks/ws-check-steam.txt" "$repo/bin/ws-check-steam"
    run_to "$dir/checks/ws-keyboard-check.txt" "$repo/bin/ws-keyboard-check"
    run_to "$dir/checks/ws-system-check.txt" "$repo/bin/ws" system check
    run_to "$dir/checks/wsflatpak-check.txt" "$repo/bin/wsflatpak" check
    run_to "$dir/checks/wswin-check.txt" "$repo/bin/wswin-check"
    run_to "$dir/checks/ws-gnome-check.txt" "$repo/bin/ws-gnome" check
    run_to "$dir/checks/ws-gnome-test.txt" "$repo/bin/ws-gnome" test
    run_to "$dir/checks/ws-suspend-check.txt" "$repo/bin/ws-suspend-check"
    run_to "$dir/checks/ws-suspend-status.txt" "$repo/bin/ws-suspend" status
    run_to "$dir/checks/ws-keyboard-status.txt" "$repo/bin/ws-keyboard-status"
    run_to "$dir/checks/ws-input-source-status.txt" "$repo/bin/ws-input-source" status
    run_to "$dir/checks/ws-workstation-verify.txt" "$repo/bin/ws-workstation-verify" --strict

    echo "== GNOME"
    run_to "$dir/gnome/dconf.ini" dconf dump /
    run_to "$dir/gnome/extensions-enabled.txt" gnome-extensions list --enabled

    echo "== Flatpak"
    run_to "$dir/flatpak/apps.txt" flatpak list --user --app --columns=application,origin,branch
    run_to "$dir/flatpak/remotes.txt" flatpak remotes --user --columns=name,url
    run_to "$dir/flatpak/system-remotes.txt" flatpak remotes --system --columns=name
    while IFS= read -r app; do
        [[ -n "$app" ]] || continue
        run_to "$dir/flatpak/overrides/$app.txt" flatpak override --user --show "$app"
    done < <(flatpak list --user --app --columns=application 2>/dev/null)
    run_to "$dir/flatpak/override-global.txt" flatpak override --user --show
    list_entries "$HOME/.local/share/applications" > "$dir/flatpak/applications.txt"

    echo "== Distrobox"
    run_to "$dir/distrobox/podman.txt" podman ps -a --format '{{.Names}} {{.ID}} {{.ImageName}} {{.Labels.manager}}'
    ls -1 "$HOME/distrobox" > "$dir/distrobox/homes.txt" 2>&1 || true

    echo "== user layer"
    list_entries \
        "$HOME/.local/bin" \
        "$HOME/.config/fish" \
        "$HOME/.config/ghostty" \
        "$HOME/.config/systemd/user" \
        "$HOME/.config/environment.d" \
        "$HOME/.config/nix" \
        "$HOME/.config/xdg-terminals.list" \
        "$HOME/.config/ubuntu-xdg-terminals.list" \
        "$HOME/.local/share/gnome-shell/extensions" \
        "$HOME/.local/share/man" \
        | grep -v '/fish_variables	' > "$dir/user/entries.txt" || true
    run_to "$dir/user/units-enabled.txt" systemctl --user list-unit-files --state=enabled --no-legend
    run_to "$dir/user/units-active.txt" systemctl --user list-units --state=active --no-legend --plain
    systemctl --user show-environment 2>/dev/null \
        | grep -vE '^(INVOCATION_ID|MANAGERPID|SSH_AUTH_SOCK|GNOME_KEYRING_CONTROL|SYSTEMD_EXEC_PID|WAYLAND_DISPLAY|DISPLAY|XAUTHORITY)=' \
        > "$dir/user/environment.txt" || true

    echo "== system"
    local f kind a
    while IFS=$'\t' read -r kind a f; do
        [[ "$kind" == file || "$kind" == watch ]] || continue
        if [[ -r "$f" ]]; then
            printf '%s\t%s\n' "$f" "$(sha256sum -- "$f" | cut -c1-16)"
        elif [[ -e "$f" ]]; then
            printf '%s\tUNREADABLE\n' "$f"
        else
            printf '%s\tMISSING\n' "$f"
        fi
    done < "$dir/system/manifest.txt" > "$dir/system/files.txt"
    ls -1 /etc/default/grub.d/ > "$dir/system/grub.d.txt" 2>&1 || true
    run_to "$dir/system/units-enabled.txt" systemctl list-unit-files --state=enabled --no-legend
    tr ' ' '\n' < /proc/cmdline | grep -v '^initrd=' > "$dir/system/cmdline.txt"
    cat /sys/power/mem_sleep > "$dir/system/mem_sleep.txt"
    # Modules the manifest's modules-load.d and modprobe.d files name:
    # loaded or not (a blacklisted one must stay unloaded).
    local tree mod
    tree="$("$repo/bin/ws" system tree 2>/dev/null)" || die "ws system tree failed"
    for mod in $(cat "$tree"/files/etc/modules-load.d/*.conf "$tree"/files/etc/modprobe.d/*.conf 2>/dev/null \
        | awk '/^[[:space:]]*#/ || NF == 0 { next }
               $1 == "options" || $1 == "blacklist" || $1 == "install" { print $2; next }
               NF == 1 { print $1 }' | tr - _ | sort -u); do
        if [[ -d "/sys/module/$mod" ]]; then
            printf '%s\tloaded\n' "$mod"
        else
            printf '%s\tnot loaded\n' "$mod"
        fi
    done > "$dir/system/modules.txt"
    {
        cat /sys/module/t2bce_core/version 2>/dev/null || echo "t2bce_core: not loaded"
        apt-mark showhold 2>/dev/null
    } > "$dir/system/t2bce.txt"
    findmnt -rno TARGET,SOURCE,FSTYPE,OPTIONS / /home /nix 2>/dev/null \
        > "$dir/system/mounts.txt" || true

    echo "== packages"
    # The owners' package lists: apt (nix/hosts/*apt.txt, as ws check apt)
    # and the Nix profile (home.packages) of the active generation.
    local h pkg hm fact list
    local -a lists
    h="$("$repo/bin/ws" host)"
    # The same lists as ws check apt: the layers by their facts.
    lists=("$repo/nix/hosts/apt.txt" "$repo/nix/hosts/$h/apt.txt")
    for fact in vm:virt nativeSteam:steam gameMode:gaming; do
        list="${fact#*:}"
        [[ "$("$repo/bin/ws" fact "${fact%%:*}" 2>/dev/null)" != yes ]] || lists+=("$repo/$list/apt.txt")
    done
    {
        cat "${lists[@]}" 2>/dev/null \
            | sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' -e '/^ppa:/d' | sort -u \
            | while read -r pkg; do
                if [[ "$pkg" == purge:* ]]; then
                    dpkg-query -W -f='${Status}' "${pkg#purge:}" 2>/dev/null | grep -q ' installed$' \
                        && printf 'purge\t%s\tINSTALLED\n' "${pkg#purge:}" \
                        || printf 'purge\t%s\tpurged\n' "${pkg#purge:}"
                    continue
                fi
                if [[ "$pkg" == source:* ]]; then
                    # The repository and its key, as bootstrap.sh installs them.
                    cmp -s "$repo/nix/hosts/$h/apt/${pkg#source:}.sources" \
                        "/etc/apt/sources.list.d/ws-${pkg#source:}.sources" \
                        && cmp -s "$repo/nix/hosts/$h/apt/${pkg#source:}.asc" \
                            "/etc/apt/keyrings/ws-${pkg#source:}.asc" \
                        && printf 'source\t%s\tpresent\n' "${pkg#source:}" \
                        || printf 'source\t%s\tMISSING\n' "${pkg#source:}"
                    continue
                fi
                if [[ "$pkg" == arch:* ]]; then
                    dpkg --print-foreign-architectures | grep -qx "${pkg#arch:}" \
                        && printf 'arch\t%s\tpresent\n' "${pkg#arch:}" \
                        || printf 'arch\t%s\tMISSING\n' "${pkg#arch:}"
                    continue
                fi
                printf 'apt\t%s\t%s\n' "$pkg" \
                    "$(dpkg-query -W -f='${Version}' "$pkg" 2>/dev/null || echo MISSING)"
            done
        hm="$(readlink -f "${XDG_STATE_HOME:-$HOME/.local/state}/nix/profiles/home-manager" 2>/dev/null)"
        for pkg in "$hm"/home-path/bin/*; do
            [[ -e "$pkg" ]] || continue
            printf 'nix\t%s\t%s\n' "${pkg##*/}" "$(readlink -f "$pkg")"
        done
    } > "$dir/packages.txt"

    if [[ "$with_sudo" == true ]]; then
        echo "== sudo"
        sudo dpkg --verify > "$dir/system/dpkg-verify.txt" 2>&1 || true
        # After a Timeshift restore the default must be the new @ (its restore
        # hook sets it; rEFInd boots from it; helpws rebuild, Recovery).
        sudo btrfs subvolume get-default / > "$dir/system/get-default.txt" 2>&1 || true
        sudo lsinitrd "/boot/initrd.img-$(uname -r)" 2>/dev/null \
            | awk '{ print $NF }' | grep -E 't2bce|appletb|modprobe\.d|modules-load' \
            | sort > "$dir/system/initrd.txt" || true
        # ESP files of the manifest (the ESP is not mounted in normal
        # operation): read-only checksums.
        while IFS=$'\t' read -r kind a f; do
            [[ "$kind" == esp ]] || continue
            sudo sh -c '
                esp="$(mktemp -d)"
                mount -o ro "/dev/disk/by-partuuid/$1" "$esp" \
                    && { sha256sum "$esp/$2" | sed "s|$esp|ESP|"; umount "$esp"; }
                rmdir "$esp"
            ' sh "$a" "$f" 2>&1 || true
        done < "$dir/system/manifest.txt" > "$dir/system/refind-esp.txt"
    fi

    echo
    echo "Captured: $dir"
}

# Owner checks (lib/check.bash): keep only PASS/WARN/FAIL lines, normalized
# and sorted, so the comparison is about which checks pass, not about
# ordering or timings. Dropped: what depends on the moment, not on the
# workstation - the Git state of the checkout, the active layout, checks
# inside containers that run only when they happen to be up. Status reports
# without such lines (ws-suspend status, ws-keyboard-status) are compared as
# whole text.
normalize_check() {
    if grep -qE '^[[:space:]]*(PASS|WARN|FAIL)[[:space:]]' "$1" 2>/dev/null; then
        grep -E '^[[:space:]]*(PASS|WARN|FAIL)[[:space:]]' "$1" \
            | sed -E 's/^[[:space:]]+//; s/[[:space:]]+/ /g' \
            | grep -vE '^(PASS|WARN|FAIL) (working tree|[a-z0-9-]+: (wsbox-host-ntsync|container-local|NTSYNC-MODULE|/dev/ntsync visible))' \
            | sed -E "s/^(PASS ws-input-source status works: ).*/\\1<layout>/" \
            | sort -u
    else
        cat "$1"
    fi
}

# Active user units without what depends on open apps and devices: app and
# container scopes, device units, snap namespace mounts. Names only.
normalize_units() {
    awk '{ print $1 }' "$1" \
        | grep -vE '\.(scope|device)$|^run-snapd-ns-' \
        | sort -u
}

cmd_diff() {
    local a="$root/${1:-}" b="$root/${2:-}" rel changed=0 tmp
    [[ -n "${1:-}" && -n "${2:-}" ]] || die "diff needs A and B"
    [[ -d "$a" ]] || die "no baseline: $a"
    [[ -d "$b" ]] || die "no baseline: $b"
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' RETURN

    while IFS= read -r rel; do
        if [[ ! -e "$a/$rel" ]]; then
            echo "=== only in ${2}: $rel"
            changed=1
            continue
        fi
        if [[ ! -e "$b/$rel" ]]; then
            echo "=== only in ${1}: $rel"
            changed=1
            continue
        fi
        case "$rel" in
            meta.txt) continue ;;
            # The active layout is the state of the moment, not configuration.
            checks/ws-input-source-status.txt)
                sed -E "s/^\('[a-z]+', '[a-z]+'\)$/<layout>/" "$a/$rel" > "$tmp/a"
                sed -E "s/^\('[a-z]+', '[a-z]+'\)$/<layout>/" "$b/$rel" > "$tmp/b"
                ;;
            checks/*)
                normalize_check "$a/$rel" > "$tmp/a"
                normalize_check "$b/$rel" > "$tmp/b"
                ;;
            # The generation counter grows with every write.
            system/get-default.txt)
                sed -E 's/ gen [0-9]+//' "$a/$rel" > "$tmp/a"
                sed -E 's/ gen [0-9]+//' "$b/$rel" > "$tmp/b"
                ;;
            gnome/dconf.ini)
                grep -v "^caps-binary-state=" "$a/$rel" > "$tmp/a"
                grep -v "^caps-binary-state=" "$b/$rel" > "$tmp/b"
                ;;
            gnome/extensions-enabled.txt|system/files.txt)
                sort "$a/$rel" > "$tmp/a"
                sort "$b/$rel" > "$tmp/b"
                ;;
            user/units-active.txt)
                normalize_units "$a/$rel" > "$tmp/a"
                normalize_units "$b/$rel" > "$tmp/b"
                ;;
            *)
                cp "$a/$rel" "$tmp/a"
                cp "$b/$rel" "$tmp/b"
                ;;
        esac
        if ! cmp -s "$tmp/a" "$tmp/b"; then
            echo "=== $rel"
            diff -U0 --label "$1" --label "$2" "$tmp/a" "$tmp/b" | grep -v '^@@' || true
            changed=1
        fi
    done < <( { (cd "$a" && find . -type f -printf '%P\n'); (cd "$b" && find . -type f -printf '%P\n'); } | sort -u)

    if ((changed)); then
        echo
        echo "Differences found. Each one must be an expected change of the phase."
        return 1
    fi
    echo "No differences."
}

cmd_list() {
    [[ -d "$root" ]] || return 0
    local d
    for d in "$root"/*/; do
        [[ -d "$d" ]] || continue
        printf '%-20s %s\n' "$(basename "$d")" "$(sed -n 's/^date: //p' "$d/meta.txt" 2>/dev/null)"
    done
}

case "${1:-}" in
    capture) shift; cmd_capture "$@" ;;
    diff) shift; cmd_diff "$@" ;;
    list) cmd_list ;;
    -h|--help|help|"") usage ;;
    *) usage >&2; exit 64 ;;
esac
