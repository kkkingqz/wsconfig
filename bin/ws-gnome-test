#!/usr/bin/env bash
set -u
set -o pipefail

# shellcheck source=../lib/common.bash
. "$(dirname "$(readlink -f "$0")")/../lib/common.bash"
strict=false

usage() {
    cat <<'USAGE'
Usage:
  ws-gnome-test [--strict]

Options:
  --strict   warnings make the command exit 2
  -h,--help  show this help

Read-only final smoke-test for the host GNOME layer.

Explicitly OUT OF SCOPE:
  - Touch Bar
  - Flatpak application integration
  - Distrobox application integration
  - Wine
USAGE
}

while (($#)); do
    case "$1" in
        --strict) strict=true; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "ws-gnome-test: unknown option: $1" >&2; exit 64 ;;
    esac
done

pass_n=0
warn_n=0
fail_n=0
info_n=0

pass() { ((pass_n++)); printf '  PASS  %s\n' "$*"; }
warn() { ((warn_n++)); printf '  WARN  %s\n' "$*"; }
fail() { ((fail_n++)); printf '  FAIL  %s\n' "$*"; }
info() { ((info_n++)); printf '  INFO  %s\n' "$*"; }

section() {
    echo
    echo "$1"
    printf '%s\n' '------------------------------------------------------------------------'
}

have() { command -v "$1" >/dev/null 2>&1; }

pkg_installed() {
    dpkg-query -W -f='${Status}' "$1" 2>/dev/null \
        | grep -qx 'install ok installed'
}

gget() {
    gsettings get "$1" "$2" 2>/dev/null || true
}

expect_gsetting() {
    local schema="$1" key="$2" expected="$3" label="$4" got
    got="$(gget "$schema" "$key")"
    if [[ "$got" == "$expected" ]]; then
        pass "$label"
    else
        fail "$label — got ${got:-MISSING}, expected $expected"
    fi
}

service_active() {
    local unit="$1"
    if systemctl --user is-active --quiet "$unit" 2>/dev/null; then
        pass "$unit active"
    else
        fail "$unit not active"
    fi
}

echo "GNOME host smoke-test"
echo "Time: $(date --iso-8601=seconds 2>/dev/null || date)"
echo "Mode: READ-ONLY"
echo "Scope: GNOME host layer only; Touch Bar/Flatpak/Distrobox/Wine excluded"

section "1. Session / compositor"

[[ "${XDG_CURRENT_DESKTOP:-}" == *GNOME* ]] \
    && pass "GNOME desktop session: ${XDG_CURRENT_DESKTOP:-}" \
    || fail "XDG_CURRENT_DESKTOP is not GNOME: ${XDG_CURRENT_DESKTOP:-unset}"

[[ "${XDG_SESSION_TYPE:-}" == "wayland" ]] \
    && pass "session type: Wayland" \
    || fail "session type is not Wayland: ${XDG_SESSION_TYPE:-unset}"

[[ -n "${WAYLAND_DISPLAY:-}" ]] \
    && pass "WAYLAND_DISPLAY=${WAYLAND_DISPLAY}" \
    || fail "WAYLAND_DISPLAY is unset"

if have gnome-shell; then
    shell_ver="$(gnome-shell --version 2>/dev/null || true)"
    [[ "$shell_ver" == "GNOME Shell 50."* ]] \
        && pass "$shell_ver" \
        || warn "unexpected GNOME Shell version: ${shell_ver:-unknown}"
else
    fail "gnome-shell binary missing"
fi

if have gdctl; then
    gdout="$(gdctl show 2>/dev/null || true)"
    scale="$(awk '/^[[:space:]]*.*Scale:[[:space:]]*/ {print $NF; exit}' <<<"$gdout")"
    if [[ "$scale" == "1.5" ]]; then
        pass "logical display scale: 1.5"
    elif [[ -n "$scale" ]]; then
        fail "logical display scale drift: $scale (checkpoint is 1.5)"
    else
        fail "unable to read logical display scale through gdctl"
    fi

    grep -Fq '3072x1920@60' <<<"$gdout" \
        && pass "internal display current mode 3072x1920@60" \
        || warn "expected internal 3072x1920@60 mode not found in gdctl output"
else
    fail "gdctl missing"
fi

section "2. Appearance / managed profile"

expect_gsetting org.gnome.desktop.interface color-scheme "'prefer-dark'" \
    "dark preference"
expect_gsetting org.gnome.desktop.interface accent-color "'orange'" \
    "orange accent"
expect_gsetting org.gnome.desktop.interface gtk-theme "'Yaru-dark'" \
    "GTK theme Yaru-dark"
expect_gsetting org.gnome.desktop.interface icon-theme "'Yaru-dark'" \
    "icon theme Yaru-dark"
expect_gsetting org.gnome.desktop.interface cursor-theme "'Yaru'" \
    "cursor theme Yaru"

if [[ -x "$repo/bin/ws-gnome-check" ]]; then
    if "$repo/bin/ws-gnome-check" --quiet >/dev/null 2>&1; then
        pass "managed appearance/Dock profile is in sync"
    else
        fail "managed appearance/Dock profile has drift"
    fi
else
    fail "ws-gnome-check missing or not executable"
fi

section "3. Ubuntu Dock"

dock_schema="org.gnome.shell.extensions.dash-to-dock"
expect_gsetting "$dock_schema" dock-position "'BOTTOM'" "Dock position bottom"
expect_gsetting "$dock_schema" dock-fixed "true" "Dock fixed mode"
expect_gsetting "$dock_schema" autohide "true" "Dock autohide"
expect_gsetting "$dock_schema" intellihide "true" "Dock intellihide"
expect_gsetting "$dock_schema" dash-max-icon-size "50" "Dock icon size 50"
expect_gsetting "$dock_schema" show-show-apps-button "true" "Show Applications kept"
expect_gsetting "$dock_schema" show-trash "false" "Dock trash hidden"

section "4. GNOME extension policy"

# Every extension of gnome/gnome-extensions.nix (built by ws switch).
ext_list_file="$HOME/.local/share/workstation/gnome/extensions"
required_extensions=()
if [[ -r "$ext_list_file" ]]; then
    mapfile -t required_extensions < <(awk '!/^#/ && NF >= 2 { print $1 }' "$ext_list_file")
fi
((${#required_extensions[@]})) || fail "extension list missing: $ext_list_file (ws switch)"

if have gnome-extensions; then
    enabled="$(gnome-extensions list --enabled 2>/dev/null || true)"

    for uuid in "${required_extensions[@]}"; do
        grep -Fxq "$uuid" <<<"$enabled" \
            && pass "required extension enabled: $uuid" \
            || fail "required extension not enabled: $uuid"
    done

    unknown=()
    while IFS= read -r uuid; do
        [[ -n "$uuid" ]] || continue
        known=false
        for expected in "${required_extensions[@]}"; do
            if [[ "$uuid" == "$expected" ]]; then
                known=true
                break
            fi
        done
        [[ "$known" == true ]] || unknown+=("$uuid")
    done <<<"$enabled"

    if ((${#unknown[@]})); then
        warn "additional enabled extension(s) outside policy: ${unknown[*]}"
    else
        pass "no additional enabled extensions outside policy"
    fi
else
    fail "gnome-extensions binary missing"
fi


section "4.1 Dock spring-loading source policy"

dock_spring_src="$repo/gnome/extensions/workstation-dock-spring@local/extension.js"
dock_spring_runtime="$HOME/.local/share/gnome-shell/extensions/workstation-dock-spring@local/extension.js"

if [[ -r "$dock_spring_src" ]]; then
    pass "Dock Spring source exists in repository"

    grep -Fq 'const HOVER_DELAY_MS = 1300;' "$dock_spring_src" \
        && pass "Dock Spring hover delay is 1300 ms" \
        || fail "Dock Spring hover delay is not the tested 1300 ms"

    grep -Fq 'running-app-only' "$dock_spring_src" \
        && pass "Dock Spring running-app-only policy marker present" \
        || fail "Dock Spring running-app-only marker missing"

    if grep -Eq '(^|[^A-Za-z0-9_])app\.activate\(' "$dock_spring_src" \
        || grep -Fq '_watchLaunchedApp' "$dock_spring_src"; then
        fail "Dock Spring contains application launch-on-hover logic"
    else
        pass "Dock Spring does not launch closed applications"
    fi
else
    fail "Dock Spring source missing from repository"
fi

if [[ -r "$dock_spring_src" && -r "$dock_spring_runtime" ]]; then
    cmp -s "$dock_spring_src" "$dock_spring_runtime" \
        && pass "Dock Spring runtime matches repository source" \
        || fail "Dock Spring runtime differs from repository source"
else
    fail "Dock Spring runtime source is unavailable"
fi

section "5. Host Qt5 / Qt6"

qt_pkgs=(
    qgnomeplatform-qt5
    qgnomeplatform-qt6
    qtwayland5
    qt6-wayland
)

for pkg in "${qt_pkgs[@]}"; do
    pkg_installed "$pkg" \
        && pass "Qt baseline package installed: $pkg" \
        || fail "Qt baseline package missing: $pkg"
done

manual_pkgs="$(apt-mark showmanual 2>/dev/null || true)"
for pkg in "${qt_pkgs[@]}"; do
    grep -Fxq "$pkg" <<<"$manual_pkgs" \
        && pass "Qt baseline package marked manual: $pkg" \
        || warn "Qt baseline package is not marked manual: $pkg"
done

if pkg_installed juffed; then
    warn "temporary Qt5 test app still installed: juffed"
else
    pass "temporary Qt5 test app removed"
fi

if pkg_installed featherpad; then
    warn "temporary Qt6 test app still installed: featherpad"
else
    pass "temporary Qt6 test app removed"
fi

qt5_plugin="$(dpkg -L qtwayland5 2>/dev/null | grep '/libqwayland-generic\.so$' | head -n1 || true)"
[[ -n "$qt5_plugin" && -r "$qt5_plugin" ]] \
    && pass "Qt5 native Wayland platform plugin present" \
    || fail "Qt5 libqwayland-generic.so not found"

qt6_plugin="$(
    find /usr/lib \
        -type f \
        -path '*/qt6/plugins/platforms/libqwayland.so' \
        -print -quit 2>/dev/null || true
)"
[[ -n "$qt6_plugin" && -r "$qt6_plugin" ]] \
    && pass "Qt6 native Wayland platform plugin present: $qt6_plugin" \
    || fail "Qt6 libqwayland.so not found"

qt_override_bad=false
for var in QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME QT_STYLE_OVERRIDE QT_SCALE_FACTOR; do
    value="${!var:-}"
    if [[ -n "$value" ]]; then
        qt_override_bad=true
        fail "global Qt override should be unset: $var=$value"
    fi
done
[[ "$qt_override_bad" == false ]] \
    && pass "no global Qt platform/theme/scale overrides"

section "6. Portals / PipeWire / XWayland"

service_active xdg-desktop-portal.service
service_active xdg-desktop-portal-gnome.service
service_active pipewire.service
service_active pipewire-pulse.service
service_active wireplumber.service

if have gdbus; then
    portal_info="$(
        gdbus introspect \
            --session \
            --dest org.freedesktop.portal.Desktop \
            --object-path /org/freedesktop/portal/desktop \
            2>/dev/null || true
    )"

    [[ -n "$portal_info" ]] \
        && pass "org.freedesktop.portal.Desktop responds" \
        || fail "org.freedesktop.portal.Desktop does not respond"

    grep -Fq 'org.freedesktop.portal.FileChooser' <<<"$portal_info" \
        && pass "FileChooser portal interface available" \
        || fail "FileChooser portal interface missing"

    grep -Fq 'org.freedesktop.portal.ScreenCast' <<<"$portal_info" \
        && pass "ScreenCast portal interface available" \
        || fail "ScreenCast portal interface missing"

    grep -Fq 'org.freedesktop.portal.Settings' <<<"$portal_info" \
        && pass "Settings portal interface available" \
        || fail "Settings portal interface missing"
else
    fail "gdbus missing; portal interfaces cannot be probed"
fi

if have Xwayland || pkg_installed xwayland; then
    pass "XWayland compatibility layer available"
else
    warn "XWayland compatibility layer not detected"
fi

section "7. Recent GNOME crash-level journal"

if have journalctl; then
    crash_hits="$(
        journalctl -b --no-pager 2>/dev/null \
            | grep -Ei 'gnome-shell.*(segfault|core dumped|fatal error)|mutter.*(segfault|core dumped|fatal error)' \
            | tail -n 20 || true
    )"

    if [[ -z "$crash_hits" ]]; then
        pass "no GNOME Shell/Mutter crash-level messages found this boot"
    else
        warn "GNOME Shell/Mutter crash-level journal matches found:"
        printf '%s\n' "$crash_hits" | sed 's/^/        /'
    fi
else
    info "journalctl unavailable; journal smoke-check skipped"
fi

section "8. Manual smoke checklist"

cat <<'CHECKLIST'
Run these checks once. They are intentionally NOT automated:

  [ ] Overview opens immediately and remains responsive.
  [ ] Ubuntu Dock and Quick Settings open without visible lag/glitches.
  [ ] Nautilus and GNOME Settings are dark, sharp and correctly sized at scale 1.5.
  [ ] Minimize / maximize / restore / fullscreen work normally.
  [ ] Clipboard copy/paste works between two host GUI applications.
  [ ] Drag-and-drop a file from Nautilus onto a host application window works.
  [ ] While dragging a file from Nautilus, hover over an already-running
      Ubuntu Dock app for ~1.3 s: its existing window comes forward; continue
      the same drag into that window and drop the file.
  [ ] While dragging a file, hover over a CLOSED pinned Dock app for several
      seconds: the application stays closed.
  [ ] A host application's Open/Save dialog opens and can select/save a file.
  [ ] Firefox/browser screen-share chooser opens and lists a window/display
      (actual Flatpak application integration is deferred to plan-flatpak).

If all ten manual items pass, the GNOME host layer is ready for final review.
CHECKLIST

section "9. Summary"

printf '  PASS: %d\n' "$pass_n"
printf '  WARN: %d\n' "$warn_n"
printf '  FAIL: %d\n' "$fail_n"
printf '  INFO: %d\n' "$info_n"

if ((fail_n > 0)); then
    echo
    echo "RESULT: FAILED"
    exit 1
fi

if [[ "$strict" == true && $warn_n -gt 0 ]]; then
    echo
    echo "RESULT: WARNINGS (--strict)"
    exit 2
fi

echo
echo "RESULT: AUTOMATED CHECKS PASSED"
exit 0
