#!/usr/bin/env bash
set -euo pipefail

# Windows programs in the Windows boxes of distrobox/distrobox.nix
# (profile wine: wine/winetricks; profile proton: umu-run). Programs with a
# launcher are listed in windows/apps.nix. ws switch builds both files:
#
#   ~/.local/share/workstation/distrobox/boxes.ini   [BOX] home profile driver dpi
#                                                    init_overrides gpu
#   ~/.local/share/workstation/windows/apps.ini      [wswin] default_box; [APP] ...
#
# Prefixes live in the container HOME (~/distrobox/BOX), survive recreate:
#   default   $HOME/.wine
#   NAME      $HOME/prefixes/NAME
#
# Commands run through `wsbox run`, which adds DRI_PRIME for gpu=amd boxes.

data="${WSWIN_DATA:-$HOME/.local/share/workstation}"
boxes_ini="$data/distrobox/boxes.ini"
apps_ini="$data/windows/apps.ini"
bin_dir="$(dirname "$(readlink -f "$0")")"

usage() {
    cat <<'USAGE'
Usage:
  wswin list
  wswin check [--json]
  wswin install [--box BOX] [--prefix NAME] [--desktop[=WxH]] SETUP.exe|.msi [ARG...]
  wswin portable [--box BOX] [--prefix NAME] FILE.exe|DIR|FILE.zip [APPNAME]
  wswin run APP [ARG...]
  wswin exec [--box BOX] [--prefix NAME] [--desktop[=WxH]] PROGRAM [ARG...]
  wswin prefix [--box BOX] NAME init [--dpi N]
  wswin prefix [--box BOX] NAME winecfg|regedit|kill|path
  wswin prefix [--box BOX] NAME winetricks [ARG...]
  wswin prefix [--box BOX] NAME remove
  wswin shell [--box BOX] [--prefix NAME]
  wswin menu [--box BOX] [--prefix NAME] add [PROGRAM.exe [TITLE]]
  wswin menu list|sync
  wswin menu remove ID

BOX defaults to the default_box of apps.ini, NAME to "default" (the
standard prefix $HOME/.wine of the box). --desktop runs the program in a
Wine virtual desktop (one window; the size is asked for, default
1600x1000, but Wine 10+/Proton under XWayland scaling opens it fullscreen):
for installers that keep taking the focus back from other windows.

Host menu entries made by install/portable/menu add are kept in the prefix
(PREFIX/.wswin/menu) and linked into ~/.local/share/applications as
wswin-BOX-PREFIX-NAME.desktop; they go with `prefix ... remove`, `menu sync`
links them again (new system, restored HOME). Programs that must come back
with the repository: windows/apps.nix.
USAGE
}

die() {
    printf 'wswin: %s\n' "$*" >&2
    exit 1
}

ini_value() {
    local file="$1" section="$2" key="$3"

    awk -v section="[$section]" -v key="$key" '
        $0 == section { inside = 1; next }
        inside && /^\[/ { exit }
        inside {
            k = $0
            sub(/=.*/, "", k)
            if (k == key) {
                sub(/^[^=]*=/, "")
                print
                exit
            }
        }
    ' "$file"
}

sections() {
    sed -nE 's/^\[([^]]+)\]$/\1/p' "$1"
}

ensure_config() {
    [[ -r "$boxes_ini" ]] || die "not found: $boxes_ini (ws switch)"
    [[ -r "$apps_ini" ]] || die "not found: $apps_ini (ws switch)"
}

box_value() {
    ini_value "$boxes_ini" "$1" "$2"
}

require_box() {
    local box="$1" profile

    profile="$(box_value "$box" profile)"
    [[ -n "$profile" ]] || die "not a Windows box: $box (distrobox/distrobox.nix)"
}

default_box() {
    ini_value "$apps_ini" wswin default_box
}

box_home() {
    local home

    home="$(box_value "$1" home)"
    printf '%s\n' "${home//\$\{HOME\}/$HOME}"
}

prefix_path() {
    local box="$1" name="$2"

    [[ "$name" =~ ^[A-Za-z0-9._-]+$ && "$name" != . && "$name" != .. ]] \
        || die "bad prefix name: $name"

    if [[ "$name" == default ]]; then
        printf '%s/.wine\n' "$(box_home "$box")"
    else
        printf '%s/prefixes/%s\n' "$(box_home "$box")" "$name"
    fi
}

# Run a command in BOX with WINEPREFIX. For proton, GAMEID tells umu which
# protonfixes apply (none for umu-default). LC_CTYPE (apps.ini lc_ctype)
# is the codepage of non-Unicode programs, LC_MESSAGES the UI language. With a custom HOME distrobox
# starts in /run/host/$PWD, which the Steam Runtime (pressure-vessel)
# refuses: start in WSWIN_CWD (a host path that exists in the container) or
# the container HOME.
in_box() {
    local box="$1" prefix="$2"
    shift 2

    exec_box "$box" env \
        WINEPREFIX="$prefix" \
        GAMEID="${GAMEID:-umu-default}" \
        WINEDEBUG="${WINEDEBUG:--all}" \
        LC_CTYPE="$(ini_value "$apps_ini" wswin lc_ctype)" \
        LC_MESSAGES="$(ini_value "$apps_ini" wswin lc_messages)" \
        WSWIN_CWD="${WSWIN_CWD:-}" \
        bash -c 'cd "${WSWIN_CWD:-$HOME}" && exec "$@"' _ "$@"
}

exec_box() {
    local box="$1"
    shift

    "$bin_dir/wsbox" run "$box" "$@"
}

# The Windows side of a box: wine PROGRAM or umu-run PROGRAM.
runner() {
    case "$(box_value "$1" profile)" in
        wine) printf 'wine\n' ;;
        proton) printf 'umu-run\n' ;;
        *) die "unknown profile of $1" ;;
    esac
}

# Create the prefix once: wineboot, then the graphics driver and DPI of the
# box (or --dpi). Registry changes are flushed by waiting for wineserver.
ensure_prefix() {
    local box="$1" name="$2" dpi="${3:-}" prefix run driver overrides

    prefix="$(prefix_path "$box" "$name")"
    [[ -f "$prefix/system.reg" && -z "$dpi" ]] && return 0

    run="$(runner "$box")"
    driver="$(box_value "$box" driver)"
    [[ -n "$dpi" ]] || dpi="$(box_value "$box" dpi)"
    overrides="$(box_value "$box" init_overrides)"

    printf 'wswin: prefix %s/%s: %s\n' "$box" "$name" "$prefix" >&2
    mkdir -p "$prefix"

    in_box "$box" "$prefix" bash -c '
        set -e
        run="$1" driver="$2" dpi="$3" overrides="$4"
        if [[ ! -f "$WINEPREFIX/system.reg" ]]; then
            WINEDLLOVERRIDES="${overrides:-$WINEDLLOVERRIDES}" "$run" wineboot -u
        fi
        if [[ -n "$driver" ]]; then
            "$run" reg add "HKCU\\Software\\Wine\\Drivers" /v Graphics /d "$driver" /f
        fi
        if [[ -n "$dpi" ]]; then
            "$run" reg add "HKCU\\Control Panel\\Desktop" /v LogPixels /t REG_DWORD /d "$dpi" /f
        fi
        if [[ "$run" == wine ]]; then
            wineserver -w
        fi
    ' _ "$run" "$driver" "$dpi" "$overrides"
}

# --box BOX --prefix NAME --desktop[=WxH]; sets box, pname, desktop, rest.
parse_target() {
    box="$(default_box)"
    pname=default
    desktop=""
    rest=()

    while (($#)); do
        case "$1" in
            --box) box="${2:?--box needs a value}"; shift 2 ;;
            --prefix) pname="${2:?--prefix needs a value}"; shift 2 ;;
            --desktop) desktop=1600x1000; shift ;;
            --desktop=*)
                desktop="${1#--desktop=}"
                [[ "$desktop" =~ ^[0-9]+x[0-9]+$ ]] || die "bad --desktop size: $desktop (WxH)"
                shift ;;
            --) shift; rest+=("$@"); break ;;
            *) rest+=("$@"); break ;;
        esac
    done

    [[ -n "$box" ]] || die "no box: default_box missing in $apps_ini"
    require_box "$box"
}

# RUNNER [explorer /desktop=NAME,WxH] PROGRAM...: the command line of a
# program, inside a Wine virtual desktop when --desktop was given (the
# desktop window is named after the prefix).
windows_cmd() {
    local run="$1"
    shift
    if [[ -n "$desktop" ]]; then
        printf '%s\0' "$run" explorer "/desktop=wswin-$pname,$desktop" "$@"
    else
        printf '%s\0' "$run" "$@"
    fi
}

# A host file becomes an absolute path (the host HOME, /tmp, /media and /mnt
# are the same path inside the container); anything else is passed as is
# (C:\..., notepad).
host_path() {
    if [[ -e "$1" ]]; then
        realpath -- "$1"
    else
        printf '%s\n' "$1"
    fi
}

# ---------------------------------------------------------------------------
# Host menu entries (wswin-*.desktop): the file lives in the prefix, the host
# gets a link.

apps_dir="$HOME/.local/share/applications"

menu_dir() {
    printf '%s/.wswin/menu\n' "$1"
}

slug() {
    local s="${1,,}"
    s="$(sed -E 's/[^a-z0-9._]+/-/g; s/^-+//; s/-+$//' <<<"$s")"
    printf '%s\n' "${s:-app}"
}

# y/N (or Y/n with a second argument "yes") from the terminal; no terminal:
# the default.
ask() {
    local question="$1" default="${2:-no}" hint="[y/N]" answer=""

    [[ "$default" == yes ]] && hint="[Y/n]"
    if { exec 3<>/dev/tty; } 2>/dev/null; then
        printf '%s %s ' "$question" "$hint" >&3
        read -r answer <&3 || answer=""
        exec 3>&-
    else
        printf '%s %s (no terminal: %s)\n' "$question" "$hint" "$default" >&2
    fi
    answer="${answer,,}"
    [[ -z "$answer" ]] && answer="$default"
    [[ "$answer" == y || "$answer" == yes ]]
}

# An argument for Exec= (desktop entry quoting, then string escaping).
desktop_quote() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//\`/\\\`}"
    s="${s//\$/\\\$}"
    s="\"$s\""
    printf '%s\n' "${s//\\/\\\\}"
}

desktop_key() {
    sed -nE "s/^$2=//p" "$1" | head -n1
}

# Write the launcher into the prefix and link it into the host menu.
#   make_launcher BOX PNAME NAME EXEC_ARG ICON WMCLASS SOURCE [TARGET]
# EXEC_ARG is already quoted for Exec=; ICON is a file or a theme name.
make_launcher() {
    local box="$1" pname="$2" name="$3" exec_arg="$4" icon="$5" wmclass="$6" source="$7"
    local target="${8:-}"
    local prefix dir id file

    prefix="$(prefix_path "$box" "$pname")"
    dir="$(menu_dir "$prefix")"
    id="wswin-$(slug "$box")-$(slug "$pname")-$(slug "$name")"
    file="$dir/$id.desktop"
    mkdir -p "$dir" "$apps_dir"

    if [[ -f "$icon" ]]; then
        cp -f -- "$icon" "$dir/$id.png"
        icon="$dir/$id.png"
    fi

    {
        printf '[Desktop Entry]\n'
        printf 'Type=Application\n'
        printf 'Name=%s\n' "$name"
        printf 'Exec=wswin exec --box %s --prefix %s %s\n' "$box" "$pname" "$exec_arg"
        printf 'Icon=%s\n' "${icon:-application-x-executable}"
        printf 'Terminal=false\n'
        printf 'StartupNotify=true\n'
        [[ -z "$wmclass" ]] || printf 'StartupWMClass=%s\n' "$wmclass"
        printf 'X-Workstation-Box=%s\n' "$box"
        printf 'X-Workstation-Prefix=%s\n' "$pname"
        [[ -z "$source" ]] || printf 'X-Wswin-Source=%s\n' "$source"
        [[ -z "$target" ]] || printf 'X-Wswin-Target=%s\n' "$target"
    } > "$file"

    ln -sfn -- "$file" "$apps_dir/$id.desktop"
    printf 'Menu: %s -> %s\n' "$name" "$apps_dir/$id.desktop"
}

# Windows shortcuts (.lnk) of PREFIX that an installer made: Start Menu
# (all users and the user) and desktops. The same in every profile (Proton
# writes no Linux menu entries): "MTIME PATH" lines.
lnk_entries() {
    local prefix="$1" root

    for root in \
        "$prefix/drive_c/ProgramData/Microsoft/Windows/Start Menu" \
        "$prefix"/drive_c/users/*/"AppData/Roaming/Microsoft/Windows/Start Menu" \
        "$prefix"/drive_c/users/*/Desktop; do
        [[ -d "$root" ]] || continue
        find -L "$root" -maxdepth 5 -iname '*.lnk' -printf '%T@ %p\n' 2>/dev/null
    done | sort -u
}

# TARGET<TAB>WORKDIR<TAB>ARGS of a .lnk, TARGET and WORKDIR as host paths
# inside PREFIX (C:\... resolved case-insensitively); nothing when the link
# does not point at a file of the prefix.
lnk_read() {
    python3 - "$1" "$2" <<'PY'
import os, struct, sys

path, prefix = sys.argv[1], sys.argv[2]
d = open(path, 'rb').read()
if d[:4] != b'L\0\0\0':
    sys.exit(0)
def malformed():
    print(f'wswin: skipping malformed shortcut: {path}', file=sys.stderr)
    sys.exit(0)
if len(d) < 76:
    malformed()
flags = struct.unpack_from('<I', d, 20)[0]
pos = 76
if flags & 0x1:                          # LinkTargetIDList
    if pos + 2 > len(d):
        malformed()
    pos += 2 + struct.unpack_from('<H', d, pos)[0]
    if pos > len(d):
        malformed()
target = ''
if flags & 0x2:                          # LinkInfo
    li = pos
    if li + 28 > len(d):
        malformed()
    size, hdr, liflags, _v, base, _n, suffix = struct.unpack_from('<7I', d, li)
    li_end = li + size
    if not 28 <= hdr <= size or li_end > len(d):
        malformed()
    def cstr(off, wide=False):
        if not li + hdr <= off < li_end:
            malformed()
        if wide:
            end = next((i for i in range(off, li_end - 1, 2)
                        if d[i:i + 2] == b'\0\0'), -1)
        else:
            end = d.find(b'\0', off, li_end)
        if end < 0:
            malformed()
        try:
            return d[off:end].decode('utf-16le' if wide else 'cp1252')
        except UnicodeDecodeError:
            malformed()
    if liflags & 1:
        if hdr >= 0x24:
            ubase, usuffix = struct.unpack_from('<2I', d, li + 28)
            target = cstr(li + ubase, True) + cstr(li + usuffix, True)
        else:
            target = cstr(li + base) + cstr(li + suffix)
    pos += size
wide = flags & 0x80
def rstr():
    global pos
    if pos + 2 > len(d):
        malformed()
    n = struct.unpack_from('<H', d, pos)[0]
    pos += 2
    end = pos + n * (2 if wide else 1)
    if end > len(d):
        malformed()
    try:
        s = d[pos:end].decode('utf-16le' if wide else 'cp1252')
    except UnicodeDecodeError:
        malformed()
    pos = end
    return s.rstrip('\0')
f = {}
for bit, key in ((0x4, 'name'), (0x8, 'rel'), (0x10, 'wd'), (0x20, 'args'), (0x40, 'icon')):
    f[key] = rstr() if flags & bit else ''

def unix(win):
    win = win.rstrip('\0')
    if len(win) < 3 or win[1] != ':' or win[0].lower() != 'c':
        return ''
    cur = os.path.join(prefix, 'drive_c')
    for part in [p for p in win[3:].split('\\') if p]:
        try:
            names = os.listdir(cur)
        except OSError:
            return ''
        match = next((n for n in names if n == part), None) \
            or next((n for n in names if n.lower() == part.lower()), None)
        if match is None:
            return ''
        cur = os.path.join(cur, match)
    return cur

t = unix(target)
if not t and f['rel']:
    t = os.path.normpath(os.path.join(os.path.dirname(path), f['rel'].replace('\\', '/')))
if not t or not os.path.isfile(t):
    sys.exit(0)
wd = unix(f['wd']) or os.path.dirname(t)
print('\t'.join((t, wd, f['args'].replace('\t', ' '))))
PY
}

# Offer one shortcut for the host menu (once per target .exe of the prefix).
offer_lnk_entry() {
    local box="$1" pname="$2" file="$3" prefix info target args title icon arg
    local -a words=()

    prefix="$(prefix_path "$box" "$pname")"
    info="$(lnk_read "$file" "$prefix")"
    [[ -n "$info" ]] || return 0
    IFS=$'\t' read -r target _ args <<<"$info"
    [[ "${target,,}" == *.exe ]] || return 0
    if grep -qsxF "X-Wswin-Target=$target" "$(menu_dir "$prefix")"/*.desktop; then
        return 0
    fi

    title="$(basename "$file")"
    title="${title%.*}"
    ask "Add \"$title\" (${target#"$prefix"/}) to the host menu?" || return 0

    arg="$(desktop_quote "$target")"
    [[ -z "$args" ]] || read -ra words <<<"$args"
    for a in "${words[@]}"; do
        arg+=" $(desktop_quote "$a")"
    done

    icon="$(mktemp --suffix=.png "${XDG_RUNTIME_DIR:-/tmp}/wswin-icon.XXXXXX")"
    exe_icon "$box" "$target" "$icon" || true
    [[ -s "$icon" ]] || { rm -f -- "$icon"; icon=""; }
    make_launcher "$box" "$pname" "$title" "$arg" "$icon" "$(basename "$target")" "$file" "$target"
    [[ -z "$icon" ]] || rm -f -- "$icon"
}

cmd_menu() {
    local box pname desktop rest prefix action entry
    parse_target "$@"
    set -- "${rest[@]}"
    action="${1:-}"

    case "$action" in
        add)
            prefix="$(prefix_path "$box" "$pname")"
            [[ -d "$prefix" ]] || die "no prefix: $prefix"
            # An exe given: an entry for it (Proton writes no Wine menu
            # entries); a path inside the prefix or on the host.
            if [[ -n "${2:-}" ]]; then
                local exe="$2" title icon
                [[ -f "$exe" ]] || exe="$prefix/$2"
                [[ -f "$exe" ]] || die "not found: $2"
                exe="$(realpath -- "$exe")"
                title="${3:-$(basename "$exe" .exe)}"
                icon="$(mktemp --suffix=.png "${XDG_RUNTIME_DIR:-/tmp}/wswin-icon.XXXXXX")"
                exe_icon "$box" "$exe" "$icon" || true
                [[ -s "$icon" ]] || { rm -f -- "$icon"; icon=""; }
                make_launcher "$box" "$pname" "$title" "$(desktop_quote "$exe")" "$icon" \
                    "$(basename "$exe")" "" "$exe"
                [[ -z "$icon" ]] || rm -f -- "$icon"
                return 0
            fi
            while read -r _ entry; do
                offer_lnk_entry "$box" "$pname" "$entry"
            done < <(lnk_entries "$prefix")
            ;;
        list)
            local link target state
            printf '%-48s %-8s %s\n' ID STATE NAME
            for link in "$apps_dir"/wswin-*.desktop; do
                [[ -L "$link" ]] || continue
                target="$(readlink -f "$link" || true)"
                if [[ -f "$target" ]]; then state=ok; else state=dangling; fi
                printf '%-48s %-8s %s\n' "$(basename "$link" .desktop)" "$state" \
                    "$( [[ -f "$target" ]] && desktop_key "$target" Name )"
            done
            ;;
        remove)
            local id="${2:-}" link target
            [[ -n "$id" ]] || die "usage: wswin menu remove ID"
            link="$apps_dir/${id%.desktop}.desktop"
            [[ -L "$link" ]] || die "no wswin menu entry: $id"
            target="$(readlink -f "$link" || true)"
            rm -f -- "$link"
            [[ -z "$target" ]] || rm -f -- "$target" "${target%.desktop}.png"
            printf 'Removed %s\n' "$id"
            ;;
        sync)
            local b home p f
            for link in "$apps_dir"/wswin-*.desktop; do
                [[ -L "$link" && ! -e "$link" ]] && rm -f -- "$link" \
                    && printf 'Removed dangling %s\n' "$(basename "$link")"
            done
            while IFS= read -r b; do
                [[ -n "$(box_value "$b" profile)" ]] || continue
                home="$(box_home "$b")"
                for p in "$home/.wine" "$home"/prefixes/*; do
                    for f in "$(menu_dir "$p")"/*.desktop; do
                        [[ -f "$f" ]] || continue
                        ln -sfn -- "$f" "$apps_dir/$(basename "$f")"
                        printf 'Linked %s\n' "$(basename "$f")"
                    done
                done
            done < <(sections "$boxes_ini")
            ;;
        *)
            die "usage: wswin menu [--box BOX] [--prefix NAME] add | menu list|sync | menu remove ID"
            ;;
    esac
}

# Host menu links of one prefix, before the prefix goes.
remove_menu_links() {
    local prefix="$1" link target

    for link in "$apps_dir"/wswin-*.desktop; do
        [[ -L "$link" ]] || continue
        target="$(readlink "$link")"
        [[ "$target" == "$prefix/"* ]] || continue
        rm -f -- "$link"
        printf 'Removed menu entry %s\n' "$(basename "$link" .desktop)"
    done
}

# Icon of a Windows executable, extracted inside the box (icoutils).
exe_icon() {
    local box="$1" exe="$2" out="$3"

    exec_box "$box" sh -c '
        command -v wrestool >/dev/null && command -v icotool >/dev/null || exit 1
        tmp="$(mktemp -d)"
        trap "rm -rf \"\$tmp\"" EXIT
        wrestool -x -t 14 "$1" > "$tmp/icon.ico" 2>/dev/null || exit 1
        icotool -x -o "$tmp" "$tmp/icon.ico" 2>/dev/null || exit 1
        best="$(ls -S "$tmp"/*.png 2>/dev/null | head -n1)"
        [ -n "$best" ] && cp "$best" "$2"
    ' _ "$exe" "$out" >/dev/null 2>&1
}

# A portable program: copied (exe, directory or zip) into
# PREFIX/drive_c/Portable/NAME, optionally a host menu entry.
cmd_portable() {
    local box pname desktop rest src name prefix dest exe icon
    local -a exes=()
    parse_target "$@"
    set -- "${rest[@]}"
    (($#)) || die "usage: wswin portable [--box BOX] [--prefix NAME] FILE.exe|DIR|FILE.zip [APPNAME]"

    [[ -e "$1" ]] || die "not found: $1"
    src="$(realpath -- "$1")"
    name="${2:-$(basename "$src")}"
    name="${name%.*}"
    [[ -d "$src" ]] && name="${2:-$(basename "$src")}"

    ensure_prefix "$box" "$pname"
    prefix="$(prefix_path "$box" "$pname")"
    dest="$prefix/drive_c/Portable/$name"
    [[ ! -e "$dest" ]] || die "already there: $dest"
    mkdir -p "$dest"

    case "${src,,}" in
        *.zip) unzip -q -d "$dest" "$src" ;;
        *.exe) cp -- "$src" "$dest/" ;;
        *) [[ -d "$src" ]] || die "not an .exe, .zip or directory: $src"
           cp -a -- "$src/." "$dest/" ;;
    esac
    printf 'Portable %s: %s\n' "$name" "$dest"

    mapfile -t exes < <(find "$dest" -maxdepth 3 -type f -iname '*.exe' | sort)
    ((${#exes[@]})) || die "no .exe in $dest"
    exe="${exes[0]}"
    if ((${#exes[@]} > 1)); then
        local i answer
        for i in "${!exes[@]}"; do
            printf '  %d) %s\n' "$((i + 1))" "${exes[$i]#$dest/}"
        done
        answer=1
        if { exec 3<>/dev/tty; } 2>/dev/null; then
            printf 'Program to start [1]: ' >&3
            read -r answer <&3 || answer=1
            exec 3>&-
        fi
        [[ "$answer" =~ ^[0-9]+$ ]] && ((answer >= 1 && answer <= ${#exes[@]})) || answer=1
        exe="${exes[$((answer - 1))]}"
    fi

    if ask "Add \"$name\" to the host menu?" yes; then
        icon="$(mktemp --suffix=.png "${XDG_RUNTIME_DIR:-/tmp}/wswin-icon.XXXXXX")"
        exe_icon "$box" "$exe" "$icon" || icon=""
        [[ -z "$icon" || -s "$icon" ]] || icon=""
        make_launcher "$box" "$pname" "$name" "$(desktop_quote "$exe")" "$icon" \
            "$(basename "$exe")" "" "$exe"
        [[ -z "$icon" ]] || rm -f -- "$icon"
    fi
    printf 'Start: wswin exec --box %s --prefix %s %q\n' "$box" "$pname" "$exe"
}

cmd_install() {
    local box pname desktop rest file prefix run
    local -a wcmd=()
    parse_target "$@"
    set -- "${rest[@]}"
    (($#)) || die "installer required"

    [[ -f "$1" ]] || die "not found: $1"
    file="$(realpath -- "$1")"
    shift

    ensure_prefix "$box" "$pname"
    prefix="$(prefix_path "$box" "$pname")"
    run="$(runner "$box")"

    local before entry mtime
    before="$(lnk_entries "$prefix")"

    case "${file,,}" in
        *.msi) mapfile -d '' wcmd < <(windows_cmd "$run" msiexec /i "$file" "$@") ;;
        *) mapfile -d '' wcmd < <(windows_cmd "$run" "$file" "$@") ;;
    esac
    in_box "$box" "$prefix" "${wcmd[@]}"

    printf '\nInstalled into %s/%s (%s).\n' "$box" "$pname" "$prefix"

    # Every new or changed shortcut the installer made in the prefix.
    while read -r mtime entry; do
        [[ -n "$entry" ]] || continue
        grep -qxF "$mtime $entry" <<<"$before" && continue
        offer_lnk_entry "$box" "$pname" "$entry"
    done < <(lnk_entries "$prefix")
    printf 'More later: wswin menu --box %s --prefix %s add [PROGRAM.exe [TITLE]]\n' "$box" "$pname"
}

cmd_exec() {
    local box pname desktop rest prefix program cwd=""
    local -a wcmd=()
    parse_target "$@"
    set -- "${rest[@]}"
    (($#)) || die "program required"

    ensure_prefix "$box" "$pname"
    prefix="$(prefix_path "$box" "$pname")"
    program="$(host_path "$1")"
    # A program file starts in its own directory (games load data relative
    # to it), as from Explorer.
    [[ -f "$program" ]] && cwd="$(dirname "$program")"
    mapfile -d '' wcmd < <(windows_cmd "$(runner "$box")" "$program" "${@:2}")
    WSWIN_CWD="$cwd" in_box "$box" "$prefix" "${wcmd[@]}"
}

# The program starts in its own directory, as from Explorer.
cmd_run() {
    local app="${1:-}" box pname exe prefix env_line args_line
    local -a args=() envs=()

    [[ -n "$app" ]] || die "app required"
    shift
    box="$(ini_value "$apps_ini" "$app" box)"
    [[ -n "$box" ]] || die "unknown app: $app (windows/apps.nix)"
    require_box "$box"
    pname="$(ini_value "$apps_ini" "$app" prefix)"
    exe="$(ini_value "$apps_ini" "$app" exe)"
    prefix="$(prefix_path "$box" "$pname")"

    [[ -f "$prefix/$exe" ]] \
        || die "$app: not installed: $prefix/$exe (wswin install --box $box --prefix $pname ...)"

    args_line="$(ini_value "$apps_ini" "$app" args)"
    env_line="$(ini_value "$apps_ini" "$app" env)"
    [[ -z "$args_line" ]] || read -ra args <<<"$args_line"
    [[ -z "$env_line" ]] || read -ra envs <<<"$env_line"

    in_box "$box" "$prefix" env "${envs[@]}" bash -c '
        cd "$(dirname "$2")" && exec "$1" "${@:2}"
    ' _ "$(runner "$box")" "$prefix/$exe" "${args[@]}" "$@"
}

cmd_prefix() {
    local box pname desktop rest prefix run action
    parse_target "$@"
    set -- "${rest[@]}"
    (($# >= 2)) || die "usage: wswin prefix [--box BOX] NAME ACTION"
    pname="$1"
    action="$2"
    shift 2
    prefix="$(prefix_path "$box" "$pname")"
    run="$(runner "$box")"

    case "$action" in
        path)
            printf '%s\n' "$prefix"
            ;;
        init)
            local dpi=""
            if [[ "${1:-}" == --dpi ]]; then
                dpi="${2:?--dpi needs a value}"
                [[ "$dpi" =~ ^[0-9]+$ ]] || die "bad dpi: $dpi"
            fi
            ensure_prefix "$box" "$pname" "$dpi"
            ;;
        winecfg|regedit)
            ensure_prefix "$box" "$pname"
            in_box "$box" "$prefix" "$run" "$action"
            ;;
        winetricks)
            ensure_prefix "$box" "$pname"
            if [[ "$run" == wine ]]; then
                in_box "$box" "$prefix" winetricks "$@"
            else
                in_box "$box" "$prefix" umu-run winetricks "$@"
            fi
            ;;
        kill)
            # Every process started with this WINEPREFIX (the containers
            # share the host PID namespace; Proton runs its own wineserver).
            local pid pids=()
            for pid in /proc/[0-9]*; do
                { tr '\0' '\n' < "$pid/environ"; } 2>/dev/null \
                    | grep -qxF "WINEPREFIX=$prefix" && pids+=("${pid#/proc/}")
            done
            if ((${#pids[@]})); then
                kill -- "${pids[@]}" 2>/dev/null || true
                printf 'Stopped %d processes of %s\n' "${#pids[@]}" "$prefix"
            else
                printf 'Nothing runs in %s\n' "$prefix"
            fi
            ;;
        remove)
            [[ -d "$prefix" ]] || die "no prefix: $prefix"
            remove_menu_links "$prefix"
            printf 'Removing %s\n' "$prefix"
            rm -rf -- "$prefix"
            ;;
        *)
            die "unknown prefix action: $action"
            ;;
    esac
}

cmd_shell() {
    local box pname desktop rest prefix
    parse_target "$@"
    prefix="$(prefix_path "$box" "$pname")"
    in_box "$box" "$prefix" bash -l
}

cmd_list() {
    local app box pname exe prefix state home name

    printf '%-14s %-14s %-12s %-10s %s\n' APP BOX PREFIX STATE EXE
    while IFS= read -r app; do
        [[ -n "$app" && "$app" != wswin ]] || continue
        box="$(ini_value "$apps_ini" "$app" box)"
        pname="$(ini_value "$apps_ini" "$app" prefix)"
        exe="$(ini_value "$apps_ini" "$app" exe)"
        prefix="$(prefix_path "$box" "$pname")"
        if [[ -f "$prefix/$exe" ]]; then state=installed; else state=missing; fi
        printf '%-14s %-14s %-12s %-10s %s\n' "$app" "$box" "$pname" "$state" "$exe"
    done < <(sections "$apps_ini")

    printf '\n%-14s %-8s %s\n' BOX PROFILE PREFIXES
    while IFS= read -r box; do
        [[ -n "$(box_value "$box" profile)" ]] || continue
        home="$(box_home "$box")"
        local -a names=()
        [[ -f "$home/.wine/system.reg" ]] && names+=(default)
        if [[ -d "$home/prefixes" ]]; then
            for name in "$home"/prefixes/*/; do
                [[ -d "$name" ]] && names+=("$(basename "$name")")
            done
        fi
        printf '%-14s %-8s %s\n' "$box" "$(box_value "$box" profile)" "${names[*]:--}"
    done < <(sections "$boxes_ini")
}

main() {
    local cmd="${1:-}"

    case "$cmd" in
        ""|-h|--help|help) usage; return 0 ;;
        check) shift; exec "$bin_dir/wswin-check" "$@" ;;
    esac

    ensure_config
    shift

    case "$cmd" in
        list) cmd_list "$@" ;;
        install) cmd_install "$@" ;;
        portable) cmd_portable "$@" ;;
        menu) cmd_menu "$@" ;;
        run) cmd_run "$@" ;;
        exec) cmd_exec "$@" ;;
        prefix) cmd_prefix "$@" ;;
        shell) cmd_shell "$@" ;;
        *) die "unknown command: $cmd" ;;
    esac
}

main "$@"
