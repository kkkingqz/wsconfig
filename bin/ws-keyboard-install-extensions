#!/usr/bin/env bash
set -euo pipefail

repo="${WSCONFIG:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"

die() {
    echo "ws-keyboard-install-extensions: $*" >&2
    exit 1
}

for cmd in python3 glib-compile-schemas curl gnome-extensions gnome-shell; do
    command -v "$cmd" >/dev/null 2>&1 || die "$cmd not found"
done

install_extension() {
    local uuid="$1"
    local src="$repo/gnome/extensions/$uuid"
    local dst="$HOME/.local/share/gnome-shell/extensions/$uuid"
    local schema_dir="$src/schemas"

    [[ -f "$src/metadata.json" ]] || die "missing $src/metadata.json"
    [[ -f "$src/extension.js" ]] || die "missing $src/extension.js"

    local has_schema=false
    if [[ -d "$schema_dir" ]] && compgen -G "$schema_dir/*.gschema.xml" >/dev/null; then
        has_schema=true
    fi

    python3 - "$src/metadata.json" "$uuid" <<'PY'
import json
import sys
from pathlib import Path

data = json.loads(Path(sys.argv[1]).read_text())
assert data.get("uuid") == sys.argv[2], (data.get("uuid"), sys.argv[2])
assert "50" in data.get("shell-version", []), data.get("shell-version")
PY

    mkdir -p "$dst"

    python3 "$repo/lib/gnome_extension_files.py" install "$src" "$dst"

    if [[ "$has_schema" == true ]]; then
        mkdir -p "$dst/schemas"

        glib-compile-schemas "$dst/schemas"
        [[ -f "$dst/schemas/gschemas.compiled" ]] \
            || die "schema compilation did not create $dst/schemas/gschemas.compiled"
    else
        rm -f -- "$dst/schemas/gschemas.compiled"
    fi

    cmp -s "$src/metadata.json" "$dst/metadata.json" \
        || die "$uuid metadata runtime mismatch"
    cmp -s "$src/extension.js" "$dst/extension.js" \
        || die "$uuid extension runtime mismatch"

    echo "installed: $uuid"
}

# An EGO extension without pin: installed once, the latest version for the
# running GNOME Shell (the download EGO and GNOME Shell use); later versions
# come from Extension Manager, not from here.
install_ego() {
    local uuid="$1" dst="$HOME/.local/share/gnome-shell/extensions/$1"
    local shell_major zip

    if [[ -e "$dst/metadata.json" ]]; then
        echo "present: $uuid (updated by Extension Manager)"
        return
    fi

    shell_major="$(gnome-shell --version | awk '{ print $3 }' | cut -d. -f1)"
    zip="$(mktemp --suffix=.shell-extension.zip)"
    curl -fsSL -o "$zip" \
        "https://extensions.gnome.org/download-extension/$uuid.shell-extension.zip?shell_version=$shell_major" \
        || { rm -f "$zip"; die "download from extensions.gnome.org failed: $uuid (GNOME Shell $shell_major)"; }
    gnome-extensions install --force "$zip" || { rm -f "$zip"; die "gnome-extensions install failed: $uuid"; }
    rm -f "$zip"
    echo "installed from extensions.gnome.org: $uuid"
}

# gnome/gnome-extensions.nix; ws switch builds the list, enables the
# extensions (enabled-extensions) and links the pinned EGO ones.
list="$HOME/.local/share/workstation/gnome/extensions"
[[ -r "$list" ]] || die "extension list missing: $list (run ws switch)"
mapfile -t local_extensions < <(awk '!/^#/ && $2 == "local" { print $1 }' "$list")
((${#local_extensions[@]})) || die "no local extensions in $list"
mapfile -t ego_extensions < <(awk '!/^#/ && $2 == "ego" && NF == 2 { print $1 }' "$list")

for uuid in "${ego_extensions[@]}"; do
    install_ego "$uuid"
done

for uuid in "${local_extensions[@]}"; do
    install_extension "$uuid"
done

echo
echo "GNOME workstation extensions installed (enabled by ws switch)."
echo "A new or changed extension loads after log out and log in on Wayland."
