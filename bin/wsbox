#!/usr/bin/env bash
set -euo pipefail

# Declared in distrobox/distrobox.nix; ws switch builds
# ~/.local/share/workstation/distrobox. wsbox only reads it; the manifest is
# rendered first (@HOST_VERSION_ID@: the host release from /etc/os-release).
cfg="${WSBOX_CONFIG:-$HOME/.local/share/workstation/distrobox}"
manifest_source="$cfg/containers.ini"
manifest="${XDG_RUNTIME_DIR:-/tmp}/wsbox-$(id -u)/containers.ini"
exports_manifest="$cfg/exports.ini"
boxes_manifest="$cfg/boxes.ini"
bin_dir="$(dirname "$(readlink -f "$0")")"
# Managed containers left out on this machine (lib/ws_select.py): apply does
# not ask about them again, check reports them as info.
skipped_file="$HOME/.local/state/workstation/distrobox/skipped"
select_py="$bin_dir/../lib/ws_select.py"
select_hint="wsbox apply --select"

usage() {
    cat <<'USAGE'
Usage:
  wsbox list
  wsbox status [NAME]
  wsbox check [--json]
  wsbox dry-run [NAME]
  wsbox apply [--select | NAME]
  wsbox update [NAME...]
  wsbox create NAME
  wsbox enter NAME
  wsbox run NAME COMMAND [ARG...]
  wsbox stop NAME
  wsbox remove NAME
  wsbox recreate NAME
  wsbox apps [NAME]
  wsbox export NAME APP
  wsbox unexport NAME APP
USAGE
}

die() {
    printf 'wsbox: %s\n' "$*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

ensure_base() {
    need podman
    need distrobox
    need distrobox-assemble
    [[ -r "$manifest_source" ]] || die "manifest not found: $manifest_source (run ws switch)"
    [[ -r "$exports_manifest" ]] || die "exports manifest not found: $exports_manifest (run ws switch)"
    [[ -r "$boxes_manifest" ]] || die "boxes manifest not found: $boxes_manifest (run ws switch)"
    render_manifest
}

host_version_id() {
    (
        . /etc/os-release
        [[ "${ID:-}" == ubuntu && -n "${VERSION_ID:-}" ]] || exit 1
        printf '%s\n' "$VERSION_ID"
    )
}

render_manifest() {
    local version=""

    if grep -Fq '@HOST_VERSION_ID@' "$manifest_source"; then
        version="$(host_version_id)" \
            || die "the manifest uses the host Ubuntu release, but /etc/os-release is not Ubuntu"
    fi

    mkdir -p "${manifest%/*}"
    sed "s/@HOST_VERSION_ID@/$version/g" "$manifest_source" > "$manifest.tmp"
    mv -f "$manifest.tmp" "$manifest"
}

managed_boxes() {
    sed -nE 's/^\[([^]]+)\]$/\1/p' "$manifest"
}

ini_value() {
    local file="$1" section="$2" key="$3" value

    value="$({
        awk -F= -v section="[$section]" -v key="$key" '
            $0 == section {
                inside=1
                next
            }

            inside && /^\[/ {
                exit
            }

            inside {
                k=$1
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", k)

                if (k == key) {
                    sub(/^[^=]*=/, "", $0)
                    gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0)
                    print $0
                    exit
                }
            }
        ' "$file"
    } || true)"

    value="${value#\"}"
    value="${value%\"}"
    value="${value//\$\{HOME\}/$HOME}"

    printf '%s\n' "$value"
}

manifest_value() {
    ini_value "$manifest" "$1" "$2"
}

export_sections() {
    sed -nE 's/^\[([^]]+)\]$/\1/p' "$exports_manifest"
}

export_aliases() {
    local name="$1"

    awk -F= -v section="[$name]" '
        $0 == section {
            inside=1
            next
        }

        inside && /^\[/ {
            exit
        }

        inside {
            line=$0
            sub(/[[:space:]]*[#;].*$/, "", line)
            if (line !~ /=/) next

            split(line, parts, "=")
            key=parts[1]
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
            if (key != "") print key
        }
    ' "$exports_manifest"
}

export_source() {
    ini_value "$exports_manifest" "$1" "$2"
}

is_skipped() {
    [[ -r "$skipped_file" ]] && grep -Fxq -- "$1" "$skipped_file"
}

is_managed() {
    managed_boxes | grep -Fxq -- "$1"
}

require_managed() {
    [[ -n "${1:-}" ]] || die "container name required"
    is_managed "$1" || die "not a managed container: $1"
}

is_managed_export() {
    local name="$1" alias="$2"
    export_aliases "$name" | grep -Fxq -- "$alias"
}

require_managed_export() {
    local name="$1" alias="$2"

    [[ -n "$alias" ]] || die "managed app alias required"
    is_managed_export "$name" "$alias" \
        || die "not a managed export: $name/$alias"
}

container_exists() {
    podman container exists "$1" >/dev/null 2>&1
}

container_state() {
    podman inspect \
        --format '{{.State.Status}}' \
        "$1" \
        2>/dev/null \
        || printf 'unknown\n'
}

container_image() {
    podman inspect \
        --format '{{.ImageName}}' \
        "$1" \
        2>/dev/null \
        || podman inspect \
            --format '{{.Config.Image}}' \
            "$1" \
            2>/dev/null \
        || printf 'unknown\n'
}

# The container runs the manifest image: same name, or, for an image pinned
# by digest (name@sha256:...), an image with that repo digest.
image_matches() {
    local name="$1" expected="$2" id

    [[ "$(container_image "$name")" == "$expected" ]] && return 0
    [[ "$expected" == *@sha256:* ]] || return 1
    id="$(podman inspect --format '{{.Image}}' "$name" 2>/dev/null)" || return 1
    podman image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$id" 2>/dev/null \
        | grep -Fxq -- "$expected"
}

# distrobox enter flags of a box: gpu=amd passes DRI_PRIME for the AMD card
# when this boot has it (ws-gpu), per call, so the container itself stays
# the same in both boots.
enter_flags() {
    local name="$1" prime

    [[ "$(ini_value "$boxes_manifest" "$name" gpu)" == amd ]] || return 0
    prime="$("$bin_dir/ws-gpu" env)"
    [[ -n "$prime" ]] || return 0
    printf '%s\n' --additional-flags "--env $prime"
}

container_exec() {
    local name="$1"
    shift

    distrobox enter \
        --name "$name" \
        -- "$@"
}

export_source_exists() {
    local name="$1" source="$2"

    container_exec "$name" test -f "$source" \
        >/dev/null 2>&1
}

export_host_path() {
    local name="$1" source="$2"
    printf '%s/.local/share/applications/%s-%s\n' \
        "$HOME" "$name" "$(basename "$source")"
}

export_launcher_targets() {
    local name="$1" launcher="$2" exec_line

    [[ -f "$launcher" ]] || return 1
    exec_line="$(grep -m1 '^Exec=' "$launcher" 2>/dev/null || true)"

    [[ "$exec_line" == *distrobox-enter* ]] || return 1
    [[ "$exec_line" == *"-n $name"* ]] || return 1
}

export_state() {
    local name="$1" source="$2" launcher

    if ! export_source_exists "$name" "$source"; then
        printf 'missing-source\n'
        return 0
    fi

    launcher="$(export_host_path "$name" "$source")"

    if [[ ! -f "$launcher" ]]; then
        printf 'not-exported\n'
    elif export_launcher_targets "$name" "$launcher"; then
        printf 'exported\n'
    else
        printf 'drift\n'
    fi
}

export_one() {
    local name="$1" alias="$2" source launcher

    require_managed "$name"
    require_managed_export "$name" "$alias"
    container_exists "$name" || die "container does not exist: $name"

    source="$(export_source "$name" "$alias")"
    [[ -n "$source" ]] || die "empty export source: $name/$alias"

    export_source_exists "$name" "$source" \
        || die "managed export source missing: $name/$alias: $source"

    launcher="$(export_host_path "$name" "$source")"

    if export_launcher_targets "$name" "$launcher"; then
        printf 'Already exported: %s/%s\n' "$name" "$alias"
        return 0
    fi

    rm -f -- "$launcher"

    container_exec "$name" distrobox-export \
        --app "$source" \
        --export-label none

    export_launcher_targets "$name" "$launcher" \
        || die "export did not create a valid launcher: $launcher"

    printf 'Exported: %s/%s -> %s\n' "$name" "$alias" "$launcher"
}

unexport_one() {
    local name="$1" alias="$2" source launcher

    require_managed "$name"
    require_managed_export "$name" "$alias"
    container_exists "$name" || die "container does not exist: $name"

    source="$(export_source "$name" "$alias")"
    [[ -n "$source" ]] || die "empty export source: $name/$alias"
    launcher="$(export_host_path "$name" "$source")"

    if export_source_exists "$name" "$source"; then
        container_exec "$name" distrobox-export \
            --app "$source" \
            --delete \
            >/dev/null 2>&1 \
            || true
    fi

    rm -f -- "$launcher"
    printf 'Unexported: %s/%s\n' "$name" "$alias"
}

apply_exports_for() {
    local name="$1" alias source state

    container_exists "$name" || return 0

    while IFS= read -r alias; do
        [[ -n "$alias" ]] || continue
        source="$(export_source "$name" "$alias")"

        if [[ -z "$source" ]] || ! export_source_exists "$name" "$source"; then
            printf '  WARN  managed export source missing: %s/%s: %s (install it, then wsbox apply %s)\n' \
                "$name" "$alias" "${source:-<empty>}" "$name"
            continue
        fi

        state="$(export_state "$name" "$source")"

        if [[ "$state" == exported ]]; then
            printf '  PASS  managed export already present: %s/%s\n' \
                "$name" "$alias"
            continue
        fi

        export_one "$name" "$alias"
    done < <(export_aliases "$name")
}

status_one() {
    local name="$1"
    local expected_image
    local expected_home
    local state
    local actual_image
    local home_state

    expected_image="$(manifest_value "$name" image)"
    expected_home="$(manifest_value "$name" home)"

    if container_exists "$name"; then
        state="$(container_state "$name")"
        actual_image="$(container_image "$name")"
    else
        state="missing"
        actual_image="-"
    fi

    if [[ -d "$expected_home" ]]; then
        home_state="present"
    else
        home_state="absent"
    fi

    printf '%-15s %-12s %-38s %-8s %s\n' \
        "$name" \
        "$state" \
        "$actual_image" \
        "$home_state" \
        "$expected_home"
}

cmd_list() {
    distrobox list --no-color
}

cmd_status() {
    local name="${1:-}"

    printf '%-15s %-12s %-38s %-8s %s\n' \
        NAME STATE IMAGE HOME PATH

    printf '%s\n' \
        '-----------------------------------------------------------------------------------------------'

    if [[ -n "$name" ]]; then
        require_managed "$name"
        status_one "$name"
    else
        while IFS= read -r name; do
            [[ -n "$name" ]] && status_one "$name"
        done < <(managed_boxes)
    fi

    local extras=""

    extras="$(
        podman ps -a \
            --filter label=manager=distrobox \
            --format '{{.Names}}' \
            2>/dev/null \
        | while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            is_managed "$name" || printf '%s\n' "$name"
        done
    )"

    if [[ -n "$extras" ]]; then
        echo
        echo "Unmanaged Distrobox containers:"
        printf '  %s\n' $extras
    fi
}

check_exports_for() {
    local name="$1" alias source launcher

    container_exists "$name" || return 0

    while IFS= read -r alias; do
        [[ -n "$alias" ]] || continue
        source="$(export_source "$name" "$alias")"

        if [[ -z "$source" ]] || ! export_source_exists "$name" "$source"; then
            warn "managed export source missing: $name/$alias: ${source:-<empty>}"
            continue
        fi

        pass "managed export source exists: $name/$alias"
        launcher="$(export_host_path "$name" "$source")"

        if [[ ! -f "$launcher" ]]; then
            fail "managed export missing: $name/$alias: $launcher"
        elif export_launcher_targets "$name" "$launcher"; then
            pass "managed export launcher valid: $name/$alias"
        else
            fail "managed export launcher drift: $name/$alias: $launcher"
        fi
    done < <(export_aliases "$name")
}

cmd_check() {
    local name
    local expected_image
    local actual_image
    local expected_home
    local repo hook path pkgbuild readme_sum ntsync_hook

    # Result contract of ws check (--json): lib/check.bash.
    repo="$(cd "$bin_dir/.." && pwd)"
    # shellcheck source=../lib/check.bash
    . "$repo/lib/check.bash"
    case "${1:-}" in
        --json) check_json_mode ;;
        "") ;;
        *) die "usage: wsbox check [--json]" ;;
    esac

    # Host packages (podman, distrobox, uidmap, …) are listed in nix/hosts/apt.txt
    # and checked by `ws check apt`.
    for p in podman distrobox distrobox-assemble; do
        if command -v "$p" >/dev/null 2>&1; then
            pass "command present: $p"
        else
            fail "command missing: $p (nix/hosts/apt.txt, ws check apt)"
        fi
    done

    if [[ "$(
        podman info \
            --format '{{.Host.Security.Rootless}}' \
            2>/dev/null \
            || true
    )" == "true" ]]
    then
        pass "Podman rootless"
    else
        fail "Podman is not rootless"
    fi

    if [[ -r "$manifest" ]]; then
        pass "manifest present"
    else
        fail "manifest missing"
    fi

    if [[ -r "$boxes_manifest" ]]; then
        pass "boxes manifest present"
    else
        fail "boxes manifest missing"
    fi

    if [[ -r "$exports_manifest" ]]; then
        pass "exports manifest present"

        while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            if is_managed "$name"; then
                pass "exports section targets managed container: $name"
            else
                fail "exports section targets unmanaged container: $name"
            fi
        done < <(export_sections)
    else
        fail "exports manifest missing"
    fi

    while IFS= read -r name; do
        [[ -n "$name" ]] || continue

        expected_image="$(manifest_value "$name" image)"
        expected_home="$(manifest_value "$name" home)"

        if ! container_exists "$name"; then
            if is_skipped "$name"; then
                info "managed container skipped on this machine: $name ($select_hint)"
            else
                fail "managed container missing: $name"
            fi
            continue
        fi

        pass "managed container exists: $name"

        actual_image="$(container_image "$name")"

        if image_matches "$name" "$expected_image"; then
            pass "$name image matches manifest"
        else
            fail "$name image drift: got $actual_image, expected $expected_image (wsbox recreate $name)"
        fi

        if [[ -d "$expected_home" ]]; then
            pass "$name custom HOME exists"
        else
            fail "$name custom HOME missing: $expected_home"
        fi

        check_exports_for "$name"
    done < <(managed_boxes)

    while IFS= read -r name; do
        [[ -n "$name" ]] || continue

        if ! is_managed "$name"; then
            warn "unmanaged Distrobox container: $name"
        fi

    done < <(
        podman ps -a \
            --filter label=manager=distrobox \
            --format '{{.Names}}' \
            2>/dev/null
    )

    # Every hook the manifest runs: in the checkout, tracked, executable.
    while IFS= read -r hook; do
        path="${hook#"$repo"/}"
        if [[ "$hook" != "$repo"/* ]]; then
            fail "hook outside the checkout: $hook"
        elif ! git -C "$repo" ls-files --error-unmatch -- "$path" >/dev/null 2>&1; then
            fail "hook not tracked: $path"
        elif [[ "$(git -C "$repo" ls-files -s -- "$path" | awk 'NR==1{print $1}')" != 100755 || ! -x "$hook" ]]; then
            fail "hook not executable (file and Git mode 100755): $path"
        else
            pass "hook executable and tracked: $path"
        fi
    done < <(sed -nE 's/^(pre_)?init_hooks="([^ "]+).*/\2/p' "$manifest_source" 2>/dev/null | sort -u)

    # wsbox-host-ntsync: the Arch package that stands in for the kernel
    # module the host provides (NTSYNC-MODULE).
    pkgbuild="$repo/distrobox/arch/wsbox-host-ntsync/PKGBUILD"
    if bash -n "$pkgbuild" >/dev/null 2>&1; then
        pass "bash syntax: distrobox/arch/wsbox-host-ntsync/PKGBUILD"
    else
        fail "bash syntax error: distrobox/arch/wsbox-host-ntsync/PKGBUILD"
    fi
    readme_sum="$(sha256sum "${pkgbuild%/*}/README.md" 2>/dev/null | cut -d' ' -f1)"
    if grep -Fq "sha256sums=(\"$readme_sum\")" "$pkgbuild"; then
        pass "wsbox-host-ntsync PKGBUILD checksum matches README.md"
    else
        fail "wsbox-host-ntsync PKGBUILD sha256sums does not match README.md (makepkg fails; update it and pkgrel)"
    fi
    ntsync_hook="$repo/distrobox/arch/wsbox-host-ntsync/install-hook"
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        if [[ "$(podman inspect -f '{{.State.Running}}' "$name" 2>/dev/null || true)" != true ]]; then
            info "$name not running; wsbox-host-ntsync not checked"
            continue
        fi
        if podman exec "$name" pacman -Q wsbox-host-ntsync >/dev/null 2>&1; then
            pass "$name: wsbox-host-ntsync installed"
        else
            fail "$name: wsbox-host-ntsync missing (wsbox recreate $name)"
        fi
        for pkg in linux mkinitcpio mkinitcpio-busybox; do
            if podman exec "$name" pacman -Q "$pkg" >/dev/null 2>&1; then
                fail "$name: container-local kernel/initramfs package should be absent: $pkg"
            else
                pass "$name: container-local package absent: $pkg"
            fi
        done
    done < <(awk -v hook="init_hooks=\"$ntsync_hook\"" '
        /^\[/ { box = substr($0, 2, length($0) - 2) }
        $0 == hook { print box }
    ' "$manifest_source" 2>/dev/null)

    check_finish
}

cmd_dry_run() {
    local name="${1:-}"
    local args=(
        create
        --file "$manifest"
        --dry-run
    )

    if [[ -n "$name" ]]; then
        require_managed "$name"
        args+=(--name "$name")
    fi

    distrobox assemble "${args[@]}"
}

cmd_apply() {
    local name="" box chosen rc=0
    local -a items=() select_args=()

    case "${1:-}" in
        --select) select_args=(--select) ;;
        "") ;;
        *) name="$1" ;;
    esac

    if [[ -n "$name" ]]; then
        require_managed "$name"
        distrobox assemble create --file "$manifest" --name "$name"
        apply_exports_for "$name"
        # Asked for by name: no longer skipped on this machine.
        python3 "$select_py" --state "$skipped_file" --hint "$select_hint" --unskip -- "$name"
        return
    fi

    # Containers that do not exist yet: all of them, or the ones picked in
    # the checklist; the others are remembered as skipped.
    while IFS= read -r box; do
        if [[ -n "$box" ]] && ! container_exists "$box"; then
            items+=("$box"$'\t'"$(manifest_value "$box" image)")
        fi
    done < <(managed_boxes)

    chosen="$(python3 "$select_py" --state "$skipped_file" --hint "$select_hint" \
        --what "контейнеры Distrobox" "${select_args[@]}" -- "${items[@]}")" || rc=$?
    case "$rc" in
        0) ;;
        2) die "выбор отменён, ничего не создано" ;;
        *) exit "$rc" ;;
    esac

    # One container at a time, in manifest order (assemble skips existing
    # ones; the list holds only missing ones).
    while IFS= read -r box; do
        if [[ -n "$box" ]]; then
            distrobox assemble create --file "$manifest" --name "$box"
        fi
    done <<<"$chosen"

    while IFS= read -r box; do
        if [[ -n "$box" ]]; then
            apply_exports_for "$box"
        fi
    done < <(managed_boxes)
}

# Packages inside the containers, with their own package manager
# (distrobox upgrade). The image itself changes only on recreate.
cmd_update() {
    local name
    local -a names=() failed=()

    if (($#)); then
        for name in "$@"; do
            require_managed "$name"
            container_exists "$name" || die "container does not exist: $name"
            names+=("$name")
        done
    else
        while IFS= read -r name; do
            [[ -n "$name" ]] && container_exists "$name" && names+=("$name")
        done < <(managed_boxes)
    fi

    ((${#names[@]})) || die "no managed container exists (wsbox apply)"

    for name in "${names[@]}"; do
        printf '\n== %s\n' "$name"
        distrobox upgrade "$name" || failed+=("$name")
    done

    if ((${#failed[@]})); then
        printf '\nwsbox update failed: %s\n' "${failed[*]}" >&2
        return 1
    fi
}

cmd_create() {
    local name="${1:-}"

    require_managed "$name"

    container_exists "$name" \
        && die "container already exists: $name"

    distrobox assemble create \
        --file "$manifest" \
        --name "$name"
}

cmd_enter() {
    local name="${1:-}"

    require_managed "$name"

    container_exists "$name" \
        || die "container does not exist: $name"

    local -a flags
    mapfile -t flags < <(enter_flags "$name")

    exec distrobox enter \
        --name "$name" \
        "${flags[@]}"
}

cmd_run() {
    local name="${1:-}"

    [[ -n "$name" ]] \
        || die "container name required"

    shift || true

    require_managed "$name"

    container_exists "$name" \
        || die "container does not exist: $name"

    (($# > 0)) \
        || die "command required"

    local -a flags
    mapfile -t flags < <(enter_flags "$name")

    exec distrobox enter \
        --name "$name" \
        "${flags[@]}" \
        -- "$@"
}

cmd_stop() {
    local name="${1:-}"

    require_managed "$name"

    container_exists "$name" \
        || die "container does not exist: $name"

    distrobox stop \
        --yes \
        "$name"
}

cmd_remove() {
    local name=""

    while (($#)); do
        case "$1" in
            -h|--help)
                echo "Usage: wsbox remove NAME"
                return 0
                ;;

            -*)
                die "unknown remove option: $1"
                ;;

            *)
                [[ -z "$name" ]] \
                    || die "only one container may be removed at a time"

                name="$1"
                ;;
        esac

        shift
    done

    require_managed "$name"

    container_exists "$name" \
        || die "container does not exist: $name"

    distrobox rm \
        --force \
        --yes \
        "$name"

    echo \
        "Managed definition and custom HOME were kept. Use 'wsbox apply $name' to recreate it."
}

# --replace removes the old container with distrobox rm, which also deletes
# its exported launchers; they are exported again here. An application that
# is not installed yet (e.g. AUR in arch) is reported: install it, then
# wsbox apply NAME.
cmd_recreate() {
    local name="${1:-}"

    require_managed "$name"

    distrobox assemble create \
        --replace \
        --file "$manifest" \
        --name "$name"

    apply_exports_for "$name"
}

show_managed_exports() {
    local name="$1" alias source state launcher

    printf '%-16s %-16s %-18s %-52s %s\n' \
        BOX APP STATE SOURCE HOST_LAUNCHER

    while IFS= read -r alias; do
        [[ -n "$alias" ]] || continue
        source="$(export_source "$name" "$alias")"

        if container_exists "$name"; then
            state="$(export_state "$name" "$source")"
        else
            state="container-missing"
        fi

        launcher="$(export_host_path "$name" "$source")"
        printf '%-16s %-16s %-18s %-52s %s\n' \
            "$name" "$alias" "$state" "$source" "$launcher"
    done < <(export_aliases "$name")
}

cmd_apps() {
    local name="${1:-}" box

    if [[ -n "$name" ]]; then
        require_managed "$name"
        show_managed_exports "$name"

        if container_exists "$name"; then
            echo
            echo "Available desktop files in $name:"
            container_exec "$name" find \
                /usr/share/applications \
                -maxdepth 1 \
                -type f \
                -name '*.desktop' \
                -printf '%f\n' \
                2>/dev/null \
                | sort
        fi
        return 0
    fi

    while IFS= read -r box; do
        [[ -n "$box" ]] || continue
        show_managed_exports "$box"
    done < <(managed_boxes)
}

cmd_export() {
    local name="${1:-}" alias="${2:-}"

    require_managed "$name"
    [[ -n "$alias" ]] || die "managed app alias required"
    [[ $# -eq 2 ]] || die "Usage: wsbox export NAME APP"
    export_one "$name" "$alias"
}

cmd_unexport() {
    local name="${1:-}" alias="${2:-}"

    require_managed "$name"
    [[ -n "$alias" ]] || die "managed app alias required"
    [[ $# -eq 2 ]] || die "Usage: wsbox unexport NAME APP"
    unexport_one "$name" "$alias"
}

main() {
    ensure_base

    local cmd="${1:-}"

    if [[ -z "$cmd" ]]; then
        usage
        exit 0
    fi

    shift || true

    case "$cmd" in
        list)
            cmd_list "$@"
            ;;

        status)
            cmd_status "$@"
            ;;

        check)
            cmd_check "$@"
            ;;

        dry-run)
            cmd_dry_run "$@"
            ;;

        apply)
            cmd_apply "$@"
            ;;

        update)
            cmd_update "$@"
            ;;

        create)
            cmd_create "$@"
            ;;

        enter)
            cmd_enter "$@"
            ;;

        run)
            cmd_run "$@"
            ;;

        stop)
            cmd_stop "$@"
            ;;

        remove|rm)
            cmd_remove "$@"
            ;;

        recreate)
            cmd_recreate "$@"
            ;;

        apps)
            cmd_apps "$@"
            ;;

        export)
            cmd_export "$@"
            ;;

        unexport)
            cmd_unexport "$@"
            ;;

        -h|--help|help)
            usage
            ;;

        *)
            die "unknown command: $cmd"
            ;;
    esac
}

main "$@"
