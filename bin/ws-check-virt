#!/usr/bin/env bash
set -u
set -o pipefail

# Virtual machines (helpws virt): KVM, libvirt qemu:///system, the VM state on
# @vms that bootstrap.sh sets up (disks, UEFI variables, TPM, XML), the NAT
# network, UEFI and TPM for guests.
# Read-only. ws check virt; ws check runs it with --json (lib/check.bash).

repo="${WSCONFIG:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
# shellcheck source=../lib/check.bash
. "$repo/lib/check.bash"

case "${1:-}" in
    --json) check_json_mode ;;
    "") ;;
    -h|--help) echo "Usage: ws-check-virt [--json]  (ws check virt)"; exit 0 ;;
    *) echo "ws-check-virt: unknown argument: $1" >&2; exit 64 ;;
esac

# Only hosts with vm = "yes" in facts.nix have the VM layer.
if [[ "$(host_fact vm)" != yes ]]; then
    info "vm = \"$(host_fact vm)\" in nix/hosts/$("$repo/bin/ws" host 2>/dev/null)/facts.nix: no VM layer, nothing to check"
    check_finish
    exit
fi

images=/var/lib/libvirt/images
user="$(id -un)"

section "1. Host"

grep -Eq '\b(vmx|svm)\b' /proc/cpuinfo \
    && pass "CPU virtualization extensions" \
    || fail "no vmx/svm in /proc/cpuinfo (virtualization off in firmware?)"
[[ -c /dev/kvm ]] && pass "/dev/kvm present" || fail "/dev/kvm missing (kvm_intel not loaded)"
if have virt-host-validate; then
    # Its WARNs name hardware features this host does not have (secure
    # guests); only FAIL means KVM cannot work.
    while IFS= read -r line; do
        case "$line" in
            *": FAIL"*) fail "virt-host-validate: $(sed -E 's/ +: FAIL/: FAIL/' <<<"$line")" ;;
            *": WARN"*) info "virt-host-validate: $(sed -E 's/ +: WARN/: WARN/' <<<"$line")" ;;
        esac
    done < <(virt-host-validate qemu 2>/dev/null)
    pass "virt-host-validate qemu: no FAIL"
else
    fail "virt-host-validate missing (libvirt-clients; bootstrap.sh)"
fi

section "2. Access"

if getent group libvirt | cut -d: -f4 | tr ',' '\n' | grep -qx "$user"; then
    pass "$user is in group libvirt"
else
    fail "$user is not in group libvirt (bootstrap.sh)"
fi
virsh=(virsh -q -c qemu:///system)
if ! id -nG | tr ' ' '\n' | grep -qx libvirt; then
    warn "session is not in group libvirt yet (log out and in); libvirt state not checked"
    check_finish
    exit
fi
if "${virsh[@]}" uri >/dev/null 2>&1; then
    pass "qemu:///system reachable as $user"
else
    fail "qemu:///system not reachable (libvirtd.socket?)"
    check_finish
    exit
fi

section "3. Storage"

# All VM state lives on @vms (outside the snapshots of @), bound into the
# paths libvirt uses.
if findmnt -no OPTIONS /var/lib/vms 2>/dev/null | tr ',' '\n' | grep -qx 'subvol=/@vms'; then
    pass "/var/lib/vms is subvolume @vms"
else
    fail "/var/lib/vms is not mounted from @vms (bootstrap.sh)"
fi
for b in "images $images" "qemu /var/lib/libvirt/qemu" "swtpm /var/lib/libvirt/swtpm" "xml /etc/libvirt/qemu"; do
    set -- $b
    if [[ "$(findmnt -no SOURCE "$2" 2>/dev/null)" == *"[/@vms/$1]" ]]; then
        pass "$2 is @vms/$1"
    else
        fail "$2 is not bound from @vms/$1: that VM state is on @ (bootstrap.sh)"
    fi
done
lsattr -d "$images" 2>/dev/null | cut -d' ' -f1 | grep -q C \
    && pass "$images without copy-on-write (+C)" \
    || fail "$images has copy-on-write; qcow2 images fragment (sudo chattr +C, then copy images anew)"
[[ "$(stat -c '%U:%G %a' "$images" 2>/dev/null)" == "root:libvirt 2775" ]] \
    && pass "$images root:libvirt 2775" \
    || warn "$images is $(stat -c '%U:%G %a' "$images" 2>/dev/null), want root:libvirt 2775 (bootstrap.sh)"
pool="$("${virsh[@]}" pool-dumpxml default 2>/dev/null | sed -n 's|.*<path>\(.*\)</path>.*|\1|p')"
[[ "$pool" == "$images" ]] \
    && pass "pool default -> $images" \
    || fail "pool default is ${pool:-missing}, want $images (bootstrap.sh)"
pool_info="$("${virsh[@]}" pool-info default 2>/dev/null)"
grep -Eq '^State:[[:space:]]+running' <<<"$pool_info" \
    && grep -Eq '^Autostart:[[:space:]]+yes' <<<"$pool_info" \
    && pass "pool default running, autostart" \
    || fail "pool default not running or not autostarted (bootstrap.sh)"
# virt-manager defines a pool for each directory picked with "Browse Local";
# one in HOME (~/VMs/...) hands qemu paths through HOME, which it may only
# pass through (bootstrap.sh).
getfacl -p "$HOME" 2>/dev/null | grep -qx 'user:libvirt-qemu:--x' \
    && pass "qemu may pass through $HOME (ACL; pools in ~/VMs)" \
    || warn "qemu cannot pass through $HOME: pools in ~/VMs fail (setfacl -m u:libvirt-qemu:x $HOME; bootstrap.sh)"
while IFS= read -r p; do
    [[ -n "$p" && "$p" != default ]] || continue
    path="$("${virsh[@]}" pool-dumpxml "$p" 2>/dev/null | sed -n 's|.*<path>\(.*\)</path>.*|\1|p')"
    info "pool $p -> $path (virt-manager)"
done < <("${virsh[@]}" pool-list --all --name 2>/dev/null)

section "4. Network"

net_info="$("${virsh[@]}" net-info default 2>/dev/null)"
grep -Eq '^Active:[[:space:]]+yes' <<<"$net_info" \
    && grep -Eq '^Autostart:[[:space:]]+yes' <<<"$net_info" \
    && pass "network default (NAT) active, autostart" \
    || fail "network default not active or not autostarted (bootstrap.sh)"

section "5. Guest firmware"

[[ -r /usr/share/OVMF/OVMF_CODE_4M.fd ]] \
    && pass "UEFI firmware (OVMF)" \
    || fail "OVMF missing (ovmf)"
[[ -r /usr/share/OVMF/OVMF_CODE_4M.secboot.fd && -r /usr/share/OVMF/OVMF_VARS_4M.ms.fd ]] \
    && pass "UEFI Secure Boot firmware with Microsoft keys (Windows 11)" \
    || warn "OVMF Secure Boot variant missing: Windows 11 guests need it"
# Internal snapshots of a UEFI VM need its variables in qcow2; the
# descriptor in /etc/qemu/firmware (ws system check) makes libvirt copy this
# template for new VMs.
vars_qcow2=/var/lib/vms/firmware/OVMF_VARS_4M.ms.qcow2
if [[ ! -r "$vars_qcow2" ]]; then
    fail "$vars_qcow2 missing: new UEFI VMs get no qcow2 variables (bootstrap.sh)"
elif qemu-img compare -q -f raw -F qcow2 /usr/share/OVMF/OVMF_VARS_4M.ms.fd "$vars_qcow2" 2>/dev/null; then
    pass "UEFI variables template in qcow2 matches the ovmf package"
else
    warn "$vars_qcow2 differs from the ovmf package template (ovmf updated? bootstrap.sh)"
fi
have swtpm_setup \
    && pass "swtpm: TPM for guests (Windows 11)" \
    || warn "swtpm_setup missing (swtpm-tools): Windows 11 guests need a TPM"

section "6. Machines"

while IFS= read -r vm; do
    [[ -n "$vm" ]] || continue
    info "VM $vm: $("${virsh[@]}" domstate "$vm" 2>/dev/null)"
    nvram="$("${virsh[@]}" dumpxml --inactive "$vm" 2>/dev/null | grep '<nvram')"
    [[ -z "$nvram" || "$nvram" == *"format='qcow2'"* ]] \
        || warn "VM $vm: UEFI variables not in qcow2, no snapshots while running (helpws virt)"
done < <("${virsh[@]}" list --all --name 2>/dev/null)

check_finish
