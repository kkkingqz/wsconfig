#!/usr/bin/env bash
set -euo pipefail

# xremap.service (keyboard/xremap.nix) passes the store build of
# keyboard/xremap.yml (@repo@ substituted), the pinned binary and the
# --desktop / --watch values.
config="${XREMAP_CONFIG:-}"
desktop="${XREMAP_DESKTOP:-}"
watch="${XREMAP_WATCH:-}"

[[ -n "$config" && -n "$desktop" && -n "$watch" ]] || { echo "ws-xremap: XREMAP_CONFIG/DESKTOP/WATCH unset; start it as xremap.service (ws-keyboard start)" >&2; exit 64; }
[[ -r "$config" ]] || { echo "ws-xremap: missing config: $config" >&2; exit 66; }

# Game Mode (gamescope-session-plus, helpws plan-legion-go) starts
# graphical-session.target too, and xremap is part of the GNOME layer: off
# there, without a failure that would restart it.
if [[ ":${XDG_CURRENT_DESKTOP:-}:" != *:GNOME:* ]] || pgrep -u "$(id -u)" -x gamescope >/dev/null 2>&1; then
    echo "ws-xremap: not a GNOME session (XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-unset}): xremap stays off"
    exit 0
fi

# The Touch Bar of mbp16 always; the host's own (facts.nix xremapIgnore).
ignore=(--ignore "Dynamic Function Row Virtual Input Device")
if [[ -n "${XREMAP_IGNORE:-}" ]]; then
    IFS=';' read -r -a names <<<"$XREMAP_IGNORE"
    for name in "${names[@]}"; do
        [[ -z "$name" ]] || ignore+=(--ignore "$name")
    done
fi

xremap_bin="${XREMAP_BIN:-$(command -v xremap || true)}"
[[ -n "$xremap_bin" ]] || { echo "ws-xremap: xremap is not installed or not in PATH" >&2; exit 127; }

# Application-specific exclusions are safety-critical: without the GNOME
# bridge Super+C could become Ctrl+C inside a terminal. On login GNOME Shell
# may expose the bridge a few seconds after graphical-session.target, so wait
# briefly rather than starting xremap without app awareness.
if [[ "$desktop" == "gnome" && "${XDG_SESSION_TYPE:-wayland}" == "wayland" ]]; then
    bridge_ready=false
    for _ in {1..30}; do
        if busctl --user call \
            org.gnome.Shell \
            /com/k0kubun/Xremap \
            com.k0kubun.Xremap \
            WMClasses >/dev/null 2>&1; then
            bridge_ready=true
            break
        fi
        sleep 1
    done
    if [[ "$bridge_ready" != true ]]; then
        echo "ws-xremap: GNOME xremap bridge is unavailable" >&2
        exit 69
    fi
fi

exec "$xremap_bin" \
    "--watch=$watch" \
    --desktop "$desktop" \
    --allow-launch true \
    "${ignore[@]}" --output-device-name workstation-xremap \
    "$config"
