#!/usr/bin/env bash
set -euo pipefail

# Suspend / T2 power layer: deep-only sleep, Broadcom Wi-Fi guards and the
# patched t2bce modules (no-state fallback fix). See helpws suspend.

# shellcheck source=../lib/common.bash
. "$(dirname "$(readlink -f "$0")")/../lib/common.bash"
# Build results (sources, modules per kernel): generated, not edited.
cache="$HOME/.local/share/workstation/t2bce"

t2bce_modules=(t2bce_dma t2bce_core t2bce_vhci t2bce_audio t2bce_ave)
t2bce_patch="$repo/system/kernel/t2bce/nostate-fix.patch"
# Kernel release -> linux-t2-patches commit, from system/kernel/t2bce/t2bce.nix.
t2bce_sources="$HOME/.local/share/workstation/t2bce/sources.json"
# The host release: the modules are built with the compiler of the kernel.
build_image="docker.io/library/ubuntu:$(. /etc/os-release && echo "$VERSION_ID")"

usage() {
    cat <<'USAGE'
Usage: ws-suspend <command> [KERNEL]

  status                 show sleep mode, t2bce state and runtime drift (read-only)
  check [--json]         deep sleep, t2bce stateful sleep, Touch Bar mode (ws check)
  apply                  install the system files: ws system apply (sudo)
  t2bce-build [KERNEL]   build patched t2bce modules into ~/.local/share/workstation/t2bce
  t2bce-install [KERNEL] install built modules into /lib/modules/KERNEL/updates/t2bce (sudo)
  t2bce-rollback [KERNEL] remove them; the in-tree modules take over (sudo)
  swap-setup [SIZE]      swapfile for hibernation in subvolume @swap at /swap,
                         SIZE 32g (RAM); prints resume= for facts.nix (sudo)

KERNEL defaults to the running kernel (uname -r).
USAGE
}

t2bce_commit() {
    local kver="$1"
    [[ -r "$t2bce_sources" ]] || die "missing $t2bce_sources (ws switch)"
    manifest_get "$t2bce_sources" "$kver"
}

cmd_status() {
    local kver ver param
    kver="$(uname -r)"

    echo "== Sleep =="
    printf 'mem_sleep:   %s\n' "$(cat /sys/power/mem_sleep)"
    printf 'cmdline:     %s\n' "$(grep -o 'pcie_aspm[^ ]*\|pm_async=[^ ]*' /proc/cmdline | tr '\n' ' ')"

    echo
    echo "== t2bce ($kver) =="
    ver="$(cat /sys/module/t2bce_core/version 2>/dev/null || echo '-')"
    param="$(cat /sys/module/t2bce_core/parameters/stateful_sleep 2>/dev/null || echo '-')"
    printf 'loaded:          %s (stateful_sleep=%s)\n' "$ver" "$param"
    printf 'resolves to:     %s\n' "$(modinfo -k "$kver" -F filename t2bce_core 2>/dev/null || echo '-')"
    printf 'pinned source:   %s\n' "$(t2bce_commit "$kver" || true)"
    if apt-mark showhold 2>/dev/null | grep -qx 'linux-t2'; then
        echo "linux-t2:        held"
    else
        echo "linux-t2:        not held (a new kernel boots the in-tree t2bce until rebuilt)"
    fi

    echo
    # The suspend files are part of the system layer (system/hardware/*.nix);
    # its manifest check covers them with the rest.
    echo "== System files (ws system check) =="
    "$repo/bin/ws" system check 2>/dev/null | grep -E '^ *(WARN|FAIL) ' || echo "no problems"
}

# Since phase 4 of helpws history-nix one owner installs all system
# files, including the suspend layer: `ws system apply` (system).
cmd_apply() {
    exec "$repo/bin/ws" system apply
}

cmd_t2bce_build() {
    local kver="$1" commit headers work src out m
    commit="$(t2bce_commit "$kver")"
    [[ -n "$commit" ]] || die "no pinned linux-t2-patches commit for $kver in system/kernel/t2bce/t2bce.nix (ws switch after adding it)"
    headers="/usr/src/linux-headers-$kver"
    [[ -d "$headers" ]] || die "kernel headers missing: $headers"
    command -v podman >/dev/null 2>&1 || die "podman not found"
    command -v git >/dev/null 2>&1 || die "git not found"

    work="$cache/$kver"
    src="$work/src"
    out="$work/modules"
    rm -rf -- "$work"
    mkdir -p "$src" "$out"

    echo "== Sources: linux-t2-patches $commit =="
    curl -fsSL -o "$work/1001.patch" \
        "https://raw.githubusercontent.com/t2linux/linux-t2-patches/$commit/1001-Add-t2bce-driver-stack.patch"
    git -C "$src" init -q
    git -C "$src" apply "$work/1001.patch"
    git -C "$src" apply "$t2bce_patch"

    echo
    echo "== Build ($build_image, $headers) =="
    podman run --rm \
        -v /usr/src:/usr/src:ro \
        -v "$src:/src:Z" \
        "$build_image" \
        bash -euc "
            apt-get update -qq
            apt-get install -y -qq --no-install-recommends gcc make libc6-dev libelf-dev >/dev/null
            make -C '$headers' M=/src/drivers/staging/t2bce \
                CONFIG_T2BCE_DMA=m CONFIG_T2BCE_CORE=m CONFIG_T2BCE_VHCI=m \
                CONFIG_T2BCE_AUDIO=m CONFIG_T2BCE_AVE=m modules
        "

    for m in "${t2bce_modules[@]}"; do
        cp -- "$src/drivers/staging/t2bce/$m/$m.ko" "$out/"
    done

    echo
    for m in "${t2bce_modules[@]}"; do
        printf '%-12s %-20s %s\n' "$m" "$(modinfo -F version "$out/$m.ko")" "$(modinfo -F vermagic "$out/$m.ko" | awk '{print $1}')"
    done
    echo
    echo "Built into $out. Install with: ws-suspend t2bce-install $kver"
}

cmd_t2bce_install() {
    local kver="$1" out dest m vm
    out="$cache/$kver/modules"
    dest="/lib/modules/$kver/updates/t2bce"
    [[ -d "/lib/modules/$kver" ]] || die "kernel $kver is not installed"
    for m in "${t2bce_modules[@]}"; do
        [[ -r "$out/$m.ko" ]] || die "missing $out/$m.ko; run: ws-suspend t2bce-build $kver"
        vm="$(modinfo -F vermagic "$out/$m.ko" | awk '{print $1}')"
        [[ "$vm" == "$kver" ]] || die "vermagic mismatch in $m.ko: $vm"
    done

    sudo install -d -m0755 "$dest"
    for m in "${t2bce_modules[@]}"; do
        sudo install -m0644 "$out/$m.ko" "$dest/$m.ko"
    done
    sudo depmod -a "$kver"
    for m in "${t2bce_modules[@]}"; do
        printf '%-12s %s\n' "$m" "$(modinfo -k "$kver" -F filename "$m")"
    done
    sudo update-initramfs -u -k "$kver"
    echo
    echo "Installed. Reboot into $kver to load the patched modules."
}

cmd_t2bce_rollback() {
    local kver="$1"
    sudo rm -rf -- "/lib/modules/$kver/updates/t2bce"
    sudo rmdir --ignore-fail-on-non-empty "/lib/modules/$kver/updates" 2>/dev/null || true
    sudo depmod -a "$kver"
    printf 't2bce_core   %s\n' "$(modinfo -k "$kver" -F filename t2bce_core)"
    sudo update-initramfs -u -k "$kver"
    echo
    echo "Rolled back to the in-tree t2bce for $kver. Reboot to apply."
}

# Hibernation needs swap (helpws suspend, Hibernate): a swapfile in its own
# subvolume @swap (no snapshots of it, no CoW, no compression), mounted at
# /swap like the other subvolumes in /etc/fstab. Idempotent; prints the
# kernel parameters for facts.nix kernelParams.
cmd_swap_setup() {
    local size="$1" uuid top offset
    uuid="$(findmnt -no UUID /)"
    [[ "$(findmnt -no FSTYPE /)" == btrfs && -n "$uuid" ]] || die "/ is not btrfs"

    if ! sudo btrfs subvolume show /swap >/dev/null 2>&1; then
        top="$(sudo mktemp -d /run/ws-btrfs-top.XXXXXX)"
        sudo mount -o subvolid=5 "UUID=$uuid" "$top"
        if [[ ! -e "$top/@swap" ]]; then
            sudo btrfs subvolume create "$top/@swap"
        fi
        sudo umount "$top"
        sudo rmdir "$top"
    fi

    if ! grep -Eq '^[^#]*[[:space:]]/swap[[:space:]]' /etc/fstab; then
        sudo cp -a /etc/fstab "/etc/fstab.ws-$(date +%Y%m%d-%H%M%S)"
        printf '%s
' \
            "UUID=$uuid  /swap         btrfs  subvol=@swap,noatime                       0 0" \
            "/swap/swapfile  none  swap  defaults  0 0" | sudo tee -a /etc/fstab >/dev/null
        sudo systemctl daemon-reload
    fi
    sudo mkdir -p /swap
    findmnt -n /swap >/dev/null || sudo mount /swap

    if [[ ! -e /swap/swapfile ]]; then
        sudo btrfs filesystem mkswapfile --size "$size" --uuid clear /swap/swapfile
    fi
    grep -q '^/swap/swapfile ' /proc/swaps || sudo swapon /swap/swapfile
    swapon --show

    offset="$(sudo btrfs inspect-internal map-swapfile -r /swap/swapfile)"
    echo
    echo "facts.nix kernelParams: \"resume=UUID=$uuid\" \"resume_offset=$offset\""
    echo "then: ws system apply; sudo update-initramfs -u; reboot (helpws suspend, Hibernate)"
}

cmd="${1:-status}"
kver="${2:-$(uname -r)}"

case "$cmd" in
    status) cmd_status ;;
    check) shift; exec "$repo/bin/ws-suspend-check" "$@" ;;
    apply) cmd_apply ;;
    t2bce-build) cmd_t2bce_build "$kver" ;;
    t2bce-install) cmd_t2bce_install "$kver" ;;
    t2bce-rollback) cmd_t2bce_rollback "$kver" ;;
    swap-setup) cmd_swap_setup "${2:-32g}" ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 64 ;;
esac
