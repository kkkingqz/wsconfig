#!/usr/bin/env bash
set -eu

# shellcheck source=../lib/common.bash
. "$(dirname "$(readlink -f "$0")")/../lib/common.bash"
# Micro config dir: settings.json and bindings.json are home-manager links
# into terminal/micro-help; micro writes buffers/ (history) next to them.
micro_cfg="$HOME/.local/share/workstation/micro-help"
topic="${1:-terminal}"

# A topic names a page by its `title:`, not by a path: docs/ can be
# rearranged without touching this list.
open_title() {
    doc="$(grep -rlx --include='*.md' "title: $1" "$repo/docs" | head -n 1)"
    [ -n "$doc" ] || { echo "helpws: no document with title $1" >&2; exit 1; }
    MICRO_CONFIG_HOME="$micro_cfg" exec micro -readonly true "$doc"
}

case "$topic" in
    readme) MICRO_CONFIG_HOME="$micro_cfg" exec micro -readonly true "$repo/README.md" ;;
    layers|architecture) open_title ws-layers ;;
    architecture-v2|arch-v2) open_title ws-architecture-v2 ;;
    checks|check) open_title ws-checks ;;
    workstation|system|baseline) open_title ws-workstation ;;
    terminal|term|ghostty|fish) open_title ws-terminal ;;
    keyboard|keys) open_title ws-keyboard ;;
    touchbar|touch-bar) open_title ws-touchbar ;;
    suspend|sleep|power) open_title ws-suspend ;;
    gnome|desktop) open_title ws-gnome ;;
    rebuild|reinstall) open_title ws-rebuild ;;
    setup|install|new) open_title ws-setup ;;
    distrobox|box|boxes|wsbox) open_title ws-distrobox ;;
    flatpak|wsflatpak) open_title ws-flatpak ;;
    windows|wine|wswin|steam|proton) open_title ws-windows ;;
    remmina|rdp) open_title ws-remmina ;;
    virt|vm|vms|libvirt|kvm) open_title ws-virt ;;
    gaming|game|gamemode|wsgame) open_title ws-gaming ;;
    backup|wsbackup) open_title ws-backup ;;
    recovery|restore|ws-restore) open_title ws-recovery ;;
    widgets|widget|wswidgets) open_title ws-widgets ;;
    roadmap|plans) open_title ws-roadmap ;;
    plan-t2) open_title ws-plan-t2 ;;
    plan-dgpu|dgpu|t2gmux) open_title ws-plan-dgpu ;;
    plan-final) open_title ws-plan-final ;;
    plan-unraid|unraid) open_title ws-plan-unraid ;;
    plan-legion-go|legion-go|legiongo) open_title ws-plan-legion-go ;;
    plan-legion-go-agent|legion-go-agent) open_title ws-plan-legion-go-agent ;;
    plan-wsgnomebox|wsgnomebox) open_title ws-plan-wsgnomebox ;;
    plan-hyprland|hyprland) open_title ws-plan-hyprland ;;
    plan-v2|v2) open_title ws-plan-v2 ;;
    history-gnome|plan-gnome) open_title ws-history-gnome ;;
    history-flatpak|plan-flatpak) open_title ws-history-flatpak ;;
    history-distrobox|plan-dev) open_title ws-history-distrobox ;;
    history-windows|plan-windows) open_title ws-history-windows ;;
    history-nix|plan-nix) open_title ws-history-nix ;;
    history-suspend|history-touchbar) open_title ws-history-suspend ;;
    history-virt|plan-virt) open_title ws-history-virt ;;
    man)
        page="${2:-ws-terminal}"
        tmp="$(mktemp "${TMPDIR:-/tmp}/helpws.XXXXXX")"
        trap 'rm -f "$tmp"' EXIT HUP INT TERM
        PAGER=cat MANPAGER=cat man "$page" | col -bx > "$tmp"
        MICRO_CONFIG_HOME="$micro_cfg" micro -readonly true "$tmp"
        ;;
    -h|--help|help)
        cat <<'USAGE'
Usage: helpws [topic]

Architecture (docs/architecture):
  readme           README: entry point
  layers           Layers, owners, rules, where things live
  architecture-v2  wsconfig v2: core, configuration repository, shared mechanisms
  checks           ws check: who checks what, --json format
  workstation      Current workstation in detail, repository map

Runbooks (docs/runbooks):
  setup            New PC on wsconfig: setup.sh (GRUB hosts)
  rebuild          Reinstall to the current state
  keyboard         macOS-style keyboard layer
  gnome            GNOME desktop
  terminal         Ghostty + Fish handbook
  suspend          Suspend / T2 power layer
  touchbar         Touch Bar
  flatpak          Flatpak applications (wsflatpak)
  distrobox        Managed Distrobox / Podman containers (wsbox)
  windows          Windows programs, Wine, Proton, Steam (wswin)
  remmina          Remmina RDP client from Nix: H.264, files
  virt             Virtual machines: KVM, libvirt, virt-manager
  gaming           Game Mode: gamescope + Steam session (wsgame)
  backup           Backup to Unraid: Timeshift snapshots, Btrfs send (wsbackup)
  recovery         Restore a date from Unraid with ws-restore (Live USB)
  widgets          Shared widget runtime (Quickshell, GNOME panel)

Plans (docs/plans):
  roadmap          What is left
  plan-t2          T2 optional / power / auth
  plan-dgpu        AMD dGPU through t2gmux (power off like macOS)
  plan-final       Backup / inventory / finalization
  plan-unraid      Unraid receiver: server survey, preparation
  plan-legion-go   Legion Go (gen 1): host, Game Mode from Bazzite parts
  plan-legion-go-agent  Legion Go: instructions for Claude on the device
  plan-wsgnomebox  wsgnomebox: wsconfig host in a container on tower
  plan-hyprland    Hyprland + Caelestia next to GNOME (proposal)
  plan-v2          wsconfig v2: cleanup, shared mechanisms, two repositories

History (docs/history; old plan-* names work too):
  history-gnome    history-flatpak    history-distrobox
  history-windows  history-nix        history-suspend (and Touch Bar)
  history-virt

Other:
  man PAGE         Open generated man page in Micro
USAGE
        ;;
    *)
        echo "Unknown topic: $topic" >&2
        echo "Run: helpws --help" >&2
        exit 2
        ;;
esac
