#!/usr/bin/env bash
set -u
set -o pipefail

# Suspend / T2 power layer at runtime: deep sleep, t2bce stateful sleep, the
# Touch Bar in native keyboard mode. The files are checked by ws system
# check, the patched t2bce against the kernel by ws-workstation-verify.
# Read-only. ws-suspend check; ws check runs it with --json (lib/check.bash).

# shellcheck source=../lib/common.bash
. "$(dirname "$(readlink -f "$0")")/../lib/common.bash"
# shellcheck source=../lib/check.bash
. "$repo/lib/check.bash"

case "${1:-}" in
    --json) check_json_mode ;;
    "") ;;
    -h|--help) echo "Usage: ws suspend check [--json]"; exit 0 ;;
    *) echo "ws suspend check: unknown argument: $1" >&2; exit 64 ;;
esac

# The suspend layer (deep-only sleep, t2bce, Touch Bar) is part of the T2
# hardware profile (system/hardware/t2-mbp16.nix).
hardware="$(host_fact hardware)"
if [[ -z "$hardware" ]]; then
    fail "unknown host: no hardware fact (ws fact hardware)"
    check_finish
    exit
elif [[ "$hardware" != t2-mbp16 ]]; then
    info "hardware $hardware: no suspend layer (T2 only, helpws suspend)"
    check_finish
    exit
fi

section "1. Sleep"

grep -Fq '[deep]' /sys/power/mem_sleep 2>/dev/null \
    && pass "mem_sleep default is deep (S3)" \
    || fail "mem_sleep default is not deep: $(cat /sys/power/mem_sleep 2>/dev/null)"

# The default entry "Ubuntu" (ws.dgpu=off) forces ASPM with the powersave
# policy (helpws suspend, ASPM); "Ubuntu (AMD)" and GRUB recovery do not.
aspm="$(grep -Eo 'pcie_aspm[^ ]*' /proc/cmdline | tr '\n' ' ')"
if grep -qw 'ws.dgpu=off' /proc/cmdline; then
    [[ "$aspm" == *pcie_aspm=force* && "$aspm" == *pcie_aspm.policy=powersave* ]] \
        && pass "kernel owns ASPM: ${aspm% }" \
        || warn "default entry without pcie_aspm=force pcie_aspm.policy=powersave (${aspm:-none}); ~2 W more idle (refind_linux.conf, ws system apply)"
    # The AMD's CPU port parked like macOS does (ws-dgpu-park; at boot from
    # ws-dgpu-off, after resume from its sleep hook): last word of this boot.
    park="$(journalctl -b -q -o cat _SYSTEMD_UNIT=ws-dgpu-off.service + SYSLOG_IDENTIFIER=ws-dgpu-park 2>/dev/null \
        | grep -E '^ws-dgpu-park: (parked|no link training|L2 request)|parking the port failed' | tail -1)"
    case "$park" in
        *"ws-dgpu-park: parked"*|*"no link training"*) pass "AMD CPU port parked (ws-dgpu-park)" ;;
        "") warn "no ws-dgpu-park result in this boot's journal (journalctl -b -u ws-dgpu-off)" ;;
        *) warn "AMD CPU port not parked, CPU package stays in PC3: $park" ;;
    esac
else
    pass "no forced ASPM outside the default entry${aspm:+ (has: $aspm)}"
fi

t2bce_param="$(cat /sys/module/t2bce_core/parameters/stateful_sleep 2>/dev/null || true)"
[[ -z "$t2bce_param" || "$t2bce_param" == "Y" ]] \
    && pass "t2bce stateful sleep enabled" \
    || fail "t2bce_core.stateful_sleep=$t2bce_param (forced no-state test mode left on)"

# Without it the firmware's Thunderbolt _PS0 polls the host bridge and every
# resume takes ~20 s longer (helpws suspend, Thunderbolt).
if systemctl is-active --quiet ws-tb-acpi-seed.service 2>/dev/null; then
    pass "Thunderbolt ACPI regions seeded before the first suspend (ws-tb-acpi-seed)"
else
    warn "ws-tb-acpi-seed.service not active: resume ~20 s slower (journalctl -b -u ws-tb-acpi-seed; ws system apply)"
fi

section "2. Hibernation"

# Configured when the kernel command line has resume= (host.toml
# kernelParams, ws-suspend swap-setup; helpws suspend, Hibernate).
resume_arg="$(grep -o 'resume=[^ ]*' /proc/cmdline | grep -v '^resume_' | head -1)"
offset_arg="$(grep -o 'resume_offset=[0-9]*' /proc/cmdline | head -1)"
if [[ -z "$resume_arg" ]]; then
    info "no resume= on the kernel command line: hibernation not set up"
else
    swap_kb="$(awk '$1 == "/swap/swapfile" { print $3 }' /proc/swaps)"
    mem_kb="$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)"
    if [[ -z "$swap_kb" ]]; then
        fail "/swap/swapfile is not active swap (ws suspend swap-setup)"
    elif (( swap_kb < mem_kb )); then
        warn "/swap/swapfile $((swap_kb / 1024)) MiB < RAM $((mem_kb / 1024)) MiB: a large image may not fit"
    else
        pass "/swap/swapfile active, $((swap_kb / 1024 / 1024)) GiB"
    fi
    [[ "$(cat /sys/power/resume 2>/dev/null)" != "0:0" ]] \
        && pass "initramfs set the resume device ($(cat /sys/power/resume), $resume_arg)" \
        || fail "resume device not set by the initramfs (/sys/power/resume 0:0; update-initramfs -u)"
    [[ "$(cat /sys/power/resume_offset 2>/dev/null)" == "${offset_arg#resume_offset=}" ]] \
        && pass "resume offset $(cat /sys/power/resume_offset)" \
        || fail "resume offset $(cat /sys/power/resume_offset 2>/dev/null) != ${offset_arg:-no resume_offset=} (ws suspend swap-setup prints it)"
    initrd="/boot/initrd.img-$(uname -r)"
    newest=""
    for f in /etc/dracut.conf.d/ws-hibernate.conf /usr/lib/dracut/modules.d/95ws-t2-resume/* \
             /usr/local/sbin/ws-t2-detach; do
        [[ -e "$f" && "$f" -nt "$initrd" ]] && newest="$f"
    done
    [[ -z "$newest" ]] \
        && pass "initramfs not older than its T2 resume scripts" \
        || warn "$newest is newer than $initrd: sudo update-initramfs -u"
fi

section "3. Touch Bar native mode"

tb_usb=""
for dev in /sys/bus/usb/devices/*; do
    if [[ "$(cat "$dev/idVendor" 2>/dev/null):$(cat "$dev/idProduct" 2>/dev/null)" == "05ac:8302" ]]; then
        tb_usb="$dev"
        break
    fi
done
if [[ -n "$tb_usb" ]]; then
    tb_cfg="$(cat "$tb_usb/bConfigurationValue" 2>/dev/null || true)"
    [[ "$tb_cfg" == "1" ]] \
        && pass "Touch Bar USB configuration 1 (native keyboard mode)" \
        || fail "Touch Bar USB configuration is '${tb_cfg:-0}', expected 1"
else
    fail "Touch Bar USB device 05ac:8302 not found"
fi

[[ -d /sys/module/appletbdrm ]] \
    && fail "appletbdrm is loaded (Touch Bar display mode)" \
    || pass "appletbdrm not loaded"

tb_mode_node=""
for node in /sys/bus/hid/drivers/hid-appletb-kbd/*/mode; do
    [[ -r "$node" ]] && { tb_mode_node="$node"; break; }
done
if [[ -n "$tb_mode_node" ]]; then
    tb_mode="$(cat "$tb_mode_node" 2>/dev/null || true)"
    [[ "$tb_mode" == "1" ]] \
        && pass "hid-appletb-kbd bound, mode 1 (F1..F12)" \
        || warn "hid-appletb-kbd mode is '$tb_mode', expected 1 unless Fn is held"
else
    fail "hid-appletb-kbd is not bound to the Touch Bar"
fi

if have dpkg-query && dpkg-query -W -f='${Status}' tiny-dfr 2>/dev/null | grep -q 'install ok installed'; then
    fail "tiny-dfr is installed (it switches the Touch Bar to display mode)"
else
    pass "tiny-dfr not installed"
fi

# The unit and its file: ws system check (system/*.nix manifest).
systemctl is-active --quiet ws-touchbar-fn.service 2>/dev/null \
    && pass "ws-touchbar-fn.service active" \
    || fail "ws-touchbar-fn.service not active"

check_finish
