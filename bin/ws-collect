#!/usr/bin/env bash
set -euo pipefail

# Machine state that a rebuild needs and the repository does not hold:
# the functional baseline, boot and disk layout, apt sources and package
# choices, the Apple Wi-Fi/Bluetooth firmware taken from macOS, machine-local
# state, and the hardware inventory of a new machine (helpws plan-legion-go,
# stage 3). Read-only on the system; writes one archive. Asks sudo (baseline
# --with-sudo, Btrfs subvolumes, input devices). helpws rebuild, section 0.

repo="${WSCONFIG:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
state="${XDG_STATE_HOME:-$HOME/.local/state}/workstation"

usage() {
    cat <<'USAGE'
Usage: ws collect [--no-firmware] [ARCHIVE]

ARCHIVE defaults to ./ws-collect-HOST-YYYYmmdd-HHMMSS.tar.gz. Copy it off the
laptop before reinstalling.

  meta/       date, host, commit (and uncommitted changes), kernel, os-release
  baseline/   ws baseline capture --with-sudo (owner checks, GNOME, Flatpak,
              Distrobox, user links, system files, packages)
  boot/       /proc/cmdline, fstab, refind_linux.conf, lsblk, blkid,
              efibootmgr, Btrfs subvolumes and default
  apt/        sources, manual and held packages, dpkg -l
  firmware/   files of /lib/firmware/brcm that no package owns (taken from
              macOS by get-apple-firmware); --no-firmware skips them
  hardware/   inventory: DMI and BIOS, CPU, memory, lspci -nnk, lsusb,
              input devices, sensors, hwmon, iio, LEDs, power supplies,
              platform_profile, firmware-attributes, displays, audio (ALSA,
              PipeWire), fwupd devices, modules, kernel warnings; no serial
              numbers
  state/      ~/.local/state/workstation without baseline/ (keyboard backup,
              checkpoints)
  virt/       libvirt definitions (virsh dumpxml of VMs, networks, pools),
              UEFI variables (nvram/) and TPM state (swtpm/); the disk
              images are not copied (backup of @vms: helpws plan-final)
USAGE
}

die() {
    echo "ws collect: $*" >&2
    exit 1
}

firmware=true
archive=""
while (($#)); do
    case "$1" in
        --no-firmware) firmware=false ;;
        -h|--help) usage; exit 0 ;;
        -*) die "unknown option: $1" ;;
        *) [[ -z "$archive" ]] || die "only one ARCHIVE"; archive="$1" ;;
    esac
    shift
done
stamp="$(date +%Y%m%d-%H%M%S)"
name="ws-collect-$(hostname)-$stamp"
archive="${archive:-$PWD/$name.tar.gz}"
[[ "$archive" == *.tar.gz ]] || die "ARCHIVE must end in .tar.gz"
[[ ! -e "$archive" ]] || die "exists: $archive"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
dir="$work/$name"
mkdir -p "$dir"/{meta,boot,apt,firmware,state,virt,hardware}

run_to() {
    local out="$1"
    shift
    { "$@" 2>&1 || echo "[exit $?]"; } > "$out"
}

sudo -v

echo "== meta"
{
    echo "date: $(date --iso-8601=seconds)"
    echo "host: $(hostname)"
    echo "model: $(cat /sys/class/dmi/id/product_name 2>/dev/null || echo '?')"
    echo "kernel: $(uname -r)"
    echo "commit: $(git -C "$repo" rev-parse HEAD 2>/dev/null || echo '?')"
    echo "flake-host: $("$repo/bin/ws" host 2>/dev/null || echo '?')"
} > "$dir/meta/meta.txt"
cp /etc/os-release "$dir/meta/os-release"
git -C "$repo" status --short > "$dir/meta/git-status.txt" 2>&1 || true
git -C "$repo" diff HEAD > "$dir/meta/git-diff.patch" 2>/dev/null || true

echo "== baseline"
"$repo/bin/ws-baseline" capture "collect-$stamp" --with-sudo
cp -a "$state/baseline/collect-$stamp" "$dir/baseline"
rm -rf -- "${state:?}/baseline/collect-$stamp"

echo "== boot"
cp /proc/cmdline "$dir/boot/cmdline"
cp /etc/fstab "$dir/boot/fstab"
[[ -r /boot/refind_linux.conf ]] && cp /boot/refind_linux.conf "$dir/boot/"
run_to "$dir/boot/lsblk.txt" lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,UUID,PARTUUID,PARTLABEL,MOUNTPOINTS
run_to "$dir/boot/blkid.txt" sudo blkid
run_to "$dir/boot/efibootmgr.txt" efibootmgr -v
run_to "$dir/boot/btrfs-subvolumes.txt" sudo btrfs subvolume list /
run_to "$dir/boot/btrfs-default.txt" sudo btrfs subvolume get-default /
run_to "$dir/boot/kernels.txt" ls -l /boot

echo "== apt"
cp -a /etc/apt/sources.list.d "$dir/apt/"
[[ -r /etc/apt/sources.list ]] && cp /etc/apt/sources.list "$dir/apt/"
apt-mark showmanual > "$dir/apt/manual.txt"
apt-mark showhold > "$dir/apt/hold.txt"
dpkg -l > "$dir/apt/dpkg-l.txt"

if [[ "$firmware" == true ]]; then
    echo "== firmware"
    # Files of /lib/firmware/brcm no package owns: what get-apple-firmware
    # copied from macOS. Without macOS they cannot be fetched again.
    cat /var/lib/dpkg/info/*.list | grep '^/lib/firmware/brcm/\|^/usr/lib/firmware/brcm/' \
        | sed 's|^/usr/lib/|/lib/|' | sort -u > "$work/owned"
    n=0
    while IFS= read -r -d '' f; do
        grep -qxF "/lib/firmware/brcm/${f##*/}" "$work/owned" && continue
        cp -a "$f" "$dir/firmware/"
        n=$((n + 1))
    done < <(find /lib/firmware/brcm -maxdepth 1 \( -type f -o -type l \) -print0)
    echo "$n files"
fi

echo "== hardware"
# What the profile of a machine is written from (system/hardware/*.nix):
# drivers, quirks, sensors, firmware knobs. Serial numbers stay out.
hw="$dir/hardware"
have() { command -v "$1" >/dev/null 2>&1; }
{
    for f in sys_vendor product_name product_version product_family board_vendor \
        board_name board_version bios_vendor bios_version bios_date bios_release; do
        printf '%s: %s\n' "$f" "$(cat "/sys/class/dmi/id/$f" 2>/dev/null || echo '?')"
    done
} > "$hw/dmi.txt"
run_to "$hw/lscpu.txt" lscpu
run_to "$hw/memory.txt" free -h
run_to "$hw/lspci.txt" lspci -nnk
run_to "$hw/lsusb.txt" lsusb
run_to "$hw/lsusb-tree.txt" lsusb -t
# Uniq: serials and Bluetooth addresses.
sed 's/^U: Uniq=..*/U: Uniq=(removed)/' /proc/bus/input/devices > "$hw/input-devices.txt"
have libinput && run_to "$hw/libinput.txt" sudo libinput list-devices
have sensors && run_to "$hw/sensors.txt" sensors
run_to "$hw/lsmod.txt" lsmod
# sysfs: NAME: VALUE of the readable files of each device (one level).
sysfs_values() {
    local d f
    for d in "$@"; do
        [[ -d "$d" ]] || continue
        echo "== $d"
        for f in "$d"/*; do
            # edid: binary, with the serial of the display.
            [[ -f "$f" && -r "$f" && "${f##*/}" != edid ]] || continue
            printf '%s: %s\n' "${f##*/}" "$(head -c 300 "$f" 2>/dev/null | tr '\n' ' ')"
        done
    done
}
sysfs_values /sys/class/hwmon/hwmon* > "$hw/hwmon.txt" 2>&1
sysfs_values /sys/bus/iio/devices/* > "$hw/iio.txt" 2>&1
sysfs_values /sys/class/leds/* > "$hw/leds.txt" 2>&1
sysfs_values /sys/class/drm/card*-* > "$hw/drm.txt" 2>&1
# Power supplies without their serial numbers.
sysfs_values /sys/class/power_supply/* | grep -vi 'serial' > "$hw/power-supply.txt" 2>&1 || true
{
    printf 'platform_profile: %s\n' "$(cat /sys/firmware/acpi/platform_profile 2>/dev/null || echo '-')"
    printf 'platform_profile_choices: %s\n' "$(cat /sys/firmware/acpi/platform_profile_choices 2>/dev/null || echo '-')"
    sysfs_values /sys/class/platform-profile/*
} > "$hw/platform-profile.txt" 2>&1
# Firmware attributes (Lenovo WMI: PPT, fan, charge): some values are root only.
if compgen -G '/sys/class/firmware-attributes/*/attributes/*' >/dev/null; then
    run_to "$hw/firmware-attributes.txt" sudo sh -c '
        for d in /sys/class/firmware-attributes/*/attributes/*; do
            echo "== $d"
            for f in "$d"/*; do
                [ -f "$f" ] && printf "%s: %s\n" "${f##*/}" "$(head -c 300 "$f" 2>/dev/null | tr "\n" " ")"
            done
        done'
fi
run_to "$hw/aplay.txt" aplay -l
have pw-cli && run_to "$hw/pipewire-nodes.txt" pw-cli ls Node
have wpctl && run_to "$hw/wpctl.txt" wpctl status
# No prompts (the output goes into a file), no serial numbers.
if have fwupdmgr; then
    { fwupdmgr get-devices --no-unreported-check --no-metadata-check </dev/null 2>&1 || echo "[exit $?]"; } \
        | grep -av 'Serial Number' > "$hw/fwupd.txt" || true
fi
run_to "$hw/kernel-warnings.txt" sudo dmesg --level=emerg,alert,crit,err,warn
run_to "$hw/cmdline.txt" cat /proc/cmdline

if command -v virsh >/dev/null 2>&1; then
    echo "== virt"
    # On @vms like the disks, so a rollback of @ keeps them; a new install
    # does not. virsh define FILE and the nvram file bring a VM back.
    v=(sudo virsh -q -c qemu:///system)
    run_to "$dir/virt/list.txt" "${v[@]}" list --all
    run_to "$dir/virt/images.txt" ls -la /var/lib/libvirt/images
    while IFS= read -r vm; do
        [[ -n "$vm" ]] || continue
        "${v[@]}" dumpxml "$vm" > "$dir/virt/domain-$vm.xml"
    done < <("${v[@]}" list --all --name)
    # UEFI variables (boot entries, Secure Boot state) and TPM state of
    # each VM: a VM with BitLocker or measured boot needs both.
    sudo sh -c 'cp -a /var/lib/libvirt/qemu/nvram /var/lib/libvirt/swtpm "$1"/ 2>/dev/null; chown -R "$2" "$1"/nvram "$1"/swtpm 2>/dev/null' \
        sh "$dir/virt" "$(id -u):$(id -g)" || true
    while IFS= read -r net; do
        [[ -n "$net" ]] || continue
        "${v[@]}" net-dumpxml "$net" > "$dir/virt/network-$net.xml"
    done < <("${v[@]}" net-list --all --name)
    while IFS= read -r pool; do
        [[ -n "$pool" ]] || continue
        "${v[@]}" pool-dumpxml "$pool" > "$dir/virt/pool-$pool.xml"
    done < <("${v[@]}" pool-list --all --name)
fi

echo "== state"
tar -C "$state" --exclude=./baseline -cf - . | tar -C "$dir/state" -xf -

tar -C "$work" -czf "$archive" "$name"
echo
echo "Collected: $archive ($(du -h "$archive" | cut -f1))"
echo "Copy it off the laptop before reinstalling."
