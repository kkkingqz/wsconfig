#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=../lib/common.bash
. "$(dirname "$(readlink -f "$0")")/../lib/common.bash"
# Machine-local state, outside the checkout: the GNOME shortcuts saved before
# the first apply (restore target) and the xremap off flag.
state_dir="$WS_STATE/keyboard"
backup="$state_dir/gsettings-backup.tsv"
# home-manager enables xremap.service (keyboard/xremap.nix); this flag is
# its ConditionPathExists, so a restored profile stays off after a reboot.
xremap_off="$state_dir/xremap.disabled"

# The GNOME shortcuts of the profile: keyboard/keyboard.nix, built by
# ws switch (SCHEMA<TAB>KEY<TAB>VALUE<TAB>required|optional).
shortcuts="${WS_KEYBOARD_MANIFEST:-$HOME/.local/share/workstation/keyboard/keyboard.json}"

[[ -r "$shortcuts" ]] || { echo "ws-keyboard-apply: missing $shortcuts (run ws switch)" >&2; exit 66; }

schema_has_key() {
    local schema="$1" key="$2"
    gsettings range "$schema" "$key" >/dev/null 2>&1
}

# Declared shortcuts, optionally only one kind: required or optional.
shortcut_lines() {
    manifest_rows "$shortcuts" schema,key,value,kind shortcuts \
        | awk -F '\t' -v want="${1:-}" 'NF == 4 && (want == "" || $4 == want)'
}

backup_key() {
    local schema="$1" key="$2"
    if schema_has_key "$schema" "$key"; then
        printf '%s\t%s\t%s\n' "$schema" "$key" "$(gsettings get "$schema" "$key")"
    fi
}

backup_once() {
    mkdir -p "$state_dir"
    [[ -f "$backup" ]] && return

    local tmp="$backup.tmp"
    local schema key value kind
    : > "$tmp"
    while IFS=$'\t' read -r schema key value kind; do
        backup_key "$schema" "$key" >> "$tmp"
    done < <(shortcut_lines)
    mv "$tmp" "$backup"
    echo "Saved original GNOME shortcuts: $backup"
}

set_key() {
    local schema="$1" key="$2" value="$3"
    # A string key where the profile has an array (screensaver on some GNOME
    # builds): set its first element.
    if [[ "$value" == \[* ]] \
        && gsettings range "$schema" "$key" 2>/dev/null | head -n1 | grep -qx 'type s'; then
        value="$(sed -E "s/^\[('([^'\\\\]|\\\\.)*')?.*$/\1/" <<<"$value")"
        [[ -n "$value" ]] || value="''"
    fi
    if schema_has_key "$schema" "$key"; then
        gsettings set "$schema" "$key" "$value"
        printf 'set %-48s %s\n' "$schema:$key" "$value"
    else
        echo "warning: missing GSettings key $schema $key" >&2
    fi
}

xremap_disable() {
    mkdir -p "$(dirname "$xremap_off")"
    touch "$xremap_off"
    systemctl --user stop xremap.service >/dev/null 2>&1 || true
}

restore_gsettings() {
    [[ -f "$backup" ]] || { echo "backup does not exist: $backup" >&2; exit 1; }
    xremap_disable
    while IFS=$'\t' read -r schema key value; do
        [[ -n "$schema" && -n "$key" ]] || continue
        if schema_has_key "$schema" "$key"; then
            gsettings set "$schema" "$key" "$value"
            echo "restored $schema:$key"
        fi
    done < "$backup"
    echo "GNOME shortcuts restored. xremap service disabled."
}

if [[ "${1:-}" == "--restore" ]]; then
    restore_gsettings
    exit 0
fi

if [[ "${XDG_CURRENT_DESKTOP:-}" != *GNOME* ]]; then
    echo "ws-keyboard-apply: current desktop is not GNOME: ${XDG_CURRENT_DESKTOP:-unset}" >&2
    exit 69
fi

# Full preflight BEFORE changing GNOME shortcuts. Some bindings (notably
# Ctrl+Left/Right for workspaces) depend on xremap, so a partial apply is worse
# than no apply.
preflight_failed=false

# Require the exact GNOME schema keys used by this profile. Do not silently
# produce a partial profile on a different GNOME build.
while IFS=$'\t' read -r schema key _ _; do
    schema_has_key "$schema" "$key" || {
        echo "missing required GSettings key: $schema $key" >&2
        preflight_failed=true
    }
done < <(shortcut_lines required)

# A container host gets its keys over RDP, without /dev/input: no xremap,
# GNOME takes its part (keyboard/keyboard.nix, helpws plan-wsgnomebox).
rdp=false
[[ "$("$repo/bin/ws" fact boot 2>/dev/null)" != container ]] || rdp=true

if [[ "$rdp" == false ]]; then
    command -v xremap >/dev/null 2>&1 || { echo "xremap not found in PATH" >&2; preflight_failed=true; }
    systemctl --user cat xremap.service >/dev/null 2>&1 || { echo "xremap.service not installed; run ws switch" >&2; preflight_failed=true; }
    if ! id -nG | tr ' ' '\n' | grep -Fxq input; then
        # A group added by bootstrap.sh reaches GNOME only through a new systemd
        # user manager: a log out keeps the old one while another session (ssh)
        # of the user is open.
        if id -nG "$(id -un)" | tr ' ' '\n' | grep -Fxq input; then
            echo "user is in group input, this session is not yet: reboot (or end every session of the user)" >&2
        else
            echo "user is not in input group (bootstrap.sh adds it)" >&2
        fi
        preflight_failed=true
    fi
    [[ -e /dev/uinput && -w /dev/uinput ]] || { echo "/dev/uinput missing or not writable" >&2; preflight_failed=true; }
    busctl --user call org.gnome.Shell /com/k0kubun/Xremap com.k0kubun.Xremap WMClasses >/dev/null 2>&1 || {
        echo "GNOME xremap bridge unavailable" >&2
        preflight_failed=true
    }
fi
# Final profile depends on the repository-owned input-source/Smart Popup
# extensions plus Window Control and Tiling Assistant. On a fresh install the
# local extensions may require one logout/login before this preflight can pass.
command -v gdbus >/dev/null 2>&1 || {
    echo "gdbus not found" >&2
    preflight_failed=true
}
command -v gnome-extensions >/dev/null 2>&1 || {
    echo "gnome-extensions not found" >&2
    preflight_failed=true
}

if command -v gdbus >/dev/null 2>&1; then
    gdbus call --session         --dest org.gnome.Shell         --object-path /org/gnome/Shell/Extensions/WorkstationInputSource         --method org.gnome.Shell.Extensions.WorkstationInputSource.GetState         >/dev/null 2>&1 || {
            echo "workstation-input-source extension is not active; log out/in and rerun" >&2
            preflight_failed=true
        }
fi

extension_is_active() {
    gnome-extensions info "$1" 2>/dev/null         | grep -Eq 'State:[[:space:]]+ACTIVE|Enabled:[[:space:]]+Yes'
}

if command -v gnome-extensions >/dev/null 2>&1; then
    extension_is_active workstation-smart-popup@local || {
        echo "workstation-smart-popup extension is not active; log out/in and rerun" >&2
        preflight_failed=true
    }
    extension_is_active window-control@carlo9890.github.io || {
        echo "Window Control extension is not active" >&2
        preflight_failed=true
    }

    if ! extension_is_active tiling-assistant@ubuntu.com        && ! extension_is_active tiling-assistant@leleat-on-github; then
        echo "Tiling Assistant is not active" >&2
        preflight_failed=true
    fi
fi

if [[ "$preflight_failed" == true ]]; then
    echo >&2
    echo "No GNOME shortcuts were changed." >&2
    echo "Run: $repo/bin/ws-keyboard-status" >&2
    exit 69
fi

# Prove the service can actually start while GNOME still has its old bindings.
# If xremap/config/runtime is broken, exit without touching GNOME shortcuts.
if [[ "$rdp" == false ]]; then
    rm -f "$xremap_off"
    if ! systemctl --user restart xremap.service; then
        echo "xremap service failed to start; no GNOME shortcuts were changed." >&2
        exit 70
    fi
fi

backup_once

# From this point onward, applying GNOME settings is transactional. If any
# gsettings operation fails, restore the original snapshot and stop/disable
# xremap so we do not leave a half-applied keyboard profile behind.
apply_started=true
apply_succeeded=false

rollback_apply() {
    local rc="$?"

    if [[ "$apply_started" == true && "$apply_succeeded" != true ]]; then
        echo >&2
        echo "ws-keyboard-apply: apply failed; restoring original GNOME shortcuts" >&2

        while IFS=$'\t' read -r schema key value; do
            [[ -n "$schema" && -n "$key" ]] || continue
            if schema_has_key "$schema" "$key"; then
                gsettings set "$schema" "$key" "$value" >/dev/null 2>&1 || true
            fi
        done < "$backup"

        xremap_disable
        echo "ws-keyboard-apply: rollback completed" >&2
    fi

    exit "$rc"
}

trap rollback_apply EXIT

# The profile: keyboard/keyboard.nix (why each binding is there is
# commented there). Optional keys are set only where the schema has them.
while IFS=$'\t' read -r schema key value kind; do
    if [[ "$kind" == optional ]] && ! schema_has_key "$schema" "$key"; then
        continue
    fi
    set_key "$schema" "$key" "$value"
done < <(shortcut_lines)

apply_succeeded=true
trap - EXIT

if [[ "$rdp" == true ]]; then
    echo "GNOME shortcuts were applied (keys over RDP, no xremap)."
else
    echo "xremap service is active and GNOME shortcuts were applied."
fi
