def build_parser():
    p = argparse.ArgumentParser(
        prog="wsflatpak",
        description="Пользовательские Flatpak-приложения и их конфигурация в wsconfig.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Установка в домашний каталог:
  wsflatpak install org.videolan.VLC
  wsflatpak install --unmanaged org.gimp.GIMP
  wsflatpak install --remote flatpark com.anthropic.ClaudeDesktop
  ws switch && wsflatpak apply

Приложения и runtimes — обычно ~/.local/share/flatpak, данные — ~/.var/app/APP_ID.
Доступ к домашним файлам задаётся отдельно через filesystem/host.
install/manage/unmanage редактируют flatpak/apps.txt.
filesystem/host/env/talk и un… редактируют flatpak/overrides.txt.
ws switch собирает эти списки; apply применяет собранную конфигурацию.

Справка по команде: wsflatpak help install или wsflatpak install --help.
Подробное руководство: helpws flatpak / man ws-flatpak.
""",
    )
    sp = p.add_subparsers(dest="cmd", required=True, title="Команды", metavar="COMMAND")

    def command(name, **kwargs):
        detail = COMMAND_DETAILS.get(name)
        if name.removeprefix("un") in ("filesystem", "host", "env", "talk"):
            detail = OVERRIDE_HELP
        return sp.add_parser(
            name, help=COMMAND_HELP[name], description=COMMAND_HELP[name],
            epilog=detail, formatter_class=argparse.RawDescriptionHelpFormatter,
            **kwargs,
        )

    q = command("install")
    q.add_argument("--remote", default="flathub",
                   help="пользовательский remote (по умолчанию flathub)")
    q.add_argument("--unmanaged", action="store_true",
                   help="не добавлять приложение в flatpak/apps.txt")
    q.add_argument("app", metavar="APP", help="App ID, запрос Flatpak или полный ref")
    q.add_argument("extra", nargs=argparse.REMAINDER, metavar="ARG",
                   help="другие приложения, ветка или аргументы flatpak install")

    q = command("manage")
    q.add_argument("app", metavar="APP", help="установленное приложение")
    q.add_argument("remote", nargs="?", metavar="REMOTE", help="remote для apps.txt")

    q = command("unmanage")
    q.add_argument("app", metavar="APP", help="точный App ID из apps.txt")

    q = command("remove", aliases=["uninstall"])
    q.add_argument("--keep-data", action="store_true", help="сохранить данные приложения")
    q.add_argument("app", metavar="APP", help="установленное приложение")

    for name in ("permissions", "reset-permissions", "info"):
        q = command(name)
        q.add_argument("app", metavar="APP", help="ID, имя или часть имени приложения")

    for name, arg, detail in (
        ("filesystem", "SPEC", "каталог и режим: host, home:ro, xdg-download, /path:rw"),
        ("talk", "BUS", "имя D-Bus session bus, например org.freedesktop.Flatpak"),
    ):
        for cmd in (name, "un" + name):
            q = command(cmd)
            q.add_argument("app", metavar="APP", help="приложение")
            q.add_argument("value", metavar=arg, help=detail)
    for cmd in ("host", "unhost"):
        q = command(cmd)
        q.add_argument("app", metavar="APP", help="приложение")
    q = command("env")
    q.add_argument("app", metavar="APP", help="приложение")
    q.add_argument("key", metavar="KEY[=VALUE]", help="переменная или KEY=VALUE")
    q.add_argument("value", nargs="?", metavar="VALUE", help="значение переменной")
    q = command("unenv")
    q.add_argument("app", metavar="APP", help="приложение")
    q.add_argument("key", metavar="KEY", help="имя объявленной переменной")

    for name in DECLARE:
        q = command(name)
        q.add_argument("args", nargs="*", metavar="NAME URL", help="имя и URL remote")

    for name in ("update", "cleanup", "list", "search"):
        q = command(name)
        q.add_argument("args", nargs=argparse.REMAINDER, metavar="ARG",
                       help="аргументы соответствующей команды Flatpak")

    q = command("run")
    q.add_argument("--direct", action="store_true", help="запускать напрямую через flatpak run")
    q.add_argument("app", metavar="APP", help="установленное приложение")
    q.add_argument("args", nargs=argparse.REMAINDER, metavar="ARG", help="аргументы приложения")

    q = command("check")
    q.add_argument("--json", action="store_true", help="вывести результат в JSON")

    for name in ("status", "test", "apply"):
        command(name)

    q = command("help")
    q.add_argument("command", nargs="?", choices=tuple(sp.choices), metavar="COMMAND",
                   help="команда, для которой показать справку")
    q.set_defaults(help_parsers=sp.choices)
    return p


def main():
    parser = build_parser()
    ns, unknown = parser.parse_known_args()

    passthrough = {"update", "cleanup", "list", "search", "run", "install"}
    if unknown and ns.cmd not in passthrough:
        parser.error("unrecognized arguments: " + " ".join(unknown))

    if hasattr(ns, "extra"):
        ns.extra += unknown
    elif hasattr(ns, "args"):
        ns.args += unknown

    if ns.cmd == "help":
        target = ns.help_parsers.get(ns.command, parser)
        target.print_help()
    elif ns.cmd == "install":
        cmd_install(ns)
    elif ns.cmd == "manage":
        need_flatpak()
        app = resolve_user_app(ns.app)
        list_add(app, ns.remote or installed_origin(app) or "flathub")
    elif ns.cmd == "unmanage":
        list_remove(ns.app)
    elif ns.cmd in DECLARE:
        cmd_declare(ns.cmd, ns.args)
    elif ns.cmd.removeprefix("un") in ("host", "filesystem", "env", "talk"):
        cmd_override(ns)
    elif ns.cmd in ("remove", "uninstall"):
        cmd_remove(ns)
    elif ns.cmd == "permissions":
        cmd_permissions(ns.app)
    elif ns.cmd == "reset-permissions":
        cmd_reset_permissions(ns.app)
    elif ns.cmd == "update":
        need_flatpak()
        run(["flatpak", "update", "--user"] + ns.args)
    elif ns.cmd == "cleanup":
        need_flatpak()
        run(["flatpak", "uninstall", "--user", "--unused"] + ns.args)
    elif ns.cmd == "list":
        need_flatpak()
        run(["flatpak", "list", "--user"] + ns.args)
    elif ns.cmd == "search":
        need_flatpak()
        run(["flatpak", "search"] + ns.args)
    elif ns.cmd == "info":
        need_flatpak()
        app = resolve_user_app(ns.app)
        run(["flatpak", "info", "--user", app])
    elif ns.cmd == "run":
        cmd_run(ns)
    elif ns.cmd == "status":
        cmd_status()
    elif ns.cmd == "check":
        raise SystemExit(cmd_check(ns.json))
    elif ns.cmd == "test":
        raise SystemExit(cmd_test())
    elif ns.cmd == "apply":
        raise SystemExit(cmd_apply())


if __name__ == "__main__":
    main()
