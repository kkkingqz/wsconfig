#!/usr/bin/env python3
import argparse
import configparser
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

# Declarations live in flatpak/flatpak.nix; home-manager builds them into
# ~/.local/share/workstation/flatpak, which wsflatpak reads. The managed app
# list is flatpak/apps.txt in the checkout: install, manage and unmanage edit
# it; the overrides are flatpak/overrides.txt: filesystem, host, env, talk and
# their un… edit it. `ws switch` builds both and commits them.
SOURCE = "flatpak/flatpak.nix"
REPO = Path(
    os.environ.get("WSCONFIG")
    or Path(os.path.realpath(__file__)).parent.parent
)
APPS_LIST = REPO / "flatpak/apps.txt"
OVERRIDES_LIST = REPO / "flatpak/overrides.txt"
OVERRIDE_KINDS = ("filesystem", "env", "talk")
CFG = Path(
    os.environ.get(
        "WSFLATPAK_CONFIG",
        Path.home() / ".local/share/workstation/flatpak",
    )
)
APPS = CFG / "apps.conf"
REMOTES = CFG / "remotes.conf"
OVERRIDES = CFG / "overrides"
DESKTOP_OVERRIDES = CFG / "desktop"
USER_APPLICATIONS = Path.home() / ".local/share/applications"


def run(args, check=True, capture=False):
    p = subprocess.run(args, text=True, capture_output=capture)
    if check and p.returncode:
        raise SystemExit(p.returncode)
    return p


def need_flatpak():
    if not shutil.which("flatpak"):
        raise SystemExit("wsflatpak: flatpak is not installed")


def ensure_cfg():
    if not APPS.is_file() or not REMOTES.is_file():
        raise SystemExit(
            f"wsflatpak: {CFG} is missing; run `ws switch` "
            f"(built from {SOURCE})"
        )


def declare_hint(action, snippet):
    raise SystemExit(
        f"wsflatpak: Flatpak state is declared in {SOURCE}.\n"
        f"{action}:\n\n    {snippet}\n\n"
        "then: ws switch && wsflatpak apply"
    )


def parse_managed_line(raw):
    line = raw.split("#", 1)[0].strip()
    if not line:
        return None

    parts = line.split()

    if len(parts) == 1:
        # Backward compatibility with the original one-column format.
        return "flathub", parts[0]

    if len(parts) == 2:
        return parts[0], parts[1]

    raise SystemExit(f"wsflatpak: invalid managed app line: {raw}")


def managed_entries():
    ensure_cfg()

    out = []
    seen = {}

    for raw in APPS.read_text().splitlines():
        entry = parse_managed_line(raw)
        if entry is None:
            continue

        remote, app = entry

        if app in seen:
            if seen[app] != remote:
                raise SystemExit(
                    f"wsflatpak: app {app} is assigned to multiple remotes: "
                    f"{seen[app]}, {remote}"
                )
            continue

        seen[app] = remote
        out.append((remote, app))

    return out


def managed_apps():
    return [app for remote, app in managed_entries()]


def listed_apps():
    out = {}
    for raw in APPS_LIST.read_text().splitlines():
        entry = parse_managed_line(raw)
        if entry:
            out[entry[1]] = entry[0]
    return out


def list_add(app, remote):
    if app in listed_apps():
        print(f"Already in {APPS_LIST}: {app}")
        return

    text = APPS_LIST.read_text()
    if text and not text.endswith("\n"):
        text += "\n"
    APPS_LIST.write_text(text + f"{remote} {app}\n")
    print(
        f"Added to {APPS_LIST}: {remote} {app}\n"
        "then: ws switch (commits it)"
    )


def list_remove(app):
    lines = APPS_LIST.read_text().splitlines(keepends=True)
    keep = [
        x for x in lines
        if (parse_managed_line(x) or (None, None))[1] != app
    ]

    if len(keep) == len(lines):
        raise SystemExit(f"wsflatpak: {app} is not in {APPS_LIST}")

    APPS_LIST.write_text("".join(keep))
    print(
        f"Removed from {APPS_LIST}: {app}\n"
        "then: ws switch (commits it)"
    )

    if app in listed_override_apps():
        print(f"NOTE: {app} still has overrides in {OVERRIDES_LIST}")

    if (DESKTOP_OVERRIDES / f"{app}.desktop").exists():
        print(f"NOTE: {app} still has a desktop file in {SOURCE}")


def parse_override_line(raw):
    line = raw.split("#", 1)[0].strip()
    if not line:
        return None

    parts = line.split()

    if len(parts) != 3 or parts[1] not in OVERRIDE_KINDS:
        raise SystemExit(
            f"wsflatpak: invalid line in {OVERRIDES_LIST}: {raw.rstrip()}"
        )

    return tuple(parts)


def fs_spec(spec):
    # Flatpak stores SPEC:rw as SPEC (read-write is the default).
    return spec.removesuffix(":rw")


def override_key(entry):
    # An env line is keyed by its name: a new value replaces the old one.
    app, kind, value = entry
    if kind == "env":
        return app, kind, value.split("=", 1)[0]
    if kind == "filesystem":
        # Flatpak keeps one mode per path; changing ro/rw/create replaces it.
        for mode in (":ro", ":rw", ":create"):
            if value.endswith(mode):
                value = value[:-len(mode)]
                break
        return app, kind, value
    return app, kind, value


def listed_override_apps():
    return {
        e[0] for e in map(parse_override_line,
                          OVERRIDES_LIST.read_text().splitlines())
        if e
    }


def override_app(query):
    # un… also works for an app that is no longer installed.
    if query in listed_override_apps():
        return query

    return resolve_user_app(query)


def overrides_add(entry):
    lines = OVERRIDES_LIST.read_text().splitlines(keepends=True)
    parsed = [parse_override_line(x) for x in lines]
    text = " ".join(entry)

    same = [
        i for i, e in enumerate(parsed)
        if e and override_key(e) == override_key(entry)
    ]
    if len(same) == 1 and parsed[same[0]] == entry:
        print(f"Already in {OVERRIDES_LIST}: {text}")
        return
    of_app = [i for i, e in enumerate(parsed) if e and e[0] == entry[0]]

    if lines and not lines[-1].endswith("\n"):
        lines[-1] += "\n"

    if same:
        lines[same[0]] = text + "\n"
        for index in reversed(same[1:]):
            del lines[index]
        action = "Replaced in"
    elif of_app:
        # Next to the app's other lines.
        lines.insert(of_app[-1] + 1, text + "\n")
        action = "Added to"
    else:
        if lines and lines[-1].strip():
            lines.append("\n")
        lines.append(text + "\n")
        action = "Added to"

    OVERRIDES_LIST.write_text("".join(lines))
    print(
        f"{action} {OVERRIDES_LIST}: {text}\n"
        "then: ws switch (commits it) && wsflatpak apply"
    )


def overrides_remove(key):
    key = override_key(key)
    lines = OVERRIDES_LIST.read_text().splitlines(keepends=True)
    keep = [
        x for x in lines
        if not (e := parse_override_line(x)) or override_key(e) != key
    ]

    if len(keep) == len(lines):
        raise SystemExit(
            f"wsflatpak: not in {OVERRIDES_LIST}: {' '.join(key)}"
        )

    OVERRIDES_LIST.write_text("".join(keep))
    print(
        f"Removed from {OVERRIDES_LIST}: {' '.join(key)}\n"
        "then: ws switch (commits it) && wsflatpak apply"
    )


def cmd_override(ns):
    need_flatpak()
    remove = ns.cmd.startswith("un")
    kind = ns.cmd[2:] if remove else ns.cmd
    app = override_app(ns.app) if remove else resolve_user_app(ns.app)

    if kind == "host":
        kind, value = "filesystem", "host"
    elif kind == "env" and not remove:
        if ns.value is not None:
            value = f"{ns.key}={ns.value}"
        elif "=" in ns.key:
            value = ns.key
        else:
            raise SystemExit("wsflatpak: env needs KEY VALUE or KEY=VALUE")
    else:
        value = ns.key if kind == "env" else ns.value

    if not value or any(c.isspace() or c == "#" for c in value):
        raise SystemExit(
            f"wsflatpak: {kind} value must be one word without #: {value!r}"
        )

    if kind == "filesystem":
        value = fs_spec(value)

    if remove:
        overrides_remove((app, kind, value))
    else:
        overrides_add((app, kind, value))


def managed_remote(app):
    for remote, candidate in managed_entries():
        if candidate == app:
            return remote

    return None

def resolve_user_app(query):
    # Resolve full App ID, display name, final component, or unique substring.
    need_flatpak()

    p = run(
        [
            "flatpak",
            "list",
            "--user",
            "--app",
            "--columns=application,name",
        ],
        check=False,
        capture=True,
    )

    q = query.casefold()
    rows = []

    for raw in p.stdout.splitlines():
        if not raw.strip():
            continue

        parts = raw.split("	", 1)
        app_id = parts[0].strip()
        name = parts[1].strip() if len(parts) > 1 else ""
        short = app_id.rsplit(".", 1)[-1]

        rows.append((app_id, name, short))

    exact = []

    for app_id, name, short in rows:
        aliases = {
            app_id.casefold(),
            short.casefold(),
        }

        if name:
            aliases.add(name.casefold())

        if q in aliases:
            exact.append(app_id)

    exact = list(dict.fromkeys(exact))

    if len(exact) == 1:
        return exact[0]

    if len(exact) > 1:
        raise SystemExit(
            "wsflatpak: ambiguous app name "
            + query
            + ": "
            + ", ".join(exact)
        )

    fuzzy = []

    for app_id, name, short in rows:
        fields = (
            app_id.casefold(),
            name.casefold(),
            short.casefold(),
        )

        if any(q in field for field in fields):
            fuzzy.append(app_id)

    fuzzy = list(dict.fromkeys(fuzzy))

    if len(fuzzy) == 1:
        return fuzzy[0]

    if len(fuzzy) > 1:
        raise SystemExit(
            "wsflatpak: ambiguous app name "
            + query
            + ": "
            + ", ".join(fuzzy)
        )

    raise SystemExit(
        f"wsflatpak: {query} is not installed in user scope"
    )


def is_managed(app):
    return app in managed_apps()


def installed_user(app):
    need_flatpak()
    return any(ref == app or ref.split("/")[1] == app for ref in user_app_refs())


def installed_origin(app):
    need_flatpak()

    if "/" not in app:
        refs = [ref for ref in user_app_refs() if ref.split("/")[1] == app]
        origins = {installed_origin(ref) for ref in refs}
        return origins.pop() if len(origins) == 1 else None

    p = run(
        ["flatpak", "info", "--user", "--show-origin", app],
        check=False,
        capture=True,
    )

    if p.returncode != 0:
        return None

    origin = p.stdout.strip()
    return origin or None


def ensure_user_runtime(app, install_args=()):
    # --user install may reuse a system runtime. Install the exact runtime
    # ref explicitly so the application also has its dependency in home.
    runtime = run(
        ["flatpak", "info", "--user", "--show-runtime", app],
        capture=True,
    ).stdout.strip()
    if not runtime:
        raise SystemExit(f"wsflatpak: could not determine runtime for {app}")

    ref = f"runtime/{runtime}"
    if run(
        ["flatpak", "info", "--user", ref], check=False, capture=True,
    ).returncode == 0:
        return

    # Prefer the app's origin, then search other user remotes. Supplying the
    # remote avoids Flatpak's selection prompt when several provide the ref.
    remotes = run(
        ["flatpak", "remotes", "--user", "--columns=name"], capture=True,
    ).stdout.splitlines()
    origin = installed_origin(app)
    candidates = sorted({r.strip() for r in remotes if r.strip()})
    if origin in candidates:
        candidates.remove(origin)
        candidates.insert(0, origin)
    for remote in candidates:
        if run(
            ["flatpak", "remote-info", "--user", remote, ref],
            check=False, capture=True,
        ).returncode == 0:
            break
    else:
        raise SystemExit(
            f"wsflatpak: no user remote provides runtime {runtime} for {app}"
        )

    print(f"Installing user runtime for {app}: {remote} {runtime}")
    run(["flatpak", "install", "--user", "--no-auto-pin"]
        + list(install_args) + [remote, ref])
    run(["flatpak", "info", "--user", ref], capture=True)


def override_file(app):
    return OVERRIDES / f"{app}.conf"


def read_override_config(app):
    path = override_file(app)
    cp = configparser.ConfigParser(interpolation=None)
    cp.optionxform = str

    if path.exists():
        cp.read(path)

    return cp



def read_managed_filesystems(app):
    cp = read_override_config(app)
    value = cp.get("Context", "filesystems", fallback="")
    return [fs_spec(x) for x in value.split(";") if x]


def read_managed_environment(app):
    cp = read_override_config(app)

    if not cp.has_section("Environment"):
        return {}

    return dict(cp.items("Environment"))

def read_managed_session_bus(app):
    cp = read_override_config(app)

    if not cp.has_section("Session Bus Policy"):
        return {}

    return dict(cp.items("Session Bus Policy"))



def runtime_session_bus(app):
    cp = runtime_override_config(app)

    if not cp.has_section("Session Bus Policy"):
        return {}

    return dict(cp.items("Session Bus Policy"))


def runtime_override(app=None):
    need_flatpak()
    cmd = ["flatpak", "override", "--user", "--show"]

    if app:
        cmd.append(app)

    return run(cmd, check=False, capture=True).stdout.strip()


def runtime_override_config(app):
    text = runtime_override(app)
    cp = configparser.ConfigParser(interpolation=None)
    cp.optionxform = str

    if text:
        cp.read_string(text)

    return cp


def runtime_filesystems(app):
    cp = runtime_override_config(app)
    value = cp.get("Context", "filesystems", fallback="")
    return [fs_spec(x) for x in value.split(";") if x]


def runtime_host(app):
    cp = runtime_override_config(app)
    value = cp.get("Context", "filesystems", fallback="")
    return "host" in [x for x in value.split(";") if x]


def runtime_environment(app):
    cp = runtime_override_config(app)

    if not cp.has_section("Environment"):
        return {}

    return dict(cp.items("Environment"))


def managed_host(app):
    return "host" in read_managed_filesystems(app)



def apply_override(app):
    need_flatpak()

    run(
        ["flatpak", "override", "--user", "--reset", app],
        check=False,
    )

    for fs in read_managed_filesystems(app):
        run(
            [
                "flatpak",
                "override",
                "--user",
                f"--filesystem={fs}",
                app,
            ]
        )

    for key, value in read_managed_environment(app).items():
        run(
            [
                "flatpak",
                "override",
                "--user",
                f"--env={key}={value}",
                app,
            ]
        )
    for name, policy in read_managed_session_bus(app).items():
        if policy != "talk":
            raise SystemExit(
                f"wsflatpak: unsupported session bus policy: "
                f"{name}={policy}"
            )

        run(
            [
                "flatpak",
                "override",
                "--user",
                f"--talk-name={name}",
                app,
            ]
        )



def cmd_install(ns):
    need_flatpak()

    remotes = {
        x.strip()
        for x in run(
            ["flatpak", "remotes", "--user", "--columns=name"],
            check=False,
            capture=True,
        ).stdout.splitlines()
        if x.strip()
    }

    if ns.remote not in remotes:
        raise SystemExit(
            f"wsflatpak: user remote not configured: {ns.remote}"
        )

    before = set(user_app_refs())

    cmd = [
        "flatpak",
        "install",
        "--user",
        ns.remote,
        ns.app,
    ] + ns.extra

    run(cmd)

    after = set(user_app_refs())
    added = sorted(after - before)

    # Preserve branch and architecture for runtime queries. Additional refs
    # can be installed through extra; include every newly installed ref.
    query = ns.app.removeprefix("app/").split("/", 1)[0]
    installed_ids = {ref.split("/")[1] for ref in after}
    added_ids = {ref.split("/")[1] for ref in added}
    if query in installed_ids:
        app = query
    elif len(added_ids) == 1:
        app = next(iter(added_ids))
    else:
        app = resolve_user_app(query)
    targets = set(added)
    requested_ids = {
        arg.removeprefix("app/").split("/", 1)[0]
        for arg in ns.extra if not arg.startswith("-")
    }
    for ref in after:
        app_id = ref.split("/")[1]
        if app_id == app or app_id in requested_ids:
            targets.add(ref)

    install_args = [
        arg for arg in ns.extra
        if arg in ("-y", "--assumeyes", "--noninteractive")
    ]
    for ref in sorted(targets):
        ensure_user_runtime(ref, install_args)

    for app in sorted({ref.split("/")[1] for ref in targets}):
        if is_managed(app):
            apply_override(app)
        elif ns.unmanaged:
            print(f"\nNot managed (--unmanaged): {app}")
        else:
            print()
            list_add(app, ns.remote)

def cmd_remove(ns):
    need_flatpak()
    app = resolve_user_app(ns.app)

    if is_managed(app):
        raise SystemExit(
            f"wsflatpak: {app} is managed; `wsflatpak unmanage {app}`, "
            "`ws switch`, then remove again"
        )

    cmd = ["flatpak", "uninstall", "--user"]

    if not ns.keep_data:
        cmd.append("--delete-data")

    cmd.append(app)
    run(cmd)



def cmd_reset_permissions(app):
    need_flatpak()
    app = resolve_user_app(app)

    run(["flatpak", "override", "--user", "--reset", app], check=False)

    # Portal permissions are a separate store. Failure here is non-fatal
    # because an application may have no portal permissions at all.
    run(["flatpak", "permission-reset", app], check=False)

    print(f"Overrides and portal permissions reset: {app}")

    if override_file(app).exists():
        print(
            f"NOTE: {app} has declared overrides in {OVERRIDES_LIST}; "
            "`wsflatpak apply` sets them again"
        )


def cmd_permissions(app):
    need_flatpak()
    app = resolve_user_app(app)

    print("===== APP =====")
    print(app)

    print("\n===== EFFECTIVE PERMISSIONS =====")
    p = run(
        ["flatpak", "info", "--user", "--show-permissions", app],
        check=False,
        capture=True,
    )
    print(p.stdout.strip() or "(not installed)")

    print("\n===== RUNTIME USER OVERRIDE =====")
    print(runtime_override(app) or "(none)")

    print("\n===== MANAGED WORKSTATION OVERRIDE =====")
    path = override_file(app)
    print(path.read_text().rstrip() if path.exists() else "(none)")

    print("\n===== EFFECTIVE HOST ACCESS =====")
    declared = p.stdout
    declared_host = False

    for line in declared.splitlines():
        if line.startswith("filesystems="):
            values = [
                x for x in line.split("=", 1)[1].split(";") if x
            ]
            declared_host = "host" in values
            break

    print("YES" if declared_host else "NO")

    print("\n===== USER OVERRIDE HOST ACCESS =====")
    if runtime_host(app):
        print("YES (tracked)" if managed_host(app) else "YES (UNTRACKED)")
    else:
        print("NO")


def user_apps():
    p = run(
        ["flatpak", "list", "--user", "--app", "--columns=application"],
        check=False,
        capture=True,
    )
    return [x.strip() for x in p.stdout.splitlines() if x.strip()]


def user_app_refs():
    # Flatpak's ref column is ID/ARCH/BRANCH; add the kind explicitly.
    output = run(
        ["flatpak", "list", "--user", "--app", "--columns=ref"],
        capture=True,
    ).stdout.splitlines()
    return [f"app/{ref.strip()}" for ref in output if ref.strip()]


def cmd_run(ns):
    need_flatpak()
    app = resolve_user_app(ns.app)

    desktop = (
        Path.home()
        / ".local/share/flatpak/exports/share/applications"
        / f"{app}.desktop"
    )

    if not ns.direct and not ns.args and desktop.exists():
        subprocess.Popen(
            ["gtk-launch", app],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return

    run(["flatpak", "run", app] + ns.args)


def managed_desktop_entries():
    ensure_cfg()
    return sorted(
        path
        for path in DESKTOP_OVERRIDES.glob("*.desktop")
        if path.is_file()
    )


def desktop_override_destination(source):
    return USER_APPLICATIONS / source.name


def desktop_override_ok(source):
    destination = desktop_override_destination(source)

    if not destination.is_symlink():
        return False

    return destination.resolve() == source.resolve()



def cmd_status():
    ensure_cfg()

    print("===== FLATPAK =====")
    if not shutil.which("flatpak"):
        print("not installed")
        return

    run(["flatpak", "--version"])

    blocks = [
        (
            "USER REMOTES",
            ["flatpak", "remotes", "--user", "--columns=name,url"],
        ),
        (
            "SYSTEM REMOTES",
            ["flatpak", "remotes", "--system", "--columns=name,url"],
        ),
        (
            "USER APPS",
            [
                "flatpak",
                "list",
                "--user",
                "--app",
                "--columns=application,name,origin",
            ],
        ),
        (
            "SYSTEM REFS",
            ["flatpak", "list", "--system", "--columns=application,ref"],
        ),
    ]

    for title, cmd in blocks:
        print(f"\n===== {title} =====")
        p = run(cmd, check=False, capture=True)
        print(p.stdout.rstrip() or "(none)")

    print("\n===== MANAGED APPS =====")
    entries = [f"{remote} {app}" for remote, app in managed_entries()]
    print("\n".join(entries) or "(none)")

    print("\n===== MANAGED OVERRIDES =====")
    files = sorted(x.name for x in OVERRIDES.glob("*.conf"))
    print("\n".join(files) or "(none)")

    print("\n===== GLOBAL USER OVERRIDE =====")
    print(runtime_override() or "(none)")

def cmd_check(json_mode=False):
    """Result contract of ws check (--json), as lib/check.bash: one object
    {"status", "passes", "warnings", "failures", "messages"} on stdout."""
    ensure_cfg()

    counts = {"pass": 0, "warn": 0, "fail": 0}
    messages = []

    def report(level, text):
        counts[level] += 1
        messages.append({"level": level, "text": text})
        if not json_mode:
            print(f"  {level.upper():<5} {text}")

    def passed(text):
        report("pass", text)

    def warn(text):
        report("warn", text)

    def fail(text):
        report("fail", text)

    def finish():
        status = "fail" if counts["fail"] else "warn" if counts["warn"] else "pass"
        if json_mode:
            print(json.dumps({
                "status": status, "passes": counts["pass"],
                "warnings": counts["warn"], "failures": counts["fail"],
                "messages": messages,
            }))
        else:
            print(f"\n  PASS={counts['pass']} WARN={counts['warn']} FAIL={counts['fail']}")
        return 1 if counts["fail"] else 0

    if not shutil.which("flatpak"):
        fail("flatpak installed")
        return finish()

    passed("flatpak installed")

    actual_remotes = {
        x.strip()
        for x in run(
            ["flatpak", "remotes", "--user", "--columns=name"],
            check=False,
            capture=True,
        ).stdout.splitlines()
        if x.strip()
    }

    expected_remotes = {name for name, url in parse_remotes()}

    for name in sorted(expected_remotes):
        if name in actual_remotes:
            passed(f"managed user remote configured: {name}")
        else:
            fail(f"managed user remote missing: {name}")

    for name in sorted(actual_remotes - expected_remotes):
        warn(f"unmanaged user remote: {name}")

    sr = run(
        ["flatpak", "remotes", "--system", "--columns=name"],
        check=False,
        capture=True,
    ).stdout.strip()

    if sr:
        fail("system remotes must be empty")
    else:
        passed("system remotes empty")

    refs = run(
        ["flatpak", "list", "--system", "--columns=ref"],
        check=False,
        capture=True,
    ).stdout.strip()

    if refs:
        fail("system installation contains refs")
    else:
        passed("system installation empty")

    global_text = runtime_override()
    global_host = any(
        line.startswith("filesystems=")
        and "host" in [
            x for x in line.split("=", 1)[1].split(";") if x
        ]
        for line in global_text.splitlines()
    )

    if global_host:
        fail("global filesystem=host override is forbidden")
    else:
        passed("no global filesystem=host override")

    for remote, app in managed_entries():
        if remote not in expected_remotes:
            fail(f"managed app remote is not declared: {app}: {remote}")

        if not installed_user(app):
            fail(f"managed app missing: {app}")
            continue

        passed(f"managed app installed: {app}")

        origin = installed_origin(app)

        if origin == remote:
            passed(f"managed app origin tracked: {app}: {remote}")
        else:
            fail(
                f"managed app origin mismatch: {app}: "
                f"expected={remote} actual={origin or '(unknown)'}"
            )

    if APPS_LIST.is_file():
        listed = sorted(f"{r} {a}" for a, r in listed_apps().items())
        built = sorted(f"{r} {a}" for r, a in managed_entries())
        if listed == built:
            passed(f"{APPS_LIST.name} built")
        else:
            warn(f"{APPS_LIST} differs from the build; run ws switch")

    for app in user_apps():
        if not is_managed(app):
            warn(f"unmanaged user app: {app}")

        if runtime_host(app):
            if managed_host(app):
                passed(f"filesystem=host tracked: {app}")
            else:
                fail(f"untracked filesystem=host: {app}")

    # A managed app with no .conf expects no user overrides. Include it so
    # removing the last declaration does not hide leftover runtime grants.
    override_apps = sorted(
        {app.removeprefix("app/").split("/", 1)[0] for app in managed_apps()}
        | {path.stem for path in OVERRIDES.glob("*.conf")}
    )

    for app in override_apps:

        if not installed_user(app):
            continue

        expected_fs = set(read_managed_filesystems(app)) - {"host"}
        actual_fs = set(runtime_filesystems(app)) - {"host"}

        for spec in sorted(expected_fs):
            if spec in actual_fs:
                passed(f"filesystem permission tracked: {app}: {spec}")
            else:
                fail(f"filesystem permission not applied: {app}: {spec}")

        for spec in sorted(actual_fs - expected_fs):
            fail(f"untracked filesystem override: {app}: {spec}")

    for app in override_apps:

        if not installed_user(app):
            if override_file(app).exists():
                warn(f"managed override for non-installed app: {app}")
            continue

        if managed_host(app) and not runtime_host(app):
            fail(f"managed override not applied: {app}")

        expected_env = read_managed_environment(app)
        actual_env = runtime_environment(app)

        for key, value in expected_env.items():
            if actual_env.get(key) == value:
                passed(f"environment tracked: {app}: {key}={value}")
            else:
                fail(
                    f"environment override not applied: "
                    f"{app}: {key}={value}"
                )

        for key, value in actual_env.items():
            if expected_env.get(key) != value:
                fail(
                    f"untracked environment override: "
                    f"{app}: {key}={value}"
                )

    for app in override_apps:

        if not installed_user(app):
            continue

        expected_bus = read_managed_session_bus(app)
        actual_bus = runtime_session_bus(app)

        for name, policy in expected_bus.items():
            if actual_bus.get(name) == policy:
                passed(
                    f"session-bus permission tracked: "
                    f"{app}: {name}={policy}"
                )
            else:
                fail(
                    f"session-bus permission not applied: "
                    f"{app}: {name}={policy}"
                )

        for name, policy in actual_bus.items():
            if expected_bus.get(name) != policy:
                fail(
                    f"untracked session-bus override: "
                    f"{app}: {name}={policy}"
                )

    for source in managed_desktop_entries():
        if desktop_override_ok(source):
            passed(
                f"managed desktop override applied: {source.name}"
            )
        else:
            fail(
                f"managed desktop override not applied: {source.name} "
                "(run ws switch)"
            )

    return finish()

def cmd_test():
    need_flatpak()

    failures = 0

    print("===== SESSION =====")
    if os.environ.get("XDG_SESSION_TYPE") == "wayland":
        print("PASS  Wayland session")
    else:
        print(
            "WARN  XDG_SESSION_TYPE="
            + os.environ.get("XDG_SESSION_TYPE", "unset")
        )

    print("\n===== PORTALS / MEDIA =====")

    units = [
        "xdg-desktop-portal.service",
        "xdg-desktop-portal-gnome.service",
        "pipewire.service",
        "wireplumber.service",
    ]

    for unit in units:
        ok = run(
            ["systemctl", "--user", "is-active", "--quiet", unit],
            check=False,
        ).returncode == 0

        print(("PASS  " if ok else "FAIL  ") + unit)
        if not ok:
            failures += 1

    pulse = any(
        run(
            ["systemctl", "--user", "is-active", "--quiet", unit],
            check=False,
        ).returncode == 0
        for unit in ("pipewire-pulse.service", "pipewire-pulse.socket")
    )

    print(("PASS  " if pulse else "FAIL  ") + "PipeWire Pulse")
    if not pulse:
        failures += 1

    print("\n===== POLICY =====")
    if cmd_check() != 0:
        failures += 1

    print("\n===== MANUAL APP CHECKLIST =====")
    print(
        "Recheck after major Flatpak / desktop changes:\n"
        "  - native Wayland / correct 1.5 scale\n"
        "  - open/save portal\n"
        "  - clipboard\n"
        "  - Nautilus drag-and-drop\n"
        "  - notifications\n"
        "  - ScreenCast chooser where applicable\n"
        "  - URI/default-app handling"
    )

    return 1 if failures else 0


def parse_remotes():
    ensure_cfg()

    out = []
    for raw in REMOTES.read_text().splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue

        parts = line.split(None, 1)
        if len(parts) != 2:
            raise SystemExit(f"wsflatpak: invalid remote line: {raw}")

        out.append(parts)

    return out


def cmd_apply():
    need_flatpak()

    for name, url in parse_remotes():
        run(
            [
                "flatpak",
                "remote-add",
                "--user",
                "--if-not-exists",
                name,
                url,
            ]
        )

    for remote, app in managed_entries():
        if not installed_user(app):
            print(f"Installing managed app: {remote} {app}")
            run(
                [
                    "flatpak",
                    "install",
                    "--user",
                    "-y",
                    remote,
                    app,
                ]
            )

        for ref in user_app_refs():
            if ref.split("/")[1] == app:
                ensure_user_runtime(ref, ["-y"])
        apply_override(app)

    for path in OVERRIDES.glob("*.conf"):
        app = path.stem

        if installed_user(app):
            apply_override(app)
        else:
            print(
                f"WARNING: override exists for non-installed app: {app}",
                file=sys.stderr,
            )

    print("\nApply complete. Running policy check...")
    return cmd_check()

DECLARE = {
    "remote-add": ("Add to remotes", '{0} = "{1}";'),
}


def cmd_declare(cmd, args):
    action, snippet = DECLARE[cmd]
    args = list(args) + ["..."] * 3
    declare_hint(action, snippet.format(*args))


