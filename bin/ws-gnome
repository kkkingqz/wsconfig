#!/usr/bin/env bash
set -eu

# shellcheck source=../lib/common.bash
. "$(dirname "$(readlink -f "$0")")/../lib/common.bash"
cmd="${1:-status}"
shift 2>/dev/null || true

case "$cmd" in
    status) exec "$repo/bin/ws-gnome-status" "$@" ;;
    check) exec "$repo/bin/ws-gnome-check" "$@" ;;
    test) exec "$repo/bin/ws-gnome-test" "$@" ;;
    -h|--help|help)
        cat <<'USAGE'
Usage: ws-gnome [status|check|test]

  status     read-only GNOME inventory
  check      compare appearance/Dock state with gnome/gnome.nix
  test       final read-only GNOME host smoke-test

The profile is applied by `ws switch` (gnome/gnome.nix).
USAGE
        ;;
    *)
        echo "ws-gnome: unknown command: $cmd" >&2
        exit 64
        ;;
esac
