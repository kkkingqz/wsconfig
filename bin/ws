#!/usr/bin/env bash
set -euo pipefail

# Entry point of the Nix layer (helpws history-nix). Runs as the
# desktop user and calls sudo itself where needed: `sudo ws` would not find
# Nix, secure_path does not contain the Nix profile.

repo="${WSCONFIG:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"

usage() {
    cat <<'USAGE'
Usage:
  ws switch [HOME-MANAGER-ARG...]
  ws diff
  ws apply [STEP...]
  ws update [STEP...]
  ws check [-v] | ws check apt|repo|home|virt [--json]
  ws system diff|check [--json]|apply|manifest|tree
  ws baseline capture|diff|list ...
  ws checkpoint create|list|show|diff|remove ...
  ws collect [--no-firmware] [ARCHIVE]
  ws backup [plan|status|list|check|send|restore-test|recovery-export ...]
  ws host
  ws fact NAME
  ws news

switch    home-manager switch for this user and host (pinned by flake.lock);
          after a successful switch commits flatpak/apps.txt,
          flatpak/overrides.txt and distrobox/hosts.txt if they changed
news      home-manager news of this flake (switch does not notify about them)
diff      build the home generation without activating it and show the
          package difference against the current one (nvd)
apply     run the layer owners in order, as by hand (no sudo steps):
            extensions  ws-keyboard-install-extensions
            tiling      ws-tiling-apply
            keyboard    ws-keyboard-apply
            flatpak     wsflatpak apply
            distrobox   wsbox apply
          a step whose preflight fails (exit 69: e.g. new extensions need a
          logout/login) is reported at the end; on a new machine:
          ws apply, log out and in, ws apply
update    bring everything that is not pinned to the latest version, in order:
            apt         sudo apt update, sudo apt full-upgrade (held
                        packages such as linux-t2 stay)
            nix         nix flake update (nixpkgs, home-manager), the
                        package difference (nvd), switch; commit flake.lock
            flatpak     wsflatpak update
            distrobox   wsbox update (packages inside the containers)
            extensions  GNOME Shell checks extensions.gnome.org for updates
                        of the unpinned EGO extensions, as Extension Manager
                        does; they are installed at the next log out and in
          pinned on purpose and not touched: the kernel (linux-t2 held,
          system/kernel/t2bce/t2bce.nix), xremap (nix/pkgs/xremap.nix), extensions
          with pin, container images by digest
check     run the owners' checks with --json and summarize their result
          objects (lib/check.bash): ws check repo, ws check home,
          ws-keyboard check, ws-gnome check, wsflatpak check, wsbox check,
          wswin check, ws-suspend check, ws system check, ws check apt,
          ws check virt, ws check backup and ws-workstation-verify
          (cross-layer invariants);
          shows WARN/FAIL messages, -v all;
          check repo: the checkout (Git, hygiene, syntax, bin/ executables);
          check home: home-manager generation, Nix, man pages, session;
          check virt: KVM, libvirt, VM storage @vms, NAT network, OVMF/TPM
          (hosts with vm = "yes" in facts.nix);
          check backup: local copy root on its own subvolume, SSH alias and key;
          check apt compares nix/hosts/apt.txt, nix/hosts/<host>/apt.txt and, with
          vm = "yes", virt/apt.txt, with nativeSteam = "yes", steam/apt.txt,
          with gameMode = "yes", gaming/apt.txt (the
          lists of bootstrap.sh) with the installed packages, report only;
          each takes --json (one result object, what ws check reads)
system    build the host system file tree (system) and compare it
          with the live system, read-only: diff shows file differences,
          check also unit states and prints OK/DIFFERS/MISSING per entry;
          files on the rEFInd ESP are compared only when it is mounted;
          apply (sudo) backs up and installs the files that differ, edits
          /etc/default/keyboard (GDM: EN only), resets /etc/default/grub to
          the package template (an installer may edit it; settings live in
          grub.d), removes known obsolete files,
          enables and restarts units, reloads udev, rebuilds the initramfs
          if modprobe.d changed and runs update-grub if grub.d changed;
          it does not touch the ESP and does not reboot;
          manifest prints what the system layer owns (file MODE PATH,
          esp PARTUUID PATH, unit STATE NAME, restart - NAME, watch - PATH:
          files it depends on without installing them); tree prints the
          built tree (files/, esp/, manifest); both are what ws-baseline
          and the checks read
          apply records the tree it installed in
          ~/.local/state/workstation/system (applied: link and GC root,
          history: date, commit, tree, result)
baseline  functional baseline, see ws-baseline --help
collect   archive of the machine state a rebuild needs and the repository
          does not hold (baseline, boot and disks, apt, Apple firmware,
          ~/.local/state/workstation), see ws-collect --help; asks sudo
backup    Timeshift snapshots to Unraid, then retain final local ro parents;
          plan/status work before SSH is configured; list shows the local
          copies (asks sudo);
          recovery-export OUTPUT writes autonomous Live USB ws-restore;
          see wsbackup --help and helpws backup / helpws recovery
checkpoint  which commit matched which working state (home-manager
          generation, system tree, kernel, baseline), see ws-checkpoint --help
host      print the flake host name used for this machine: WS_HOST, else
          the nix/hosts/<host> whose facts.nix has hostname = "$(hostname)"
fact      print a string fact of this host (hardware, boot, user, wsconfig,
          ...) from nix/hosts/<host>/facts.nix, without Nix
USAGE
}

die() {
    echo "ws: $*" >&2
    exit 1
}

[[ $EUID -ne 0 ]] || die "run as the desktop user, not root"

nix_bin() {
    command -v nix 2>/dev/null \
        || die "nix not found (apt: nix-bin nix-setup-systemd; helpws history-nix, phase 0)"
}

# A string fact of a facts.nix (NAME = "VALUE"; on one line), read without
# Nix: bootstrap.sh needs the facts before Nix exists, checks read them often.
fact_in() {
    sed -nE "s/^[[:space:]]*$2 = \"([^\"]*)\";.*/\1/p" "$1" 2>/dev/null | head -n1
}

# Flake host for this machine: WS_HOST, else the host whose facts.nix has
# this hostname.
host() {
    local f
    if [[ -n "${WS_HOST:-}" ]]; then
        echo "$WS_HOST"
        return
    fi
    for f in "$repo"/nix/hosts/*/facts.nix; do
        if [[ "$(fact_in "$f" hostname)" == "$(hostname)" ]]; then
            f="${f%/facts.nix}"
            echo "${f##*/}"
            return
        fi
    done
    die "no nix/hosts/*/facts.nix with hostname = \"$(hostname)\"; add the host or set WS_HOST"
}

cmd_fact() {
    local h value
    [[ $# -eq 1 ]] || die "usage: ws fact NAME"
    h="$(host)"
    [[ -r "$repo/nix/hosts/$h/facts.nix" ]] || die "no nix/hosts/$h/facts.nix"
    value="$(fact_in "$repo/nix/hosts/$h/facts.nix" "$1")"
    [[ -n "$value" ]] || die "no string fact $1 in nix/hosts/$h/facts.nix"
    echo "$value"
}

target() {
    echo "$repo#$(id -un)@$(host)"
}

# The flake sees only files known to git; a new .nix file that is not added
# would silently be missing from the build.
check_untracked() {
    local untracked
    untracked="$(git -C "$repo" ls-files --others --exclude-standard -- \
        '*.nix' flake.lock)"
    [[ -z "$untracked" ]] || die "untracked flake files (git add them first):
$untracked"
}

current_generation() {
    local p
    for p in "${XDG_STATE_HOME:-$HOME/.local/state}/nix/profiles/home-manager" \
        "/nix/var/nix/profiles/per-user/$(id -un)/home-manager"; do
        if [[ -e "$p" ]]; then
            readlink -f "$p"
            return
        fi
    done
}

# Lists that commands edit in the checkout (wsflatpak install/manage/unmanage/
# remove/apply, filesystem/env/talk and un…; wsbox create/apply/remove), all
# with workstation marks (lib/ws_marks.py): switch adds them before the build
# and commits them after a successful one.
tool_lists=(flatpak/apps.txt flatpak/overrides.txt distrobox/hosts.txt)

commit_tool_lists() {
    local f changes old
    for f in "${tool_lists[@]}"; do
        [[ -e "$repo/$f" ]] || continue
        git -C "$repo" diff --quiet HEAD -- "$f" 2>/dev/null && continue
        # +NAME, -NAME, NAME HOST=STATE; overrides.txt: NAME is APP KIND VALUE.
        old="$(mktemp)"
        git -C "$repo" show "HEAD:$f" > "$old" 2>/dev/null || : > "$old"
        changes="$(python3 "$repo/lib/ws_marks.py" "$repo/$f" summary "$old" \
            $([[ "$f" != flatpak/overrides.txt ]] || echo 3))"
        rm -f "$old"
        git -C "$repo" commit -q -m "$f: ${changes:-edited} (ws switch)" -- "$f" || return
        echo "committed $f: ${changes:-edited}"
    done
}

cmd_switch() {
    local nix f
    nix="$(nix_bin)" || return
    for f in "${tool_lists[@]}"; do
        [[ ! -e "$repo/$f" ]] || git -C "$repo" add -- "$f" || return
    done
    check_untracked || return
    "$nix" run "$repo#home-manager" -- switch --flake "$(target)" "$@" || return
    commit_tool_lists
}

cmd_news() {
    local nix
    nix="$(nix_bin)"
    check_untracked
    "$nix" run "$repo#home-manager" -- news --flake "$(target)" "$@"
}

cmd_diff() {
    local nix new old
    nix="$(nix_bin)" || return
    check_untracked || return
    new="$("$nix" build --no-link --print-out-paths \
        "$repo#homeConfigurations.\"$(id -un)@$(host)\".activationPackage")" || return
    old="$(current_generation)"
    if [[ -z "$old" ]]; then
        echo "no home-manager generation yet; new: $new"
        return
    fi
    "$nix" run "$repo#nvd" -- diff "$old" "$new"
}

# Layer owners in apply order: name, command.
apply_steps=(
    "extensions ws-keyboard-install-extensions"
    "tiling ws-tiling-apply"
    "keyboard ws-keyboard-apply"
    "flatpak wsflatpak apply"
    "distrobox wsbox apply"
)

cmd_apply() {
    local wanted=("$@") step name cmd rc known
    local -a results=()
    local failed=false

    for name in "${wanted[@]}"; do
        known=false
        for step in "${apply_steps[@]}"; do
            [[ "${step%% *}" == "$name" ]] && known=true
        done
        [[ "$known" == true ]] || die "unknown apply step: $name"
    done

    for step in "${apply_steps[@]}"; do
        name="${step%% *}"
        cmd="${step#* }"
        if ((${#wanted[@]})) && [[ " ${wanted[*]} " != *" $name "* ]]; then
            continue
        fi
        printf '\n=== %s: %s\n' "$name" "$cmd"
        rc=0
        # shellcheck disable=SC2086 # cmd is a fixed command line
        "$repo/bin/"$cmd || rc=$?
        case "$rc" in
            0) results+=("OK        $name") ;;
            69) results+=("PREFLIGHT $name (log out and in, then: ws apply $name)"); failed=true ;;
            *) results+=("FAIL      $name (exit $rc)"); failed=true ;;
        esac
    done

    printf '\n=== ws apply\n'
    printf '  %s\n' "${results[@]}"
    # wsflatpak/wsbox apply may have written marks: switch links the desktop
    # entries of what this workstation now has and commits the lists.
    if ! git -C "$repo" diff --quiet HEAD -- "${tool_lists[@]}" 2>/dev/null; then
        printf '  marks changed: ws switch (links the desktop entries, commits the lists)\n'
    fi
    [[ "$failed" == false ]]
}

# The update_* steps run where set -e is off (cmd_update): check each command.
update_apt() {
    sudo apt update || return
    sudo apt full-upgrade || return
    if apt-mark showhold | grep -qx linux-t2; then
        echo "linux-t2 held: a new kernel needs new t2bce modules (helpws suspend)"
    fi
}

update_nix() {
    local nix
    nix="$(nix_bin)" || return
    check_untracked || return
    "$nix" flake update --flake "$repo" || return
    cmd_diff || return
    cmd_switch || return
    if ! git -C "$repo" diff --quiet -- flake.lock; then
        echo "flake.lock changed: commit it (git -C $repo commit flake.lock)"
    fi
}

update_extensions() {
    local list="$HOME/.local/share/workstation/gnome/extensions" pinned
    [[ -r "$list" ]] || die "extension list missing: $list (ws switch)"
    # GNOME Shell updates every extension from EGO, a pinned copy too.
    pinned="$(awk '!/^#/ && $2 == "ego" && NF >= 3 { print $1 }' "$list")"
    if [[ -n "$pinned" ]]; then
        echo "pinned EGO extensions would be replaced as well:" $pinned
        echo "update the others one by one in Extension Manager"
        return 1
    fi
    gdbus call --session --dest org.gnome.Shell.Extensions \
        --object-path /org/gnome/Shell/Extensions \
        --method org.gnome.Shell.Extensions.CheckForUpdates > /dev/null || return
    echo "GNOME Shell checks for extension updates; downloaded updates are"
    echo "installed at the next log out and in (Extension Manager shows them)"
}

update_steps=(
    "apt update_apt"
    "nix update_nix"
    "flatpak $repo/bin/wsflatpak update -y"
    "distrobox $repo/bin/wsbox update"
    "extensions update_extensions"
)

cmd_update() {
    local wanted=("$@") step name cmd rc known
    local -a results=()
    local failed=false

    for name in "${wanted[@]}"; do
        known=false
        for step in "${update_steps[@]}"; do
            [[ "${step%% *}" == "$name" ]] && known=true
        done
        [[ "$known" == true ]] || die "unknown update step: $name"
    done

    for step in "${update_steps[@]}"; do
        name="${step%% *}"
        cmd="${step#* }"
        if ((${#wanted[@]})) && [[ " ${wanted[*]} " != *" $name "* ]]; then
            continue
        fi
        printf '\n=== %s\n' "$name"
        rc=0
        # shellcheck disable=SC2086 # cmd is a fixed command line
        ( $cmd ) || rc=$?
        if ((rc == 0)); then
            results+=("OK    $name")
        else
            results+=("FAIL  $name (exit $rc)")
            failed=true
        fi
    done

    printf '\n=== ws update\n'
    printf '  %s\n' "${results[@]}"
    [[ "$failed" == false ]]
}

system_tree() {
    local nix
    nix="$(nix_bin)"
    check_untracked
    "$nix" build --no-link --print-out-paths "$repo#system-$(host)"
}

# Result of one entry: ws system check reports it through lib/check.bash
# (pass/fail, --json for ws check); diff prints only the problems.
system_report() {
    if [[ "$system_mode" == check ]]; then
        "$1" "$2"
    elif [[ "$1" != pass ]]; then
        printf '%s\n' "$2"
    fi
}

# Compare one built file with the live one: content, mode and root:root.
# Reports it (diff also prints the content difference); returns 1 on a
# difference.
system_compare() {
    local built="$1" live="$2" want="$3" have
    if [[ ! -e "$live" ]]; then
        system_report fail "missing: $live"
        return 1
    fi
    if [[ ! -r "$live" ]]; then
        system_report fail "not readable: $live"
        return 1
    fi
    if ! cmp -s "$built" "$live"; then
        system_report fail "differs: $live"
        [[ "$system_mode" == diff ]] && { diff -u --label "$live" --label "built" "$live" "$built" || true; }
        return 1
    fi
    have="$(stat -c '%a %U:%G' "$live")"
    if [[ "$have" != "${want#0} root:root" ]]; then
        system_report fail "differs: $live ($have, want ${want#0} root:root)"
        return 1
    fi
    system_report pass "$live"
}

# What the system layer relies on without installing it, and what apply
# removes: checked by ws system check after the manifest entries.
system_check_extra() {
    local mounts layout
    # /etc/default/grub belongs to the grub package (ucf); workstation
    # settings live only in grub.d drop-ins.
    if cmp -s /usr/share/grub/default/grub /etc/default/grub; then
        pass "/etc/default/grub is the package template"
    else
        warn "/etc/default/grub differs from /usr/share/grub/default/grub; settings belong in grub.d (ws system apply resets it)"
    fi
    [[ -e /etc/default/grub.d/90-pcie-aspm.cfg ]] \
        && warn "/etc/default/grub.d/90-pcie-aspm.cfg forces ASPM on GRUB/recovery kernels (helpws suspend)"
    # Recovery must not stop in emergency mode when a non-system disk is absent.
    mounts="$(awk '$0 !~ /^[[:space:]]*#/ && NF >= 4 && $2 ~ /^\/mnt\// && $4 !~ /(^|,)nofail(,|$)/ { print $2 }' /etc/fstab 2>/dev/null)"
    if [[ -z "$mounts" ]]; then
        pass "fstab: /mnt/* mounts are nofail"
    else
        warn "fstab: /mnt/* without nofail ($(echo $mounts)); boot/recovery would stop in emergency mode"
    fi
    # GDM/login: /etc/default/keyboard as apply edits it (keyboard_default).
    layout="$(busctl get-property org.freedesktop.locale1 /org/freedesktop/locale1 \
        org.freedesktop.locale1 X11Layout 2>/dev/null | sed -E 's/^s "(.*)"$/\1/')"
    [[ "$layout" == us ]] \
        && pass "GDM/login X11 layout: us" \
        || fail "GDM/login X11 layout is '${layout:-unknown}', expected us (ws system apply)"
    [[ -f "$obsolete_uinput" ]] && warn "obsolete $obsolete_uinput (ws system apply removes it)"
    [[ -f "$obsolete_tiny_cfg" ]] && ! tiny_dfr_installed \
        && warn "obsolete $obsolete_tiny_cfg (ws system apply removes it)"
    systemctl list-unit-files tiny-dfr-sleep.service 2>/dev/null | grep -q '^tiny-dfr-sleep\.service' \
        && warn "obsolete tiny-dfr-sleep.service still installed"
    [[ -f "$obsolete_t2gmux_hook" ]] && warn "obsolete $obsolete_t2gmux_hook (ws system apply removes it)"
    local f
    for f in "${obsolete_backup_snapshot[@]}"; do
        [[ -e "$f" ]] && warn "obsolete $f (ws system apply removes it)"
    done
    [[ -d /.snapshots ]] && warn "obsolete /.snapshots (recovery before Timeshift; helpws rebuild, Recovery)"
    return 0
}

cmd_system() {
    local tree kind a b esp state
    system_mode="${1:-}"

    case "$system_mode" in
        diff) ;;
        check)
            # shellcheck source=../lib/check.bash
            . "$repo/lib/check.bash"
            case "${2:-}" in
                --json) check_json_mode ;;
                "") ;;
                *) die "usage: ws system check [--json]" ;;
            esac
            ;;
        apply) shift; cmd_system_apply "$@"; return ;;
        tree) system_tree; return ;;
        manifest) cat "$(system_tree)/manifest"; return ;;
        *) die "usage: ws system diff|check|apply|manifest|tree" ;;
    esac
    tree="$(system_tree)"
    local problems=0 files=0

    while IFS=$'\t' read -r kind a b; do
        case "$kind" in
            file)
                files=$((files + 1))
                system_compare "$tree/files$b" "$b" "$a" || problems=$((problems + 1))
                ;;
            esp)
                files=$((files + 1))
                esp="$(findmnt -rno TARGET "/dev/disk/by-partuuid/$a" 2>/dev/null | head -n1 || true)"
                if [[ -z "$esp" ]]; then
                    [[ "$system_mode" == check ]] && info "ESP:$b not compared (ESP not mounted)"
                    continue
                fi
                system_compare "$tree/esp/$b" "$esp/$b" 0644 || problems=$((problems + 1))
                ;;
            unit)
                [[ "$system_mode" == check ]] || continue
                state="$(systemctl is-enabled "$b" 2>/dev/null || true)"
                if [[ "$state" == "$a" ]]; then
                    pass "unit $b ($state)"
                else
                    fail "unit $b is ${state:-unknown}, want $a"
                fi
                ;;
        esac
    done < "$tree/manifest"

    if [[ "$system_mode" == check ]]; then
        info "tree: $tree"
        system_check_extra
        check_finish
    elif ((problems == 0)); then
        echo "no differences ($files files)"
    else
        return 1
    fi
}

# GDM/login keyboard: /etc/default/keyboard belongs to keyboard-configuration
# and is edited, not replaced: XKBLAYOUT=us, no variant, no grp:/grp_led:
# options (layouts are switched by the workstation input-source extension).
# Prints the edited file.
keyboard_default() {
    python3 - "$1" <<'PY'
from pathlib import Path
import re
import sys

text = Path(sys.argv[1]).read_text()

def get_value(name, default=""):
    m = re.search(
        rf'(?m)^\s*{re.escape(name)}\s*=\s*(?:"([^"]*)"|\'([^\']*)\'|([^\n#]*))',
        text,
    )
    if not m:
        return default
    return next((g.strip() for g in m.groups() if g is not None), default)

def set_value(name, value):
    global text
    line = f'{name}="{value}"'
    pat = rf'(?m)^\s*{re.escape(name)}\s*=.*$'
    if re.search(pat, text):
        text = re.sub(pat, line, text, count=1)
    else:
        if text and not text.endswith("\n"):
            text += "\n"
        text += line + "\n"

model = get_value("XKBMODEL", "pc105") or "pc105"
kept = [
    o for o in (x.strip() for x in get_value("XKBOPTIONS", "").split(","))
    if o and not o.startswith(("grp:", "grp_led:"))
]

set_value("XKBMODEL", model)
set_value("XKBLAYOUT", "us")
set_value("XKBVARIANT", "")
set_value("XKBOPTIONS", ",".join(kept))
sys.stdout.write(text)
PY
}

# Obsolete files of earlier baselines: path, the only content line that
# allows removal (empty: remove whenever the condition in apply holds).
obsolete_uinput=/etc/udev/rules.d/70-workstation-uinput.rules
obsolete_uinput_line='KERNEL=="uinput", TAG+="uaccess", OPTIONS+="static_node=uinput"'
obsolete_tiny_cfg=/etc/tiny-dfr/config.toml
# Sleep hook of the first t2gmux test boots (helpws plan-dgpu, 2026-10-01):
# the card leaves the PCI bus again, so S3 needs nothing.
obsolete_t2gmux_hook=/usr/lib/systemd/system-sleep/70-ws-dgpu-t2gmux
# Recovery snapshot before Timeshift (2026-10-02): the script, its GRUB entry
# and the kernel copies it made; /.snapshots itself is removed by hand
# (helpws rebuild, Recovery).
obsolete_backup_snapshot=(/usr/local/sbin/system-backup-snapshot /etc/grub.d/41_backup_snapshot
    /boot/recovery /boot/recovery.previous)

tiny_dfr_installed() {
    dpkg-query -W -f='${Status}' tiny-dfr 2>/dev/null | grep -q 'install ok installed'
}

# The tree ws system apply installed: a link that is also a GC root, and one
# history line per apply (date, commit, dirty files, tree, result).
system_record() {
    local tree="$1" rc="$2" dir="${XDG_STATE_HOME:-$HOME/.local/state}/workstation/system"
    mkdir -p "$dir"
    "$(nix_bin)" build --out-link "$dir/applied" "$tree"
    printf '%s\t%s\t%s\t%s\t%s\n' "$(date --iso-8601=seconds)" \
        "$(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo '?')" \
        "dirty=$(git -C "$repo" status --porcelain 2>/dev/null | wc -l)" \
        "$tree" "$([[ "$rc" == 0 ]] && echo ok || echo problems)" >> "$dir/history"
}

# One owner of the system files (phase 4 of helpws history-nix):
# what ws-keyboard-system-apply and ws-suspend apply did, for the whole tree.
# Only files that differ are backed up and replaced; the ESP is not touched,
# nothing reboots.
cmd_system_apply() {
    local tree kind a b f backup tmp unit changed=0 modprobe=false grub=false logind=false
    local refind=false d3cold=false touchbar=false bootlinks=false has_bootlinks=false saved=false dev cfg out rc=0
    local -a restart=()

    command -v sudo >/dev/null 2>&1 || die "sudo not found"
    command -v python3 >/dev/null 2>&1 || die "python3 not found"
    tree="$(system_tree)"
    backup="/var/backups/workstation/system-$(date +%Y%m%d-%H%M%S)"

    # Back up a live file under $backup before it is replaced or removed.
    save() {
        [[ -e "$1" ]] || return 0
        sudo install -d -m0700 "$backup" "$backup$(dirname "$1")"
        sudo cp -a -- "$1" "$backup$1"
        saved=true
    }

    sudo -v
    echo "== Files ($tree)"
    while IFS=$'\t' read -r kind a b; do
        case "$kind" in
            file)
                case "$b" in
                    /etc/udev/rules.d/90-touchbar-native.rules) touchbar=true ;;
                    /usr/local/sbin/ws-boot-links) has_bootlinks=true ;;
                esac
                if [[ -e "$b" ]] && cmp -s "$tree/files$b" "$b" \
                    && [[ "$(stat -c '%a %U:%G' "$b")" == "${a#0} root:root" ]]; then
                    continue
                fi
                save "$b"
                sudo install -D -m"$a" -o root -g root "$tree/files$b" "$b"
                echo "installed: $b"
                changed=$((changed + 1))
                case "$b" in
                    /etc/modprobe.d/*) modprobe=true ;;
                    /etc/default/grub.d/*) grub=true ;;
                    /etc/grub.d/*) grub=true ;;
                    /etc/systemd/logind.conf.d/*) logind=true ;;
                    /boot/refind_linux.conf) refind=true ;;
                    /usr/local/sbin/ws-boot-links) bootlinks=true ;;
                    */70-bcm4364-no-d3cold.rules) d3cold=true ;;
                esac
                ;;
            restart) restart+=("$b") ;;
        esac
    done < "$tree/manifest"

    echo
    echo "== GDM/login keyboard"
    tmp="$(mktemp)"
    keyboard_default /etc/default/keyboard > "$tmp"
    if cmp -s "$tmp" /etc/default/keyboard; then
        echo "unchanged: /etc/default/keyboard"
    else
        save /etc/default/keyboard
        sudo install -m0644 -o root -g root "$tmp" /etc/default/keyboard
        echo "edited: /etc/default/keyboard"
        changed=$((changed + 1))
    fi
    rm -f "$tmp"

    # The installer of a new machine edits /etc/default/grub (Ubuntu 26.04:
    # empty GRUB_CMDLINE_LINUX_DEFAULT); workstation settings are grub.d
    # drop-ins over the package template.
    echo
    echo "== /etc/default/grub"
    if [[ ! -r /usr/share/grub/default/grub ]] || cmp -s /usr/share/grub/default/grub /etc/default/grub; then
        echo "unchanged: /etc/default/grub"
    else
        save /etc/default/grub
        sudo install -m0644 -o root -g root /usr/share/grub/default/grub /etc/default/grub
        echo "reset to the package template: /etc/default/grub"
        changed=$((changed + 1))
        grub=true
    fi

    echo
    echo "== Obsolete files"
    if [[ -f "$obsolete_uinput" ]]; then
        if grep -Fxq "$obsolete_uinput_line" "$obsolete_uinput"; then
            save "$obsolete_uinput"
            sudo rm -f -- "$obsolete_uinput"
            echo "removed: $obsolete_uinput"
        else
            echo "WARN    $obsolete_uinput does not match the known old rule; left untouched"
        fi
    fi
    if [[ -f "$obsolete_tiny_cfg" ]] && ! tiny_dfr_installed; then
        save "$obsolete_tiny_cfg"
        sudo rm -f -- "$obsolete_tiny_cfg"
        sudo rmdir --ignore-fail-on-non-empty "$(dirname "$obsolete_tiny_cfg")"
        echo "removed: $obsolete_tiny_cfg"
    fi
    if [[ -f "$obsolete_t2gmux_hook" ]]; then
        save "$obsolete_t2gmux_hook"
        sudo rm -f -- "$obsolete_t2gmux_hook"
        echo "removed: $obsolete_t2gmux_hook"
    fi
    for f in "${obsolete_backup_snapshot[@]}"; do
        [[ -e "$f" ]] || continue
        [[ -d "$f" ]] || save "$f"
        sudo rm -rf -- "$f"
        echo "removed: $f"
        [[ "$f" != /etc/grub.d/* ]] || grub=true
    done

    echo
    echo "== Units"
    sudo systemctl daemon-reload
    while IFS=$'\t' read -r kind a b; do
        [[ "$kind" == unit && "$a" == enabled ]] || continue
        sudo systemctl enable --quiet "$b"
        echo "enabled: $b"
    done < "$tree/manifest"
    for unit in "${restart[@]}"; do
        sudo systemctl restart "$unit"
        echo "restarted: $unit"
    done
    # logind rereads logind.conf.d on reload; a restart would end sessions.
    if [[ "$logind" == true ]]; then
        sudo systemctl reload systemd-logind
        echo "reloaded: systemd-logind"
    fi

    echo
    echo "== udev"
    sudo udevadm control --reload-rules
    sudo udevadm trigger --subsystem-match=input --action=change || true
    sudo udevadm settle || true

    # The hooks keep /boot/ws current from now on; create it the first time.
    if [[ "$has_bootlinks" == true ]] && [[ "$bootlinks" == true || ! -e /boot/ws/vmlinuz ]]; then
        echo
        echo "== /boot/ws (rEFInd \"Ubuntu (AMD)\")"
        sudo /usr/local/sbin/ws-boot-links
    fi

    # hid-appletb-kbd options are read from the initramfs at boot.
    if [[ "$modprobe" == true ]]; then
        echo
        echo "== initramfs (modprobe.d changed)"
        sudo update-initramfs -u -k "$(uname -r)"
        sudo lsinitrd 2>/dev/null | grep -E 't2bce|appletb|modprobe.d' || true
    fi
    if [[ "$grub" == true ]]; then
        echo
        echo "== GRUB (grub.d changed)"
        sudo update-grub
    fi

    echo
    echo "== Check"
    [[ "$saved" == true ]] && echo "backup: $backup"
    out="$(cmd_system check)" || rc=1
    grep -E '^ *(WARN|FAIL) ' <<<"$out" || echo "ws system check: no problems"
    for unit in "${restart[@]}"; do
        if systemctl is-active --quiet "$unit"; then
            echo "OK      $unit active"
        else
            echo "FAIL    $unit not active"
            rc=1
        fi
    done
    python3 - /etc/default/keyboard <<'PY' || rc=1
from pathlib import Path
import re
import sys

text = Path(sys.argv[1]).read_text()

def value(name):
    m = re.search(
        rf'(?m)^\s*{re.escape(name)}\s*=\s*(?:"([^"]*)"|\'([^\']*)\'|([^\n#]*))',
        text,
    )
    if not m:
        return None
    return next((g.strip() for g in m.groups() if g is not None), "")

options = value("XKBOPTIONS") or ""
if (value("XKBLAYOUT") == "us" and value("XKBVARIANT") in ("", None)
        and not any(x.startswith(("grp:", "grp_led:")) for x in options.split(","))):
    print("OK      GDM/login keyboard: EN only")
else:
    print("FAIL    GDM/login keyboard is not EN only")
    sys.exit(1)
PY
    printf 'MemorySleepMode: %s\n' \
        "$(systemd-analyze cat-config systemd/sleep.conf 2>/dev/null \
            | sed -n 's/^MemorySleepMode=//p' | tail -n1)"

    if [[ "$touchbar" == true ]]; then
        if tiny_dfr_installed; then
            echo "WARN    tiny-dfr is installed; it switches the Touch Bar to display mode (helpws touchbar)"
        fi
        for dev in /sys/bus/usb/devices/*; do
            [[ "$(cat "$dev/idVendor" 2>/dev/null):$(cat "$dev/idProduct" 2>/dev/null)" == "05ac:8302" ]] || continue
            cfg="$(cat "$dev/bConfigurationValue" 2>/dev/null || true)"
            if [[ "$cfg" == 1 ]]; then
                echo "OK      Touch Bar: USB configuration 1 (native)"
            else
                echo "WARN    Touch Bar is in USB configuration '${cfg:-0}'; reboot to apply the udev rule"
            fi
        done
    fi

    system_record "$tree" "$rc"

    echo
    echo "$changed file(s) changed."
    [[ "$refind" == true ]] && echo "refind_linux.conf changed: the kernel command line applies on the next boot."
    [[ "$refind" == true ]] && echo "refind.conf on the ESP is not installed by apply; copy system/files/esp/refind.conf by hand (helpws workstation, GRAPHICS)."
    [[ "$d3cold" == true ]] && echo "The d3cold rule takes effect on the next boot."
    return "$rc"
}

# Owner checks: name, command. Each runs with --json and prints one result
# object (lib/check.bash); ws check reads only that, not the text. verify
# (cross-layer) runs last: wsbox check has started the containers by then.
check_steps=(
    "repo ws-check-repo"
    "home ws-check-home"
    "keyboard ws-keyboard check"
    "gnome ws-gnome check"
    "widgets ws-widgets check"
    "flatpak wsflatpak check"
    "distrobox wsbox check"
    "windows wswin check"
    "suspend ws-suspend check"
    "system ws system check"
    "apt ws check apt"
    "virt ws check virt"
    "backup ws check backup"
    "verify ws-workstation-verify"
)

# The apt lists of bootstrap.sh against the installed system; reports only.
# A listed package that is missing or only auto-installed (apt autoremove
# could take it) is a WARN; manual packages outside the lists are listed.
cmd_check_apt() {
    local h pkg status name
    local -a want=() extra=()
    local -A listed=() manual=()

    # shellcheck source=../lib/check.bash
    . "$repo/lib/check.bash"
    case "${1:-}" in
        --json) check_json_mode ;;
        "") ;;
        *) die "usage: ws check apt [--json]" ;;
    esac

    h="$(host)"
    local -a lists=("$repo/nix/hosts/apt.txt" "$repo/nix/hosts/$h/apt.txt")
    # VM packages only on hosts with vm = "yes" (helpws virt).
    [[ "$(fact_in "$repo/nix/hosts/$h/facts.nix" vm)" != yes ]] || lists+=("$repo/virt/apt.txt")
    # Native Steam and the Game Mode session (helpws plan-legion-go).
    [[ "$(fact_in "$repo/nix/hosts/$h/facts.nix" nativeSteam)" != yes ]] || lists+=("$repo/steam/apt.txt")
    [[ "$(fact_in "$repo/nix/hosts/$h/facts.nix" gameMode)" != yes ]] || lists+=("$repo/gaming/apt.txt")
    mapfile -t want < <(cat "${lists[@]}" 2>/dev/null \
        | sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' -e '/^ppa:/d' | sort -u)
    for pkg in $(printf '%s\n' "${want[@]}" | sed -n 's/^purge://p'); do
        if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q ' installed$'; then
            warn "installed, the host list purges it: $pkg (bootstrap.sh)"
        else
            pass "purged: $pkg"
        fi
    done
    # Repositories and architectures of the host list (bootstrap.sh).
    for name in $(printf '%s\n' "${want[@]}" | sed -n 's/^source://p'); do
        if cmp -s "$repo/nix/hosts/$h/apt/$name.sources" "/etc/apt/sources.list.d/ws-$name.sources" \
            && cmp -s "$repo/nix/hosts/$h/apt/$name.asc" "/etc/apt/keyrings/ws-$name.asc"; then
            pass "apt source: $name"
        else
            warn "apt source $name missing or not as nix/hosts/$h/apt/$name.* (bootstrap.sh)"
        fi
    done
    for name in $(printf '%s\n' "${want[@]}" | sed -n 's/^arch://p'); do
        if dpkg --print-foreign-architectures | grep -qx "$name"; then
            pass "architecture: $name"
        else
            warn "architecture missing: $name (bootstrap.sh)"
        fi
    done
    mapfile -t want < <(printf '%s\n' "${want[@]}" | grep -v '^purge:\|^source:\|^arch:')
    while read -r pkg; do
        manual[$pkg]=1
    done < <(apt-mark showmanual)

    for pkg in "${want[@]}"; do
        listed[$pkg]=1
        status="$(dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null || true)"
        if [[ "$status" != *" ok installed" ]]; then
            warn "not installed: $pkg"
        elif [[ -z "${manual[$pkg]:-}" ]]; then
            warn "auto-installed, apt autoremove could remove it: $pkg (sudo apt-mark manual $pkg)"
        else
            pass "$pkg"
        fi
    done
    for pkg in "${!manual[@]}"; do
        [[ -n "${listed[$pkg]:-}" ]] || extra+=("$pkg")
    done
    info "${#extra[@]} manual packages are not in nix/hosts/apt.txt or nix/hosts/$h/apt.txt: $(printf '%s\n' "${extra[@]}" | sort | paste -sd' ')"
    check_finish
}

# Counts and messages of one result object: first line "WARNINGS FAILURES",
# then the messages to show (WARN/FAIL; all with -v). Fails on bad JSON.
check_result() {
    python3 -c '
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    print(int(d["warnings"]), int(d["failures"]))
except Exception:
    sys.exit(1)
for m in d.get("messages", []):
    if sys.argv[2] == "true" or m["level"] in ("warn", "fail"):
        print("  %-5s %s" % (m["level"].upper(), m["text"]))
' "$1" "$2"
}

cmd_check() {
    local verbose=false step name cmd rc out err res counts warn fail
    local -a results=()
    local total_warn=0 total_fail=0

    case "${1:-}" in
        apt) shift; cmd_check_apt "$@"; return ;;
        repo) shift; exec "$repo/bin/ws-check-repo" "$@" ;;
        home) shift; exec "$repo/bin/ws-check-home" "$@" ;;
        virt|vm) shift; exec "$repo/bin/ws-check-virt" "$@" ;;
        backup) shift; exec "$repo/bin/ws-check-backup" "$@" ;;
        widgets) shift; exec "$repo/bin/ws-widgets-check" "$@" ;;
        -v|--verbose) verbose=true ;;
        "") ;;
        *) die "unknown check option: $1" ;;
    esac

    out="$(mktemp)"
    err="$(mktemp)"
    trap 'rm -f "$out" "$err"; trap - RETURN' RETURN

    for step in "${check_steps[@]}"; do
        name="${step%% *}"
        cmd="${step#* }"
        rc=0
        # shellcheck disable=SC2086 # cmd is a fixed command line
        "$repo/bin/"$cmd --json > "$out" 2> "$err" || rc=$?
        printf '\n=== %s: %s (exit %s)\n' "$name" "$cmd" "$rc"
        if res="$(check_result "$out" "$verbose")"; then
            counts="${res%%$'\n'*}"
            warn="${counts% *}"
            fail="${counts#* }"
            [[ "$res" != *$'\n'* ]] || printf '%s\n' "${res#*$'\n'}"
        else
            # No result object: the check itself broke.
            warn=0
            fail=1
            echo "  FAIL  no result from $cmd --json:"
            tail -n 5 "$err" | sed 's/^/        /'
        fi
        # A non-zero exit without failures still counts as one failure.
        if ((rc != 0 && fail == 0)); then
            fail=1
        fi

        total_warn=$((total_warn + warn))
        total_fail=$((total_fail + fail))
        if ((fail)); then
            results+=("FAIL  $name ($fail)")
        elif ((warn)); then
            results+=("WARN  $name ($warn)")
        else
            results+=("OK    $name")
        fi
    done

    printf '\n=== ws check\n'
    printf '  %s\n' "${results[@]}"
    printf '  FAIL=%d WARN=%d\n' "$total_fail" "$total_warn"
    ((total_fail == 0))
}

case "${1:-}" in
    apply) shift; cmd_apply "$@" ;;
    check) shift; cmd_check "$@" ;;
    switch) shift; cmd_switch "$@" ;;
    diff) shift; cmd_diff "$@" ;;
    news) shift; cmd_news "$@" ;;
    update) shift; cmd_update "$@" ;;
    system) shift; cmd_system "$@" ;;
    baseline) shift; exec "$repo/bin/ws-baseline" "$@" ;;
    checkpoint) shift; exec "$repo/bin/ws-checkpoint" "$@" ;;
    collect) shift; exec "$repo/bin/ws-collect" "$@" ;;
    backup) shift; exec "$repo/bin/wsbackup" "$@" ;;
    host) host ;;
    fact) shift; cmd_fact "$@" ;;
    # Step names of apply, update and check, one per line: the fish
    # completion reads them from here instead of keeping its own list.
    steps)
        case "${2:-}" in
            apply) printf '%s\n' "${apply_steps[@]%% *}" ;;
            update) printf '%s\n' "${update_steps[@]%% *}" ;;
            check) printf '%s\n' "${check_steps[@]%% *}" ;;
            *) die "usage: ws steps apply|update|check" ;;
        esac
        ;;
    -h|--help|help) usage ;;
    "") usage; exit 1 ;;
    *) usage >&2; exit 1 ;;
esac
