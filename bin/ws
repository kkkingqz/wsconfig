#!/usr/bin/env bash
set -euo pipefail

# Entry point of the Nix layer (ws help history-nix). Runs as the
# desktop user and calls sudo itself where needed: `sudo ws` would not find
# Nix, secure_path does not contain the Nix profile.

# shellcheck source=../lib/common.bash
. "$(dirname "$(readlink -f "$0")")/../lib/common.bash"

usage() {
    cat <<'USAGE'
Usage:
  ws diff [--core PATH]
  ws apply [--core PATH] [home|apt|system|STEP...]
  ws sync [--dry-run]
  ws update [--core PATH] [STEP...]
  ws check [-v] | ws check apt|repo|home|virt|steam|gaming [--json]
  ws system diff|check [--json]|manifest|tree
  ws baseline capture|diff|list ...
  ws checkpoint create|list|show|diff|remove ...
  ws collect [--no-firmware] [ARCHIVE]
  ws btrfs make [--dry-run] [--yes]
  ws setup [--repo URL|PATH | --new [DIR]] [--host NAME]
  ws backup [plan|status|list|check|send|restore-test|recovery-export ...]
  ws container build|run|status HOST [--dry-run]
  ws host [--for-marks]
  ws fact [--host HOST] NAME
  ws news
  ws help [TOPIC]          the docs; without TOPIC the list of topics
  ws battery|gmux|psr|gpu ...   diagnostics of the hardware
  ws MODULE [ARG...]       flatpak box windows widgets game keyboard gnome
                           suspend backup script: the owner of that layer

--core PATH  (apply, diff, news, update, checkpoint, container) build the configuration
          with the core checkout PATH instead of the revision its flake.lock
          pins (--override-input wsconfig; flake.lock stays); only for a
          configuration of its own, which has the input wsconfig
sync      publish the configuration (a repository of its own, all of it
          data): one commit of every tracked change, with what changed
          (catalogs, host choices, flake.lock), then git pull --rebase and
          git push when the branch has an upstream (no remote: the commit
          stays local); a new file of scripts/ is added to Git first, other
          files Git does not track are only named (git add FILE); refuses
          during a Git operation and on a detached HEAD;
          --dry-run shows what it would do
news      home-manager news of this flake (apply does not notify about them)
diff      build the home generation without activating it and show the
          package difference against the current one (nvd)
apply     apply the configuration of this host, in one order:
            choices     the new positions of the catalogs, one checklist
                        (lib/ws_catalog.py offer --all; no terminal: they
                        stay ask)
            build       the home-manager generation and the system tree;
                        a failure applies nothing (exit 2)
            apt         what the apt lists lack, purge: (checked by a
                        simulation first); sudo only when there is some
            system      the system files, only when the tree differs from
                        the live system (sudo then)
            home        home-manager switch: ws and its tools, manifests,
                        links; records ~/.local/state/wsconfig/host.json
            extensions  ws gnome extensions
            tiling      ws-tiling-apply
            keyboard    ws-keyboard-apply
            flatpak     ws flatpak apply
            distrobox   ws box apply
            widgets     ws widgets apply
            scripts     ws script apply
          a new file of scripts/ is added to Git before the build (the
          flake sees only what Git tracks); then what is left: log out and in (a step whose preflight fails,
          exit 69), reboot (initramfs, kernel command line), ws sync;
          ws apply NAME... runs build and home always, of the rest only the
          names (home: nothing else); apt or system pending but not named
          is left as "ws apply apt|system"
update    bring everything that is not pinned to the latest version, in order:
            apt         sudo apt update, sudo apt full-upgrade (held
                        packages such as linux-t2 stay)
            core        nix flake update wsconfig: the newest core a
                        configuration of its own pins, built, its schema
                        checked, applied; flake.lock goes back when nothing
                        was applied
            nix         nix flake update nixpkgs home-manager wswidgets, the
                        package difference (nvd), ws apply; flake.lock goes
                        back only when nothing was applied; then ws sync
            flatpak     ws flatpak update
            distrobox   ws box update (packages inside the containers)
            extensions  GNOME Shell checks extensions.gnome.org for updates
                        of the unpinned EGO extensions, as Extension Manager
                        does; they are installed at the next log out and in
          pinned on purpose and not touched: the kernel (linux-t2 held,
          system/kernel/t2bce/t2bce.nix), xremap (nix/pkgs/xremap.nix), extensions
          with pin, container images by digest
check     run the owners' checks with --json and summarize their result
          objects (lib/check.bash): ws check repo, ws check home,
          ws keyboard check, ws gnome check, ws check widgets,
          ws script check, ws flatpak check, ws box check,
          ws windows check, ws suspend check, ws system check, ws check apt,
          ws check virt, ws check steam, ws game check, ws check backup and
          ws-workstation-verify (cross-layer invariants);
          shows WARN/FAIL messages, -v all;
          check repo: the configuration (Git, schema, untracked files;
          with WSCONFIG=CORE_CHECKOUT the core: hygiene, syntax, executables);
          check home: home-manager generation, Nix, man pages, session;
          check widgets: the wswidgets runtime, adapter and IPC (ws-widgets
          check) and its manifest against hosts/HOST/widgets.toml (hosts with
          widgets = true);
          check virt: KVM, libvirt, VM storage @vms, NAT network, OVMF/TPM
          (hosts with vm = true in host.toml);
          check steam: Steam data on @steam in ~/.local/share/Steam (hosts
          with nativeSteam = true);
          check gaming: the Game Mode packages, services, display manager
          and session names (ws game check; hosts with gameMode = true);
          check backup: local copy root on its own subvolume, SSH alias and key;
          check apt compares system/apt.txt, apt.txt, hosts/<host>/apt.txt,
          system/apt-machine.txt (not in a container) and, with
          vm = true, virt/apt.txt, with nativeSteam = true, steam/apt.txt,
          with gameMode = true, gaming/apt.txt (the
          lists of ws setup) with the installed packages, report only;
          each takes --json (one result object, what ws check reads)
system    build the host system file tree (system) and compare it
          with the live system, read-only: diff shows file differences,
          check also unit states and prints OK/DIFFERS/MISSING per entry;
          files on the rEFInd ESP are compared only when it is mounted;
          apply (sudo) backs up and installs the files that differ, edits
          /etc/default/keyboard (GDM: EN only), resets /etc/default/grub to
          the package template (an installer may edit it; settings live in
          grub.d), enables and restarts units, reloads udev, rebuilds the initramfs
          if modprobe.d changed, runs update-grub if grub.d changed and
          sysctl --system if sysctl.d changed;
          it does not touch the ESP and does not reboot;
          manifest prints what the system layer owns (file MODE PATH,
          esp PARTUUID PATH, unit STATE NAME, restart - NAME, watch - PATH:
          files it depends on without installing them); tree prints the
          built tree (files/, esp/, manifest); both are what ws-baseline
          and the checks read
          apply records the tree it installed in
          ~/.local/state/wsconfig/system (applied: link and GC root,
          history: date, commit, tree, result)
baseline  functional baseline, see ws baseline --help
collect   archive of the machine state a rebuild needs and the repository
          does not hold (baseline, boot and disks, apt, Apple firmware,
          ~/.local/state/wsconfig), see ws-collect --help; asks sudo
btrfs     make: the Btrfs layout of a fresh install (@, @home, @cache, @tmp,
          @log) from the installed system; ws setup runs it (twice, a
          reboot through GRUB between); see ws-btrfs --help and ws help
          rebuild, section 3
setup     the first setup of this PC (ws help setup): install.sh runs it
          on a fresh Ubuntu; --repo URL|PATH a configuration that exists,
          --new [DIR] a new one; after each reboot it goes on by itself
backup    Timeshift snapshots to Unraid, then retain final local ro parents;
          plan/status work before SSH is configured; list shows the local
          copies (asks sudo);
          recovery-export OUTPUT writes autonomous Live USB ws-restore;
          see ws backup --help and ws help backup / ws help recovery
checkpoint  which commit matched which working state (home-manager
          generation, system tree, kernel, baseline), see ws checkpoint --help
container  image and container of a container host (boot = "container",
          ws help plan-wsgnomebox) on its server, see ws-container --help
host      print the flake host name used for this machine: WS_HOST, else
          the hosts/<host> whose host.toml has hostname = "$(hostname)";
          --for-marks: fail unless the name can stand in a list mark
fact      print a fact of this host, or of --host HOST (hardware, boot,
          user, vm, ...) from hosts/<host>/host.toml, without Nix
          (lib/ws_facts.py); true and false print as yes and no
MODULE    the owners of the layers, one command for each (ws help plan-v2,
          2.8); ARG... as the owner takes them, see ws MODULE --help:
            flatpak   Flatpak apps, remotes, overrides (ws flatpak)
            box       Distrobox containers (ws box)
            windows   Windows programs in the Windows boxes (ws windows)
            widgets   Quickshell widgets (ws widgets)
            game      Game Mode from Bazzite parts (ws game)
            keyboard  xremap and the GNOME shortcuts (ws keyboard)
            gnome     GNOME profile, extensions (ws gnome)
            suspend   suspend, hibernate, t2bce (ws suspend)
            backup    Timeshift snapshots to Unraid (ws backup)
            script    the scripts of the configuration, run by name (ws script)
USAGE
}

[[ $EUID -ne 0 ]] || die "run as the desktop user, not root"

# Host and string facts: lib/ws_facts.py, the one reader (ws help plan-v2,
# 2.2). host: WS_HOST, else the host whose host.toml has this hostname.
facts_py() { python3 "$WS_CORE/lib/ws_facts.py" "$@"; }
host() { facts_py host "$@" || exit 1; }
cmd_fact() { facts_py fact "$@"; }

target() {
    echo "$repo#$(id -un)@$(host)"
}

current_generation() {
    local p
    for p in "${XDG_STATE_HOME:-$HOME/.local/state}/nix/profiles/home-manager" \
        "/nix/var/nix/profiles/per-user/$(id -un)/home-manager"; do
        if [[ -e "$p" ]]; then
            readlink -f "$p"
            return
        fi
    done
}

# Data files: everything of the configuration (a repository of its own, ws
# help plan-v2, 8.6 and 8.11), published only by ws sync: what it tracks
# (staged new files too) and what HEAD has. ws check repo reads them
# (ws data-files).
data_files() {
    {
        git -C "$repo" ls-files --cached
        git -C "$repo" ls-tree -r --name-only HEAD 2>/dev/null
    } | awk '!seen[$0]++'
}

# Data files that differ from HEAD (staged or not, new or deleted).
changed_data_files() {
    local f
    while IFS= read -r f; do
        if ! git -C "$repo" cat-file -e "HEAD:$f" 2>/dev/null; then
            [[ -e "$repo/$f" ]] && echo "$f"
        elif [[ ! -e "$repo/$f" ]] || ! git -C "$repo" diff --quiet HEAD -- "$f" 2>/dev/null; then
            echo "$f"
        fi
    done < <(data_files)
}

# Files of the configuration that Git does not track (and does not
# ignore): neither ws apply nor ws sync adds them (ws help architecture-v2,
# 7); they are named instead. Those of auto_tracked (scripts/) they add
# first (add_module_files, lib/common.bash).
untracked_files() {
    git -C "$repo" ls-files --others --exclude-standard
}

# What changed in a data file against HEAD, for the commit message: a host
# choice NAME=yes, NAME=no, -NAME, overrides APP (lib/ws_catalog.py); the
# Flatpak catalog +APP, -APP, APP (fields) (lib/flatpak_catalog.py);
# a script +NAME (new), -NAME (deleted), edited; flake.lock: the inputs
# with a new revision.
data_summary() {
    local f="$1" old
    old="$(mktemp)"
    git -C "$repo" show "HEAD:$f" > "$old" 2>/dev/null || : > "$old"
    if [[ "$f" == flake.lock ]]; then
        python3 - "$old" "$repo/$f" <<'PY'
import json, sys
def revs(path):
    try:
        nodes = json.load(open(path)).get("nodes", {})
    except ValueError:
        return {}
    return {k: v.get("locked", {}).get("rev") or v.get("locked", {}).get("narHash") for k, v in nodes.items()}
old, new = revs(sys.argv[1]), revs(sys.argv[2])
print(", ".join(k for k in sorted(set(old) | set(new)) if old.get(k) != new.get(k) and k != "root"))
PY
    elif [[ "$f" == hosts/*/flatpak.toml || "$f" == hosts/*/boxes.toml || "$f" == hosts/*/widgets.toml \
        || "$f" == hosts/*/scripts.toml ]]; then
        python3 "$WS_CORE/lib/ws_catalog.py" summary "$old" "$repo/$f"
    elif [[ "$f" == flatpak/catalog.toml ]]; then
        python3 "$WS_CORE/lib/flatpak_catalog.py" summary "$old" "$repo/$f"
    elif [[ "$f" == scripts/* && "$f" != scripts/catalog.toml && "$f" != scripts/lib/* ]]; then
        if ! git -C "$repo" cat-file -e "HEAD:$f" 2>/dev/null; then
            echo "+${f#scripts/}"
        elif [[ ! -e "$repo/$f" ]]; then
            echo "-${f#scripts/}"
        else
            echo "edited"
        fi
    else
        echo
    fi
    rm -f "$old"
}

# The data files not published yet: changed ones, and those of local commits
# the upstream does not have. One line for the end of switch, apply and
# update nix; nothing when all is published.
unpublished_notice() {
    local -a pending=()
    local f
    mapfile -t pending < <({
        changed_data_files
        if git -C "$repo" rev-parse --verify -q '@{u}' >/dev/null 2>&1; then
            git -C "$repo" log --format= --name-only '@{u}..HEAD'
        fi
    } | sort -u | sed '/^$/d')
    ((${#pending[@]})) || return 0
    printf 'not published: %s (ws sync)\n' "${pending[*]}"
}

# A Git operation in progress: rebase, merge, cherry-pick, revert, bisect.
git_operation() {
    local p
    for p in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
        [[ -e "$(git -C "$repo" rev-parse --path-format=absolute --git-path "$p")" ]] && { echo "${p,,}"; return 0; }
    done
    return 1
}

cmd_sync() {
    local dry_run=false op f subject remote upstream branch
    local -a to_commit=() untracked=() body=()
    case "${1:-}" in
        --dry-run|-n) dry_run=true ;;
        "") ;;
        *) die "usage: ws sync [--dry-run]" ;;
    esac
    git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a Git checkout: $repo"

    if op="$(git_operation)"; then
        die "a Git operation is in progress ($op): finish or abort it first (git status)"
    fi
    branch="$(git -C "$repo" symbolic-ref -q --short HEAD)" \
        || die "HEAD is detached: check out a branch first"
    upstream="$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)" || upstream=""
    # Everything tracked is data; a new file is published only once added,
    # one of scripts/ by this (add_module_files).
    if [[ "$dry_run" == true ]]; then
        mapfile -t untracked < <(git -C "$repo" ls-files --others --exclude-standard -- "${auto_tracked[@]}")
        ((${#untracked[@]} == 0)) || echo "would add to Git and commit: ${untracked[*]}"
    else
        add_module_files || return 1
    fi
    mapfile -t untracked < <(untracked_files | grep -v -e "^scripts/" || true)
    ((${#untracked[@]} == 0)) \
        || echo "not tracked, not published: ${untracked[*]} (git -C $repo add FILE, then ws sync)"

    mapfile -t to_commit < <(changed_data_files)
    if ((${#to_commit[@]})); then
        for f in "${to_commit[@]}"; do
            body+=("$f: $(data_summary "$f" | sed 's/^$/edited/')")
        done
        subject="ws sync: ${to_commit[*]}"
        printf '%s\n' "${body[@]}"
        if [[ "$dry_run" == true ]]; then
            echo "would commit: $subject"
        else
            git -C "$repo" add -- "${to_commit[@]}"
            git -C "$repo" commit -q -m "$subject" -m "$(printf '%s\n' "${body[@]}")" -- "${to_commit[@]}" \
                || die "git commit failed"
            echo "committed: $subject"
        fi
    else
        echo "no changed data files"
    fi

    remote="$(git -C "$repo" remote | head -n1)"
    if [[ -z "$remote" ]]; then
        echo "no remote: the commit stays local"
    elif [[ -z "$upstream" ]]; then
        echo "no upstream for $branch: the commit stays local (to publish: git -C $repo push -u $remote $branch)"
    elif [[ "$dry_run" == true ]]; then
        echo "would run: git pull --rebase, git push ($upstream)"
    else
        if ! git -C "$repo" pull -q --rebase; then
            if git_operation >/dev/null; then
                cat >&2 <<MSG
ws sync: the rebase onto $upstream stopped on a conflict. By hand:
  git -C $repo status                 the files in conflict
  edit them, git -C $repo add FILE    then: git -C $repo rebase --continue
  or git -C $repo rebase --abort      back to the state before the pull
then ws sync again.
MSG
            else
                echo "ws sync: git pull --rebase failed (network? login?); nothing pushed" >&2
            fi
            return 1
        fi
        git -C "$repo" push -q || die "git push failed (network? login?); the commit is local"
        echo "pushed to $upstream"
    fi
}

# The flake sees only files Git knows: a new file of scripts/ is added
# (add_module_files), nothing else (ws help architecture-v2, 7); a file Git
# does not track is named instead.
stage_data() {
    local -a untracked=()
    add_module_files || return 2
    mapfile -t untracked < <(untracked_files)
    ((${#untracked[@]} == 0)) || {
        printf '%s: files the flake does not see (not tracked): %s\n  git -C %s add FILE (or .gitignore it), then ws apply\n' \
            "$ws_prog" "${untracked[*]}" "$repo" >&2
        return 2
    }
}

# home-manager switch of this host (stage 6 of ws apply). A file it would
# replace is kept as *.HOME_MANAGER_BACKUP_EXT when that is set (ws setup).
home_switch() {
    local nix
    nix="$(nix_bin)" || return
    "$nix" run "${nix_args[@]}" "$repo#home-manager" -- switch --flake "$(target)" "${nix_args[@]}" \
        ${HOME_MANAGER_BACKUP_EXT:+-b "$HOME_MANAGER_BACKUP_EXT"} || return
    # host.json: the ws in PATH, the core in the store, finds this
    # configuration and host through it (lib/ws_common.py).
    facts_py record
}

cmd_news() {
    local nix
    nix="$(nix_bin)"
    check_untracked
    "$nix" run "${nix_args[@]}" "$repo#home-manager" -- news --flake "$(target)" "${nix_args[@]}" "$@"
}

# This core reads the configuration: wsconfig.toml has a schema of
# lib/wsconfig-schema.toml (ws help plan-v2, 8.5); else exit 2 before Nix.
check_schema() {
    python3 "$WS_CORE/lib/ws_common.py" schema || return 2
}

cmd_diff() {
    local nix new old
    check_schema || return
    nix="$(nix_bin)" || return
    check_untracked || return
    new="$("$nix" build --no-link --print-out-paths "${nix_args[@]}" \
        "$repo#homeConfigurations.\"$(id -un)@$(host)\".activationPackage")" || return
    old="$(current_generation)"
    if [[ -z "$old" ]]; then
        echo "no home-manager generation yet; new: $new"
        return
    fi
    "$nix" run "${nix_args[@]}" "$repo#nvd" -- diff "$old" "$new"
}

# Layer owners in apply order: name, command.
# The modules: ws MODULE ARG... runs the owner of that layer (ws help
# plan-v2, 2.8). The fish completion reads this table (ws modules).
modules=(
    "flatpak wsflatpak"
    "box wsbox"
    "windows wswin"
    "widgets wswidgets"
    "game wsgame"
    "keyboard ws-keyboard"
    "gnome ws-gnome"
    "suspend ws-suspend"
    "backup wsbackup"
    "script wsscript"
)

module_owner() {
    local m
    for m in "${modules[@]}"; do
        [[ "${m%% *}" == "$1" ]] && { echo "${m#* }"; return 0; }
    done
    return 1
}

# Step tables (apply_steps, update_steps, check_steps): "NAME COMMAND" per
# entry. Shared by apply, update and check is only the walk (ws help plan-v2,
# 2.5): names, the selection, the step header and the summary. What a result
# means each command decides itself: apply OK/PREFLIGHT (69)/FAIL, update
# OK/FAIL, check the result object of lib/check.bash.

# Dies on a NAME that is not in the table: steps_check TABLE KIND NAME...
steps_check() {
    local -n steps_table="$1"
    local kind="$2" name step known
    shift 2
    for name in "$@"; do
        known=false
        for step in "${steps_table[@]}"; do
            [[ "${step%% *}" == "$name" ]] && known=true
        done
        [[ "$known" == true ]] || die "unknown $kind step: $name"
    done
}

# The entries of TABLE to run, in table order: all, or the NAMEs given.
# Read them with mapfile: the steps keep the terminal as their input.
steps_selected() {
    local -n steps_table="$1"
    local step
    shift
    for step in "${steps_table[@]}"; do
        if (($#)) && [[ " $* " != *" ${step%% *} "* ]]; then
            continue
        fi
        printf '%s\n' "$step"
    done
}

step_header() {
    printf '\n=== %s\n' "$1"
}

# steps_summary TITLE LINE...
steps_summary() {
    printf '\n=== %s\n' "$1"
    shift
    printf '  %s\n' "$@"
}

# The module steps of ws apply, in order: name, command (stage 7 below).
apply_steps=(
    "extensions ws-gnome extensions"
    "tiling ws-tiling-apply"
    "keyboard ws-keyboard-apply"
    "flatpak wsflatpak apply"
    "distrobox wsbox apply"
    "widgets wswidgets apply"
    "scripts wsscript apply"
)
# The names ws apply NAME... takes: home (only the Nix stages), apt,
# system and the module steps.
apply_names=(home apt system "${apply_steps[@]%% *}")

# The choices the apply steps may write, to see whether they changed.
marks_state() {
    local f
    while IFS= read -r f; do
        [[ "$f" == flake.lock ]] || { echo "$f"; cat "$repo/$f" 2>/dev/null; }
    done < <(data_files) | cksum
}

# ws apply [NAME...] (ws help architecture-v2, 8): one order for everything.
#   1. host and roots: new files of scripts/ added to Git, no other
#      untracked flake files
#   2. the new positions of the catalogs, one checklist (of the modules
#      named; without a terminal they stay ask)
#   3. build: the home-manager generation and the system tree
#   4. apt: what the apt lists lack (ws-apt; sudo only when there is some)
#   5. system: only when the tree differs from the live system (ws-system)
#   6. home-manager switch
#   7. the module steps, asking nothing (WS_OFFERED)
#   8. the summary and what is left: log out and in, reboot, ws apply
#      (apt or system not named but pending), ws sync
# NAME... runs 1-3 and 6 always (a module would see an old manifest), and of
# the rest only what is named. Exit 0: everything OK; 2: nothing applied
# (stages 1-3 failed); 1: a step failed or needs a log out and in.
cmd_apply() {
    local name step cmd rc out notes marks_before container=false
    local full=true home_ok=true failed=false
    local -a named=() results=() left=() modules=()

    for name; do
        [[ " ${apply_names[*]} " == *" $name "* ]] \
            || die "unknown apply step: $name (steps: ${apply_names[*]})"
        named+=("$name")
    done
    ((${#named[@]} == 0)) || full=false
    wanted() { [[ "$full" == true || " ${named[*]} " == *" $1 "* ]]; }

    notes="$(mktemp)"
    export WS_APPLY_NOTES="$notes"
    # shellcheck disable=SC2064 # the path now
    trap "rm -f '$notes'; trap - RETURN" RETURN

    # 1. Host and roots; this core reads the configuration.
    check_schema || return 2
    host >/dev/null
    [[ "$(cmd_fact boot 2>/dev/null)" != container ]] || container=true
    stage_data || return 2
    marks_before="$(marks_state)"

    # 2. Every question first.
    for name in flatpak distrobox widgets scripts; do
        wanted "$name" || continue
        case "$name" in
            distrobox) modules+=(boxes) ;;
            *) modules+=("$name") ;;
        esac
    done
    if ((${#modules[@]})); then
        step_header "choices: ws_catalog offer --all ${modules[*]}"
        rc=0
        python3 "$WS_CORE/lib/ws_catalog.py" offer --all "${modules[@]}" >/dev/null || rc=$?
        if ((rc != 0)); then
            steps_summary "ws apply" "FAIL      choices (exit $rc)" "nothing applied"
            return 2
        fi
        results+=("OK        choices")
        export WS_OFFERED=1
        # The choices are files of the flake now.
        stage_data || return 2
    fi

    # 3. Build what the stages apply; a failure leaves the system as it is.
    step_header "build: home-manager generation, system tree"
    if ! "$(nix_bin)" build --no-link "${nix_args[@]}" \
        "$repo#homeConfigurations.\"$(id -un)@$(host)\".activationPackage" \
        "$repo#system-$(host)"; then
        steps_summary "ws apply" "${results[@]}" "FAIL      build" "nothing applied"
        return 2
    fi
    results+=("OK        build")

    # 4, 5. apt and system: sudo only when there is something to do.
    for name in apt system; do
        # The packages of a container host are in its image; its system
        # tree too, but apply installs a newer one until the next image.
        if [[ "$container" == true && "$name" == apt ]]; then
            wanted apt && results+=("OK        apt (container host: in the image)")
            continue
        fi
        rc=0
        out="$("$WS_CORE/libexec/ws-$name" pending)" || rc=$?
        if ((rc != 0)); then
            results+=("FAIL      $name (cannot compare, exit $rc)")
            failed=true
            continue
        fi
        if ! wanted "$name"; then
            [[ -z "$out" ]] || left+=("ws apply $name: $(wc -l <<<"$out") to do")
            continue
        fi
        if [[ -z "$out" ]]; then
            results+=("OK        $name (nothing to do)")
            continue
        fi
        step_header "$name"
        printf '%s\n' "$out" | sed 's/^/to do: /'
        rc=0
        "$WS_CORE/libexec/ws-$name" apply || rc=$?
        if ((rc == 0)); then
            results+=("OK        $name")
        else
            results+=("FAIL      $name (exit $rc)")
            failed=true
        fi
    done

    # 6. home-manager: the manifests the module steps read.
    step_header "home: home-manager switch"
    if home_switch; then
        results+=("OK        home")
    else
        results+=("FAIL      home")
        failed=true
        home_ok=false
    fi

    # 7. The module steps; a command of a module applies nothing itself
    # here (apply_module of lib/common.bash).
    export WS_APPLYING=1
    for step in "${apply_steps[@]}"; do
        name="${step%% *}"
        cmd="${step#* }"
        wanted "$name" || continue
        if [[ "$home_ok" == false ]]; then
            results+=("SKIP      $name (home failed)")
            continue
        fi
        step_header "$name: $cmd"
        rc=0
        # shellcheck disable=SC2086 # cmd is a fixed command line
        ws_run $cmd || rc=$?
        case "$rc" in
            0) results+=("OK        $name") ;;
            69) results+=("PREFLIGHT $name")
                left+=("log out and in, then: ws apply $name")
                failed=true ;;
            *) results+=("FAIL      $name (exit $rc)"); failed=true ;;
        esac
    done

    # 8. Summary.
    # A module step wrote a choice (it should not after the checklist).
    [[ "$(marks_state)" == "$marks_before" ]] || left+=("choices changed: ws apply")
    while IFS= read -r out; do
        [[ -n "$out" ]] && left+=("$out")
    done < "$notes"
    out="$(unpublished_notice)"
    [[ -z "$out" ]] || left+=("$out")
    steps_summary "ws apply" "${results[@]}"
    if ((${#left[@]})); then
        printf '\n  left to do:\n'
        printf '    %s\n' "${left[@]}"
    fi
    [[ "$failed" == false ]] || return 1
}

# The update_* steps run where set -e is off (cmd_update): check each command.
update_apt() {
    sudo apt update || return
    sudo apt full-upgrade || return
    if apt-mark showhold | grep -qx linux-t2; then
        echo "linux-t2 held: a new kernel needs new t2bce modules (ws help suspend)"
    fi
}

# flake.lock goes back when nothing was applied (the build failed, exit 2
# of cmd_apply); once applying began it stays new: part of the system is of
# the new version (ws help architecture-v2, 12.3).
# flake update of the inputs NAME..., the package difference (nvd), ws
# apply; flake.lock goes back when nothing was applied (exit 2: the build or
# the schema of a new core failed).
update_inputs() {
    local nix backup rc=0
    nix="$(nix_bin)" || return
    check_untracked || return
    backup="$(mktemp)"
    cp "$repo/flake.lock" "$backup"
    "$nix" flake update "$@" --flake "$repo" || { cp "$backup" "$repo/flake.lock"; rm -f "$backup"; return 1; }
    cmd_diff || { cp "$backup" "$repo/flake.lock"; rm -f "$backup"; echo "flake.lock restored" >&2; return 1; }
    ( cmd_apply ) || rc=$?
    if ((rc == 2)); then
        cp "$backup" "$repo/flake.lock"
        echo "nothing applied; flake.lock restored" >&2
    elif ((rc != 0)); then
        echo "flake.lock stays new (applying had begun): fix the failed step and ws apply again," >&2
        echo "or go back by hand: git checkout flake.lock, ws apply" >&2
    fi
    rm -f "$backup"
    return "$rc"
}

# nixpkgs, home-manager and wswidgets of the configuration; the core stays
# (ws update core).
update_nix() {
    update_inputs nixpkgs home-manager wswidgets
}

# The core a configuration of its own pins (its input wsconfig, ws help
# plan-v2, 8.6): the newest revision, built and applied. A checkout of core
# and data together has no such input.
update_core() {
    if [[ -z "$(python3 "$WS_CORE/lib/ws_common.py" get "$repo/flake.lock" nodes root inputs wsconfig)" ]]; then
        echo "the configuration pins no core (no flake input wsconfig): nothing to update"
        return 0
    fi
    [[ -z "${WS_CORE_PATH:-}" ]] || die "ws update core with --core: the core is $WS_CORE_PATH, nothing is pinned"
    update_inputs wsconfig
}

update_extensions() {
    local list="$HOME/.local/share/wsconfig/gnome/extensions.json" pinned
    [[ -r "$list" ]] || die "extension list missing: $list (ws apply home)"
    # GNOME Shell updates every extension from EGO, a pinned copy too.
    pinned="$(manifest_get "$list" pins)"
    if [[ -n "$pinned" ]]; then
        echo "pinned EGO extensions would be replaced as well:" $pinned
        echo "update the others one by one in Extension Manager"
        return 1
    fi
    gdbus call --session --dest org.gnome.Shell.Extensions \
        --object-path /org/gnome/Shell/Extensions \
        --method org.gnome.Shell.Extensions.CheckForUpdates > /dev/null || return
    echo "GNOME Shell checks for extension updates; downloaded updates are"
    echo "installed at the next log out and in (Extension Manager shows them)"
}

update_steps=(
    "apt update_apt"
    "core update_core"
    "nix update_nix"
    "flatpak ws_run wsflatpak update -y"
    "distrobox ws_run wsbox update"
    "extensions update_extensions"
)

cmd_update() {
    local step name cmd rc
    local -a results=() selected=()
    local failed=false

    steps_check update_steps update "$@"
    mapfile -t selected < <(steps_selected update_steps "$@")
    for step in "${selected[@]}"; do
        name="${step%% *}"
        cmd="${step#* }"
        step_header "$name"
        rc=0
        # shellcheck disable=SC2086 # cmd is a fixed command line
        ( $cmd ) || rc=$?
        if ((rc == 0)); then
            results+=("OK    $name")
        else
            results+=("FAIL  $name (exit $rc)")
            failed=true
        fi
    done

    steps_summary "ws update" "${results[@]}"
    [[ "$failed" == false ]]
}

# Owner checks: name, command. Each runs with --json and prints one result
# object (lib/check.bash); ws check reads only that, not the text. verify
# (cross-layer) runs last: wsbox check has started the containers by then.
check_steps=(
    "repo ws-check-repo"
    "home ws-check-home"
    "keyboard ws-keyboard check"
    "gnome ws-gnome check"
    "widgets ws check widgets"
    "scripts wsscript check"
    "flatpak wsflatpak check"
    "distrobox wsbox check"
    "windows wswin check"
    "suspend ws-suspend check"
    "system ws system check"
    "apt ws check apt"
    "virt ws check virt"
    "steam ws check steam"
    "gaming wsgame check"
    "backup ws check backup"
    "verify ws-workstation-verify"
)

# The apt lists of ws-prepare against the installed system; reports only.
# A listed package that is missing or only auto-installed (apt autoremove
# could take it) is a WARN; manual packages outside the lists are listed.
cmd_check_apt() {
    local h pkg status name f
    local -a want=() extra=()
    local -A listed=() manual=()

    # shellcheck source=../lib/check.bash
    . "$WS_CORE/lib/check.bash"
    case "${1:-}" in
        --json) check_json_mode ;;
        "") ;;
        *) die "usage: ws check apt [--json]" ;;
    esac

    h="$(host)"
    # The lists of the host by its facts (lib/apt.bash).
    local host host_list container vm native_steam game_mode
    # shellcheck source=../lib/apt.bash
    . "$WS_CORE/lib/apt.bash"
    apt_host "$h"
    mapfile -t want < <(apt_lines | sed -e '/^ppa:/d' -e 's/^rec://' | sort -u)
    for pkg in $(printf '%s\n' "${want[@]}" | sed -n 's/^purge://p'); do
        if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q ' installed$'; then
            warn "installed, the host list purges it: $pkg (ws setup)"
        else
            pass "purged: $pkg"
        fi
    done
    # Repositories and architectures of the host list (ws setup).
    for name in $(printf '%s\n' "${want[@]}" | sed -n 's/^source://p'); do
        if cmp -s "$repo/hosts/$h/apt/$name.sources" "/etc/apt/sources.list.d/ws-$name.sources" \
            && cmp -s "$repo/hosts/$h/apt/$name.asc" "/etc/apt/keyrings/ws-$name.asc"; then
            pass "apt source: $name"
        else
            warn "apt source $name missing or not as hosts/$h/apt/$name.* (ws setup)"
        fi
    done
    # ws-NAME without its source: line: ws-prepare removes it.
    for f in /etc/apt/sources.list.d/ws-*.sources; do
        [[ -e "$f" ]] || continue
        name="${f##*/ws-}"
        name="${name%.sources}"
        printf '%s\n' "${want[@]}" | grep -qx "source:$name" \
            || warn "apt source ws-$name is in no apt list: apt still installs from it (ws setup removes it)"
    done
    for name in $(printf '%s\n' "${want[@]}" | sed -n 's/^arch://p'); do
        if dpkg --print-foreign-architectures | grep -qx "$name"; then
            pass "architecture: $name"
        else
            warn "architecture missing: $name (ws setup)"
        fi
    done
    mapfile -t want < <(printf '%s\n' "${want[@]}" | grep -v '^purge:\|^source:\|^arch:')
    while read -r pkg; do
        manual[$pkg]=1
    done < <(apt-mark showmanual)

    for pkg in "${want[@]}"; do
        listed[$pkg]=1
        status="$(dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null || true)"
        if [[ "$status" != *" ok installed" ]]; then
            warn "not installed: $pkg"
        elif [[ -z "${manual[$pkg]:-}" ]]; then
            warn "auto-installed, apt autoremove could remove it: $pkg (sudo apt-mark manual $pkg)"
        else
            pass "$pkg"
        fi
    done
    for pkg in "${!manual[@]}"; do
        [[ -n "${listed[$pkg]:-}" ]] || extra+=("$pkg")
    done
    info "${#extra[@]} manual packages are in no apt list of the host: $(printf '%s\n' "${extra[@]}" | sort | paste -sd' ')"
    check_finish
}

# Counts and messages of one result object: first line "WARNINGS FAILURES",
# then the messages to show (WARN/FAIL; all with -v). Fails on bad JSON.
check_result() {
    python3 "$WS_CORE/lib/ws_check.py" result "$1" "$2"
}

cmd_check() {
    local verbose=false step name cmd rc out err res counts warn fail
    local -a results=() selected=()
    local total_warn=0 total_fail=0

    case "${1:-}" in
        apt) shift; cmd_check_apt "$@"; return ;;
        repo) shift; exec "$WS_CORE/libexec/ws-check-repo" "$@" ;;
        home) shift; exec "$WS_CORE/libexec/ws-check-home" "$@" ;;
        virt|vm) shift; exec "$WS_CORE/libexec/ws-check-virt" "$@" ;;
        steam) shift; exec "$WS_CORE/libexec/ws-check-steam" "$@" ;;
        gaming|game) shift; exec "$WS_CORE/libexec/wsgame" check "$@" ;;
        backup) shift; exec "$WS_CORE/libexec/ws-check-backup" "$@" ;;
        widgets|widget) shift; exec "$WS_CORE/libexec/ws-check-widgets" "$@" ;;
        -v|--verbose) verbose=true ;;
        "") ;;
        *) die "unknown check option: $1" ;;
    esac

    out="$(mktemp)"
    err="$(mktemp)"
    trap 'rm -f "$out" "$err"; trap - RETURN' RETURN

    mapfile -t selected < <(steps_selected check_steps)
    for step in "${selected[@]}"; do
        name="${step%% *}"
        cmd="${step#* }"
        rc=0
        # shellcheck disable=SC2086 # cmd is a fixed command line
        ws_run $cmd --json > "$out" 2> "$err" || rc=$?
        step_header "$name: $cmd (exit $rc)"
        if res="$(check_result "$out" "$verbose")"; then
            counts="${res%%$'\n'*}"
            warn="${counts% *}"
            fail="${counts#* }"
            [[ "$res" != *$'\n'* ]] || printf '%s\n' "${res#*$'\n'}"
        else
            # No result object: the check itself broke.
            warn=0
            fail=1
            echo "  FAIL  no result from $cmd --json:"
            tail -n 5 "$err" | sed 's/^/        /'
        fi
        # A non-zero exit without failures still counts as one failure.
        if ((rc != 0 && fail == 0)); then
            fail=1
        fi

        total_warn=$((total_warn + warn))
        total_fail=$((total_fail + fail))
        if ((fail)); then
            results+=("FAIL  $name ($fail)")
        elif ((warn)); then
            results+=("WARN  $name ($warn)")
        else
            results+=("OK    $name")
        fi
    done

    steps_summary "ws check" "${results[@]}" "$(printf 'FAIL=%d WARN=%d' "$total_fail" "$total_warn")"
    ((total_fail == 0))
}

# --core PATH, anywhere after the command name of the commands that build
# (use_core, lib/common.bash).
case "${1:-}" in
    apply|diff|news|update|checkpoint|container)
        args=("$1")
        shift
        while (($#)); do
            case "$1" in
                --core) (($# >= 2)) || die "--core needs a PATH"; use_core "$2"; shift 2 ;;
                --core=*) use_core "${1#--core=}"; shift ;;
                *) args+=("$1"); shift ;;
            esac
        done
        set -- "${args[@]}"
        ;;
esac

if owner="$(module_owner "${1:-}")"; then
    shift
    exec "$WS_CORE/libexec/$owner" "$@"
fi

case "${1:-}" in
    apply) shift; cmd_apply "$@" ;;
    sync) shift; cmd_sync "$@" ;;
    check) shift; cmd_check "$@" ;;
    # Gone in ws help plan-v2, stage 6: one apply.
    switch) die "ws switch is gone: ws apply (or ws apply home for the home-manager generation only)" ;;
    diff) shift; cmd_diff "$@" ;;
    news) shift; cmd_news "$@" ;;
    update) shift; cmd_update "$@" ;;
    system) shift; exec "$WS_CORE/libexec/ws-system" "$@" ;;
    baseline) shift; exec "$WS_CORE/libexec/ws-baseline" "$@" ;;
    checkpoint) shift; exec "$WS_CORE/libexec/ws-checkpoint" "$@" ;;
    collect) shift; exec "$WS_CORE/libexec/ws-collect" "$@" ;;
    container) shift; exec "$WS_CORE/libexec/ws-container" "$@" ;;
    btrfs) shift; exec "$WS_CORE/libexec/ws-btrfs" "$@" ;;
    setup) shift; exec "$WS_CORE/libexec/ws-setup" "$@" ;;
    # Diagnostics of the hardware, run by hand (ws help workstation, plan-dgpu).
    battery) shift; exec "$WS_CORE/libexec/ws-battery" "$@" ;;
    gmux) shift; exec "$WS_CORE/libexec/ws-gmux" "$@" ;;
    psr) shift; exec "$WS_CORE/libexec/ws-psr" "$@" ;;
    gpu) shift; exec "$WS_CORE/libexec/ws-gpu" "$@" ;;
    host) shift; host "$@" ;;
    fact) shift; cmd_fact "$@" ;;
    # The data files and what of them is not published (ws check repo).
    data-files) data_files ;;
    unpublished) unpublished_notice ;;
    modules) printf '%s\n' "${modules[@]}" ;;
    # Step names of apply, update and check, one per line: the fish
    # completion reads them from here instead of keeping its own list.
    steps)
        case "${2:-}" in
            apply) printf '%s\n' "${apply_names[@]}" ;;
            update) printf '%s\n' "${update_steps[@]%% *}" ;;
            check) printf '%s\n' "${check_steps[@]%% *}" ;;
            *) die "usage: ws steps apply|update|check" ;;
        esac
        ;;
    help) shift; exec "$WS_CORE/libexec/helpws" "$@" ;;
    -h|--help) usage ;;
    "") usage; exit 1 ;;
    *) usage >&2; exit 1 ;;
esac
