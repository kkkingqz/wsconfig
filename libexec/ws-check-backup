#!/usr/bin/env bash
set -u
set -o pipefail

# Backup to Unraid (ws help backup), local side only: the copy root is mounted
# from its own top-level subvolume (fstab, like @vms) and the SSH alias has its
# key. No sudo, no network; ws backup check --remote asks the receiver.
# Read-only. ws check backup; ws check runs it with --json (lib/check.bash).

# shellcheck source=../lib/common.bash
. "$(dirname "$(readlink -f "$0")")/../lib/common.bash"
# shellcheck source=../lib/check.bash
. "$WS_CORE/lib/check.bash"

case "${1:-}" in
    --json) check_json_mode ;;
    "") ;;
    -h|--help) echo "Usage: ws-check-backup [--json]  (ws check backup)"; exit 0 ;;
    *) echo "ws-check-backup: unknown argument: $1" >&2; exit 64 ;;
esac

section "1. Configuration"

# backup/config.toml and hosts/HOST/backup.toml of the configuration, else
# the former config.json of the state (lib/backup.py current_config).
values="$(python3 - "$WS_CORE/lib" <<'PY' 2>&1
import sys
sys.path.insert(0, sys.argv[1])
import backup
try:
    c = backup.current_config()
except ValueError as e:
    print("error", e)
    sys.exit(0)
toml = backup.read_toml() is not None
where = " + ".join(str(p) for p in backup.toml_paths() if p.exists()) if toml else str(backup.config_path())
print("ok", int(len(c) > 1), int(toml), int(backup.migration() is not None), where)
print(c.get("source_snapshot_root", ""), c.get("source_fs_uuid", ""), c.get("ssh_host", ""))
PY
)" || { fail "unreadable configuration: $values"; check_finish; exit; }
read -r state configured _ old where <<<"$(head -n1 <<<"$values")"
if [[ "$state" != ok ]]; then
    fail "configuration: ${values#error }"
    check_finish
    exit
fi
if [[ "$configured" == 0 ]]; then
    info "not configured: backup/config.toml and hosts/HOST/backup.toml of the configuration (ws help backup)"
    check_finish
    exit
fi
read -r root fs_uuid ssh_host <<<"$(sed -n 2p <<<"$values")"
[[ -n "$root" && -n "$fs_uuid" && -n "$ssh_host" ]] \
    && pass "configuration: $where" \
    || fail "incomplete configuration (ws backup check): $where"
[[ "$old" == 0 ]] \
    || warn "the former $where: write the TOML of the configuration instead (ws backup check prints it)"

section "2. Local copy root"

if [[ -z "$root" ]]; then
    :
elif [[ ! -d "$root" ]]; then
    fail "missing: $root; create top-level @wsbackup and mount it there (ws help backup)"
else
    read -r target fstype uuid options < <(findmnt -nro TARGET,FSTYPE,UUID,OPTIONS -T "$root")
    if [[ "$target" != "$root" ]]; then
        fail "$root is not a mount: a subvolume inside $target moves with it on restore (ws help backup)"
    elif [[ "$fstype" != btrfs || "$uuid" != "$fs_uuid" ]]; then
        fail "$root: expected Btrfs $fs_uuid, found $fstype $uuid"
    elif [[ ! ",$options," =~ ,subvol=/?(@[A-Za-z0-9_-]+), || "${BASH_REMATCH[1]}" == @home ]]; then
        fail "$root: not its own top-level subvolume ($options)"
    else
        pass "$root mounted from ${BASH_REMATCH[1]}"
        awk -v t="$root" '$1 !~ /^#/ && $2 == t' /etc/fstab | grep -q . \
            && pass "$root in /etc/fstab" \
            || warn "$root is mounted but not in /etc/fstab: gone after reboot (ws help backup)"
    fi
fi

section "3. SSH"

if [[ -n "$ssh_host" ]] && have ssh; then
    key="$(ssh -G "$ssh_host" 2>/dev/null | awk '$1 == "identityfile" {print $2; exit}')"
    key="${key/#\~/$HOME}"
    if [[ "$(ssh -G "$ssh_host" 2>/dev/null | awk '$1 == "hostname" {print $2}')" == "$ssh_host" ]]; then
        fail "no Host $ssh_host in ~/.ssh/config (ws help backup)"
    elif [[ -n "$key" && -f "$key" ]]; then
        pass "$ssh_host: key $key"
    else
        fail "$ssh_host: key file missing: ${key:-none}"
    fi
fi

check_finish
