#!/usr/bin/env bash
set -euo pipefail

# Declared in distrobox/catalog.toml; ws apply builds
# ~/.local/share/wsconfig/distrobox. wsbox only reads it: boxes.json (the
# containers, their hooks and exports) and containers.ini for distrobox
# assemble, rendered first (@HOST_VERSION_ID@: the host release from
# /etc/os-release).
cfg="${WSBOX_CONFIG:-$HOME/.local/share/wsconfig/distrobox}"
manifest_source="$cfg/containers.ini"
manifest="${XDG_RUNTIME_DIR:-/tmp}/wsbox-$(id -u)/containers.ini"
boxes_manifest="$cfg/boxes.json"
# The copies of the hooks the containers run (distrobox/distrobox.nix).
hooks_dir="${WSBOX_HOOKS:-$HOME/.local/share/wsconfig/hooks}"
# shellcheck source=../lib/common.bash
. "$(dirname "$(readlink -f "$0")")/../lib/common.bash"
ws_prog="ws box"
# Which containers this host has: nix/hosts/HOST/boxes.toml in the
# configuration, yes = [...], no = [...]; a container in neither has its
# default of distrobox/catalog.toml (boxes.json; lib/ws_catalog.py). create/apply NAME
# put it in yes, remove in no, apply asks about the containers in state ask;
# ws sync publishes the file.
catalog_py="$WS_CORE/lib/ws_catalog.py"
select_hint="ws box apply --select"

usage() {
    cat <<'USAGE'
Usage:
  ws box list
  ws box status [NAME]
  ws box check [--json]
  ws box dry-run [NAME]
  ws box apply [--select | NAME]
  ws box update [NAME...]
  ws box create NAME
  ws box enter NAME
  ws box run NAME COMMAND [ARG...]
  ws box stop NAME
  ws box remove NAME
  ws box recreate NAME
  ws box apps [NAME]
  ws box export NAME APP
  ws box unexport NAME APP
USAGE
}

ensure_base() {
    need podman
    need distrobox
    need distrobox-assemble
    [[ -r "$manifest_source" ]] || die "manifest not found: $manifest_source (run ws apply distrobox)"
    [[ -r "$boxes_manifest" ]] || die "boxes manifest not found: $boxes_manifest (run ws apply distrobox)"
    render_manifest
}

host_version_id() {
    (
        . /etc/os-release
        [[ "${ID:-}" == ubuntu && -n "${VERSION_ID:-}" ]] || exit 1
        printf '%s\n' "$VERSION_ID"
    )
}

render_manifest() {
    local version=""

    if grep -Fq '@HOST_VERSION_ID@' "$manifest_source"; then
        version="$(host_version_id)" \
            || die "the manifest uses the host Ubuntu release, but /etc/os-release is not Ubuntu"
    fi

    mkdir -p "${manifest%/*}"
    sed "s/@HOST_VERSION_ID@/$version/g" "$manifest_source" > "$manifest.tmp"
    mv -f "$manifest.tmp" "$manifest"
}

# The containers of boxes.json, in order.
managed_boxes() {
    manifest_get "$boxes_manifest"
}

# A value of a box in boxes.json: ${HOME} in home and the host release in
# the image as containers.ini has them once rendered.
box_value() {
    local value
    value="$(manifest_get "$boxes_manifest" "$@")"
    value="${value//\$\{HOME\}/$HOME}"
    if [[ "$value" == *@HOST_VERSION_ID@* ]]; then
        value="${value//@HOST_VERSION_ID@/$(host_version_id || true)}"
    fi
    printf '%s\n' "$value"
}

# The boxes with exports.
export_sections() {
    local name
    while IFS= read -r name; do
        [[ -z "$(manifest_get "$boxes_manifest" "$name" exports)" ]] || printf '%s\n' "$name"
    done < <(managed_boxes)
}

export_aliases() {
    manifest_get "$boxes_manifest" "$1" exports
}

export_source() {
    box_value "$1" exports "$2"
}

# HOOK lines of every box (init_hooks, pre_init_hooks): sh, the hook, its
# arguments (distrobox/distrobox.nix).
box_hooks() {
    local name
    while IFS= read -r name; do
        manifest_get "$boxes_manifest" "$name" pre_init_hooks
        manifest_get "$boxes_manifest" "$name" init_hooks
    done < <(managed_boxes)
}

# The workstation (ws host) into ws_host, once, in this shell: commands call
# it before they change anything. The name must fit a host directory
# (ws host --for-marks).
load_host() {
    [[ -z "${ws_host:-}" ]] || return 0
    ws_host="$("$WS_CORE/bin/ws" host --for-marks)" \
        || die "no host for nix/hosts/HOST/boxes.toml (ws host --for-marks)"
    hosts_file="nix/hosts/$ws_host/boxes.toml"
}

choice() {
    load_host
    python3 "$catalog_py" --host "$ws_host" boxes "$@"
}

this_host() {
    load_host
    printf '%s\n' "$ws_host"
}

# NAME<TAB>DEFAULT of every managed container (ask without one: a
# boxes.json from before the defaults).
box_defaults() {
    local name default
    while IFS=$'\t' read -r name default; do
        [[ -n "$name" ]] && printf '%s\t%s\n' "$name" "${default:-ask}"
    done < <(manifest_rows "$boxes_manifest" name,default)
}

# NAME STATE lines for every managed container on this host.
box_states() {
    local -a boxes
    mapfile -t boxes < <(box_defaults | tr '\t' =)
    ((${#boxes[@]})) || return 0
    choice states "${boxes[@]}"
}

mark_box() {
    choice set "$2" "$1"
}

is_managed() {
    managed_boxes | grep -Fxq -- "$1"
}

require_managed() {
    [[ -n "${1:-}" ]] || die "container name required"
    is_managed "$1" || die "not a managed container: $1"
}

is_managed_export() {
    local name="$1" alias="$2"
    export_aliases "$name" | grep -Fxq -- "$alias"
}

require_managed_export() {
    local name="$1" alias="$2"

    [[ -n "$alias" ]] || die "managed app alias required"
    is_managed_export "$name" "$alias" \
        || die "not a managed export: $name/$alias"
}

container_exists() {
    podman container exists "$1" >/dev/null 2>&1
}

container_state() {
    podman inspect \
        --format '{{.State.Status}}' \
        "$1" \
        2>/dev/null \
        || printf 'unknown\n'
}

container_image() {
    podman inspect \
        --format '{{.ImageName}}' \
        "$1" \
        2>/dev/null \
        || podman inspect \
            --format '{{.Config.Image}}' \
            "$1" \
            2>/dev/null \
        || printf 'unknown\n'
}

# The container runs the manifest image: same name, or, for an image pinned
# by digest (name@sha256:...), an image with that repo digest.
image_matches() {
    local name="$1" expected="$2" id

    [[ "$(container_image "$name")" == "$expected" ]] && return 0
    [[ "$expected" == *@sha256:* ]] || return 1
    id="$(podman inspect --format '{{.Image}}' "$name" 2>/dev/null)" || return 1
    podman image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$id" 2>/dev/null \
        | grep -Fxq -- "$expected"
}

# distrobox enter flags of a box: gpu=amd passes DRI_PRIME for the AMD card
# when this boot has it (ws-gpu), per call, so the container itself stays
# the same in both boots.
enter_flags() {
    local name="$1" prime

    [[ "$(box_value "$name" gpu)" == amd ]] || return 0
    prime="$("$WS_CORE/libexec/ws-gpu" env)"
    [[ -n "$prime" ]] || return 0
    printf '%s\n' --additional-flags "--env $prime"
}

container_exec() {
    local name="$1"
    shift

    distrobox enter \
        --name "$name" \
        -- "$@"
}

export_source_exists() {
    local name="$1" source="$2"

    container_exec "$name" test -f "$source" \
        >/dev/null 2>&1
}

export_host_path() {
    local name="$1" source="$2"
    printf '%s/.local/share/applications/%s-%s\n' \
        "$HOME" "$name" "$(basename "$source")"
}

export_launcher_targets() {
    local name="$1" launcher="$2" exec_line

    [[ -f "$launcher" ]] || return 1
    exec_line="$(grep -m1 '^Exec=' "$launcher" 2>/dev/null || true)"

    [[ "$exec_line" == *distrobox-enter* ]] || return 1
    [[ "$exec_line" == *"-n $name"* ]] || return 1
}

export_state() {
    local name="$1" source="$2" launcher

    if ! export_source_exists "$name" "$source"; then
        printf 'missing-source\n'
        return 0
    fi

    launcher="$(export_host_path "$name" "$source")"

    if [[ ! -f "$launcher" ]]; then
        printf 'not-exported\n'
    elif export_launcher_targets "$name" "$launcher"; then
        printf 'exported\n'
    else
        printf 'drift\n'
    fi
}

export_one() {
    local name="$1" alias="$2" source launcher

    require_managed "$name"
    require_managed_export "$name" "$alias"
    container_exists "$name" || die "container does not exist: $name"

    source="$(export_source "$name" "$alias")"
    [[ -n "$source" ]] || die "empty export source: $name/$alias"

    export_source_exists "$name" "$source" \
        || die "managed export source missing: $name/$alias: $source"

    launcher="$(export_host_path "$name" "$source")"

    if export_launcher_targets "$name" "$launcher"; then
        printf 'Already exported: %s/%s\n' "$name" "$alias"
        return 0
    fi

    rm -f -- "$launcher"

    container_exec "$name" distrobox-export \
        --app "$source" \
        --export-label none

    export_launcher_targets "$name" "$launcher" \
        || die "export did not create a valid launcher: $launcher"

    printf 'Exported: %s/%s -> %s\n' "$name" "$alias" "$launcher"
}

unexport_one() {
    local name="$1" alias="$2" source launcher

    require_managed "$name"
    require_managed_export "$name" "$alias"
    container_exists "$name" || die "container does not exist: $name"

    source="$(export_source "$name" "$alias")"
    [[ -n "$source" ]] || die "empty export source: $name/$alias"
    launcher="$(export_host_path "$name" "$source")"

    if export_source_exists "$name" "$source"; then
        container_exec "$name" distrobox-export \
            --app "$source" \
            --delete \
            >/dev/null 2>&1 \
            || true
    fi

    rm -f -- "$launcher"
    printf 'Unexported: %s/%s\n' "$name" "$alias"
}

apply_exports_for() {
    local name="$1" alias source state

    container_exists "$name" || return 0

    while IFS= read -r alias; do
        [[ -n "$alias" ]] || continue
        source="$(export_source "$name" "$alias")"

        if [[ -z "$source" ]] || ! export_source_exists "$name" "$source"; then
            printf '  WARN  managed export source missing: %s/%s: %s (install it, then ws box apply %s)\n' \
                "$name" "$alias" "${source:-<empty>}" "$name"
            continue
        fi

        state="$(export_state "$name" "$source")"

        if [[ "$state" == exported ]]; then
            printf '  PASS  managed export already present: %s/%s\n' \
                "$name" "$alias"
            continue
        fi

        export_one "$name" "$alias"
    done < <(export_aliases "$name")
}

status_one() {
    local name="$1"
    local expected_image
    local expected_home
    local state
    local actual_image
    local home_state

    expected_image="$(box_value "$name" image)"
    expected_home="$(box_value "$name" home)"

    if container_exists "$name"; then
        state="$(container_state "$name")"
        actual_image="$(container_image "$name")"
    else
        state="missing"
        actual_image="-"
    fi

    if [[ -d "$expected_home" ]]; then
        home_state="present"
    else
        home_state="absent"
    fi

    printf '%-15s %-12s %-38s %-8s %s\n' \
        "$name" \
        "$state" \
        "$actual_image" \
        "$home_state" \
        "$expected_home"
}

cmd_list() {
    distrobox list --no-color
}

cmd_status() {
    local name="${1:-}"

    printf '%-15s %-12s %-38s %-8s %s\n' \
        NAME STATE IMAGE HOME PATH

    printf '%s\n' \
        '-----------------------------------------------------------------------------------------------'

    if [[ -n "$name" ]]; then
        require_managed "$name"
        status_one "$name"
    else
        while IFS= read -r name; do
            [[ -n "$name" ]] && status_one "$name"
        done < <(managed_boxes)
    fi

    local extras=""

    extras="$(
        podman ps -a \
            --filter label=manager=distrobox \
            --format '{{.Names}}' \
            2>/dev/null \
        | while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            is_managed "$name" || printf '%s\n' "$name"
        done
    )"

    if [[ -n "$extras" ]]; then
        echo
        echo "Unmanaged Distrobox containers:"
        printf '  %s\n' $extras
    fi
}

check_exports_for() {
    local name="$1" alias source launcher

    container_exists "$name" || return 0

    while IFS= read -r alias; do
        [[ -n "$alias" ]] || continue
        source="$(export_source "$name" "$alias")"

        if [[ -z "$source" ]] || ! export_source_exists "$name" "$source"; then
            warn "managed export source missing: $name/$alias: ${source:-<empty>}"
            continue
        fi

        pass "managed export source exists: $name/$alias"
        launcher="$(export_host_path "$name" "$source")"

        if [[ ! -f "$launcher" ]]; then
            fail "managed export missing: $name/$alias: $launcher"
        elif export_launcher_targets "$name" "$launcher"; then
            pass "managed export launcher valid: $name/$alias"
        else
            fail "managed export launcher drift: $name/$alias: $launcher"
        fi
    done < <(export_aliases "$name")
}

cmd_check() {
    local name
    local expected_image
    local actual_image
    local expected_home
    local hook path core_installed pkgbuild readme_sum ntsync_hook host state box_state marks_err
    local -A states=()

    # Result contract of ws check (--json): lib/check.bash.
    # shellcheck source=../lib/check.bash
    . "$WS_CORE/lib/check.bash"
    case "${1:-}" in
        --json) check_json_mode ;;
        "") ;;
        *) die "usage: ws box check [--json]" ;;
    esac

    # Host packages (podman, distrobox, uidmap, …) are listed in nix/hosts/apt.txt
    # and checked by `ws check apt`.
    for p in podman distrobox distrobox-assemble; do
        if command -v "$p" >/dev/null 2>&1; then
            pass "command present: $p"
        else
            fail "command missing: $p (nix/hosts/apt.txt, ws check apt)"
        fi
    done

    if [[ "$(
        podman info \
            --format '{{.Host.Security.Rootless}}' \
            2>/dev/null \
            || true
    )" == "true" ]]
    then
        pass "Podman rootless"
    else
        fail "Podman is not rootless"
    fi

    if [[ -r "$manifest" ]]; then
        pass "manifest present"
    else
        fail "manifest missing"
    fi

    # Errors apart from the NAME STATE lines: a warning must not become a box.
    marks_err="$(mktemp)"
    if host="$(this_host 2>"$marks_err")" && box_state="$(box_states 2>"$marks_err")"; then
        while read -r name state; do
            [[ -n "$name" ]] && states[$name]="$state"
        done <<<"$box_state"
        hosts_file="nix/hosts/$host/boxes.toml"
        pass "host choice read: $host ($hosts_file)"
        while read -r name; do
            [[ -n "$name" ]] || continue
            is_managed "$name" || warn "$hosts_file chooses an undeclared container: $name"
        done < <(choice chosen 2>/dev/null)
    else
        fail "host choice: $(tr '\n' ' ' < "$marks_err")"
        host=unknown
    fi
    rm -f "$marks_err"

    if [[ -r "$boxes_manifest" ]]; then
        pass "boxes manifest present"
    else
        fail "boxes manifest missing"
    fi

    if [[ -r "$boxes_manifest" ]]; then
        pass "exports manifest present"

        while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            if is_managed "$name"; then
                pass "exports section targets managed container: $name"
            else
                fail "exports section targets unmanaged container: $name"
            fi
        done < <(export_sections)
    else
        fail "exports manifest missing"
    fi

    while IFS= read -r name; do
        [[ -n "$name" ]] || continue

        expected_image="$(box_value "$name" image)"
        expected_home="$(box_value "$name" home)"

        state="${states[$name]:-ask}"

        if ! container_exists "$name"; then
            case "$state" in
                yes) fail "managed container missing: $name (yes on $host; ws box apply)" ;;
                no) info "managed container declined on $host: $name ($select_hint)" ;;
                *) info "managed container not offered on $host yet: $name (ws box apply asks)" ;;
            esac
            continue
        fi

        case "$state" in
            yes) pass "managed container exists: $name" ;;
            no) warn "managed container exists but no on $host: $name (ws box remove $name, or ws box apply $name)" ;;
            *) warn "managed container exists but not chosen on $host: $name (ws box apply puts it in yes)" ;;
        esac

        actual_image="$(container_image "$name")"

        if image_matches "$name" "$expected_image"; then
            pass "$name image matches manifest"
        else
            fail "$name image drift: got $actual_image, expected $expected_image (ws box recreate $name)"
        fi

        if [[ -d "$expected_home" ]]; then
            pass "$name custom HOME exists"
        else
            fail "$name custom HOME missing: $expected_home"
        fi

        check_exports_for "$name"
    done < <(managed_boxes)

    while IFS= read -r name; do
        [[ -n "$name" ]] || continue

        if ! is_managed "$name"; then
            warn "unmanaged Distrobox container: $name"
        fi

    done < <(
        podman ps -a \
            --filter label=manager=distrobox \
            --format '{{.Names}}' \
            2>/dev/null
    )

    # Every hook the manifest runs: sh and a copy in hooks_dir of the hook
    # of the installed core (ws apply home renews the copies).
    core_installed="$(readlink -f "$HOME/.local/share/wsconfig/libexec/.." 2>/dev/null || true)"
    while IFS= read -r hook; do
        path="${hook#"$hooks_dir"/}"
        if [[ "$hook" != "$hooks_dir"/* ]]; then
            fail "hook not under $hooks_dir (run by sh): $hook"
        elif [[ ! -r "$hook" ]]; then
            fail "hook missing: $hook (ws apply home)"
        elif ! cmp -s -- "$hook" "$core_installed/distrobox/$path"; then
            fail "hook differs from distrobox/$path of the installed core (ws apply home)"
        else
            pass "hook in place: distrobox/$path"
        fi
    done < <(box_hooks | awk '$1 == "sh" { print $2; next } { print $1 }' | sort -u)

    # wsbox-host-ntsync: the Arch package that stands in for the kernel
    # module the host provides (NTSYNC-MODULE).
    pkgbuild="$WS_CORE/distrobox/arch/wsbox-host-ntsync/PKGBUILD"
    if bash -n "$pkgbuild" >/dev/null 2>&1; then
        pass "bash syntax: distrobox/arch/wsbox-host-ntsync/PKGBUILD"
    else
        fail "bash syntax error: distrobox/arch/wsbox-host-ntsync/PKGBUILD"
    fi
    readme_sum="$(sha256sum "${pkgbuild%/*}/README.md" 2>/dev/null | cut -d' ' -f1)"
    if grep -Fq "sha256sums=(\"$readme_sum\")" "$pkgbuild"; then
        pass "wsbox-host-ntsync PKGBUILD checksum matches README.md"
    else
        fail "wsbox-host-ntsync PKGBUILD sha256sums does not match README.md (makepkg fails; update it and pkgrel)"
    fi
    ntsync_hook="$hooks_dir/arch/wsbox-host-ntsync/install-hook"
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        if [[ "$(podman inspect -f '{{.State.Running}}' "$name" 2>/dev/null || true)" != true ]]; then
            info "$name not running; wsbox-host-ntsync not checked"
            continue
        fi
        if podman exec "$name" pacman -Q wsbox-host-ntsync >/dev/null 2>&1; then
            pass "$name: wsbox-host-ntsync installed"
        else
            fail "$name: wsbox-host-ntsync missing (ws box recreate $name)"
        fi
        for pkg in linux mkinitcpio mkinitcpio-busybox; do
            if podman exec "$name" pacman -Q "$pkg" >/dev/null 2>&1; then
                fail "$name: container-local kernel/initramfs package should be absent: $pkg"
            else
                pass "$name: container-local package absent: $pkg"
            fi
        done
    done < <(for name in $(managed_boxes); do
        manifest_get "$boxes_manifest" "$name" init_hooks | grep -Fq -- "sh $ntsync_hook " && echo "$name"
    done)

    check_finish
}

cmd_dry_run() {
    local name="${1:-}"
    local args=(
        create
        --file "$manifest"
        --dry-run
    )

    if [[ -n "$name" ]]; then
        require_managed "$name"
        args+=(--name "$name")
    fi

    distrobox assemble "${args[@]}"
}

cmd_apply() {
    local name="" box state states chosen rc=0 host
    local -a items=() select=()
    local -A wanted=() defaults=()

    case "${1:-}" in
        --select) select=(--select) ;;
        "") ;;
        *) name="$1" ;;
    esac

    load_host
    host="$ws_host"

    if [[ -n "$name" ]]; then
        require_managed "$name"
        distrobox assemble create --file "$manifest" --name "$name"
        apply_exports_for "$name"
        mark_box "$name" yes
        return
    fi

    # yes: created without asking; ask: offered, the answer is written to
    # the host choice; no: left alone unless --select. An existing
    # container in state ask goes to yes. The choice is read first: an
    # unreadable file stops apply here instead of leaving it with nothing
    # to do.
    states="$(box_states)" || die "cannot read $hosts_file"
    while IFS=$'\t' read -r box state; do
        [[ -n "$box" ]] && defaults[$box]="$state"
    done < <(box_defaults)
    while read -r box state; do
        [[ -n "$box" ]] || continue
        if container_exists "$box"; then
            case "$state" in
                ask) mark_box "$box" yes ;;
                no) printf 'WARNING: %s exists but is no on %s\n' "$box" "$host" >&2 ;;
            esac
        elif [[ "$state" == yes ]]; then
            wanted[$box]=1
        elif [[ "$state" == ask || ( "$state" == no && ${#select[@]} -gt 0 ) ]]; then
            items+=("$box"$'\t'"${defaults[$box]:-ask}"$'\t'"$(box_value "$box" image)")
        fi
    done <<<"$states"

    # ws apply asked already (ws_catalog offer --all).
    [[ -z "${WS_OFFERED:-}" || ${#select[@]} -gt 0 ]] || items=()
    if ((${#items[@]})); then
        chosen="$(choice offer "${select[@]}" --what "контейнеры Distrobox" -- "${items[@]}")" || rc=$?
        case "$rc" in
            0)
                while IFS= read -r box; do
                    [[ -z "$box" ]] || wanted[$box]=1
                done <<<"$chosen"
                [[ -n "${WS_APPLYING:-}" ]] \
                    || printf 'Choice of %s written to %s; then: ws apply distrobox (links the launchers)\n' "$host" "$hosts_file"
                ;;
            2)
                # Cancel answers only the question: the offered containers
                # stay ask; those in yes are still created.
                printf 'ws box: выбор отменён, предложенные контейнеры не тронуты (спросит в следующий раз)\n' >&2
                ;;
            3)
                ((${#select[@]} == 0)) || die "$select_hint: needs a terminal"
                printf 'Not offered on %s yet (no terminal to ask): %s; run ws box apply in a terminal\n' \
                    "$host" "$(echo $chosen)" >&2
                ;;
            *) exit "$rc" ;;
        esac
    fi

    # One container at a time, in manifest order.
    while IFS= read -r box; do
        if [[ -n "$box" && -n "${wanted[$box]:-}" ]]; then
            distrobox assemble create --file "$manifest" --name "$box"
        fi
    done < <(managed_boxes)

    while IFS= read -r box; do
        if [[ -n "$box" ]]; then
            apply_exports_for "$box"
        fi
    done < <(managed_boxes)
}

# Packages inside the containers, with their own package manager
# (distrobox upgrade). The image itself changes only on recreate.
cmd_update() {
    local name
    local -a names=() failed=()

    if (($#)); then
        for name in "$@"; do
            require_managed "$name"
            container_exists "$name" || die "container does not exist: $name"
            names+=("$name")
        done
    else
        while IFS= read -r name; do
            [[ -n "$name" ]] && container_exists "$name" && names+=("$name")
        done < <(managed_boxes)
    fi

    # A host may have none (nix/hosts/HOST/boxes.toml): nothing to update.
    if ((${#names[@]} == 0)); then
        echo "no managed container on this workstation: nothing to update (ws box apply)"
        return 0
    fi

    for name in "${names[@]}"; do
        printf '\n== %s\n' "$name"
        distrobox upgrade "$name" || failed+=("$name")
    done

    if ((${#failed[@]})); then
        printf '\nwsbox update failed: %s\n' "${failed[*]}" >&2
        return 1
    fi
}

cmd_create() {
    local name="${1:-}"

    require_managed "$name"
    load_host

    container_exists "$name" \
        && die "container already exists: $name"

    distrobox assemble create \
        --file "$manifest" \
        --name "$name"

    mark_box "$name" yes
}

cmd_enter() {
    local name="${1:-}"

    require_managed "$name"

    container_exists "$name" \
        || die "container does not exist: $name"

    local -a flags
    mapfile -t flags < <(enter_flags "$name")

    exec distrobox enter \
        --name "$name" \
        "${flags[@]}"
}

cmd_run() {
    local name="${1:-}"

    [[ -n "$name" ]] \
        || die "container name required"

    shift || true

    require_managed "$name"

    container_exists "$name" \
        || die "container does not exist: $name"

    (($# > 0)) \
        || die "command required"

    local -a flags
    mapfile -t flags < <(enter_flags "$name")

    exec distrobox enter \
        --name "$name" \
        "${flags[@]}" \
        -- "$@"
}

cmd_stop() {
    local name="${1:-}"

    require_managed "$name"

    container_exists "$name" \
        || die "container does not exist: $name"

    distrobox stop \
        --yes \
        "$name"
}

cmd_remove() {
    local name=""

    while (($#)); do
        case "$1" in
            -h|--help)
                echo "Usage: ws box remove NAME"
                return 0
                ;;

            -*)
                die "unknown remove option: $1"
                ;;

            *)
                [[ -z "$name" ]] \
                    || die "only one container may be removed at a time"

                name="$1"
                ;;
        esac

        shift
    done

    require_managed "$name"

    container_exists "$name" \
        || die "container does not exist: $name"

    # The host and a readable choice first: a failure leaves the container
    # in place rather than gone but still in yes.
    choice chosen >/dev/null || die "cannot read nix/hosts/HOST/boxes.toml"

    distrobox rm \
        --force \
        --yes \
        "$name"

    # The host choice: no. The definition in distrobox/catalog.toml stays.
    mark_box "$name" no
    echo "no on $ws_host in $hosts_file: $name"

    echo \
        "Managed definition and custom HOME were kept. Use 'ws box apply $name' to recreate it."
    # The launchers of the container go with the next home-manager switch.
    apply_module home
}

# --replace removes the old container with distrobox rm, which also deletes
# its exported launchers; they are exported again here. An application that
# is not installed yet (e.g. AUR in arch) is reported: install it, then
# wsbox apply NAME.
cmd_recreate() {
    local name="${1:-}"

    require_managed "$name"

    distrobox assemble create \
        --replace \
        --file "$manifest" \
        --name "$name"

    apply_exports_for "$name"
}

show_managed_exports() {
    local name="$1" alias source state launcher

    printf '%-16s %-16s %-18s %-52s %s\n' \
        BOX APP STATE SOURCE HOST_LAUNCHER

    while IFS= read -r alias; do
        [[ -n "$alias" ]] || continue
        source="$(export_source "$name" "$alias")"

        if container_exists "$name"; then
            state="$(export_state "$name" "$source")"
        else
            state="container-missing"
        fi

        launcher="$(export_host_path "$name" "$source")"
        printf '%-16s %-16s %-18s %-52s %s\n' \
            "$name" "$alias" "$state" "$source" "$launcher"
    done < <(export_aliases "$name")
}

cmd_apps() {
    local name="${1:-}" box

    if [[ -n "$name" ]]; then
        require_managed "$name"
        show_managed_exports "$name"

        if container_exists "$name"; then
            echo
            echo "Available desktop files in $name:"
            container_exec "$name" find \
                /usr/share/applications \
                -maxdepth 1 \
                -type f \
                -name '*.desktop' \
                -printf '%f\n' \
                2>/dev/null \
                | sort
        fi
        return 0
    fi

    while IFS= read -r box; do
        [[ -n "$box" ]] || continue
        show_managed_exports "$box"
    done < <(managed_boxes)
}

cmd_export() {
    local name="${1:-}" alias="${2:-}"

    require_managed "$name"
    [[ -n "$alias" ]] || die "managed app alias required"
    [[ $# -eq 2 ]] || die "Usage: ws box export NAME APP"
    export_one "$name" "$alias"
}

cmd_unexport() {
    local name="${1:-}" alias="${2:-}"

    require_managed "$name"
    [[ -n "$alias" ]] || die "managed app alias required"
    [[ $# -eq 2 ]] || die "Usage: ws box unexport NAME APP"
    unexport_one "$name" "$alias"
}

main() {
    ensure_base

    local cmd="${1:-}"

    if [[ -z "$cmd" ]]; then
        usage
        exit 0
    fi

    shift || true

    case "$cmd" in
        list)
            cmd_list "$@"
            ;;

        status)
            cmd_status "$@"
            ;;

        check)
            cmd_check "$@"
            ;;

        dry-run)
            cmd_dry_run "$@"
            ;;

        apply)
            cmd_apply "$@"
            ;;

        update)
            cmd_update "$@"
            ;;

        create)
            cmd_create "$@"
            ;;

        enter)
            cmd_enter "$@"
            ;;

        run)
            cmd_run "$@"
            ;;

        stop)
            cmd_stop "$@"
            ;;

        remove|rm)
            cmd_remove "$@"
            ;;

        recreate)
            cmd_recreate "$@"
            ;;

        apps)
            cmd_apps "$@"
            ;;

        export)
            cmd_export "$@"
            ;;

        unexport)
            cmd_unexport "$@"
            ;;

        -h|--help|help)
            usage
            ;;

        *)
            die "unknown command: $cmd"
            ;;
    esac
}

main "$@"
