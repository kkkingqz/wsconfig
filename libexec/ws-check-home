#!/usr/bin/env bash
# shellcheck disable=SC2088 # "~/..." in the messages is text, not a path
set -u
set -o pipefail

# The user layer of home-manager and the Nix installation it needs: the
# files of the active generation, the Nix profile commands, /nix on its own
# subvolume, the man pages built from docs/ and the session environment.
# Read-only. ws check home runs it with --json (lib/check.bash).

# shellcheck source=../lib/common.bash
. "$(dirname "$(readlink -f "$0")")/../lib/common.bash"
# shellcheck source=../lib/check.bash
. "$WS_CORE/lib/check.bash"

case "${1:-}" in
    --json) check_json_mode ;;
    "") ;;
    -h|--help) echo "Usage: ws-check-home [--json]  (ws check home)"; exit 0 ;;
    *) echo "ws-check-home: unknown argument: $1" >&2; exit 64 ;;
esac

is_tracked() {
    git -C "$repo" ls-files --error-unmatch -- "$1" >/dev/null 2>&1
}

section "1. home-manager generation"

# The active home-manager generation is the list of the user layer: every
# file it links (ws and its tools from the store, fish, ghostty, configs
# built from Nix) must resolve to the same target from $HOME. Targets in the
# checkout must be tracked.
hm_gen="$(readlink -f "${XDG_STATE_HOME:-$HOME/.local/state}/nix/profiles/home-manager" 2>/dev/null || true)"
hm_files="$(readlink -f "$hm_gen/home-files" 2>/dev/null || true)"
if [[ -n "$hm_gen" && -e "$hm_gen/activate" && -d "$hm_files" ]]; then
    pass "home-manager generation active: ${hm_gen#/nix/store/}"
    hm_ok=0
    hm_repo=0
    while IFS= read -r -d '' entry; do
        rel="${entry#"$hm_files"/}"
        want="$(readlink -f -- "$entry" 2>/dev/null || true)"
        got="$(readlink -f -- "$HOME/$rel" 2>/dev/null || true)"
        if [[ -z "$want" || "$got" != "$want" ]]; then
            fail "~/$rel is not the generation's (${got:-missing}, want ${want:-broken}); ws switch"
            continue
        fi
        hm_ok=$((hm_ok + 1))
        [[ "$want" == "$repo"/* && -f "$want" ]] || continue
        hm_repo=$((hm_repo + 1))
        path="${want#"$repo"/}"
        is_tracked "$path" || fail "~/$rel links to untracked $path"
    done < <(find "$hm_files" -mindepth 1 \( -type l -o -type f \) -print0 2>/dev/null)
    pass "home-manager files match the generation: $hm_ok ($hm_repo into the checkout)"
else
    fail "no active home-manager generation (ws switch)"
fi

# ws in PATH is the core in the store (nix/pkgs/ws.nix); libexec for the
# callers without PATH is that of the same core.
ws_real="$(readlink -f "$HOME/.local/bin/ws" 2>/dev/null || true)"
core_installed="${ws_real%/bin/ws}"
if [[ "$ws_real" == /nix/store/*/bin/ws && -e "$core_installed/.wsconfig-package" ]]; then
    pass "~/.local/bin/ws is the core in the store: ${core_installed#/nix/store/}"
else
    fail "~/.local/bin/ws is not the core in the store (${ws_real:-missing}); ws switch"
fi
if [[ -n "$core_installed" \
    && "$(readlink -f "$HOME/.local/share/workstation/libexec" 2>/dev/null)" == "$core_installed/libexec" ]]; then
    pass "~/.local/share/workstation/libexec is libexec/ of that core"
else
    fail "~/.local/share/workstation/libexec is not libexec/ of the installed core; ws switch"
fi
# host.json: the configuration and host of the ws in PATH.
record="$(python3 "$WS_CORE/lib/ws_common.py" get "$WS_STATE/host.json" config 2>/dev/null || true)"
if [[ "$record" == "$repo" ]]; then
    pass "$WS_STATE/host.json names this configuration"
else
    warn "$WS_STATE/host.json names ${record:-no configuration}, not $repo; ws switch"
fi

section "2. Nix"

if [[ -d /nix/var/nix ]]; then
    nix_source="$(findmnt -rno SOURCE /nix 2>/dev/null || true)"
    if [[ "$("$WS_CORE/bin/ws" fact boot 2>/dev/null)" == container ]]; then
        # A container host: /nix is a directory of the server, outside the
        # image (helpws plan-wsgnomebox).
        mountpoint -q /nix \
            && pass "/nix is a mount of the server (container)" \
            || fail "/nix is not a mount: a new container would lose it (ws container run)"
    else
        [[ "$nix_source" == *"[/@nix]" ]] \
            && pass "/nix is mounted from subvolume @nix" \
            || fail "/nix is not a separate @nix mount (${nix_source:-not mounted}); @ rollback would lose it"
        grep -Eq '^[^#]*[[:space:]]/nix[[:space:]].*subvol=@nix' /etc/fstab \
            && pass "fstab mounts @nix at /nix" \
            || fail "fstab has no @nix entry for /nix"
    fi

    id -nG | tr ' ' '\n' | grep -Fxq nix-users \
        && pass "user session is in group nix-users" \
        || fail "user session not in group nix-users (usermod -aG nix-users, then log in again)"
    systemctl is-enabled --quiet nix-daemon.socket 2>/dev/null \
        && pass "nix-daemon.socket enabled" \
        || fail "nix-daemon.socket not enabled"
    systemctl is-active --quiet nix-daemon.socket 2>/dev/null \
        && pass "nix-daemon.socket active" \
        || fail "nix-daemon.socket not active"

    if have nix; then
        pass "nix in PATH: $(nix --version 2>/dev/null)"
        nix config show experimental-features 2>/dev/null | grep -qw flakes \
            && pass "nix: flakes enabled" \
            || fail "nix: experimental-features lack flakes"
    else
        fail "nix-bin installed but nix not in PATH"
    fi

    # Commands of the Nix profile (home.packages): each resolves to the
    # profile; a copy in /usr/bin (apt) would shadow it for sudo and
    # non-fish shells.
    for tool_path in "$hm_gen"/home-path/bin/*; do
        [[ -x "$tool_path" ]] || continue
        tool="${tool_path##*/}"
        [[ "$(command -v "$tool" 2>/dev/null)" == "$HOME/.nix-profile/bin/$tool" ]] \
            && pass "$tool from Nix profile" \
            || warn "$tool does not resolve to ~/.nix-profile/bin ($(command -v "$tool" 2>/dev/null || echo missing))"
        [[ -e "/usr/bin/$tool" ]] \
            && warn "/usr/bin/$tool exists too; Nix provides $tool (sudo apt remove the package)"
    done
else
    warn "Nix not installed yet (phase 0 of helpws history-nix)"
fi

section "3. Man pages"

# Built by Nix from docs/ (nix/pkgs/man.nix), linked by home-manager into
# ~/.local/share/man/man1.
if have nix; then
    man_built="$(nix eval --raw "$repo#packages.$(uname -m)-linux.man.outPath" 2>/dev/null || true)"
    man_missing=false
    man_stale=false
    while IFS= read -r doc; do
        page="$(sed -n 's/^title:[[:space:]]*//p' "$doc" | head -n 1)"
        [[ -n "$page" ]] || continue
        link="$HOME/.local/share/man/man1/$page.1"
        if [[ ! -e "$link" ]]; then
            man_missing=true
            warn "man page missing: $page (ws switch)"
        elif [[ -n "$man_built" && "$(readlink -f "$link")" != "$man_built/"* ]]; then
            man_stale=true
        fi
    done < <(find "$WS_CORE/docs" -type f -name '*.md' | sort)
    [[ "$man_missing" == false ]] && pass "man pages installed for every docs title"
    if [[ -z "$man_built" ]]; then
        warn "cannot evaluate the man package of the flake"
    elif [[ "$man_stale" == true ]]; then
        warn "man pages are older than docs/ (ws switch)"
    else
        pass "man pages match docs/ (${man_built#/nix/store/})"
    fi
fi

section "4. Session environment"

# Qt applications follow GNOME through qgnomeplatform (apt); a global
# override would bypass it.
qt_override_bad=false
for var in QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME QT_STYLE_OVERRIDE QT_SCALE_FACTOR; do
    value="${!var:-}"
    if [[ -n "$value" ]]; then
        qt_override_bad=true
        fail "global Qt override should be unset: $var=$value"
    fi
done
[[ "$qt_override_bad" == false ]] \
    && pass "no global Qt platform/theme/scale overrides"

check_finish
