#!/usr/bin/env python3
import argparse
import configparser
import os
from pathlib import Path
import shutil
import subprocess
import sys

# Declarations: flatpak/catalog.toml (remotes, apps, their overrides;
# lib/flatpak_catalog.py) and the choice of each host
# nix/hosts/HOST/flatpak.toml (yes, no and own overrides; lib/ws_catalog.py)
# in the configuration; desktop overrides in flatpak/flatpak.nix.
# home-manager builds them into ~/.local/share/wsconfig/flatpak, which
# wsflatpak reads. install, manage and unmanage edit the catalog and the
# choice; filesystem, host, env, talk and their un… edit the overrides.
# `ws switch` builds them, `ws sync` publishes them.
SOURCE = "flatpak/flatpak.nix"
sys.path.insert(0, str(Path(os.path.realpath(__file__)).parent.parent / "lib"))
import ws_common  # noqa: E402

REPO = ws_common.CONFIG
CATALOG_NAME = "flatpak/catalog.toml"
OVERRIDE_KINDS = ("filesystem", "env", "talk")
CFG = Path(
    os.environ.get(
        "WSFLATPAK_CONFIG",
        Path.home() / ".local/share/wsconfig/flatpak",
    )
)
# remotes, apps (REMOTE APP in order) and the overrides of this host
# (flatpak/flatpak.nix; helpws plan-v2, 2.6).
MANIFEST = CFG / "flatpak.json"
DESKTOP_OVERRIDES = CFG / "desktop"
USER_APPLICATIONS = Path.home() / ".local/share/applications"
# The state of an app on this host (lib/ws_catalog.py): yes (installed),
# no (declined), else the default of its catalog entry (ask: offered).
# install/manage put it in yes, remove in no, apply asks about the apps in
# state ask (lib/ws_select.py) and records the answer.
SELECT_HINT = "ws flatpak apply --select"

import flatpak_catalog  # noqa: E402
import ws_catalog  # noqa: E402
import ws_check  # noqa: E402
import ws_select  # noqa: E402


_host = None


def this_host():
    global _host
    if _host is None:
        try:
            _host = ws_catalog.current_host(REPO)
        except ValueError as e:
            raise SystemExit(f"ws flatpak: {e}")
    return _host


def catalog():
    try:
        return flatpak_catalog.Catalog(REPO)
    except ValueError as e:
        raise SystemExit(f"ws flatpak: {e}")


def host_choice(cat=None, host=None):
    """The choice of HOST (this one) for Flatpak, its overrides checked
    against the catalog."""
    try:
        choice = ws_catalog.Choice("flatpak", host or this_host(), REPO)
        flatpak_catalog.check_host(choice, cat or catalog())
    except ValueError as e:
        raise SystemExit(f"ws flatpak: {e}")
    return choice


def choice_name(choice):
    return str(choice.path.relative_to(REPO)) if choice.path.is_relative_to(REPO) else str(choice.path)


def run(args, check=True, capture=False):
    p = subprocess.run(args, text=True, capture_output=capture)
    if check and p.returncode:
        raise SystemExit(p.returncode)
    return p


def need_flatpak():
    if not shutil.which("flatpak"):
        raise SystemExit("ws flatpak: flatpak is not installed")


def ensure_cfg():
    if not MANIFEST.is_file():
        raise SystemExit(
            f"ws flatpak: {CFG} is missing; run `ws switch` "
            f"(built from {CATALOG_NAME})"
        )


def declare_hint(action, snippet):
    raise SystemExit(
        f"ws flatpak: Flatpak remotes are declared in {CATALOG_NAME}.\n"
        f"{action}:\n\n    {snippet}\n\n"
        "then: ws switch && ws flatpak apply"
    )


def manifest():
    ensure_cfg()
    data = ws_common.load(MANIFEST)
    if not isinstance(data, dict):
        raise SystemExit(f"ws flatpak: {MANIFEST} is not a manifest; run `ws switch`")
    return data


def managed_entries():
    out = []
    seen = {}

    for entry in manifest().get("apps", []):
        remote, app = entry["remote"], entry["app"]

        if app in seen:
            if seen[app] != remote:
                raise SystemExit(
                    f"ws flatpak: app {app} is assigned to multiple remotes: "
                    f"{seen[app]}, {remote}"
                )
            continue

        seen[app] = remote
        out.append((remote, app))

    return out


def managed_apps():
    return [app for remote, app in managed_entries()]


def list_add(app, remote):
    """APP in yes of this host; a new app goes to the end of the catalog
    (default ask)."""
    host = this_host()
    cat = catalog()
    choice = host_choice(cat)
    added = cat.add_app(app, remote)
    if not added and app in choice.yes():
        print(f"Already yes on {host}: {app} ({choice_name(choice)})")
        return
    choice.set(app, "yes")
    try:
        cat.save()
    except ValueError as e:
        raise SystemExit(f"ws flatpak: {e}")
    choice.save()
    added_text = f"Added to {CATALOG_NAME}: {remote} {app}\n" if added else ""
    print(
        f"{added_text}yes on {host} in {choice_name(choice)}: {app}\n"
        "then: ws switch (links the desktop entries), ws sync"
    )


def list_remove(app):
    """unmanage: APP leaves the catalog, with its overrides, and the choice
    of every host."""
    cat = catalog()
    if not cat.remove_app(app):
        raise SystemExit(f"ws flatpak: {app} is not in {CATALOG_NAME}")
    for path in sorted(ws_catalog.hosts_dir(REPO).glob("*/flatpak.toml")):
        choice = ws_catalog.Choice("flatpak", path.parent.name, REPO)
        if app in choice.data.get("overrides", {}):
            del choice.edit()["overrides"][app]
            flatpak_catalog.tidy_host(choice, app)
        choice.set(app, "ask")
        if choice.save():
            print(f"Dropped from {choice_name(choice)}: {app}")
    cat.save()
    print(
        f"Removed from {CATALOG_NAME}: {app} (with its overrides)\n"
        "then: ws switch, ws sync"
    )

    if (DESKTOP_OVERRIDES / f"{app}.desktop").exists():
        print(f"NOTE: {app} still has a desktop file in {SOURCE}")


def fs_spec(spec):
    # Flatpak stores SPEC:rw as SPEC (read-write is the default).
    return spec.removesuffix(":rw")


def override_key(entry):
    """(APP, KIND, KEY): an env value by its name, a filesystem by its path
    (Flatpak keeps one mode per path), a bus by its name."""
    app, kind, value = entry
    return app, kind, flatpak_catalog.key_of(kind, value)


def declared_override_apps():
    """Apps with overrides in the catalog or in a host file."""
    cat = catalog()
    apps = {a for a in cat.ids() if cat.values(a)}
    for path in ws_catalog.hosts_dir(REPO).glob("*/flatpak.toml"):
        try:
            apps |= set(ws_catalog.Choice("flatpak", path.parent.name, REPO).data.get("overrides", {}))
        except ValueError:
            pass
    return apps


def override_app(query):
    # un… also works for an app that is no longer installed.
    if query in declared_override_apps():
        return query

    return resolve_user_app(query)


def overrides_add(entry, own=False):
    """Declare ENTRY (APP, KIND, VALUE): in the catalog, for every host that
    has APP, or with OWN for this host only (its flatpak.toml). A value of
    the same key (env name, filesystem path, bus) is replaced. A catalog
    value lifts this host's skip and own value of the key, so it applies
    here too."""
    app, kind, value = entry
    key = flatpak_catalog.key_of(kind, value)
    cat = catalog()
    if cat.app(app) is None:
        raise SystemExit(
            f"ws flatpak: {app} is not in {CATALOG_NAME}; first: ws flatpak manage {app}"
        )
    choice = host_choice(cat)
    try:
        if own:
            if (kind, value) in cat.values(app):
                # The catalog value itself: no own value needed.
                flatpak_catalog.remove_host_key(choice, app, kind, key)
                result = "same"
            else:
                result = flatpak_catalog.set_host_value(choice, app, kind, value)
            flatpak_catalog.set_skip(choice, app, kind, key, False)
            where = choice_name(choice)
        else:
            result = cat.set_value(app, kind, value)
            flatpak_catalog.remove_host_key(choice, app, kind, key)
            flatpak_catalog.set_skip(choice, app, kind, key, False)
            where = CATALOG_NAME
        flatpak_catalog.check_host(choice, cat)
    except ValueError as e:
        raise SystemExit(f"ws flatpak: {e}")
    changed = cat.save() | choice.save()
    if not changed:
        print(f"Already declared in {where}: {' '.join(entry)}")
        return
    action = {"added": "Added to", "replaced": "Replaced in", "same": "Applies here from"}[result]
    print(
        f"{action} {where}: {' '.join(entry)}\n"
        "then: ws switch && ws flatpak apply; ws sync"
    )


def overrides_remove(entry, everywhere=False):
    """Drop the value of KEY of APP here: this host's own value goes from
    its flatpak.toml, a catalog value gets a skip there; with EVERYWHERE the
    catalog value goes from the catalog."""
    app, kind, key = override_key(entry)
    cat = catalog()
    choice = host_choice(cat)
    host = this_host()
    done = []
    try:
        if flatpak_catalog.remove_host_key(choice, app, kind, key):
            done.append(f"Removed from {choice_name(choice)}")
        common = any(k == kind and flatpak_catalog.key_of(k, v) == key for k, v in cat.values(app))
        if common and everywhere:
            cat.remove_key(app, kind, key)
            for path in sorted(ws_catalog.hosts_dir(REPO).glob("*/flatpak.toml")):
                other = ws_catalog.Choice("flatpak", path.parent.name, REPO)
                if f"{kind} {key}" in flatpak_catalog.host_section(other, app).get("skip", []):
                    flatpak_catalog.set_skip(other, app, kind, key, False)
                    other.save()
            done.append(f"Removed from {CATALOG_NAME}")
        elif common:
            skipped = f"{kind} {key}" in flatpak_catalog.host_section(choice, app).get("skip", [])
            if not skipped:
                flatpak_catalog.set_skip(choice, app, kind, key, True)
                done.append(f"Skipped on {host} in {choice_name(choice)} (the catalog keeps it; --all drops it)")
    except ValueError as e:
        raise SystemExit(f"ws flatpak: {e}")
    if not done:
        raise SystemExit(
            f"ws flatpak: not declared for {host} in {CATALOG_NAME} or {choice_name(choice)}: "
            f"{app} {kind} {key}"
        )
    cat.save()
    choice.save()
    for line in done:
        print(f"{line}: {app} {kind} {key}")
    print("then: ws switch && ws flatpak apply; ws sync")


def cmd_override(ns):
    need_flatpak()
    remove = ns.cmd.startswith("un")
    kind = ns.cmd[2:] if remove else ns.cmd
    app = override_app(ns.app) if remove else resolve_user_app(ns.app)

    if kind == "host":
        kind, value = "filesystem", "host"
    elif kind == "env" and not remove:
        if ns.value is not None:
            value = f"{ns.key}={ns.value}"
        elif "=" in ns.key:
            value = ns.key
        else:
            raise SystemExit("ws flatpak: env needs KEY VALUE or KEY=VALUE")
    else:
        value = ns.key if kind == "env" else ns.value

    if not value or any(c.isspace() or c == "#" for c in value):
        raise SystemExit(
            f"ws flatpak: {kind} value must be one word without #: {value!r}"
        )

    if kind == "filesystem":
        value = fs_spec(value)

    if remove:
        overrides_remove((app, kind, value), getattr(ns, "everywhere", False))
    else:
        overrides_add((app, kind, value), getattr(ns, "own", False))


def managed_remote(app):
    for remote, candidate in managed_entries():
        if candidate == app:
            return remote

    return None

def resolve_user_app(query):
    # Resolve full App ID, display name, final component, or unique substring.
    need_flatpak()

    p = run(
        [
            "flatpak",
            "list",
            "--user",
            "--app",
            "--columns=application,name",
        ],
        check=False,
        capture=True,
    )

    q = query.casefold()
    rows = []

    for raw in p.stdout.splitlines():
        if not raw.strip():
            continue

        parts = raw.split("	", 1)
        app_id = parts[0].strip()
        name = parts[1].strip() if len(parts) > 1 else ""
        short = app_id.rsplit(".", 1)[-1]

        rows.append((app_id, name, short))

    exact = []

    for app_id, name, short in rows:
        aliases = {
            app_id.casefold(),
            short.casefold(),
        }

        if name:
            aliases.add(name.casefold())

        if q in aliases:
            exact.append(app_id)

    exact = list(dict.fromkeys(exact))

    if len(exact) == 1:
        return exact[0]

    if len(exact) > 1:
        raise SystemExit(
            "ws flatpak: ambiguous app name "
            + query
            + ": "
            + ", ".join(exact)
        )

    fuzzy = []

    for app_id, name, short in rows:
        fields = (
            app_id.casefold(),
            name.casefold(),
            short.casefold(),
        )

        if any(q in field for field in fields):
            fuzzy.append(app_id)

    fuzzy = list(dict.fromkeys(fuzzy))

    if len(fuzzy) == 1:
        return fuzzy[0]

    if len(fuzzy) > 1:
        raise SystemExit(
            "ws flatpak: ambiguous app name "
            + query
            + ": "
            + ", ".join(fuzzy)
        )

    raise SystemExit(
        f"ws flatpak: {query} is not installed in user scope"
    )


def is_managed(app):
    return app in managed_apps()


def installed_user(app):
    need_flatpak()
    return any(ref == app or ref.split("/")[1] == app for ref in user_app_refs())


def installed_origin(app):
    need_flatpak()

    if "/" not in app:
        refs = [ref for ref in user_app_refs() if ref.split("/")[1] == app]
        origins = {installed_origin(ref) for ref in refs}
        return origins.pop() if len(origins) == 1 else None

    p = run(
        ["flatpak", "info", "--user", "--show-origin", app],
        check=False,
        capture=True,
    )

    if p.returncode != 0:
        return None

    origin = p.stdout.strip()
    return origin or None


def ensure_user_runtime(app, install_args=()):
    # --user install may reuse a system runtime. Install the exact runtime
    # ref explicitly so the application also has its dependency in home.
    runtime = run(
        ["flatpak", "info", "--user", "--show-runtime", app],
        capture=True,
    ).stdout.strip()
    if not runtime:
        raise SystemExit(f"ws flatpak: could not determine runtime for {app}")

    ref = f"runtime/{runtime}"
    if run(
        ["flatpak", "info", "--user", ref], check=False, capture=True,
    ).returncode == 0:
        return

    # Prefer the app's origin, then search other user remotes. Supplying the
    # remote avoids Flatpak's selection prompt when several provide the ref.
    remotes = run(
        ["flatpak", "remotes", "--user", "--columns=name"], capture=True,
    ).stdout.splitlines()
    origin = installed_origin(app)
    candidates = sorted({r.strip() for r in remotes if r.strip()})
    if origin in candidates:
        candidates.remove(origin)
        candidates.insert(0, origin)
    for remote in candidates:
        if run(
            ["flatpak", "remote-info", "--user", remote, ref],
            check=False, capture=True,
        ).returncode == 0:
            break
    else:
        raise SystemExit(
            f"ws flatpak: no user remote provides runtime {runtime} for {app}"
        )

    print(f"Installing user runtime for {app}: {remote} {runtime}")
    run(["flatpak", "install", "--user", "--no-auto-pin"]
        + list(install_args) + [remote, ref])
    run(["flatpak", "info", "--user", ref], capture=True)


def managed_overrides():
    """APP: {filesystems, environment, session_bus} of this workstation."""
    return manifest().get("overrides", {})


def managed_override(app):
    return managed_overrides().get(app)


def managed_override_text(app):
    """The declared override in Flatpak's keyfile form, for people."""
    o = managed_override(app) or {}
    sections = []
    if o.get("filesystems"):
        sections.append("[Context]\nfilesystems=" + "".join(f"{x};" for x in o["filesystems"]))
    for title, key in (("Environment", "environment"), ("Session Bus Policy", "session_bus")):
        if o.get(key):
            sections.append(f"[{title}]\n" + "\n".join(f"{k}={v}" for k, v in o[key].items()))
    return "\n\n".join(sections)


def read_managed_filesystems(app):
    return [fs_spec(x) for x in (managed_override(app) or {}).get("filesystems", [])]


def read_managed_environment(app):
    return dict((managed_override(app) or {}).get("environment", {}))


def read_managed_session_bus(app):
    return dict((managed_override(app) or {}).get("session_bus", {}))



def runtime_session_bus(app):
    cp = runtime_override_config(app)

    if not cp.has_section("Session Bus Policy"):
        return {}

    return dict(cp.items("Session Bus Policy"))


def runtime_override(app=None):
    need_flatpak()
    cmd = ["flatpak", "override", "--user", "--show"]

    if app:
        cmd.append(app)

    return run(cmd, check=False, capture=True).stdout.strip()


def runtime_override_config(app):
    text = runtime_override(app)
    cp = configparser.ConfigParser(interpolation=None)
    cp.optionxform = str

    if text:
        cp.read_string(text)

    return cp


def runtime_filesystems(app):
    cp = runtime_override_config(app)
    value = cp.get("Context", "filesystems", fallback="")
    return [fs_spec(x) for x in value.split(";") if x]


def runtime_host(app):
    cp = runtime_override_config(app)
    value = cp.get("Context", "filesystems", fallback="")
    return "host" in [x for x in value.split(";") if x]


def runtime_environment(app):
    cp = runtime_override_config(app)

    if not cp.has_section("Environment"):
        return {}

    return dict(cp.items("Environment"))


def managed_host(app):
    return "host" in read_managed_filesystems(app)



def apply_override(app):
    need_flatpak()

    run(
        ["flatpak", "override", "--user", "--reset", app],
        check=False,
    )

    for fs in read_managed_filesystems(app):
        run(
            [
                "flatpak",
                "override",
                "--user",
                f"--filesystem={fs}",
                app,
            ]
        )

    for key, value in read_managed_environment(app).items():
        run(
            [
                "flatpak",
                "override",
                "--user",
                f"--env={key}={value}",
                app,
            ]
        )
    for name, policy in read_managed_session_bus(app).items():
        if policy != "talk":
            raise SystemExit(
                f"ws flatpak: unsupported session bus policy: "
                f"{name}={policy}"
            )

        run(
            [
                "flatpak",
                "override",
                "--user",
                f"--talk-name={name}",
                app,
            ]
        )



def cmd_install(ns):
    need_flatpak()
    # The workstation before installing: its mark is written afterwards.
    this_host()

    remotes = {
        x.strip()
        for x in run(
            ["flatpak", "remotes", "--user", "--columns=name"],
            check=False,
            capture=True,
        ).stdout.splitlines()
        if x.strip()
    }

    if ns.remote not in remotes:
        raise SystemExit(
            f"ws flatpak: user remote not configured: {ns.remote}"
        )

    before = set(user_app_refs())

    cmd = [
        "flatpak",
        "install",
        "--user",
        ns.remote,
        ns.app,
    ] + ns.extra

    run(cmd)

    after = set(user_app_refs())
    added = sorted(after - before)

    # Preserve branch and architecture for runtime queries. Additional refs
    # can be installed through extra; include every newly installed ref.
    query = ns.app.removeprefix("app/").split("/", 1)[0]
    installed_ids = {ref.split("/")[1] for ref in after}
    added_ids = {ref.split("/")[1] for ref in added}
    if query in installed_ids:
        app = query
    elif len(added_ids) == 1:
        app = next(iter(added_ids))
    else:
        app = resolve_user_app(query)
    targets = set(added)
    requested_ids = {
        arg.removeprefix("app/").split("/", 1)[0]
        for arg in ns.extra if not arg.startswith("-")
    }
    for ref in after:
        app_id = ref.split("/")[1]
        if app_id == app or app_id in requested_ids:
            targets.add(ref)

    install_args = [
        arg for arg in ns.extra
        if arg in ("-y", "--assumeyes", "--noninteractive")
    ]
    for ref in sorted(targets):
        ensure_user_runtime(ref, install_args)

    for app in sorted({ref.split("/")[1] for ref in targets}):
        if is_managed(app):
            apply_override(app)
            list_add(app, ns.remote)
        elif ns.unmanaged:
            print(f"\nNot managed (--unmanaged): {app}")
        else:
            print()
            list_add(app, ns.remote)

def cmd_remove(ns):
    need_flatpak()
    app = resolve_user_app(ns.app)
    # The host and its choice first: a failure here leaves the app
    # installed rather than gone but still yes.
    host = this_host()
    cat = catalog()
    choice = host_choice(cat)

    cmd = ["flatpak", "uninstall", "--user"]

    if not ns.keep_data:
        cmd.append("--delete-data")

    cmd.append(app)
    run(cmd)

    # The choice of this host: no. The catalog entry stays (other hosts,
    # ws flatpak unmanage drops it).
    if cat.app(app) is None:
        return
    choice.set(app, "no")
    choice.save()
    print(f"\nno on {host} in {choice_name(choice)}: {app}\nthen: ws switch, ws sync")



def cmd_reset_permissions(app):
    need_flatpak()
    app = resolve_user_app(app)

    run(["flatpak", "override", "--user", "--reset", app], check=False)

    # Portal permissions are a separate store. Failure here is non-fatal
    # because an application may have no portal permissions at all.
    run(["flatpak", "permission-reset", app], check=False)

    print(f"Overrides and portal permissions reset: {app}")

    if managed_override(app) is not None:
        print(
            f"NOTE: {app} has declared overrides ({CATALOG_NAME}, nix/hosts/HOST/flatpak.toml); "
            "`ws flatpak apply` sets them again"
        )


def cmd_permissions(app):
    need_flatpak()
    app = resolve_user_app(app)

    print("===== APP =====")
    print(app)

    print("\n===== EFFECTIVE PERMISSIONS =====")
    p = run(
        ["flatpak", "info", "--user", "--show-permissions", app],
        check=False,
        capture=True,
    )
    print(p.stdout.strip() or "(not installed)")

    print("\n===== RUNTIME USER OVERRIDE =====")
    print(runtime_override(app) or "(none)")

    print("\n===== MANAGED WORKSTATION OVERRIDE =====")
    print(managed_override_text(app) if managed_override(app) is not None else "(none)")

    print("\n===== EFFECTIVE HOST ACCESS =====")
    declared = p.stdout
    declared_host = False

    for line in declared.splitlines():
        if line.startswith("filesystems="):
            values = [
                x for x in line.split("=", 1)[1].split(";") if x
            ]
            declared_host = "host" in values
            break

    print("YES" if declared_host else "NO")

    print("\n===== USER OVERRIDE HOST ACCESS =====")
    if runtime_host(app):
        print("YES (tracked)" if managed_host(app) else "YES (UNTRACKED)")
    else:
        print("NO")


def user_apps():
    p = run(
        ["flatpak", "list", "--user", "--app", "--columns=application"],
        check=False,
        capture=True,
    )
    return [x.strip() for x in p.stdout.splitlines() if x.strip()]


def user_app_refs():
    # Flatpak's ref column is ID/ARCH/BRANCH; add the kind explicitly.
    output = run(
        ["flatpak", "list", "--user", "--app", "--columns=ref"],
        capture=True,
    ).stdout.splitlines()
    return [f"app/{ref.strip()}" for ref in output if ref.strip()]


def cmd_run(ns):
    need_flatpak()
    app = resolve_user_app(ns.app)

    desktop = (
        Path.home()
        / ".local/share/flatpak/exports/share/applications"
        / f"{app}.desktop"
    )

    if not ns.direct and not ns.args and desktop.exists():
        subprocess.Popen(
            ["gtk-launch", app],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return

    run(["flatpak", "run", app] + ns.args)


def managed_desktop_entries():
    ensure_cfg()
    return sorted(
        path
        for path in DESKTOP_OVERRIDES.glob("*.desktop")
        if path.is_file()
    )


def desktop_override_destination(source):
    return USER_APPLICATIONS / source.name


def desktop_override_ok(source):
    destination = desktop_override_destination(source)

    if not destination.is_symlink():
        return False

    return destination.resolve() == source.resolve()



def cmd_status():
    ensure_cfg()

    print("===== FLATPAK =====")
    if not shutil.which("flatpak"):
        print("not installed")
        return

    run(["flatpak", "--version"])

    blocks = [
        (
            "USER REMOTES",
            ["flatpak", "remotes", "--user", "--columns=name,url"],
        ),
        (
            "SYSTEM REMOTES",
            ["flatpak", "remotes", "--system", "--columns=name,url"],
        ),
        (
            "USER APPS",
            [
                "flatpak",
                "list",
                "--user",
                "--app",
                "--columns=application,name,origin",
            ],
        ),
        (
            "SYSTEM REFS",
            ["flatpak", "list", "--system", "--columns=application,ref"],
        ),
    ]

    for title, cmd in blocks:
        print(f"\n===== {title} =====")
        p = run(cmd, check=False, capture=True)
        print(p.stdout.rstrip() or "(none)")

    print("\n===== MANAGED APPS =====")
    entries = [f"{remote} {app}" for remote, app in managed_entries()]
    print("\n".join(entries) or "(none)")

    print("\n===== MANAGED OVERRIDES =====")
    files = sorted(managed_overrides())
    print("\n".join(files) or "(none)")

    print("\n===== GLOBAL USER OVERRIDE =====")
    print(runtime_override() or "(none)")

def cmd_check(json_mode=False):
    """Result contract of ws check (--json), as lib/check.bash: one object
    {"status", "passes", "warnings", "failures", "messages"} on stdout."""
    ensure_cfg()

    c = ws_check.Check(json_mode)
    passed, warn, fail, info, finish = c.passed, c.warn, c.fail, c.info, c.finish

    try:
        host = this_host()
        cat = catalog()
        choice = host_choice(cat)
    except SystemExit as e:
        fail(f"catalog and host choice: {e}")
        return finish()
    state_of = lambda app: choice.state(app, cat.default(app))

    if not shutil.which("flatpak"):
        fail("flatpak installed")
        return finish()

    passed("flatpak installed")

    actual_remotes = {
        x.strip()
        for x in run(
            ["flatpak", "remotes", "--user", "--columns=name"],
            check=False,
            capture=True,
        ).stdout.splitlines()
        if x.strip()
    }

    expected_remotes = {name for name, url in parse_remotes()}

    for name in sorted(expected_remotes):
        if name in actual_remotes:
            passed(f"managed user remote configured: {name}")
        else:
            fail(f"managed user remote missing: {name}")

    for name in sorted(actual_remotes - expected_remotes):
        warn(f"unmanaged user remote: {name}")

    sr = run(
        ["flatpak", "remotes", "--system", "--columns=name"],
        check=False,
        capture=True,
    ).stdout.strip()

    if sr:
        fail("system remotes must be empty")
    else:
        passed("system remotes empty")

    refs = run(
        ["flatpak", "list", "--system", "--columns=ref"],
        check=False,
        capture=True,
    ).stdout.strip()

    if refs:
        fail("system installation contains refs")
    else:
        passed("system installation empty")

    global_text = runtime_override()
    global_host = any(
        line.startswith("filesystems=")
        and "host" in [
            x for x in line.split("=", 1)[1].split(";") if x
        ]
        for line in global_text.splitlines()
    )

    if global_host:
        fail("global filesystem=host override is forbidden")
    else:
        passed("no global filesystem=host override")

    for remote, app in managed_entries():
        if remote not in expected_remotes:
            fail(f"managed app remote is not declared: {app}: {remote}")

        state = state_of(app)

        if not installed_user(app):
            if state == "yes":
                fail(f"managed app missing: {app} (yes on {host}; ws flatpak apply)")
            elif state == "no":
                info(f"managed app declined on {host}: {app} ({SELECT_HINT})")
            else:
                info(f"managed app not offered on {host} yet: {app} (ws flatpak apply asks)")
            continue

        if state == "no":
            warn(f"managed app installed but no on {host}: {app} (ws flatpak remove, or install to put it in yes)")
        elif state == "ask":
            warn(f"managed app installed but not chosen on {host}: {app} (ws flatpak apply puts it in yes)")
        else:
            passed(f"managed app installed: {app}")

        origin = installed_origin(app)

        if origin == remote:
            passed(f"managed app origin tracked: {app}: {remote}")
        else:
            fail(
                f"managed app origin mismatch: {app}: "
                f"expected={remote} actual={origin or '(unknown)'}"
            )

    listed = [f"{e['remote']} {e['id']}" for e in cat.apps()]
    built = [f"{r} {a}" for r, a in managed_entries()]
    if listed == built:
        passed(f"{CATALOG_NAME} built")
    else:
        warn(f"{CATALOG_NAME} differs from the build; run ws switch")
    for app in choice.yes() + choice.no():
        if cat.app(app) is None:
            warn(f"{choice_name(choice)} chooses an app not in {CATALOG_NAME}: {app}")

    for app in user_apps():
        if not is_managed(app):
            warn(f"unmanaged user app: {app}")

        if runtime_host(app):
            if managed_host(app):
                passed(f"filesystem=host tracked: {app}")
            else:
                fail(f"untracked filesystem=host: {app}")

    # A managed app with no .conf expects no user overrides. Include it so
    # removing the last declaration does not hide leftover runtime grants.
    override_apps = sorted(
        {app.removeprefix("app/").split("/", 1)[0] for app in managed_apps()}
        | set(managed_overrides())
    )

    for app in override_apps:

        if not installed_user(app):
            continue

        expected_fs = set(read_managed_filesystems(app)) - {"host"}
        actual_fs = set(runtime_filesystems(app)) - {"host"}

        for spec in sorted(expected_fs):
            if spec in actual_fs:
                passed(f"filesystem permission tracked: {app}: {spec}")
            else:
                fail(f"filesystem permission not applied: {app}: {spec}")

        for spec in sorted(actual_fs - expected_fs):
            fail(f"untracked filesystem override: {app}: {spec}")

    for app in override_apps:

        if not installed_user(app):
            if managed_override(app) is not None and state_of(app) == "yes":
                warn(f"managed override for non-installed app: {app}")
            continue

        if managed_host(app) and not runtime_host(app):
            fail(f"managed override not applied: {app}")

        expected_env = read_managed_environment(app)
        actual_env = runtime_environment(app)

        for key, value in expected_env.items():
            if actual_env.get(key) == value:
                passed(f"environment tracked: {app}: {key}={value}")
            else:
                fail(
                    f"environment override not applied: "
                    f"{app}: {key}={value}"
                )

        for key, value in actual_env.items():
            if expected_env.get(key) != value:
                fail(
                    f"untracked environment override: "
                    f"{app}: {key}={value}"
                )

    for app in override_apps:

        if not installed_user(app):
            continue

        expected_bus = read_managed_session_bus(app)
        actual_bus = runtime_session_bus(app)

        for name, policy in expected_bus.items():
            if actual_bus.get(name) == policy:
                passed(
                    f"session-bus permission tracked: "
                    f"{app}: {name}={policy}"
                )
            else:
                fail(
                    f"session-bus permission not applied: "
                    f"{app}: {name}={policy}"
                )

        for name, policy in actual_bus.items():
            if expected_bus.get(name) != policy:
                fail(
                    f"untracked session-bus override: "
                    f"{app}: {name}={policy}"
                )

    # Linked by ws switch only where the app is yes (flatpak.nix).
    for source in managed_desktop_entries():
        app = source.name.removesuffix(".desktop")
        linked = desktop_override_ok(source)
        if state_of(app) == "yes":
            if linked:
                passed(f"managed desktop override applied: {source.name}")
            else:
                fail(f"managed desktop override not applied: {source.name} "
                     f"(yes on {host}; run ws switch)")
        elif linked:
            warn(f"managed desktop override linked but {app} is not yes "
                 f"on {host}: {source.name} (run ws switch)")
        else:
            info(f"managed desktop override not linked: {app} is not on {host}")

    return finish()

def cmd_test():
    need_flatpak()

    failures = 0

    print("===== SESSION =====")
    if os.environ.get("XDG_SESSION_TYPE") == "wayland":
        print("PASS  Wayland session")
    else:
        print(
            "WARN  XDG_SESSION_TYPE="
            + os.environ.get("XDG_SESSION_TYPE", "unset")
        )

    print("\n===== PORTALS / MEDIA =====")

    units = [
        "xdg-desktop-portal.service",
        "xdg-desktop-portal-gnome.service",
        "pipewire.service",
        "wireplumber.service",
    ]

    for unit in units:
        ok = run(
            ["systemctl", "--user", "is-active", "--quiet", unit],
            check=False,
        ).returncode == 0

        print(("PASS  " if ok else "FAIL  ") + unit)
        if not ok:
            failures += 1

    pulse = any(
        run(
            ["systemctl", "--user", "is-active", "--quiet", unit],
            check=False,
        ).returncode == 0
        for unit in ("pipewire-pulse.service", "pipewire-pulse.socket")
    )

    print(("PASS  " if pulse else "FAIL  ") + "PipeWire Pulse")
    if not pulse:
        failures += 1

    print("\n===== POLICY =====")
    if cmd_check() != 0:
        failures += 1

    print("\n===== MANUAL APP CHECKLIST =====")
    print(
        "Recheck after major Flatpak / desktop changes:\n"
        "  - native Wayland / correct 1.5 scale\n"
        "  - open/save portal\n"
        "  - clipboard\n"
        "  - Nautilus drag-and-drop\n"
        "  - notifications\n"
        "  - ScreenCast chooser where applicable\n"
        "  - URI/default-app handling"
    )

    return 1 if failures else 0


def parse_remotes():
    return [[name, url] for name, url in manifest().get("remotes", {}).items()]


def cmd_apply(reselect=False):
    need_flatpak()

    for name, url in parse_remotes():
        run(
            [
                "flatpak",
                "remote-add",
                "--user",
                "--if-not-exists",
                name,
                url,
            ]
        )

    # What this host gets: yes is installed, ask is offered (the answer is
    # written into its flatpak.toml), no is left alone unless --select.
    host = this_host()
    cat = catalog()
    choice = host_choice(cat)
    before = choice.text
    state_of = lambda app: choice.state(app, cat.default(app))
    entries = managed_entries()
    installed = {app for _, app in entries if installed_user(app)}
    items = []
    for remote, app in entries:
        state = state_of(app)
        if app in installed:
            if state == "ask":
                choice.set(app, "yes")
            elif state == "no":
                print(f"WARNING: {app} is installed but no on {host}", file=sys.stderr)
        elif state == "ask" or (state == "no" and reselect):
            items.append((app, cat.default(app), remote))

    wanted = {app for _, app in entries if app in installed or state_of(app) == "yes"}
    if os.environ.get("WS_OFFERED") and not reselect:
        # ws apply asked already (ws_catalog offer --all).
        items = []
    try:
        chosen = ws_catalog.offer(choice, items, reselect, "приложения Flatpak")
    except ws_select.NoTerminal:
        if reselect:
            raise SystemExit(f"{SELECT_HINT}: needs a terminal")
        chosen = []
        print(f"Not offered on {host} yet (no terminal to ask): "
              f"{', '.join(app for app, _, _ in items)}; run ws flatpak apply in a terminal",
              file=sys.stderr)
    if chosen is None:
        # Cancel answers only the question: the offered apps keep their
        # state and are asked about next time; the rest is applied.
        print("ws flatpak: выбор отменён, предложенные приложения не тронуты "
              "(спросит в следующий раз)", file=sys.stderr)
        chosen = []
    wanted |= set(chosen)
    choice.save()
    if choice.text != before:
        print(f"Choice of {host} written to {choice_name(choice)}; then: ws switch "
              "(links the desktop entries), ws sync")

    for remote, app in entries:
        if app not in wanted:
            continue
        if not installed_user(app):
            print(f"Installing managed app: {remote} {app}")
            run(
                [
                    "flatpak",
                    "install",
                    "--user",
                    "-y",
                    remote,
                    app,
                ]
            )

        for ref in user_app_refs():
            if ref.split("/")[1] == app:
                ensure_user_runtime(ref, ["-y"])
        apply_override(app)

    for app in sorted(managed_overrides()):
        if installed_user(app):
            apply_override(app)
        elif app in wanted:
            print(
                f"WARNING: override exists for non-installed app: {app}",
                file=sys.stderr,
            )

    print("\nApply complete. Running policy check...")
    return cmd_check()

DECLARE = {
    "remote-add": ("Add to [remotes]", '{0} = "{1}"'),
}


def cmd_declare(cmd, args):
    action, snippet = DECLARE[cmd]
    args = list(args) + ["..."] * 3
    declare_hint(action, snippet.format(*args))


