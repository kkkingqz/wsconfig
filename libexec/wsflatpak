    "apply": "Install the declared apps and their runtimes, apply the overrides.",
    "help": "Show the general help or the help of a command.",
}

OVERRIDE_HELP = """APP: the ID, the name or an unambiguous part of the name of an installed app.
The un… commands also take the ID of an app with declared overrides after it
was removed. A value is one word without spaces and #.

Without --host the value goes into the entry of the app in flatpak/catalog.toml
and acts on every machine that has the app; with --host into
[overrides."APP"] of hosts/HOST/flatpak.toml of this machine (ws host).
A value of the same key (env name, filesystem path, bus name) is replaced;
the value of the machine replaces that of the catalog. un… drops the value on
this machine: its own from its flatpak.toml, a common one by a skip there; with
--all the common one is removed from the catalog. To apply:
  ws apply flatpak
apply resets the current overrides of a managed app and replaces them with the
declared ones. Manual changes made with Flatseal are lost then.
"""

COMMAND_DETAILS = {
    "install": """Apps and runtimes are installed with --user, usually into ~/.local/share/flatpak.
A runtime is installed for the user even when the system has it.
Installing a dependency by hand does not pin it.

Give --remote and --unmanaged before APP.
After APP: more apps, a branch or arguments of flatpak install.
New apps are added to flatpak/catalog.toml and to yes of this machine
(hosts/HOST/flatpak.toml); to apply: ws apply flatpak.
Declared overrides of a new app are applied by ws flatpak apply.

Examples:
  ws flatpak install org.videolan.VLC
  ws flatpak install org.gimp.GIMP org.videolan.VLC -y
  ws flatpak install --remote flatpark com.anthropic.ClaudeDesktop
  ws flatpak install --unmanaged app/org.mozilla.firefox/x86_64/beta
""",
    "manage": """APP: the ID, the name or an unambiguous part of the name of an installed app.
Without REMOTE the origin of the app is used, then flathub as a fallback.
The app is added to flatpak/catalog.toml (unless it is there) and to yes of
this machine; to apply: ws apply flatpak.

Example: ws flatpak manage org.videolan.VLC
""",
    "unmanage": """Give the exact App ID of flatpak/catalog.toml. The app is not removed.
The entry leaves the catalog with its overrides, and the files of all machines
lose their choice and overrides of the app. ws apply flatpak updates the built
list of managed apps.

Example: ws flatpak unmanage org.videolan.VLC
""",
    "remove": """By default: flatpak uninstall --user --delete-data.
--keep-data keeps the data of the app.
A managed app goes to no of this machine (hosts/HOST/flatpak.toml);
the catalog entry stays for other machines (to drop it: unmanage).
Then ws apply flatpak runs; ws sync publishes the file.
""",
    "reset-permissions": """Declared overrides stay in the configuration and come back on apply.
For a lasting change use unfilesystem, unhost, unenv or untalk.
""",
    "remote-add": """Prints a line NAME = "URL" for [remotes] in flatpak/catalog.toml.
After editing the file run ws apply flatpak.

Example: ws flatpak remote-add example https://example.org/repo.flatpakrepo
""",
    "run": """Without app arguments gtk-launch is used when a .desktop is exported.
--direct or app arguments switch to flatpak run.
Give --direct before APP, app arguments after APP.

Examples:
  ws flatpak run org.videolan.VLC
  ws flatpak run --direct org.videolan.VLC /home/user/video.mkv
""",
    "apply": """Adds the declared user remotes, installs missing apps and provides the user
runtime for every installed branch of the managed apps.
What goes on this machine is up to its hosts/HOST/flatpak.toml (HOST is the name
of ws host): yes is installed without a question, no is skipped; an app in
neither gets the default of the catalog. For those in state ask apply shows
one list, all checked (Space toggles, Ctrl+A all, Enter accepts, Esc
cancels); checked go into yes, unchecked into no. --select asks about no
again too (unchecked).
Without a terminal the ones not offered are not installed.
Then it resets their overrides, applies the declared values and runs check.
Usually run by ws apply (ws apply flatpak): that one builds the configuration
first and links its .desktop files.
""",
    "check": """Exit status 1 means errors, 0 no errors; warnings are allowed.
--json prints an object with status, passes, warnings, failures and messages.
System remotes and system apps/runtimes are a policy error.
""",
    "cleanup": """Passes the arguments to flatpak uninstall --user --unused.
Runtimes pinned by hand are kept.

Example: ws flatpak cleanup -y
""",
}


def build_parser():
    p = argparse.ArgumentParser(
        prog="ws flatpak",
        description="User Flatpak apps and their configuration in wsconfig.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Installing into the home directory:
  ws flatpak install org.videolan.VLC
  ws flatpak install --unmanaged org.gimp.GIMP
  ws flatpak install --remote flatpark com.anthropic.ClaudeDesktop
  ws apply flatpak

Apps and runtimes: usually ~/.local/share/flatpak, data: ~/.var/app/APP_ID.
Access to home files is set separately by filesystem/host.
install/manage/unmanage edit flatpak/catalog.toml and the choices of the machine
in hosts/HOST/flatpak.toml; filesystem/host/env/talk and un… the overrides there.
ws apply flatpak builds and applies them.

Help of a command: ws flatpak help install or ws flatpak install --help.
The guide: ws help flatpak / man ws-flatpak.
""",
    )
    sp = p.add_subparsers(dest="cmd", required=True, title="Commands", metavar="COMMAND")

    def command(name, **kwargs):
        detail = COMMAND_DETAILS.get(name)
        if name.removeprefix("un") in ("filesystem", "host", "env", "talk"):
            detail = OVERRIDE_HELP
        return sp.add_parser(
            name, help=COMMAND_HELP[name], description=COMMAND_HELP[name],
            epilog=detail, formatter_class=argparse.RawDescriptionHelpFormatter,
            **kwargs,
        )

    q = command("install")
    q.add_argument("--remote", default="flathub",
                   help="user remote (default flathub)")
    q.add_argument("--unmanaged", action="store_true",
                   help="do not add the app to the catalog")
    q.add_argument("app", metavar="APP", help="App ID, a Flatpak query or a full ref")
    q.add_argument("extra", nargs=argparse.REMAINDER, metavar="ARG",
                   help="more apps, a branch or arguments of flatpak install")

    q = command("manage")
    q.add_argument("app", metavar="APP", help="installed app")
    q.add_argument("remote", nargs="?", metavar="REMOTE", help="remote for the catalog")

    q = command("unmanage")
    q.add_argument("app", metavar="APP", help="exact App ID of the catalog")

    q = command("remove", aliases=["uninstall"])
    q.add_argument("--keep-data", action="store_true", help="keep the data of the app")
    q.add_argument("app", metavar="APP", help="installed app")

    for name in ("permissions", "reset-permissions", "info"):
        q = command(name)
        q.add_argument("app", metavar="APP", help="ID, name or part of the name of the app")

    def scope(q, cmd):
        if cmd.startswith("un"):
            q.add_argument("--all", dest="everywhere", action="store_true",
                           help="drop the common value from the catalog (all machines)")
        else:
            q.add_argument("--host", dest="own", action="store_true",
                           help="only for this machine (its flatpak.toml)")

    for name, arg, detail in (
        ("filesystem", "SPEC", "directory and mode: host, home:ro, xdg-download, /path:rw"),
        ("talk", "BUS", "D-Bus session bus name, e.g. org.freedesktop.Flatpak"),
    ):
        for cmd in (name, "un" + name):
            q = command(cmd)
            scope(q, cmd)
            q.add_argument("app", metavar="APP", help="app")
            q.add_argument("value", metavar=arg, help=detail)
    for cmd in ("host", "unhost"):
        q = command(cmd)
        scope(q, cmd)
        q.add_argument("app", metavar="APP", help="app")
    q = command("env")
    scope(q, "env")
    q.add_argument("app", metavar="APP", help="app")
    q.add_argument("key", metavar="KEY[=VALUE]", help="variable or KEY=VALUE")
    q.add_argument("value", nargs="?", metavar="VALUE", help="value of the variable")
    q = command("unenv")
    scope(q, "unenv")
    q.add_argument("app", metavar="APP", help="app")
    q.add_argument("key", metavar="KEY", help="name of the declared variable")

    for name in DECLARE:
        q = command(name)
        q.add_argument("args", nargs="*", metavar="NAME URL", help="name and URL of the remote")

    for name in ("update", "cleanup", "list", "search"):
        q = command(name)
        q.add_argument("args", nargs=argparse.REMAINDER, metavar="ARG",
                       help="arguments of the matching Flatpak command")

    q = command("run")
    q.add_argument("--direct", action="store_true", help="run directly with flatpak run")
    q.add_argument("app", metavar="APP", help="installed app")
    q.add_argument("args", nargs=argparse.REMAINDER, metavar="ARG", help="arguments of the app")

    q = command("check")
    q.add_argument("--json", action="store_true", help="print the result as JSON")

    for name in ("status", "test"):
        command(name)

    q = command("apply")
    q.add_argument("--select", action="store_true",
                   help="ask about apps in no of this machine too")

    q = command("help")
    q.add_argument("command", nargs="?", choices=tuple(sp.choices), metavar="COMMAND",
                   help="command to show the help of")
    q.set_defaults(help_parsers=sp.choices)
    return p


def main():
    parser = build_parser()
    ns, unknown = parser.parse_known_args()

    passthrough = {"update", "cleanup", "list", "search", "run", "install"}
    if unknown and ns.cmd not in passthrough:
        parser.error("unrecognized arguments: " + " ".join(unknown))

    if hasattr(ns, "extra"):
        ns.extra += unknown
    elif hasattr(ns, "args"):
        ns.args += unknown

    if ns.cmd == "help":
        target = ns.help_parsers.get(ns.command, parser)
        target.print_help()
    elif ns.cmd == "install":
        cmd_install(ns)
    elif ns.cmd == "manage":
        need_flatpak()
        app = resolve_user_app(ns.app)
        list_add(app, ns.remote or installed_origin(app) or "flathub")
        ws_common.apply_module("flatpak")
    elif ns.cmd == "unmanage":
        list_remove(ns.app)
    elif ns.cmd in DECLARE:
        cmd_declare(ns.cmd, ns.args)
    elif ns.cmd.removeprefix("un") in ("host", "filesystem", "env", "talk"):
        cmd_override(ns)
    elif ns.cmd in ("remove", "uninstall"):
        cmd_remove(ns)
    elif ns.cmd == "permissions":
        cmd_permissions(ns.app)
    elif ns.cmd == "reset-permissions":
        cmd_reset_permissions(ns.app)
    elif ns.cmd == "update":
        need_flatpak()
        run(["flatpak", "update", "--user"] + ns.args)
    elif ns.cmd == "cleanup":
        need_flatpak()
        run(["flatpak", "uninstall", "--user", "--unused"] + ns.args)
    elif ns.cmd == "list":
        need_flatpak()
        run(["flatpak", "list", "--user"] + ns.args)
    elif ns.cmd == "search":
        need_flatpak()
        run(["flatpak", "search"] + ns.args)
    elif ns.cmd == "info":
        need_flatpak()
        app = resolve_user_app(ns.app)
        run(["flatpak", "info", "--user", app])
    elif ns.cmd == "run":
        cmd_run(ns)
    elif ns.cmd == "status":
        cmd_status()
    elif ns.cmd == "check":
        raise SystemExit(cmd_check(ns.json))
    elif ns.cmd == "test":
        raise SystemExit(cmd_test())
    elif ns.cmd == "apply":
        raise SystemExit(cmd_apply(ns.select))


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        # Ctrl+C (the apply checklist restores the terminal): no traceback.
        print(file=sys.stderr)
        raise SystemExit(130)
