#!/usr/bin/env python3
"""Window shortcuts (ws help keyboard): hide, minimize or close the windows
of the focused application through the desktop contract of wsdbus
(wsdbus-ctl windows, wsdbus-ctl window ID ACTION; GNOME: the wsdbus
extension), the task manager and logout. check: the provider offers windows
and WindowAction (ws keyboard apply preflight).

wsdbus-ctl: WSDBUS_CTL (tests), libexec/wsdbus-ctl of the core
(nix/pkgs/ws.nix), else PATH."""

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

# Exit codes of wsdbus-ctl (wsdbus spec/README.md).
NO_PROVIDER = 3
STALE = 5
LOCKED = 6


def fail(message, code=1):
    print(f"ws-window: {message}", file=sys.stderr)
    raise SystemExit(code)


def ctl_path():
    path = os.environ.get("WSDBUS_CTL")
    if path:
        return path
    own = Path(__file__).resolve().parent / "wsdbus-ctl"
    if os.access(own, os.X_OK):
        return str(own)
    found = shutil.which("wsdbus-ctl")
    if found:
        return found
    fail("wsdbus-ctl not found (ws apply home)")


def ctl(*args):
    """Runs wsdbus-ctl; returns (status, stdout)."""
    try:
        done = subprocess.run([ctl_path(), *args], text=True, capture_output=True)
    except OSError as exc:
        fail(f"cannot run wsdbus-ctl: {exc}")
    if done.returncode == NO_PROVIDER:
        fail("no wsdbus provider on the session bus "
             "(GNOME: the wsdbus extension, active after a new login)")
    if done.returncode == LOCKED:
        fail("the screen is locked")
    if done.returncode not in (0, STALE):
        detail = done.stderr.strip()
        fail(f"wsdbus-ctl {' '.join(args)} failed" + (f": {detail}" if detail else ""))
    return done.returncode, done.stdout


def windows():
    _status, out = ctl("--json", "windows")
    try:
        items = json.loads(out)["windows"]
    except (ValueError, KeyError, TypeError) as exc:
        fail(f"cannot read wsdbus-ctl windows: {exc}")
    if not isinstance(items, list):
        fail("wsdbus-ctl windows gave no list")
    return items


def focused_window(items):
    for item in items:
        if item.get("focused"):
            return item
    fail("no focused window")


def act(item, action):
    # A window that closed meanwhile (stale) needs nothing more.
    ctl("window", str(item["id"]), action)


def minimize_current():
    items = windows()
    app = focused_window(items)["app"]
    for item in items:
        if item.get("app") == app and not item.get("minimized"):
            act(item, "minimize")


def minimize_others():
    items = windows()
    app = focused_window(items)["app"]
    for item in items:
        if item.get("app") != app and not item.get("minimized"):
            act(item, "minimize")


def close_current():
    items = windows()
    focused = focused_window(items)
    targets = [item for item in items if item.get("app") == focused["app"]]
    # The focused window last: closing it first would move the focus.
    targets.sort(key=lambda item: item["id"] == focused["id"])
    for item in targets:
        act(item, "close")


def check():
    """The provider offers what the window actions need."""
    _status, out = ctl("--json", "info")
    try:
        capabilities = json.loads(out)["capabilities"]
    except (ValueError, KeyError, TypeError) as exc:
        fail(f"cannot read wsdbus-ctl info: {exc}")
    missing = [c for c in ("windows", "WindowAction") if c not in capabilities]
    if missing:
        fail(f"the wsdbus provider lacks {', '.join(missing)}")
    print("wsdbus provider: windows, WindowAction")


def task_manager():
    exe = shutil.which("gnome-system-monitor")
    if exe:
        subprocess.Popen(
            [exe],
            start_new_session=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return

    flatpak = shutil.which("flatpak")
    if flatpak:
        check = subprocess.run(
            [flatpak, "info", "org.gnome.SystemMonitor"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if check.returncode == 0:
            subprocess.Popen(
                [flatpak, "run", "org.gnome.SystemMonitor"],
                start_new_session=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            return

    fail(
        "GNOME System Monitor is not installed; "
        "install package 'gnome-system-monitor'"
    )


def logout(no_prompt=False):
    exe = shutil.which("gnome-session-quit")
    if not exe:
        fail("gnome-session-quit is not installed")

    cmd = [exe, "--logout"]
    if no_prompt:
        cmd.append("--no-prompt")

    os.execv(exe, cmd)


def main():
    if len(sys.argv) != 2:
        fail(
            "usage: ws-window "
            "{task-manager|hide-current|hide-others|"
            "minimize-current|close-current|logout|logout-now|check}",
            2,
        )

    action = sys.argv[1]

    if action == "task-manager":
        task_manager()
    elif action in ("hide-current", "minimize-current"):
        minimize_current()
    elif action == "hide-others":
        minimize_others()
    elif action == "close-current":
        close_current()
    elif action == "logout":
        logout(False)
    elif action == "logout-now":
        logout(True)
    elif action == "check":
        check()
    else:
        fail(f"unknown action: {action}", 2)


if __name__ == "__main__":
    main()
