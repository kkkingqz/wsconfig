#!/usr/bin/env bash
set -euo pipefail

# The widget layer of this repository (ws help widgets): which widgets of
# wswidgets each workstation has and which wswidgets version is installed.
# The widgets come from the wswidgets flake input pinned by flake.lock
# (github:kkkingqz/wswidgets), never from a local checkout: list, enable and
# update read its catalog (lib.catalog) through Nix. Which host has which
# widget: hosts/HOST/widgets.toml, yes = [...] in panel order, no =
# [...]; a widget in neither is ask (lib/ws_catalog.py). enable/disable/apply
# edit it and run ws apply widgets; update moves flake.lock to the newest
# wswidgets and applies. ws sync publishes both (ws help plan-v2, 2.7).

# shellcheck source=../lib/common.bash
. "$(dirname "$(readlink -f "$0")")/../lib/common.bash"
ws_prog="ws widgets"
catalog_py="$WS_CORE/lib/ws_catalog.py"
# Tests replace the catalog (a JSON file), ws apply and the layer fact.
catalog_file="${WSWIDGETS_CATALOG:-}"
apply_cmd="${WSWIDGETS_APPLY:-$WS_CORE/bin/ws apply widgets}"

usage() {
    cat <<'USAGE'
Usage:
  ws widgets list                 widgets of the pinned wswidgets and their state here
  ws widgets enabled              IDs enabled on this workstation, in panel order
  ws widgets enable [-n] ID...    yes on this host, then ws apply widgets
  ws widgets disable [-n] ID...   no on this host, then ws apply widgets
  ws widgets apply [--select]     offer the widgets not offered here yet (ws apply
                                  widgets runs it; alone it names ws apply widgets)
  ws widgets update [-n]          newest wswidgets from GitHub: flake.lock, ws apply widgets
  ws widgets version              the pinned wswidgets revision
  ws widgets status               ws-widgets status (the running runtime)
  ws widgets check [--json]       ws check widgets

  -n, --no-apply  only edit the list or flake.lock; ws apply applies it later
  --select        offer the declined widgets again
  --json          one result object (ws check)
USAGE
}

load_host() {
    [[ -z "${ws_host:-}" ]] || return 0
    ws_host="$("$WS_CORE/bin/ws" host --for-marks)" \
        || die "no host for hosts/HOST/widgets.toml (ws host --for-marks)"
    list_file="hosts/$ws_host/widgets.toml"
}

choice() {
    python3 "$catalog_py" --host "$ws_host" widgets "$@"
}

# widgets of this host's host.toml, yes or no (ws fact): the layer itself.
layer() {
    if [[ -n "${WSWIDGETS_FACT:-}" ]]; then
        printf '%s\n' "$WSWIDGETS_FACT"
    else
        "$WS_CORE/bin/ws" fact widgets 2>/dev/null || true
    fi
}

require_layer() {
    load_host
    [[ "$(layer)" == yes ]] \
        || die "widgets is not true in hosts/$ws_host/host.toml: no widget layer here (ws help widgets)"
}

# lib.catalog of the wswidgets in flake.lock, as JSON.
catalog_json() {
    if [[ -n "$catalog_file" ]]; then
        cat "$catalog_file"
    else
        "$(nix_bin)" eval --json --inputs-from "$repo" 'wswidgets#lib.catalog' 2>/dev/null \
            || die "cannot read the wswidgets catalog (flake.lock; network for a revision not fetched yet)"
    fi
}

# ID<TAB>LABEL per catalog widget, in catalog order.
catalog_rows() {
    catalog_json | python3 -c '
import json, sys
for w in json.load(sys.stdin):
    print(w["id"] + "\t" + w["label"])'
}

catalog_ids() {
    catalog_rows | cut -f1
}

state_of() {
    choice state "$1"
}

# ws apply widgets after a change (not inside ws apply, which applies it
# itself); with -n only the hint.
do_apply() {
    [[ -z "${WS_APPLYING:-}" ]] || return 0
    if [[ "$1" == true ]]; then
        echo "then: ws apply widgets (applies it), ws sync (publishes $list_file)"
    else
        # shellcheck disable=SC2086 # apply_cmd is a fixed command line
        $apply_cmd
    fi
}

no_apply_flag() {
    case "${1:-}" in -n|--no-apply) return 0 ;; esac
    return 1
}

# flake.lock fields of the wswidgets input: rev, lastModified, owner/repo.
lock_field() {
    python3 - "$repo/flake.lock" "$1" <<'PY'
import json, sys
node = json.load(open(sys.argv[1]))["nodes"]["wswidgets"]["locked"]
field = sys.argv[2]
if field == "repo":
    print(f'{node["owner"]}/{node["repo"]}')
elif field == "date":
    import datetime
    print(datetime.datetime.fromtimestamp(node["lastModified"], datetime.timezone.utc).strftime("%Y-%m-%d"))
else:
    print(node[field])
PY
}

cmd_list() {
    local id label state known
    load_host
    printf 'wswidgets %s (%s), %s:\n' "$(lock_field rev | cut -c1-7)" "$(lock_field date)" "$ws_host"
    [[ "$(layer)" == yes ]] || printf '  (widgets is not true in host.toml: the layer is off here)\n'
    known="$(catalog_rows)" || exit 1
    while IFS=$'\t' read -r id label; do
        [[ -n "$id" ]] || continue
        state="$(state_of "$id")"
        printf '  %-16s %-4s %s\n' "$id" "$state" "$label"
    done <<<"$known"
    # Chosen widgets the pinned version no longer has.
    while IFS= read -r id; do
        [[ -n "$id" ]] || continue
        grep -q "^$id"$'\t' <<<"$known" && continue
        printf '  %-16s %-4s (not in this wswidgets version)\n' "$id" "$(state_of "$id")"
    done < <(choice chosen)
}

# What widgets.nix enables: yes of this host, in panel order.
cmd_enabled() {
    load_host
    choice yes
}

cmd_enable() {
    local no_apply=false id ids
    if no_apply_flag "${1:-}"; then no_apply=true; shift; fi
    (($#)) || die "usage: ws widgets enable [-n] ID..."
    require_layer
    ids="$(catalog_ids)" || exit 1
    for id in "$@"; do
        grep -Fxq -- "$id" <<<"$ids" \
            || die "no widget $id in wswidgets $(lock_field rev | cut -c1-7); have: $(paste -sd ' ' <<<"$ids")"
    done
    choice set yes "$@" || exit
    for id in "$@"; do
        echo "enabled on $ws_host: $id"
    done
    do_apply "$no_apply"
}

cmd_disable() {
    local no_apply=false id
    if no_apply_flag "${1:-}"; then no_apply=true; shift; fi
    (($#)) || die "usage: ws widgets disable [-n] ID..."
    require_layer
    for id in "$@"; do
        [[ "$(state_of "$id")" == yes ]] || die "$id is not enabled on $ws_host"
    done
    choice set no "$@" || exit
    for id in "$@"; do
        echo "disabled on $ws_host: $id (no in $list_file)"
    done
    do_apply "$no_apply"
}

# yes: enabled; ask: offered (the answer goes to widgets.toml); no: left
# alone unless --select. A new catalog widget without a line is offered too.
cmd_apply() {
    local id label state rc=0 offered rows
    local -a items=() select=()
    case "${1:-}" in
        --select) select=(--select) ;;
        "") ;;
        *) die "usage: ws widgets apply [--select]" ;;
    esac
    load_host
    if [[ "$(layer)" != yes ]]; then
        echo "widgets is not true in hosts/$ws_host/host.toml: no widget layer, nothing to apply"
        return 0
    fi
    # Every widget of the catalog defaults to ask.
    rows="$(catalog_rows)" || exit 1
    while IFS=$'\t' read -r id label; do
        [[ -z "$id" ]] || items+=("$id"$'\t'ask$'\t'"$label")
    done <<<"$rows"
    offered="$(for id in "${items[@]}"; do
        id="${id%%$'\t'*}"
        state="$(state_of "$id")"
        if [[ "$state" == ask || ( "$state" == no && ${#select[@]} -gt 0 ) ]]; then echo "$id"; fi
    done)"
    # ws apply asked already (ws_catalog offer --all).
    [[ -z "${WS_OFFERED:-}" || ${#select[@]} -gt 0 ]] || offered=""
    if [[ -z "$offered" ]]; then
        echo "no widgets to offer on $ws_host"
        return 0
    fi
    choice offer "${select[@]}" --what "wswidgets widgets" -- "${items[@]}" >/dev/null || rc=$?
    case "$rc" in
        0) [[ -n "${WS_APPLYING:-}" ]] || echo "then: ws apply widgets (applies the choice)" ;;
        2) echo "ws widgets: choice cancelled, the offered widgets left as they are (asked next time)" >&2 ;;
        3)
            ((${#select[@]} == 0)) || die "ws widgets apply --select: needs a terminal"
            echo "Not offered on $ws_host yet (no terminal to ask): $(echo $offered); run ws widgets apply in a terminal" >&2
            ;;
        *) exit "$rc" ;;
    esac
}

cmd_update() {
    local no_apply=false old new nix backup gone=() missing id rc
    if no_apply_flag "${1:-}"; then no_apply=true; shift; fi
    (($# == 0)) || die "usage: ws widgets update [-n]"
    nix="$(nix_bin)"
    git -C "$repo" diff --quiet HEAD -- flake.lock \
        || die "flake.lock has uncommitted changes; commit or restore them first"
    old="$(lock_field rev)"
    local old_ids new_ids
    old_ids="$(catalog_ids)" || exit 1
    backup="$(mktemp)"
    cp "$repo/flake.lock" "$backup"
    restore() { cp "$backup" "$repo/flake.lock"; rm -f "$backup"; }

    "$nix" flake update wswidgets --flake "$repo" || { restore; die "nix flake update wswidgets failed"; }
    new="$(lock_field rev)"
    if [[ "$new" == "$old" ]]; then
        rm -f "$backup"
        echo "wswidgets ${old:0:7} is the newest"
        return 0
    fi
    new_ids="$(catalog_ids)" || { restore; exit 1; }

    # A widget enabled on some host must still exist: its home
    # configuration would not build. Disable it first (ws widgets disable).
    while IFS= read -r id; do
        [[ -n "$id" ]] || continue
        grep -Fxq -- "$id" <<<"$new_ids" || gone+=("$id")
    done < <(python3 "$catalog_py" widgets used)
    if ((${#gone[@]})); then
        restore
        die "wswidgets ${new:0:7} has no ${gone[*]}, enabled in hosts/*/widgets.toml; disable them first (flake.lock unchanged)"
    fi

    echo "wswidgets ${old:0:7} -> ${new:0:7} ($(lock_field date))"
    echo "  https://github.com/$(lock_field repo)/compare/$old...$new"
    missing="$(comm -13 <(sort <<<"$old_ids") <(sort <<<"$new_ids") | paste -sd ' ')"
    [[ -z "$missing" ]] || echo "  new widgets: $missing (ws widgets apply offers them)"
    missing="$(comm -23 <(sort <<<"$old_ids") <(sort <<<"$new_ids") | paste -sd ' ')"
    [[ -z "$missing" ]] || echo "  removed widgets: $missing"

    if [[ "$no_apply" == false ]]; then
        # flake.lock goes back only when nothing was applied (exit 2 of ws
        # apply: the build failed); once applying began part of the system is
        # of the new version (ws help architecture-v2, 12.3).
        rc=0
        # shellcheck disable=SC2086 # apply_cmd is a fixed command line
        $apply_cmd || rc=$?
        if ((rc == 2)); then
            restore
            die "ws apply built nothing; flake.lock restored to ${old:0:7}"
        elif ((rc != 0)); then
            rm -f "$backup"
            die "ws apply failed after applying began; flake.lock stays at ${new:0:7}: fix it and ws apply, or git checkout flake.lock and ws apply"
        fi
    fi
    rm -f "$backup"
    echo "flake.lock: wswidgets ${new:0:7}, not published (ws sync)"
    [[ "$no_apply" == false ]] || echo "then: ws apply widgets"
}

cmd_version() {
    printf 'wswidgets %s (%s) github:%s\n' "$(lock_field rev)" "$(lock_field date)" "$(lock_field repo)"
}

case "${1:-}" in
    list) shift; cmd_list "$@" ;;
    enabled) shift; cmd_enabled "$@" ;;
    enable) shift; cmd_enable "$@" ;;
    disable) shift; cmd_disable "$@" ;;
    apply) shift; cmd_apply "$@" ;;
    update) shift; cmd_update "$@" ;;
    version) shift; cmd_version ;;
    status) shift; require_layer; exec ws-widgets status "$@" ;;
    check) shift; exec "$WS_CORE/libexec/ws-check-widgets" "$@" ;;
    -h|--help|help) usage ;;
    "") usage; exit 64 ;;
    *) usage >&2; exit 64 ;;
esac
