#!/usr/bin/env bash
set -euo pipefail

# First setup of a PC on wsconfig (ws help setup; ws help plan-v2, stage 9),
# from a fresh Ubuntu 26.04 to a checked workstation. install.sh (the root
# of the core) prepares Nix and runs it from the core in the store; it goes
# on by itself after every reboot until the end:
#
#   configuration  --repo URL|PATH: a clone in ~/wsconfig (GitHub login for
#                  a GitHub URL); --new [DIR]: a new one from template/
#   core           the revision flake.lock of the configuration pins, built
#                  from the configuration (nix build CONFIG#ws) into
#                  WS_STATE/setup/ws; a run of another core execs that one
#   host           the one whose host.toml has this hostname, else asked (an
#                  existing one gives the PC its hostname, a new one is made
#                  and committed)
#   choices        all questions at once: Flatpak apps, Distrobox boxes,
#                  widgets and overrides without a choice of this host
#                  (lib/ws_catalog.py offer --all --setup), package licenses,
#                  the go; the host and its choices are published after a
#                  question (ws sync)
#   btrfs          ws btrfs make → reboot → ws btrfs make
#   prepare        libexec/ws-prepare: apt, @vms, @steam, @wsbackup, groups,
#                  fish, the first ws apply home → reboot
#   layers         ws apply → reboot → ws apply
#   check          ws check (FAIL does not stop: listed at the end)
#   timeshift      its configuration and the first snapshot
#   backup         the backup key
#   finish         ws apply home, ws checkpoint create setup, ws sync after
#                  the question
#
# Each run starts where the last one stopped: the state of the system and
# the steps done in WS_STATE/setup. Until the end a GNOME autostart entry
# runs it again after each login. GRUB hosts only: rEFInd (mbp16) is ws help
# rebuild.

# shellcheck source=../lib/common.bash
. "$(dirname "$(readlink -f "$0")")/../lib/common.bash"
ws_prog="ws setup"

usage() {
    cat <<'USAGE'
Usage:
  ws setup --repo URL|PATH [--host NAME]   set up this PC from a configuration
                                           (cloned to ~/wsconfig)
  ws setup --new [DIR] [--host NAME]       set up this PC with a new
                                           configuration in DIR (~/wsconfig)
  ws setup                                 go on where the last run stopped
  ws setup --check                         the manual steps of a rEFInd host
                                           (T2): done or not; changes nothing

  --repo URL|PATH  a configuration that exists
  --new [DIR]      a new configuration in DIR (~/wsconfig)
  --host NAME      the host when the hostname finds none
  --check          only check the manual steps

install.sh runs it on a fresh Ubuntu (ws help setup); after each reboot the
autostart runs it again (--autostart). --host NAME answers the question of
the host when the hostname finds none. A host with boot = "refind-..." (T2,
mbp16) has steps by hand (ws help rebuild, sections 2 to 5): ws setup checks
them, stops with what is left and goes on when they are done.
USAGE
}

state="$WS_STATE/setup"
autostart="$HOME/.config/autostart/ws-setup.desktop"
mode=
source_arg=
host_arg=
autostarted=false
check_only=false
args=("$@")
while (($#)); do
    case "$1" in
        --repo) (($# >= 2)) || die "--repo needs a URL or PATH"; mode=repo; source_arg="$2"; shift 2 ;;
        --new)
            mode=new
            if [[ -n "${2:-}" && "$2" != --* ]]; then source_arg="$2"; shift; fi
            shift
            ;;
        --host) (($# >= 2)) || die "--host needs a NAME"; host_arg="$2"; shift 2 ;;
        --autostart) autostarted=true; shift ;;
        --check) check_only=true; shift ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; exit 64 ;;
    esac
done

[[ $EUID -ne 0 ]] || die "run as the desktop user, not root"

say() {
    printf '\n== %s\n' "$*"
}

# The dialogs: gum through libexec/ws-ui (ws help plan-v2, 11). Esc is no
# (confirm) or the default (input); Ctrl+C or a gum failure ends setup.
ui() {
    local rc=0
    "$WS_CORE/libexec/ws-ui" "$@" || rc=$?
    case "$rc" in
        0 | 1 | 2) return "$rc" ;;
        3) die "no terminal to ask on" ;;
        130) die "interrupted" ;;
        *) die "the dialog failed (ws-ui exit $rc)" ;;
    esac
}

# yes/no question; $2 is the answer on Enter (y or n).
ask() {
    local default=yes
    [[ "${2:-y}" == y ]] || default=no
    ui confirm --default "$default" "$1"
}

# A line of text; $2 is in the field, Enter or Esc keeps it.
ask_text() {
    local a
    a="$(ui input --value "$2" "$1")" || a=
    echo "${a:-$2}"
}

# Wait for Enter.
pause() {
    "$WS_CORE/libexec/ws-ui" pause "$1" || true
}

done_step() { [[ -e "$state/$1.done" ]]; }
mark_step() { mkdir -p "$state" && date -Is > "$state/$1.done"; }

ws() { "$WS_CORE/bin/ws" "$@"; }

# A fact of a host.toml (lib/ws_facts.py); empty when there is none.
fact_in() {
    python3 "$WS_CORE/lib/ws_facts.py" fact --file "$1" "$2" 2>/dev/null || true
}

# The terminal: install.sh gives it as stdin (wget | bash); WS_SETUP_TTY
# replaces it (tests), also for the dialogs (WS_UI_TTY of lib/ws_ui.py).
if [[ -n "${WS_SETUP_TTY:-}" ]]; then
    exec <"$WS_SETUP_TTY"
    export WS_UI_TTY="$WS_SETUP_TTY"
else
    [[ -t 0 ]] || die "run it in a terminal: it asks questions"
fi
# The terminal of the autostart closes with the script: keep it open.
if [[ "$autostarted" == true ]]; then
    trap 'echo; pause "Enter: close the window"' EXIT
fi
# One run at a time (the autostart and a terminal); exec keeps the PID.
# --check only reads.
if [[ "$check_only" == false ]]; then
    mkdir -p "$state"
    if old="$(cat "$state/pid" 2>/dev/null)" && [[ "$old" != "$$" ]] \
        && tr '\0' ' ' < "/proc/$old/cmdline" 2>/dev/null | grep -q 'ws-setup'; then
        die "ws setup is already running (PID $old)"
    fi
    echo "$$" > "$state/pid"
fi
# The Nix profile, as 00-nix.fish puts it into login shells; Nix of apt
# knows no flakes until home-manager writes ~/.config/nix/nix.conf.
[[ ! -d "$HOME/.nix-profile/bin" ]] || PATH="$HOME/.nix-profile/bin:$PATH"
export NIX_CONFIG="${NIX_CONFIG:-experimental-features = nix-command flakes}"

# The ws to run again: the core of setup in the store (install.sh, the GC
# root WS_STATE/setup/ws), else this one (a checkout of the core).
setup_ws() {
    if [[ -x "$state/ws/bin/ws" ]]; then
        echo "$state/ws/bin/ws"
    else
        echo "$WS_CORE/bin/ws"
    fi
}

reboot_now() {
    say "Reboot: $1"
    echo "After the login ws setup goes on by itself."
    pause "Enter: reboot"
    trap - EXIT
    sudo systemctl reboot
    exit 0
}

step_tools() {
    local -a missing=()
    local c
    command -v nix >/dev/null 2>&1 || die "no Nix: install.sh first (ws help setup)"
    for c in git gh xdg-terminal-exec; do
        command -v "$c" >/dev/null 2>&1 || missing+=("$c")
    done
    # The host choices are edited through tomlkit (lib/ws_catalog.py), the
    # first time in step_choices.
    python3 -c 'import tomlkit' 2>/dev/null || missing+=(python3-tomlkit)
    ((${#missing[@]})) || return 0
    say "apt: ${missing[*]}"
    sudo apt-get update
    sudo apt-get install -y "${missing[@]}"
}

# GitHub: the login in the browser, git over gh, the author of commits;
# once a run.
github_done=false
step_github() {
    local name email
    [[ "$github_done" == false ]] || return 0
    github_done=true
    if ! gh auth status --hostname github.com >/dev/null 2>&1; then
        say "GitHub: login in the browser (one-time code)"
        gh auth login --hostname github.com --git-protocol https --web --scopes user:email
    fi
    if ! git config --global --get-all credential.https://github.com.helper 2>/dev/null | grep -q 'gh auth git-credential'; then
        gh auth setup-git --hostname github.com
    fi
    if [[ -z "$(git config --global user.name)" ]]; then
        name="$(gh api user --jq '.name // .login')"
        git config --global user.name "$name"
    fi
    if [[ -z "$(git config --global user.email)" ]]; then
        email="$(gh api user/emails --jq 'map(select(.primary))[0].email' 2>/dev/null || true)"
        [[ -n "$email" && "$email" != null ]] \
            || email="$(gh api user --jq '"\(.id)+\(.login)@users.noreply.github.com"')"
        git config --global user.email "$email"
    fi
    [[ -n "$(git config --global init.defaultBranch)" ]] || git config --global init.defaultBranch main
}

is_github() { [[ "$1" == https://github.com/* || "$1" == git@github.com:* ]]; }

# A configuration of wsconfig: its schema file and the input wsconfig.
is_config() {
    [[ -r "$1/wsconfig.toml" && -r "$1/flake.lock" ]] \
        && [[ -n "$(manifest_get "$1/flake.lock" nodes root inputs wsconfig 2>/dev/null)" ]]
}

# The configuration: the path of the last run (WS_STATE/setup/config), else
# --repo or --new; then WS_CONFIG of every tool.
step_config() {
    local dir url
    dir="$(cat "$state/config" 2>/dev/null || true)"
    if [[ -z "$dir" ]]; then
        case "$mode" in
            repo)
                dir="$HOME/wsconfig"
                url="$source_arg"
                [[ "$url" == */* || "$url" == *:* || -d "$url" ]] || die "--repo $url: not a URL or a path"
                [[ ! -d "$url" ]] || url="$(cd "$url" && pwd)"
                ! is_github "$url" || step_github
                if [[ -d "$dir/.git" ]] \
                    && [[ "$(git -C "$dir" remote get-url origin 2>/dev/null)" == "$url" ]]; then
                    echo "$dir: a clone of $url, going on with it"
                elif [[ -e "$dir" && -n "$(ls -A "$dir" 2>/dev/null)" ]]; then
                    die "$dir exists and is not a clone of $url: move it away first (nothing is overwritten)"
                else
                    say "Configuration: $url → $dir"
                    git clone -q "$url" "$dir" || die "git clone $url failed (URL, access?)"
                fi
                ;;
            new)
                dir="${source_arg:-$HOME/wsconfig}"
                [[ "$dir" == /* ]] || dir="$PWD/$dir"
                new_config "$dir"
                ;;
            *)
                is_config "$HOME/wsconfig" \
                    || die "no configuration: ws setup --repo URL or --new (ws help setup)"
                dir="$HOME/wsconfig"
                ;;
        esac
        is_config "$dir" || die "$dir is not a configuration of wsconfig (wsconfig.toml, flake input wsconfig)"
        echo "$dir" > "$state/config"
    fi
    is_config "$dir" || die "$dir is not a configuration of wsconfig any more (WS_STATE/setup/config)"
    WS_CONFIG="$dir"
    WSCONFIG="$dir"
    repo="$dir"
    export WS_CONFIG WSCONFIG
    # The GitHub login only when the configuration lives there (git push,
    # ws sync).
    if url="$(git -C "$repo" remote get-url origin 2>/dev/null)" && is_github "$url"; then
        step_github
    fi
}

# The revision of this core: install.sh recorded it, a checkout has it.
own_rev() {
    if [[ -s "$state/core" ]]; then
        cat "$state/core"
    else
        git -C "$WS_CORE" rev-parse HEAD 2>/dev/null || die "the revision of the core $WS_CORE is unknown"
    fi
}

# The author of the commits ws setup makes, when Git has none yet (no
# GitHub login with --new).
git_identity() {
    local name email
    if [[ -z "$(git config --global user.name)" ]]; then
        name="$(ask_text "Name of the commit author" "$(id -un)")"
        git config --global user.name "$name"
    fi
    if [[ -z "$(git config --global user.email)" ]]; then
        email="$(ask_text "E-mail of the commit author" "$(id -un)@$(hostname)")"
        git config --global user.email "$email"
    fi
    [[ -n "$(git config --global init.defaultBranch)" ]] || git config --global init.defaultBranch main
}

# --new DIR: the template of this core (lib/ws_template.py), its flake.lock
# pins this core and the nixpkgs, home-manager and wswidgets of its own
# lock; a local commit (nothing leaves the machine: the remote is the
# question at the end).
new_config() {
    local dir="$1" rev
    if [[ -e "$dir" && -n "$(ls -A "$dir" 2>/dev/null)" ]]; then
        die "$dir exists and is not empty: nothing is overwritten (ws setup --new DIR)"
    fi
    rev="$(own_rev)"
    say "New configuration: $dir (core ${rev:0:12})"
    nix flake metadata --json "${WS_SETUP_CORE_FLAKE:-github:kkkingqz/wsconfig}/$rev" > "$state/core-metadata.json" \
        || die "nix flake metadata of the core $rev failed (network? the revision pushed?)"
    python3 "$WS_CORE/lib/ws_template.py" new --core "$WS_CORE" --metadata "$state/core-metadata.json" "$dir" >/dev/null \
        || die "the template was not written"
    git_identity
    git -C "$dir" init -q -b main
    git -C "$dir" add -A
    git -C "$dir" commit -q -m "Configuration from the template of wsconfig ${rev:0:12} (ws setup --new)"
    echo new > "$state/mode"
}

# The revision of the core the configuration pins (its input wsconfig).
pinned_core() {
    local node
    node="$(manifest_get "$repo/flake.lock" nodes root inputs wsconfig)"
    manifest_get "$repo/flake.lock" nodes "$node" locked rev \
        || die "$repo/flake.lock pins no revision of the core"
}

# The configuration is run by its own core: when the core of this run is
# another one, the pinned one is built from the configuration into the GC
# root WS_STATE/setup/ws and runs this command again. A checkout of the
# core (not the store) is not replaced: it is the one being tested.
step_core() {
    local rev own problem
    rev="$(pinned_core)"
    if [[ ! -e "$WS_CORE/.wsconfig-package" ]]; then
        echo "Core: checkout $WS_CORE (the configuration pins ${rev:0:12}, not switching)"
        own="$rev"
    else
        own="$(cat "$state/core" 2>/dev/null || true)"
    fi
    if [[ "$own" == "$rev" ]]; then
        # The core that runs the configuration reads its schema.
        problem="$(python3 "$WS_CORE/lib/ws_common.py" schema 2>&1)" || die "$problem"
        return 0
    fi
    say "Core of the configuration: ${rev:0:12} (now ${own:0:12})"
    nix build --out-link "$state/ws" "git+file:$repo#ws" \
        || die "nix build of the core $rev of the configuration failed"
    [[ -x "$state/ws/libexec/ws-setup" ]] \
        || die "the configuration pins core $rev, older than ws setup: ws update core first (another machine), then ws setup again"
    echo "$rev" > "$state/core"
    exec "$state/ws/bin/ws" setup "${args[@]}"
}

# The newest configuration of main (a run after a reboot); its core may
# have moved (step_core).
step_pull() {
    [[ "$autostarted" == true || -e "$state/choices.done" ]] || return 0
    if [[ -n "$(git -C "$repo" status --porcelain)" ]]; then
        echo "$repo has changes: not pulled"
    elif [[ "$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null)" == main ]] \
        && git -C "$repo" rev-parse -q --verify '@{u}' >/dev/null \
        && ! git -C "$repo" pull -q --ff-only; then
        echo "git pull failed: going on with this version"
    fi
}

push() {
    git -C "$repo" push -q origin HEAD:main || die "git push failed (network, GitHub login?); ws setup again"
}

# The new host (a commit of ws setup) and the marks (data files) leave this
# machine only after the question; ws sync commits the marks and pushes (no
# remote: the commit stays local).
publish() {
    local remote=false
    git -C "$repo" remote get-url origin >/dev/null 2>&1 && remote=true
    if [[ "$remote" == true ]] && ! ask "Publish the new host and the choices (ws sync)?" y; then
        echo "Not published; later: git -C $repo push (the new host), ws sync (the choices)."
        return 0
    fi
    if [[ "$remote" == true && -n "$(git -C "$repo" log --format=%h '@{u}..HEAD' -- hosts 2>/dev/null)" ]]; then
        push
    fi
    ws sync || die "ws sync failed; ws setup again or ws sync by hand"
}

# Host name as a directory (hosts/HOST, lib/ws_facts.py) and the receiver user
# wsbackup-HOST on Unraid (backup/unraid/boot.sh: lowercase, 23 at most) can
# carry it.
valid_name() { [[ "$1" =~ ^[a-z0-9][a-z0-9_-]{0,22}$ && "$1" != all ]]; }

set_hostname() {
    local new="$1" old
    old="$(hostname)"
    [[ "$old" != "$new" ]] || return 0
    say "hostname: $old -> $new"
    sudo hostnamectl set-hostname "$new"
    # sudo resolves the hostname through /etc/hosts.
    sudo sed -i -E "s/^(127\.0\.1\.1[[:space:]]+).*/\1$new/" /etc/hosts
    grep -Eq "^127\.0\.1\.1[[:space:]]+$new\$" /etc/hosts \
        || printf '127.0.1.1\t%s\n' "$new" | sudo tee -a /etc/hosts >/dev/null
}

# The checkout path of the configuration relative to $HOME (wsconfig of
# host.toml: home-manager links point there).
config_rel() {
    [[ "$repo" == "$HOME"/* ]] || die "the configuration must be under $HOME: $repo"
    echo "${repo#"$HOME"/}"
}

# A yes/no question whose default is a fact (yes or no) of the base host.
ask_layer() {
    local question="$1" default="$2"
    [[ "$default" == yes ]] && default=y || default=n
    ask "$question" "$default"
}

# hosts/NAME from the inventory of this machine (lib/ws_inventory.py), or
# from a host of the same hardware; then the layers.
new_host() {
    local name="$1" inv="$state/inventory.json" hw known guest kvm base='' h
    local vm=no widgets=yes steam=no game=no
    local -a flags=()
    python3 "$WS_CORE/lib/ws_inventory.py" > "$inv" || die "the inventory of this machine failed"
    hw="$(manifest_get "$inv" hardware)"
    known="$(manifest_get "$inv" known)"
    guest="$(manifest_get "$inv" guest)"
    kvm="$(manifest_get "$inv" kvm)"
    say "New host $name"
    echo "Machine: $(manifest_get "$inv" model)$([[ "$guest" == false ]] || echo ', virtual')"
    echo "  hardware = $hw$([[ "$known" == true ]] || echo ' (not in the list: a generic PC)'), boot = $(manifest_get "$inv" boot), displayScale = $(manifest_get "$inv" displayScale)"
    if [[ "$known" == false || "$guest" == true ]]; then
        ask "Write it so?" y \
            || die "hosts/$name/host.toml by hand (ws help setup, lib/host.nix), then ws setup again"
    fi
    if [[ "$known" == true ]]; then
        for h in "$repo"/hosts/*/host.toml; do
            [[ -r "$h" && "$(fact_in "$h" hardware)" == "$hw" ]] || continue
            h="$(basename "$(dirname "$h")")"
            if ask "Base it on hosts/$h (the same hardware: kernel parameters, packages)?" y; then
                base="$h"
                break
            fi
        done
    fi
    if [[ -n "$base" ]]; then
        vm="$(fact_in "$repo/hosts/$base/host.toml" vm)"
        widgets="$(fact_in "$repo/hosts/$base/host.toml" widgets)"
        steam="$(fact_in "$repo/hosts/$base/host.toml" nativeSteam)"
        game="$(fact_in "$repo/hosts/$base/host.toml" gameMode)"
        flags+=(--base "$base")
    elif [[ "$kvm" == true && "$guest" == false ]]; then
        vm=yes
    fi
    if [[ "$kvm" == false ]]; then
        echo "No /dev/kvm: no virtual machines."
        vm=no
    elif ask_layer "Virtual machines (libvirt, ws help virt)?" "$vm"; then
        vm=yes
    else
        vm=no
    fi
    ask_layer "Quickshell widgets on the GNOME panel (ws help widgets)?" "$widgets" && widgets=yes || widgets=no
    if ask_layer "Steam from apt (instead of Flatpak; ws help plan-legion-go)?" "$steam"; then
        steam=yes
        ask_layer "Game Mode (a Steam session as in SteamOS)?" "$game" && game=yes || game=no
    else
        steam=no
        game=no
    fi
    [[ "$vm" == no ]] || flags+=(--vm)
    [[ "$widgets" == yes ]] || flags+=(--no-widgets)
    [[ "$steam" == no ]] || flags+=(--steam)
    [[ "$game" == no ]] || flags+=(--game)
    python3 "$WS_CORE/lib/ws_inventory.py" write-host --config "$repo" --name "$name" \
        --inventory "$inv" "${flags[@]}" >/dev/null || die "hosts/$name not written"
    git -C "$repo" add "hosts/$name"
    git -C "$repo" commit -q -m "Hosts: $name${base:+ from $base} (ws setup)" -- "hosts/$name"
}

# What ws setup needs from the facts of HOST, checked before the PC is renamed.
check_facts() {
    local facts="$repo/hosts/$1/host.toml"
    [[ "$(fact_in "$facts" user)" == "$(id -un)" ]] \
        || die "hosts/$1/host.toml: user = \"$(fact_in "$facts" user)\", this user is $(id -un)"
    [[ "$(fact_in "$facts" wsconfig)" == "$(config_rel)" ]] \
        || die "hosts/$1/host.toml: wsconfig = \"$(fact_in "$facts" wsconfig)\", the configuration is ~/$(config_rel)"
    case "$(fact_in "$facts" boot)" in
        grub|refind-grub-recovery) ;;
        *) die "boot = \"$(fact_in "$facts" boot)\" in hosts/$1/host.toml: ws setup knows grub and refind-grub-recovery" ;;
    esac
}

# The host of this PC: one of the configuration (the one named as this PC
# preselected) or "new host…", then its name (this PC's name in the field).
pick_host() {
    local current="$1" sel="new host…" h a
    shift
    for h in "$@"; do
        [[ "$h" != "$current" ]] || sel="$h"
    done
    if (($#)); then
        a="$(ui choose --selected "$sel" "Host of this PC" "$@" "new host…")" || return 1
        [[ "$a" == "new host…" ]] || { echo "$a"; return 0; }
    fi
    valid_name "$current" || current=
    a="$(ui input --value "$current" "Name of the new host")" && [[ -n "$a" ]] || return 1
    echo "$a"
}

step_host() {
    local name hosts current
    if host="$(ws host 2>/dev/null)"; then
        :
    else
        current="$(hostname)"
        hosts="$(cd "$repo/hosts" 2>/dev/null && ls -d -- */ 2>/dev/null | tr -d / | tr '\n' ' ' || true)"
        say "No host for \"$current\""
        echo "Hosts: ${hosts:-none}"
        name="$host_arg"
        while :; do
            # shellcheck disable=SC2086 # one word per host
            [[ -n "$name" ]] || name="$(pick_host "$current" $hosts)" || die "no answer"
            valid_name "$name" && break
            echo "only lowercase latin letters, digits, - and _, up to 23 characters"
            [[ -z "$host_arg" ]] || die "--host $host_arg: not a host name"
            name=
        done
        if [[ -r "$repo/hosts/$name/host.toml" ]]; then
            check_facts "$name"
            set_hostname "$(fact_in "$repo/hosts/$name/host.toml" hostname)"
        else
            new_host "$name"
            set_hostname "$name"
        fi
        host="$(ws host)"
    fi
    check_facts "$host"
    echo "Host: $host"
}

# All questions before the long part: marks, the Steam license, consent.
step_choices() {
    local changed rc=0
    done_step choices && return 0
    say "What goes on $host"
    changed="$(python3 "$WS_CORE/lib/ws_catalog.py" --host "$host" offer --all --setup)" || rc=$?
    ((rc == 0)) || die "lists not answered (ws_catalog exit $rc); ws setup again"
    if [[ -n "$changed" ]]; then
        # shellcheck disable=SC2086 # one line of the names
        echo "Choices of $host: $(echo $changed)"
    fi
    publish
    # Licenses apt would ask about in the middle of ws-prepare.
    local -a eula=('Microsoft core fonts (ubuntu-restricted-extras)')
    local -a seed=('ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true')
    if [[ "$(ws fact nativeSteam)" == yes ]]; then
        eula+=('Valve Steam (steam-installer)')
        seed+=('steam steam/question select I AGREE' 'steam steam/license note ')
    fi
    say "Package licenses"
    printf '  %s\n' "${eula[@]}"
    ask "Accept?" || die "the system preparation installs them: nothing started"
    printf '%s\n' "${seed[@]}" | sudo debconf-set-selections
    say "No more questions from here"
    echo "Btrfs layout (the old root is removed once the boot is checked), system preparation,"
    echo "ws apply (twice), ws check, Timeshift, the backup key. Reboots in between:"
    echo "log in after each one, ws setup goes on by itself. It asks the sudo password after each login."
    ask "Start?" || die "nothing started; ws setup again"
    mark_step choices
}

install_autostart() {
    local exec
    exec="$(setup_ws)"
    if [[ -e "$autostart" ]] && grep -Fqx "Exec=xdg-terminal-exec $exec setup --autostart" "$autostart"; then
        return 0
    fi
    mkdir -p "$(dirname "$autostart")"
    cat > "$autostart" <<EOF
[Desktop Entry]
Type=Application
Name=wsconfig setup
Comment=Continues ws setup after a reboot (ws help setup); removed at its end
Exec=xdg-terminal-exec $exec setup --autostart
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF
}

step_btrfs() {
    if is_refind; then
        # The layout of a T2 host is a step by hand (ws help plan-v2, 9.0).
        t2_stop pre
        return 0
    fi
    case "$(findmnt -no OPTIONS / | tr ',' '\n' | sed -n 's/^subvol=//p')" in
        /)
            install_autostart
            say "Btrfs layout, step 1"
            ws btrfs make --yes
            reboot_now "Btrfs layout, step 1 done"
            ;;
        /@)
            if [[ -e /var/lib/ws-btrfs-layout/old-root ]]; then
                say "Btrfs layout, step 2"
                ws btrfs make --yes
            fi
            ;;
        *) die "/ is neither the top level of Btrfs nor @ (ws help rebuild, section 3)" ;;
    esac
}

step_prepare() {
    done_step prepare && return 0
    install_autostart
    say "System preparation (apt, subvolumes, groups, fish, ws apply home)"
    "$WS_CORE/libexec/ws-prepare"
    mark_step prepare
    reboot_now "groups, fish, PATH of Nix"
}

step_layers() {
    if ! done_step apply1; then
        say "ws apply (first pass)"
        # apt, the system files and the user layer at once. New GNOME
        # extensions activate only in a new session: steps with a failed
        # preflight run again after the reboot.
        ws apply || echo "ws apply: the rest after the reboot"
        mark_step apply1
        reboot_now "system files and GNOME extensions"
    fi
    if ! done_step apply2; then
        say "ws apply"
        ws apply || die "ws apply failed: fix it, then ws setup again"
        mark_step apply2
    fi
}

# T2 and rEFInd (boot = "refind-...", ws help plan-v2, 9.0 and 9.9): the
# steps of ws help rebuild done by hand, checked. pre: before the system is
# prepared (layout, kernel, the values of host.toml); post: after ws apply
# (firmware, refind.conf, resume). Each prints OK or what to do.
is_refind() { [[ "$(ws fact boot)" == refind* ]]; }

# The files these checks read; WS_SETUP_ROOT moves them (tests).
t2_root="${WS_SETUP_ROOT:-}"

t2_left=0
t2_line() {
    if [[ "$1" == ok ]]; then
        printf '  OK   %s\n' "$2"
    else
        printf '  NO   %s\n       → %s\n' "$2" "$3"
        t2_left=$((t2_left + 1))
    fi
}

t2_fact() { python3 "$WS_CORE/lib/ws_facts.py" fact "$1" 2>/dev/null || true; }

# A kernel parameter NAME=VALUE of host.toml (a list: not a fact of ws_facts).
t2_param() {
    python3 - "$repo/hosts/$host/host.toml" "$1" <<'PY'
import sys, tomllib
params = tomllib.load(open(sys.argv[1], "rb"))["platform"].get("kernelParams", [])
print(next((p.split("=", 1)[1] for p in params if p.startswith(sys.argv[2] + "=")), ""))
PY
}

t2_pre() {
    local uuid id def esp boot_part kernel
    uuid="$(findmnt -no UUID /)"
    if findmnt -no OPTIONS / | tr ',' '\n' | grep -qx 'subvol=/@'; then
        t2_line ok "/ on the subvolume @"
        id="$(sudo btrfs subvolume show / | awk '/Subvolume ID:/ { print $3 }')"
        def="$(sudo btrfs subvolume get-default / | awk '{ print $2 }')"
        if [[ -n "$id" && "$id" == "$def" ]]; then
            t2_line ok "@ is the default subvolume (rEFInd takes the kernel from it)"
        else
            t2_line no "@ is not the default subvolume (now ID ${def:-?})" "sudo btrfs subvolume set-default $id /"
        fi
    else
        t2_line no "/ is not on @" "Btrfs layout: $(setup_ws) btrfs make, reboot through GRUB, the same again (ws help rebuild, section 3)"
    fi
    kernel="$(uname -r)"
    if [[ "$kernel" == *t2* ]]; then
        t2_line ok "T2 kernel ($kernel)"
    else
        t2_line no "not a T2 kernel ($kernel)" "the t2linux Ubuntu image, or linux-t2 from its repository (ws help rebuild, sections 2 and 4)"
    fi
    if [[ "$(t2_fact rootUuid)" == "$uuid" ]]; then
        t2_line ok "rootUuid = UUID / ($uuid)"
    else
        t2_line no "rootUuid = \"$(t2_fact rootUuid)\", UUID of / is $uuid" "rootUuid = \"$uuid\" in hosts/$host/host.toml"
    fi
    esp="$(t2_fact refindEspPartuuid)"
    boot_part="$(lsblk -no PARTUUID "$(findmnt -no SOURCE /boot/efi 2>/dev/null)" 2>/dev/null || true)"
    if [[ -n "$esp" && "$esp" != "$boot_part" ]] \
        && lsblk -rno PARTUUID,FSTYPE | grep -qx "$esp vfat"; then
        t2_line ok "refindEspPartuuid is a vfat partition $esp (not /boot/efi)"
    else
        t2_line no "refindEspPartuuid = \"$esp\": not a separate rEFInd ESP" \
            "the PARTUUID of the rEFInd ESP (lsblk -o NAME,PARTUUID,FSTYPE; not /boot/efi) as refindEspPartuuid in hosts/$host/host.toml (ws help rebuild, section 2)"
    fi
}

t2_post() {
    local uuid offset esp tree mnt="$t2_root/run/ws-setup-esp"
    if compgen -G "$t2_root/lib/firmware/brcm/brcmfmac4364*.bin*" >/dev/null; then
        t2_line ok "firmware Wi-Fi (brcmfmac4364)"
    else
        t2_line no "no Wi-Fi firmware" "get-apple-firmware.service (ws apply system) takes it from macOS; without macOS from an archive (ws help rebuild, section 4)"
    fi
    uuid="$(findmnt -no UUID /)"
    if [[ ! -f "$t2_root/swap/swapfile" ]]; then
        t2_line no "no /swap/swapfile (hibernation)" "ws suspend swap-setup 32g, its resume= in kernelParams of hosts/$host/host.toml"
    else
        offset="$(sudo btrfs inspect-internal map-swapfile -r "$t2_root/swap/swapfile")"
        if [[ "$(t2_param resume)" == "UUID=$uuid" && "$(t2_param resume_offset)" == "$offset" ]]; then
            t2_line ok "resume= and resume_offset= point at /swap/swapfile"
        else
            t2_line no "resume=$(t2_param resume) resume_offset=$(t2_param resume_offset), needed UUID=$uuid and $offset" \
                "\"resume=UUID=$uuid\", \"resume_offset=$offset\" in kernelParams of hosts/$host/host.toml, ws apply system"
        fi
    fi
    esp="$(t2_fact refindEspPartuuid)"
    if [[ -z "$esp" ]] || ! tree="$(ws system tree 2>/dev/null)"; then
        t2_line no "refind.conf not compared (no refindEspPartuuid or no system build)" "the steps above first, ws apply"
        return
    fi
    sudo install -d "$mnt"
    if ! sudo mount -o ro "/dev/disk/by-partuuid/$esp" "$mnt"; then
        t2_line no "ESP $esp does not mount" "refindEspPartuuid in hosts/$host/host.toml"
        sudo rmdir "$mnt" 2>/dev/null || true
        return
    fi
    if sudo cmp -s "$tree/esp/EFI/BOOT/refind.conf" "$mnt/EFI/BOOT/refind.conf"; then
        t2_line ok "refind.conf on the ESP is the built one"
    else
        t2_line no "refind.conf on the ESP is not the built one" \
            "sudo mount /dev/disk/by-partuuid/$esp /mnt && sudo cp \"\$(ws system tree)/esp/EFI/BOOT/refind.conf\" /mnt/EFI/BOOT/refind.conf && sudo umount /mnt (ws help workstation, GRAPHICS)"
    fi
    sudo umount "$mnt"
    sudo rmdir "$mnt" 2>/dev/null || true
}

# The checks of PART; setup stops when one is not done.
t2_stop() {
    say "Manual steps of T2 and rEFInd (ws help rebuild)"
    t2_left=0
    "t2_$1"
    if ((t2_left)); then
        echo
        echo "Not done: $t2_left. After them: ws setup (goes on from here)."
        trap - EXIT
        exit 1
    fi
}

# The manual steps that need the system of ws apply (firmware, refind.conf).
step_t2() {
    is_refind || return 0
    t2_stop post
}

# FAIL does not stop setup: the snapshot is marked and the end lists them.
step_check() {
    done_step check && return 0
    say "ws check"
    rm -f "$state/check-fail.txt"
    if ! ws check | tee "$state/check.txt"; then
        grep -E '^ *FAIL ' "$state/check.txt" > "$state/check-fail.txt" \
            || echo "  FAIL  ws check (exit status)" > "$state/check-fail.txt"
    fi
    mark_step check
}

# Timeshift: Btrfs @ and @home; the schedule of mbp16 (ws help rebuild,
# section 12). Written once: afterwards the file belongs to Timeshift.
step_timeshift() {
    local conf=/etc/timeshift/timeshift.json uuid
    done_step timeshift && return 0
    say "Timeshift"
    uuid="$(findmnt -no UUID /)"
    if [[ ! -e "$conf" ]] || grep -Eq '"do_first_run" *: *"true"' "$conf"; then
        python3 - "$uuid" <<'PY' | sudo tee "$conf" >/dev/null
import json, sys
print(json.dumps({
    "backup_device_uuid": sys.argv[1], "parent_device_uuid": "",
    "do_first_run": "false", "btrfs_mode": "true",
    "include_btrfs_home_for_backup": "true", "include_btrfs_home_for_restore": "false",
    "stop_cron_emails": "true",
    "schedule_monthly": "true", "schedule_weekly": "true", "schedule_daily": "false",
    "schedule_hourly": "false", "schedule_boot": "true",
    "count_monthly": "1", "count_weekly": "3", "count_daily": "5",
    "count_hourly": "6", "count_boot": "3",
    "snapshot_size": "0", "snapshot_count": "0",
    "date_format": "%Y-%m-%d %H:%M:%S", "exclude": [], "exclude-apps": [],
}, indent=2))
PY
        echo "$conf: Btrfs $uuid, @home included, monthly 1, weekly 3, boot 3"
    else
        echo "$conf exists: kept"
    fi
    if [[ -s "$state/check-fail.txt" ]]; then
        sudo timeshift --create --scripted --comments "setup, ws check FAIL"
    else
        sudo timeshift --create --scripted --comments "setup"
    fi
    mark_step timeshift
}

# Backup (ws help backup): the local side. @wsbackup is ws-prepare; the
# key goes to the receiver as hosts/HOST/ on the Unraid flash, by hand.
step_backup() {
    local key="$HOME/.ssh/wsbackup_ed25519"
    done_step backup && return 0
    say "Backup"
    if [[ ! -e "$key" ]]; then
        install -d -m 0700 "$HOME/.ssh"
        ssh-keygen -q -t ed25519 -N "" -C "workstation-backup $host" -f "$key"
    fi
    echo "Local copies: /var/lib/workstation-backup (@wsbackup). Key: $key.pub"
    echo "On Unraid: hosts/$host/ with this key (user wsbackup-$host), then the alias and"
    echo "hosts/$host/backup.toml of the configuration: ws help backup (several workstations)."
    mark_step backup
}

# --new: a private GitHub repository only after the question, no by default
# (ws help plan-v2, 9.0).
new_remote() {
    local name
    [[ "$(cat "$state/mode" 2>/dev/null)" == new ]] || return 0
    git -C "$repo" remote get-url origin >/dev/null 2>&1 && return 0
    if ! ask "Create a private GitHub repository for the configuration?" n; then
        echo "No remote: ws sync commits locally. Later: gh repo create --private NAME --source $repo --push"
        return 0
    fi
    step_github
    name="$(ask_text "Repository name" "$(basename "$repo")")"
    gh repo create --private "$name" --source "$repo" --remote origin --push \
        || echo "Not created; later: gh repo create --private NAME --source $repo --push"
}

step_finish() {
    local checkpoint=true
    # Everything of the configuration is data (ws sync); step_choices may
    # have made the host files, so untracked ones count.
    say "Finish"
    ws apply home
    # A checkpoint needs a live system that matches its tree (ws system check).
    if ! git -C "$repo" rev-parse -q --verify refs/tags/checkpoint/setup >/dev/null; then
        ws checkpoint create setup || checkpoint=false
    fi
    new_remote
    if [[ -n "$(git -C "$repo" log --oneline '@{u}..HEAD' 2>/dev/null)" \
        || -n "$(git -C "$repo" status --porcelain --untracked-files=all)" ]]; then
        publish
    fi
    rm -f "$autostart"
    if [[ -s "$state/check-fail.txt" ]]; then
        echo "Host $host is set up, but ws check found FAIL ($state/check.txt):"
        cat "$state/check-fail.txt"
        echo "Timeshift snapshot: \"setup, ws check FAIL\". After the fix: ws check,"
        echo "sudo timeshift --create --comments checked, ws checkpoint create setup."
    else
        echo "Host $host is set up: ws check without FAIL, Timeshift snapshot \"setup\"."
    fi
    [[ "$checkpoint" == true ]] || echo "checkpoint setup not created: ws checkpoint create setup after the fix."
}

# --check: the manual steps of this host, nothing else (no state, no apt).
if [[ "$check_only" == true ]]; then
    host="$(ws host)" || die "no host for $(hostname) in $repo (ws host)"
    if ! is_refind; then
        echo "Host $host (boot = $(ws fact boot)): no manual steps."
        exit 0
    fi
    say "Manual steps of T2 and rEFInd, host $host (ws help rebuild)"
    t2_pre
    t2_post
    if ((t2_left)); then
        printf '\nNot done: %s.\n' "$t2_left"
        exit 1
    fi
    printf '\nAll manual steps are done.\n'
    exit 0
fi

sudo -v || die "sudo needed"
step_tools
step_config
step_pull
step_core
step_host
step_choices
step_btrfs
step_prepare
step_layers
