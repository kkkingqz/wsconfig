#!/usr/bin/env bash
set -u
set -o pipefail

# Windows layer (windows/apps.nix, the Windows boxes of distrobox.nix):
# programs point at Windows boxes and are installed in their prefixes, .exe
# opens in the default box, menu links resolve. Read-only. wswin check; ws check runs it with --json
# (lib/check.bash).

# shellcheck source=../lib/common.bash
. "$(dirname "$(readlink -f "$0")")/../lib/common.bash"
# shellcheck source=../lib/check.bash
. "$WS_CORE/lib/check.bash"

case "${1:-}" in
    --json) check_json_mode ;;
    "") ;;
    -h|--help) echo "Usage: ws windows check [--json]"; exit 0 ;;
    *) echo "ws windows check: unknown argument: $1" >&2; exit 64 ;;
esac

data="${WSWIN_DATA:-$HOME/.local/share/wsconfig}"
boxes_json="$data/distrobox/boxes.json"
apps_json="$data/windows/apps.json"
# Both files are built by ws switch (distrobox/distrobox.nix, windows/apps.nix).
# The Windows boxes: those with a profile (distrobox/distrobox.nix).
win_boxes="$(for b in $(manifest_get "$boxes_json"); do
    [[ -z "$(manifest_get "$boxes_json" "$b" profile)" ]] || echo "$b"
done)"
if [[ -n "$win_boxes" ]]; then
    pass "Windows boxes: $(echo $win_boxes)"
else
    fail "no Windows box in boxes.json (distrobox/distrobox.nix)"
fi

# Launchers exist only where the box is yes (nix/hosts/HOST/boxes.toml, else
# the default of the box; windows/apps.nix); the programs of other boxes are
# not checked here.
declare -A box_state=()
# Errors apart from the BOX STATE lines: a warning must not become a box.
marks_err="$(mktemp)"
mapfile -t box_defaults < <(for b in $win_boxes; do
    d="$(manifest_get "$boxes_json" "$b" default)"
    echo "$b=${d:-ask}"
done)
if host="$("$WS_CORE/bin/ws" host --for-marks 2>/dev/null)" \
    && states="$(python3 "$WS_CORE/lib/ws_catalog.py" --host "$host" boxes states "${box_defaults[@]}" 2>"$marks_err")"; then
    while read -r box state; do
        [[ -n "$box" ]] && box_state[$box]="$state"
    done <<<"$states"
else
    err="$(tr '\n' ' ' < "$marks_err")"
    fail "host choice of the boxes: ${err:-unknown host (ws host)}"
    host=unknown
fi
rm -f "$marks_err"
on_host() { [[ "${box_state[$1]:-ask}" == yes ]]; }

default_box="$(manifest_get "$apps_json" default_box)"
if [[ -n "$default_box" ]] && grep -qxF "$default_box" <<<"$win_boxes"; then
    pass "ws windows default box is a Windows box: $default_box"
else
    fail "ws windows default box is not a Windows box: ${default_box:-<none>}"
fi

while IFS= read -r app; do
    [[ -n "$app" && "$app" != wswin ]] || continue
    app_box="$(manifest_get "$apps_json" apps "$app" box)"
    if grep -qxF "$app_box" <<<"$win_boxes"; then
        pass "app $app: box $app_box is a Windows box"
    else
        fail "app $app: box ${app_box:-<none>} is not a Windows box"
    fi
    if ! on_host "$app_box"; then
        info "app $app: box $app_box is not on $host, no launcher (ws box apply $app_box)"
        continue
    fi
    # The program itself is machine state (wswin install, a prefix from a
    # backup): on a new machine the launcher exists before it (phase 6, wsvm).
    app_prefix="$(manifest_get "$apps_json" apps "$app" prefix)"
    app_exe="$(manifest_get "$apps_json" apps "$app" exe)"
    if [[ "$app_prefix" == default ]]; then
        app_dir="$HOME/distrobox/$app_box/.wine"
    else
        app_dir="$HOME/distrobox/$app_box/prefixes/$app_prefix"
    fi
    if [[ -f "$app_dir/$app_exe" ]]; then
        pass "app $app: installed ($app_exe)"
    else
        warn "app $app: not installed, the launcher has nothing to run: $app_dir/$app_exe (helpws windows; helpws rebuild)"
    fi
done < <(manifest_get "$apps_json" apps)

if ! on_host "$default_box"; then
    info ".exe: default box $default_box is not on $host, no ws-win-exe.desktop"
elif have xdg-mime; then
    exe_default="$(xdg-mime query default application/vnd.microsoft.portable-executable 2>/dev/null)"
    if [[ "$exe_default" == ws-win-exe.desktop ]]; then
        pass ".exe opens with ws-win-exe.desktop (wine-wayland, standard prefix)"
    else
        warn ".exe opens with ${exe_default:-nothing}, not ws-win-exe.desktop (ws switch)"
    fi
fi

dangling_menu=""
old_menu=""
for link in "$HOME"/.local/share/applications/wswin-*.desktop; do
    [[ -L "$link" && ! -e "$link" ]] && dangling_menu+=" $(basename "$link")"
    grep -qs '^Exec=wswin ' "$link" && old_menu+=" $(basename "$link")"
done
if [[ -n "$dangling_menu" ]]; then
    warn "ws windows menu links to missing prefixes:$dangling_menu (ws windows menu sync)"
else
    pass "ws windows menu links resolve"
fi
# wswin is no longer in PATH (helpws plan-v2, stage 5).
[[ -z "$old_menu" ]] \
    || warn "ws windows menu entries run the old name wswin:$old_menu (ws windows menu sync)"

info "GPU for Proton/Steam: $("$WS_CORE/libexec/ws-gpu" status 2>/dev/null || echo unknown)"

check_finish
