#!/usr/bin/env bash
set -eu

# shellcheck source=../lib/common.bash
. "$(dirname "$(readlink -f "$0")")/../lib/common.bash"
cmd="${1:-status}"
shift 2>/dev/null || true

case "$cmd" in
    status) exec "$WS_CORE/libexec/ws-gnome-status" "$@" ;;
    check) exec "$WS_CORE/libexec/ws-gnome-check" "$@" ;;
    test) exec "$WS_CORE/libexec/ws-gnome-test" "$@" ;;
    extensions) exec "$WS_CORE/libexec/ws-gnome-extensions" "$@" ;;
    -h|--help|help)
        cat <<'USAGE'
Usage:
  ws gnome status               read-only GNOME inventory (the default)
  ws gnome check [--json]       compare appearance/Dock state with gnome/config.toml
  ws gnome test [--strict]      final read-only GNOME host smoke-test
  ws gnome extensions           install the EGO extensions without pin and the local
                                ones of gnome/config.toml (ws apply extensions)

  --json    one result object (ws check)
  --strict  warnings make the smoke-test exit 2

The profile is applied by `ws apply` (gnome/config.toml).
USAGE
        ;;
    *)
        echo "ws gnome: unknown command: $cmd" >&2
        exit 64
        ;;
esac
