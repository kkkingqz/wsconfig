#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=../lib/common.bash
. "$(dirname "$(readlink -f "$0")")/../lib/common.bash"

usage() {
    cat <<'USAGE'
Usage:
  ws keyboard apply             Apply GNOME shortcuts, symlinks and start xremap if ready
  ws keyboard restore           Restore backed-up GNOME shortcuts and disable xremap
  ws keyboard status            Show keyboard/xremap/GNOME status (the default)
  ws keyboard check [--json]    Compare xremap, GNOME and Tiling Assistant shortcuts and
                                the input sources with keyboard/config.toml
  ws keyboard start             Start xremap user service (clears the restore flag)
  ws keyboard stop              Stop xremap user service
  ws keyboard restart           Restart xremap user service
  ws keyboard logs              Follow xremap user-service log
  ws keyboard devices           List xremap input devices
  ws keyboard gnome-apps        Query GNOME xremap application bridge

  --json  one result object (ws check)
USAGE
}

case "${1:-status}" in
    apply) exec "$WS_CORE/libexec/ws-keyboard-apply" ;;
    restore) exec "$WS_CORE/libexec/ws-keyboard-apply" --restore ;;
    status) exec "$WS_CORE/libexec/ws-keyboard-status" ;;
    check) shift; exec "$WS_CORE/libexec/ws-keyboard-check" "$@" ;;
    start) rm -f "$WS_STATE/keyboard/xremap.disabled"; systemctl --user start xremap.service ;;
    stop) systemctl --user stop xremap.service ;;
    restart) systemctl --user restart xremap.service ;;
    logs) exec journalctl --user -fu xremap.service ;;
    devices) exec xremap --list-devices ;;
    gnome-apps) exec busctl --user call org.gnome.Shell /com/k0kubun/Xremap com.k0kubun.Xremap WMClasses ;;
    -h|--help|help) usage ;;
    *) echo "Unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
