#!/usr/bin/env sh
set -eu

# Man pages from docs/**/*.md, one per `title:` (lowdown -s -t man).
# nix/pkgs/man.nix runs this in the Nix build with lowdown from nixpkgs; `ws switch`
# installs the result. A run by hand writes the untracked man/ for preview.

repo="${WSCONFIG:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
mandir="$repo/man/man1"

mkdir -p "$mandir"

find "$repo/docs" -type f -name '*.md' | sort | while IFS= read -r doc; do
    page="$(sed -n 's/^title:[[:space:]]*//p' "$doc" | head -n 1)"
    [ -n "$page" ] || {
        echo "Skipping $doc: no title metadata" >&2
        continue
    }
    lowdown -s -t man "$doc" > "$mandir/$page.1"
    echo "Generated: $mandir/$page.1"
done
