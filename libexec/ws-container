#!/usr/bin/env bash
set -euo pipefail

# Container hosts (boot = "container" in host.toml, ws help plan-wsgnomebox):
# the image is built on the server from a commit of this checkout, the
# container runs there with the spec of host.toml [container]. Run from any
# machine with SSH to the server; nothing is copied to it but the build
# context.

# shellcheck source=../lib/common.bash
. "$(dirname "$(readlink -f "$0")")/../lib/common.bash"
ws_prog="ws container"

usage() {
    cat <<'USAGE'
Usage:
  ws container build HOST [--dry-run]
  ws container run HOST [--dry-run]
  ws container status HOST

build     docker build on the server from the HEAD of the configuration
          (clean checkout only) and the core its flake.lock pins (or the
          clean checkout of ws container --core PATH): image
          IMAGE:COMMIT-CORE and IMAGE:latest (host.toml [container])
run       replace the container HOST on the server with one from
          IMAGE:latest: mounts, devices and port of host.toml [container]; the
          directories of the mounts must exist (shares of the server)
status    the container and its image commit against HEAD

--dry-run prints the docker command instead of running it.
USAGE
}

# [container] of the host.toml of HOST as JSON.
spec() {
    [[ -r "$repo/hosts/$1/host.toml" ]] || die "no hosts/$1/host.toml"
    [[ "$(python3 "$WS_CORE/lib/ws_facts.py" fact --host "$1" boot 2>/dev/null)" == container ]] \
        || die "$1 is not a container host (boot = \"container\")"
    python3 "$WS_CORE/lib/ws_facts.py" section --host "$1" container
}

field() {
    python3 -c 'import json,sys; v=json.load(sys.stdin)[sys.argv[1]]; print("\n".join(v) if isinstance(v, list) else v)' "$1" <<<"$spec_json"
}

remote() {
    ssh -o BatchMode=yes "$server" "$@"
}

# The core of the image of a configuration of its own, unpacked as DIR/core;
# prints its short revision. --core PATH: the HEAD of that clean checkout;
# else the source of the input wsconfig that flake.lock pins, from the
# local store (nix flake archive): the server fetches no core.
core_into() {
    local dir="$1" src
    if [[ -n "${WS_CORE_PATH:-}" ]]; then
        [[ -z "$(git -C "$WS_CORE_PATH" status --porcelain)" ]] \
            || die "--core $WS_CORE_PATH has changes: the image is built from a commit (commit first)"
        git -C "$WS_CORE_PATH" archive --format=tar --prefix=core/ HEAD | tar -x -C "$dir"
        git -C "$WS_CORE_PATH" rev-parse --short HEAD
        return
    fi
    src="$("$(nix_bin)" flake archive --json "$repo" \
        | python3 -c 'import json, sys; print(json.load(sys.stdin)["inputs"]["wsconfig"]["path"])')" \
        || die "nix flake archive: no source of the input wsconfig"
    cp -r "$src" "$dir/core"
    chmod -R u+w "$dir/core"
    python3 "$WS_CORE/lib/ws_common.py" get "$repo/flake.lock" nodes wsconfig locked rev | cut -c1-7
}

cmd_build() {
    local commit core_rev ctx
    [[ -z "$(git -C "$repo" status --porcelain)" ]] \
        || die "the checkout has changes: the image is built from a commit (commit first)"
    commit="$(git -C "$repo" rev-parse --short HEAD)"
    # The context holds config/ (its HEAD) and core/ (ws help plan-v2,
    # 8.7); the tag both revisions.
    ctx="$(mktemp -d)"
    # shellcheck disable=SC2064 # the path now
    trap "rm -rf '$ctx'" EXIT
    git -C "$repo" archive --format=tar --prefix=config/ HEAD | tar -x -C "$ctx"
    if [[ "$dry_run" == true && -z "${WS_CORE_PATH:-}" ]]; then
        core_rev="$(python3 "$WS_CORE/lib/ws_common.py" get "$repo/flake.lock" nodes wsconfig locked rev | cut -c1-7)"
    else
        core_rev="$(core_into "$ctx")"
    fi
    [[ -n "$core_rev" ]] || die "no core revision (flake.lock input wsconfig, or --core PATH)"
    local -a build=(docker build --build-arg "HOST=$host" --build-arg CONFIG=config --build-arg CORE=core
        --label "org.opencontainers.image.revision=$commit"
        --label "org.wsconfig.core.revision=$core_rev"
        -t "$image:$commit-$core_rev" -t "$image:latest" -f core/container/Dockerfile -)
    if [[ "$dry_run" == true ]]; then
        echo "would run: config $commit + core $core_rev | ssh $server ${build[*]}"
        return
    fi
    tar -C "$ctx" -c . | remote "${build[*]@Q}"
    echo "built $image:$commit-$core_rev on $server"
}

cmd_run() {
    local m d src rest
    # shellcheck disable=SC2054 # commas are mount options, not separators
    local -a args=(docker run -d --name "$host" --hostname "$host"
        --restart unless-stopped
        --runtime nvidia -e NVIDIA_VISIBLE_DEVICES=all -e NVIDIA_DRIVER_CAPABILITIES=all
        # systemd as PID 1: its cgroup tree, tmpfs where it expects them.
        --cgroupns host -v /sys/fs/cgroup:/sys/fs/cgroup:rw
        --tmpfs /run:rw,nosuid,nodev,mode=755
        --tmpfs /run/lock:rw,nosuid,nodev,noexec,mode=755
        --tmpfs /tmp:rw,nosuid,nodev,mode=1777
        # Rootless podman, bubblewrap (Flatpak) and GDM inside: user
        # namespaces, mounts and a fresh /proc.
        --security-opt seccomp=unconfined --security-opt systempaths=unconfined
        --cap-add SYS_ADMIN --cap-add SYS_RESOURCE --cap-add SYS_NICE
        --cap-add SYS_TTY_CONFIG --cap-add MKNOD --cap-add DAC_READ_SEARCH
        --shm-size 16g --pids-limit 16384
        --log-opt max-size=50m --log-opt max-file=1
        -p "$port:3389")
    while IFS= read -r m; do
        [[ -n "$m" ]] || continue
        src="${m%%:*}"
        rest="${m#*:}"
        # SRC:~ or SRC:~/PATH: the home of the user of host.toml.
        # shellcheck disable=SC2088 # a literal ~ of host.toml
        case "$rest" in
            '~' | '~/'* | '~:'*) rest="/home/$user${rest#\~}" ;;
        esac
        m="$src:$rest"
        [[ "$dry_run" == true ]] || remote test -d "$src" || die "$src does not exist on $server (create the share first)"
        args+=(-v "$m")
    done < <(field mounts)
    while IFS= read -r d; do
        [[ -n "$d" ]] && args+=(--device "$d")
    done < <(field devices)
    args+=("$image:latest")
    if [[ "$dry_run" == true ]]; then
        echo "would run on $server: docker rm -f $host"
        echo "would run on $server: ${args[*]}"
        return
    fi
    remote docker image inspect "$image:latest" >/dev/null || die "no $image:latest on $server (ws container build $host)"
    remote "docker rm -f ${host@Q} >/dev/null 2>&1 || true; ${args[*]@Q}"
    echo "started $host on $server (RDP port $port)"
}

cmd_status() {
    local rev head
    remote docker ps -a --filter "name=^${host}\$" --format '{{.Names}}\t{{.Image}}\t{{.Status}}'
    rev="$(remote docker inspect -f '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$host" 2>/dev/null || true)"
    head="$(git -C "$repo" rev-parse --short HEAD)"
    if [[ -z "$rev" ]]; then
        echo "no container $host"
    elif [[ "$rev" == "$head" ]]; then
        echo "image commit $rev = HEAD"
    else
        echo "image commit $rev, HEAD $head (ws container build $host, ws container run $host)"
    fi
}

[[ $# -ge 1 ]] || { usage >&2; exit 64; }
case "$1" in
    -h|--help|help) usage; exit 0 ;;
esac
command="$1"
host="${2:-}"
[[ -n "$host" ]] || { usage >&2; exit 64; }
dry_run=false
case "${3:-}" in
    --dry-run) dry_run=true ;;
    "") ;;
    *) die "unknown argument: $3" ;;
esac

spec_json="$(spec "$host")"
user="$(python3 "$WS_CORE/lib/ws_facts.py" fact --host "$host" user 2>/dev/null || true)"
server="$(field server)"
image="$(field image)"
port="$(field port)"

case "$command" in
    build) cmd_build ;;
    run) cmd_run ;;
    status) cmd_status ;;
    *) usage >&2; exit 64 ;;
esac
