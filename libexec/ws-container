#!/usr/bin/env bash
set -euo pipefail

# Container hosts (boot = "container" in host.toml, ws help plan-wsgnomebox):
# the image is built on the server from a commit of this checkout, the
# container runs there with the spec of host.toml [container]. Run from any
# machine with SSH to the server; nothing is copied to it but the build
# context.

# shellcheck source=../lib/common.bash
. "$(dirname "$(readlink -f "$0")")/../lib/common.bash"
ws_prog="ws container"

usage() {
    cat <<'USAGE'
Usage:
  ws container build HOST [--dry-run]   image from HEAD and the pinned core
  ws container run HOST [--dry-run]     replace the container with the latest image
  ws container status HOST              container and image commit against HEAD
  ws container password HOST [--rdp]    set the password of the user (--rdp: of RDP)

  --dry-run  print the docker command

build     docker build on the server from the HEAD of the configuration
          (clean checkout only) and the core its flake.lock pins (or the
          clean checkout of ws container --core PATH): image
          IMAGE:COMMIT-CORE and IMAGE:latest (host.toml [container])
run       replace the container HOST on the server with one from
          IMAGE:latest: mounts, devices, port and memory of host.toml [container]; the
          directories of the mounts must exist (shares of the server).
          Asks once what the server has not yet: the password of the user
          and the RDP user and password
status    the container and its image commit against HEAD
password  asks the password again and applies it to the running
          container too; removes the plain-text files of before

The server keeps no password in plain text: the password of the user as a
SHA-512 crypt hash in CONFIG/password.hash (CONFIG: the mount of /config,
ws-container-init sets it on every start), RDP in the store of
gnome-remote-desktop, GRD/.local/share/gnome-remote-desktop/credentials.ini
(GRD: the mount of /var/lib/gnome-remote-desktop; 0600, readable by it
alone: without a TPM it has no other store). passwd inside the container
lasts until its next start.

--dry-run prints the docker command instead of running it.
USAGE
}

# [container] of the host.toml of HOST as JSON.
spec() {
    [[ -r "$repo/hosts/$1/host.toml" ]] || die "no hosts/$1/host.toml"
    [[ "$(python3 "$WS_CORE/lib/ws_facts.py" fact --host "$1" boot 2>/dev/null)" == container ]] \
        || die "$1 is not a container host (boot = \"container\")"
    python3 "$WS_CORE/lib/ws_facts.py" section --host "$1" container
}

# A key of [container]; empty when it has none (memory).
field() {
    python3 -c 'import json,sys; v=json.load(sys.stdin).get(sys.argv[1], ""); print("\n".join(v) if isinstance(v, list) else v)' "$1" <<<"$spec_json"
}

remote() {
    ssh -o BatchMode=yes "$server" "$@"
}

# The source on the server of the mount of TARGET in the container.
mount_src() {
    local m
    while IFS= read -r m; do
        case "${m#*:}" in
            "$1" | "$1":*) echo "${m%%:*}"; return ;;
        esac
    done < <(field mounts)
    die "no mount of $1 in [container] mounts of hosts/$host/host.toml"
}

# A secret into the variable $2: twice from a terminal, without echo; a
# line (and its repeat) from anything else.
ask_secret() {
    local -n out="$2"
    local again
    if [[ -t 0 ]]; then
        read -rsp "$1: " out; echo >&2
        read -rsp "$1 (again): " again; echo >&2
    else
        IFS= read -r out || true
        IFS= read -r again || true
    fi
    [[ -n "$out" ]] || die "empty password"
    [[ "$out" == "$again" ]] || die "the passwords differ"
}

# stdin into the file $1 on the server, readable by root alone; its
# directory 0755 when new (gnome-remote-desktop walks it).
put_remote() {
    local dir="${1%/*}" tmp="$1.tmp"
    remote "umask 022 && mkdir -p ${dir@Q} && umask 077 && cat > ${tmp@Q} && mv -f ${tmp@Q} ${1@Q}"
}

running() {
    [[ "$(remote docker inspect -f '{{.State.Running}}' "$host" 2>/dev/null </dev/null || true)" == true ]]
}

# The password of the user: its hash to the server; with --live into the
# running container as well. The plain-text file of before goes.
set_password() {
    local pw hash inner
    need openssl
    ask_secret "password of $user in $host" pw
    hash="$(printf '%s' "$pw" | openssl passwd -6 -stdin)"
    unset pw
    printf '%s\n' "$hash" | put_remote "$hash_file"
    remote rm -f "$config_dir/password" </dev/null
    echo "password of $user: $hash_file"
    if [[ "${1:-}" == --live ]] && running; then
        # The hash on stdin, not in the arguments of docker exec.
        # shellcheck disable=SC2016 # $h of the shell in the container
        inner='IFS= read -r h && usermod --password "$h" '"$user"
        printf '%s\n' "$hash" | remote "docker exec -i ${host@Q} sh -c ${inner@Q}"
        echo "applied in the running $host"
    fi
}

rdp_keyfile='
import sys
user, pw = sys.stdin.read().split("\n")[:2]
def gstr(text):
    return chr(39) + text.replace("\\", "\\\\").replace(chr(39), "\\" + chr(39)) + chr(39)
value = "{%s: <%s>, %s: <%s>}" % (gstr("username"), gstr(user), gstr("password"), gstr(pw))
print("[RDP]\ncredentials=" + value.replace("\\", "\\\\"))
'

# RDP user and password: the GKeyFile of gnome-remote-desktop (GVariant
# text, then the escapes of a GKeyFile value), as ws-rdp-init wrote it from
# the files of before. With --live the running container takes it now.
set_rdp() {
    local rdp_user pw
    if [[ -t 0 ]]; then
        read -rp "RDP user of $host [$user]: " rdp_user
    else
        IFS= read -r rdp_user || true
    fi
    rdp_user="${rdp_user:-$user}"
    ask_secret "RDP password of $host" pw
    printf '%s\n%s\n' "$rdp_user" "$pw" | python3 -c "$rdp_keyfile" | put_remote "$cred_file"
    unset pw
    remote rm -f "$config_dir/rdp-user" "$config_dir/rdp-password" </dev/null
    echo "RDP user $rdp_user: $cred_file"
    if [[ "${1:-}" == --live ]] && running; then
        # ws-rdp-init gives the file to gnome-remote-desktop; RDP sessions end.
        remote docker exec "$host" systemctl restart ws-rdp-init.service gnome-remote-desktop.service </dev/null
        echo "applied in the running $host (RDP restarted)"
    fi
}

# The core of the image of a configuration of its own, unpacked as DIR/core;
# prints its short revision. --core PATH: the HEAD of that clean checkout;
# else the source of the input wsconfig that flake.lock pins, from the
# local store (nix flake archive): the server fetches no core.
core_into() {
    local dir="$1" src
    if [[ -n "${WS_CORE_PATH:-}" ]]; then
        [[ -z "$(git -C "$WS_CORE_PATH" status --porcelain)" ]] \
            || die "--core $WS_CORE_PATH has changes: the image is built from a commit (commit first)"
        git -C "$WS_CORE_PATH" archive --format=tar --prefix=core/ HEAD | tar -x -C "$dir"
        git -C "$WS_CORE_PATH" rev-parse --short HEAD
        return
    fi
    src="$("$(nix_bin)" flake archive --json "$repo" \
        | python3 -c 'import json, sys; print(json.load(sys.stdin)["inputs"]["wsconfig"]["path"])')" \
        || die "nix flake archive: no source of the input wsconfig"
    cp -r "$src" "$dir/core"
    chmod -R u+w "$dir/core"
    python3 "$WS_CORE/lib/ws_common.py" get "$repo/flake.lock" nodes wsconfig locked rev | cut -c1-7
}

cmd_build() {
    local commit core_rev ctx
    [[ -z "$(git -C "$repo" status --porcelain)" ]] \
        || die "the checkout has changes: the image is built from a commit (commit first)"
    commit="$(git -C "$repo" rev-parse --short HEAD)"
    # The context holds config/ (its HEAD) and core/ (ws help plan-v2,
    # 8.7); the tag both revisions.
    ctx="$(mktemp -d)"
    # shellcheck disable=SC2064 # the path now
    trap "rm -rf '$ctx'" EXIT
    git -C "$repo" archive --format=tar --prefix=config/ HEAD | tar -x -C "$ctx"
    if [[ "$dry_run" == true && -z "${WS_CORE_PATH:-}" ]]; then
        core_rev="$(python3 "$WS_CORE/lib/ws_common.py" get "$repo/flake.lock" nodes wsconfig locked rev | cut -c1-7)"
    else
        core_rev="$(core_into "$ctx")"
    fi
    [[ -n "$core_rev" ]] || die "no core revision (flake.lock input wsconfig, or --core PATH)"
    local -a build=(docker build --build-arg "HOST=$host" --build-arg CONFIG=config --build-arg CORE=core
        --label "org.opencontainers.image.revision=$commit"
        --label "org.wsconfig.core.revision=$core_rev"
        -t "$image:$commit-$core_rev" -t "$image:latest" -f core/container/Dockerfile -)
    if [[ "$dry_run" == true ]]; then
        echo "would run: config $commit + core $core_rev | ssh $server ${build[*]}"
        return
    fi
    tar -C "$ctx" -c . | remote "${build[*]@Q}"
    echo "built $image:$commit-$core_rev on $server"
}

cmd_run() {
    local m d src rest
    # shellcheck disable=SC2054 # commas are mount options, not separators
    local -a args=(docker run -d --name "$host" --hostname "$host"
        --restart unless-stopped
        --runtime nvidia -e NVIDIA_VISIBLE_DEVICES=all -e NVIDIA_DRIVER_CAPABILITIES=all
        # systemd as PID 1: its cgroup tree, tmpfs where it expects them.
        --cgroupns host -v /sys/fs/cgroup:/sys/fs/cgroup:rw
        --tmpfs /run:rw,nosuid,nodev,mode=755
        --tmpfs /run/lock:rw,nosuid,nodev,noexec,mode=755
        # exec: docker adds noexec to a tmpfs without it, and builds and
        # installers run what they unpack to /tmp.
        --tmpfs /tmp:rw,exec,nosuid,nodev,mode=1777
        # Rootless podman, bubblewrap (Flatpak) and GDM inside: user
        # namespaces, mounts and a fresh /proc.
        --security-opt seccomp=unconfined --security-opt systempaths=unconfined
        --cap-add SYS_ADMIN --cap-add SYS_RESOURCE --cap-add SYS_NICE
        --cap-add SYS_TTY_CONFIG --cap-add MKNOD --cap-add DAC_READ_SEARCH
        --shm-size 16g --pids-limit 16384
        --log-opt max-size=50m --log-opt max-file=1
        -p "$port:3389")
    # The limit of [container] memory: a leak inside (Firefox, 2026-11-04 in
    # gnomebox-desktop) ends in an OOM of the container, not of the server.
    # --memory-swap the same: swap of the server is no extra room.
    [[ -z "$memory" ]] || args+=(--memory "$memory" --memory-swap "$memory")
    while IFS= read -r m; do
        [[ -n "$m" ]] || continue
        src="${m%%:*}"
        rest="${m#*:}"
        # SRC:~ or SRC:~/PATH: the home of the user of host.toml.
        # shellcheck disable=SC2088 # a literal ~ of host.toml
        case "$rest" in
            '~' | '~/'* | '~:'*) rest="/home/$user${rest#\~}" ;;
        esac
        m="$src:$rest"
        # </dev/null: ssh would read the rest of the mounts of this loop.
        [[ "$dry_run" == true ]] || remote test -d "$src" </dev/null || die "$src does not exist on $server (create the share first)"
        args+=(-v "$m")
    done < <(field mounts)
    while IFS= read -r d; do
        [[ -n "$d" ]] && args+=(--device "$d")
    done < <(field devices)
    args+=("$image:latest")
    if [[ "$dry_run" == true ]]; then
        echo "would run on $server: docker rm -f $host"
        echo "would run on $server: ${args[*]}"
        return
    fi
    remote docker image inspect "$image:latest" >/dev/null </dev/null || die "no $image:latest on $server (ws container build $host)"
    # What the server has not yet, asked once, before the old container goes.
    remote test -s "$hash_file" </dev/null || set_password
    remote test -s "$cred_file" </dev/null || set_rdp
    if remote test -e "$config_dir/password" -o -e "$config_dir/rdp-password" </dev/null; then
        echo "plain-text passwords in $config_dir: ws container password $host (and --rdp) replaces them" >&2
    fi
    remote "docker rm -f ${host@Q} >/dev/null 2>&1 || true; ${args[*]@Q}"
    echo "started $host on $server (RDP port $port)"
}

cmd_status() {
    local rev head
    remote docker ps -a --filter "name=^${host}\$" --format '{{.Names}}\t{{.Image}}\t{{.Status}}'
    rev="$(remote docker inspect -f '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$host" 2>/dev/null || true)"
    head="$(git -C "$repo" rev-parse --short HEAD)"
    if [[ -z "$rev" ]]; then
        echo "no container $host"
    elif [[ "$rev" == "$head" ]]; then
        echo "image commit $rev = HEAD"
    else
        echo "image commit $rev, HEAD $head (ws container build $host, ws container run $host)"
    fi
}

[[ $# -ge 1 ]] || { usage >&2; exit 64; }
case "$1" in
    -h|--help|help) usage; exit 0 ;;
esac
command="$1"
host="${2:-}"
[[ -n "$host" ]] || { usage >&2; exit 64; }
dry_run=false
rdp=false
case "$command:${3:-}" in
    build:--dry-run | run:--dry-run) dry_run=true ;;
    password:--rdp) rdp=true ;;
    *:) ;;
    *) die "unknown argument: $3" ;;
esac

spec_json="$(spec "$host")"
user="$(python3 "$WS_CORE/lib/ws_facts.py" fact --host "$host" user 2>/dev/null || true)"
server="$(field server)"
image="$(field image)"
port="$(field port)"
memory="$(field memory)"
# Where the passwords go on the server (run, password).
if [[ "$command" == run || "$command" == password ]]; then
    config_dir="$(mount_src /config)"
    hash_file="$config_dir/password.hash"
    cred_file="$(mount_src /var/lib/gnome-remote-desktop)/.local/share/gnome-remote-desktop/credentials.ini"
fi

case "$command" in
    build) cmd_build ;;
    run) cmd_run ;;
    status) cmd_status ;;
    password) if [[ "$rdp" == true ]]; then set_rdp --live; else set_password --live; fi ;;
    *) usage >&2; exit 64 ;;
esac
