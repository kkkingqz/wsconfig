#!/usr/bin/env bash
set -u
set -o pipefail

# Cross-layer invariants of the workstation: what holds only when two owners
# agree. Each owner checks its own layer (ws check runs them all):
#   ws check repo / home, ws-keyboard check, ws-gnome check, wsflatpak check,
#   wsbox check, wswin check, ws-suspend check, ws system check, ws check apt.
# Here: GNOME <-> keyboard, kernel <-> t2bce and i915 PSR, boot <-> dGPU policy,
# Distrobox <-> host NTSync. The T2 and dGPU sections run only on hardware
# t2-mbp16, /boot/ws only with boot refind-grub-recovery (ws fact). Read-only.
# Exit codes: 0 = no FAIL, 1 = FAIL, 2 = warnings with --strict.

# shellcheck source=../lib/common.bash
. "$(dirname "$(readlink -f "$0")")/../lib/common.bash"
# shellcheck source=../lib/check.bash
. "$WS_CORE/lib/check.bash"
strict=false

usage() {
    cat <<'USAGE'
Usage: ws-workstation-verify [--strict] [--json]

  --strict   WARN also makes the result non-zero (exit 2)
  --json     one result object for ws check (lib/check.bash)
USAGE
}

while (($#)); do
    case "$1" in
        --strict) strict=true ;;
        --json) check_json_mode ;;
        -h|--help) usage; exit 0 ;;
        *) echo "ws-workstation-verify: unknown argument: $1" >&2; usage >&2; exit 64 ;;
    esac
    shift
done

hardware="$(host_fact hardware)"
boot="$(host_fact boot)"
t2=false
[[ "$hardware" == t2-mbp16 ]] && t2=true

section "1. Host / session"

[[ -n "$hardware" ]] \
    && info "host $("$WS_CORE/bin/ws" host): hardware $hardware, boot ${boot:-unknown}" \
    || fail "unknown host: no hardware fact (ws fact hardware)"
model="$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)"
if [[ "$t2" == true ]]; then
    [[ "$model" == "MacBookPro16,1" ]] \
        && pass "hardware: $model" \
        || warn "hardware: ${model:-unknown} (expected MacBookPro16,1 for t2-mbp16)"
else
    info "hardware: ${model:-unknown}"
fi

desktop="${XDG_CURRENT_DESKTOP:-unknown}"
[[ "$desktop" == *GNOME* ]] && pass "desktop: $desktop" || fail "desktop is not GNOME: $desktop"

session="${XDG_SESSION_TYPE:-unknown}"
[[ "$session" == "wayland" ]] && pass "session: Wayland" || warn "session: $session"

if have gnome-shell; then
    gv="$(gnome-shell --version 2>/dev/null || true)"
    [[ -n "$gv" ]] && info "GNOME: $gv" || warn "unable to read GNOME Shell version"
else
    fail "gnome-shell binary missing"
fi

kernel="$(uname -r)"
if [[ "$t2" == true ]]; then
    [[ "$kernel" == *t2* ]] && pass "T2 kernel: $kernel" || warn "kernel is not T2-labelled: $kernel"
else
    info "kernel: $kernel"
fi

section "2. GNOME <-> keyboard"

# The keyboard layer (xremap, keyboard.nix shortcuts) works through GNOME
# extensions: the xremap bridge for application-specific remaps, the Input
# Source extension for ws-input-source, Tiling Assistant for the private
# tiling chords.
if [[ "$boot" == container ]]; then
    # Keys over RDP, no xremap (keyboard/keyboard.nix, helpws plan-wsgnomebox).
    info "container: no xremap, its GNOME bridge is not needed"
elif have busctl && busctl --user call \
    org.gnome.Shell \
    /com/k0kubun/Xremap \
    com.k0kubun.Xremap \
    WMClasses >/dev/null 2>&1; then
    pass "xremap GNOME Wayland bridge responds (xremap@k0kubun.com)"
else
    fail "xremap GNOME Wayland bridge unavailable (xremap@k0kubun.com)"
fi

if have gdbus && gdbus call --session \
    --dest org.gnome.Shell \
    --object-path /org/gnome/Shell/Extensions/WorkstationInputSource \
    --method org.gnome.Shell.Extensions.WorkstationInputSource.GetState \
    >/dev/null 2>&1; then
    pass "Input Source D-Bus API responds (workstation-input-source@local)"
else
    fail "Input Source D-Bus API unavailable (workstation-input-source@local)"
fi

if have gnome-extensions && gnome-extensions info tiling-assistant@ubuntu.com 2>/dev/null | grep -Eq 'State:[[:space:]]+ACTIVE|Enabled:[[:space:]]+Yes'; then
    pass "Tiling Assistant active: tiling-assistant@ubuntu.com"
elif have gnome-extensions && gnome-extensions info tiling-assistant@leleat-on-github 2>/dev/null | grep -Eq 'State:[[:space:]]+ACTIVE|Enabled:[[:space:]]+Yes'; then
    pass "Tiling Assistant active: tiling-assistant@leleat-on-github"
else
    fail "Tiling Assistant not active"
fi

section "3. Kernel <-> t2bce, i915 PSR"

# The patched t2bce modules exist per kernel release (system/kernel/t2bce):
# the running kernel must have them, and apt must not bring a newer one.
if [[ "$t2" == true ]]; then
    t2bce_ver="$(cat /sys/module/t2bce_core/version 2>/dev/null || true)"
    if [[ "$t2bce_ver" == *nostatefix* ]]; then
        pass "patched t2bce loaded: t2bce_core $t2bce_ver"
    else
        warn "t2bce_core '${t2bce_ver:-not loaded}' is not the patched build; run ws suspend t2bce-build && ws suspend t2bce-install (helpws suspend)"
    fi

    if apt-mark showhold 2>/dev/null | grep -qx 'linux-t2'; then
        pass "linux-t2 held (patched t2bce modules exist only for $(uname -r))"
    else
        warn "linux-t2 is not held: a kernel update would boot the in-tree t2bce (helpws suspend)"
    fi

    t2bce_sources="$HOME/.local/share/wsconfig/t2bce/sources.json"
    if [[ -n "$(manifest_get "$t2bce_sources" "$(uname -r)")" ]]; then
        pass "system/kernel/t2bce/t2bce.nix pins sources for $(uname -r)"
    else
        warn "system/kernel/t2bce/t2bce.nix has no entry for $(uname -r)"
    fi

    # i915 with PSR on the Apple panel (system/kernel/i915-psr): without it
    # the stock i915 runs, PSR is off and a static screen costs ~1 W more.
    if [[ -e /sys/module/i915/parameters/t2_apple_psr ]]; then
        pass "i915 with Apple panel PSR loaded"
    else
        warn "stock i915 (no PSR on the Apple panel); run ws-psr build && ws-psr install (helpws plan-t2)"
    fi
else
    info "no T2 (hardware ${hardware:-unknown}): nothing to check"
fi

section "4. Boot <-> dGPU policy"

# rEFInd "Ubuntu" boots with ws.dgpu=off: ws-dgpu-off.service powers the AMD
# dGPU off and removes it from the PCI bus. "Ubuntu (AMD)" boots /boot/ws
# without it (helpws workstation, helpws suspend).
if [[ "$t2" != true ]]; then
    info "no dGPU policy (hardware ${hardware:-unknown})"
elif grep -Eq '(^| )ws\.dgpu=off( |$)' /proc/cmdline; then
    systemctl is-active --quiet ws-dgpu-off.service 2>/dev/null \
        && pass "booted with ws.dgpu=off: ws-dgpu-off.service succeeded" \
        || fail "booted with ws.dgpu=off but ws-dgpu-off.service is not active (journalctl -b -u ws-dgpu-off)"
    # ws-dgpu-off removes the card only after its config space reads ffff
    # (power cut), so a bus without AMD devices means the card is off.
    amd_devices=""
    for dev in /sys/bus/pci/devices/*; do
        [[ "$(cat "$dev/vendor" 2>/dev/null)" == 0x1002 ]] && amd_devices+=" ${dev##*/}"
    done
    [[ -z "$amd_devices" ]] \
        && pass "AMD dGPU powered off and removed from PCI" \
        || fail "AMD devices still on the PCI bus:$amd_devices (journalctl -b -u ws-dgpu-off)"
else
    dgpu_state="$(cat /sys/bus/pci/devices/0000:03:00.0/power_state 2>/dev/null || echo absent)"
    pass "booted with the AMD dGPU on (rEFInd Ubuntu (AMD) or GRUB): $dgpu_state"
fi

newest_kernel="$(ls /boot/vmlinuz-* 2>/dev/null | sort -V | tail -n1)"
newest_version="${newest_kernel#/boot/vmlinuz-}"
if [[ "$boot" == container ]]; then
    info "container: the kernel of the server, $(uname -r)"
elif [[ -z "$newest_kernel" ]]; then
    fail "no /boot/vmlinuz-* found"
elif [[ "$boot" == refind-grub-recovery ]]; then
    # /boot/ws: the kernel of "Ubuntu (AMD)", relinked by ws-boot-links.
    if [[ /boot/ws/vmlinuz -ef "$newest_kernel" && /boot/ws/initrd.img -ef "/boot/initrd.img-$newest_version" ]]; then
        pass "/boot/ws links the newest kernel and initrd: $newest_version"
    else
        fail "/boot/ws does not link $newest_version (kernel and initrd); run sudo /usr/local/sbin/ws-boot-links"
    fi
    [[ "$t2" != true || "$newest_version" == *-t2-* ]] \
        || warn "newest kernel $newest_version is not a T2 kernel; rEFInd boots it by default"
else
    info "newest kernel: $newest_version (boot ${boot:-unknown})"
fi

section "5. Distrobox <-> host NTSync"

# Boxes whose manifest runs the NTSync hook use the host module through
# wsbox-host-ntsync (it provides NTSYNC-MODULE); wsbox check checks the
# package, this the device end to end.
if [[ "$boot" == container ]]; then
    # The server's kernel decides, its /dev/ntsync is not passed in
    # (helpws plan-wsgnomebox; Unraid 6.18 has no ntsync).
    if [[ -c /dev/ntsync ]]; then
        pass "/dev/ntsync character device present (from the server)"
    else
        info "container: no /dev/ntsync from the server; Wine runs without NTSync"
    fi
else
    if lsmod 2>/dev/null | awk '$1 == "ntsync" { found=1 } END { exit !found }'; then
        pass "host ntsync module loaded"
    else
        fail "host ntsync module not loaded"
    fi
    [[ -c /dev/ntsync ]] \
        && pass "/dev/ntsync character device present" \
        || fail "/dev/ntsync character device missing"
fi

# The hook as distrobox/distrobox.nix writes it: sh, the copy, the user.
ntsync_hook="sh $HOME/.local/share/wsconfig/hooks/arch/wsbox-host-ntsync/install-hook "
ntsync_boxes="$(
    awk -v hook="init_hooks=\"$ntsync_hook" '
        /^\[/ { box = substr($0, 2, length($0) - 2) }
        index($0, hook) == 1 { print box }
    ' "$HOME/.local/share/wsconfig/distrobox/containers.ini" 2>/dev/null
)"
[[ -n "$ntsync_boxes" ]] || fail "no box runs the NTSync hook (distrobox/distrobox.nix; ws switch)"
for box in $ntsync_boxes; do
    if [[ "$(podman inspect -f '{{.State.Running}}' "$box" 2>/dev/null || true)" != true ]]; then
        info "$box not running; NTSync inside not checked"
        continue
    fi
    ntsync_missing="$(podman exec "$box" pacman -T NTSYNC-MODULE 2>/dev/null || true)"
    [[ -z "$ntsync_missing" ]] \
        && pass "$box: NTSYNC-MODULE dependency satisfied" \
        || fail "$box: NTSYNC-MODULE dependency unsatisfied: $ntsync_missing"
    if [[ "$boot" == container && ! -c /dev/ntsync ]]; then
        continue
    fi
    podman exec "$box" test -c /dev/ntsync >/dev/null 2>&1 \
        && pass "$box: /dev/ntsync visible inside" \
        || fail "$box: /dev/ntsync not visible inside"
done

check_finish
rc=$?
((rc == 0 && check_n_warn > 0)) && [[ "$strict" == true ]] && exit 2
exit "$rc"
