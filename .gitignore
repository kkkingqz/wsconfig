# GNOME GSettings compiled schemas are generated from tracked XML sources
gnome/extensions/*/schemas/gschemas.compiled

# Python bytecode/cache
__pycache__/
*.pyc

# Man pages are built by Nix from docs/ (nix/pkgs/man.nix); a local
# bin/ws-doc-build run writes here
man/

# nix build output links (build with --no-link)
result
result-*

# Isolated feature worktrees
.worktrees/
